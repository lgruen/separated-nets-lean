/-- Decidable reformulation of `IsKNskel`. -/
theorem isKNskel_of {r p k : ℕ} {sk : Fin 3 → Fin 3 → Fin 4 → ℤ}
    {C : Fin 3 → Matrix (Fin (3 * k + r)) (Fin (3 * k + r)) (ZMod p)}
    (h1 : ∀ c : Fin 3, ∀ j < depth r k c, ∀ col < 3 * k + r,
      ent (C c) j col = if col = off r k c + j then 1 else 0)
    (h2 : ∀ c d : Fin 3, r ≤ (c : ℕ) → ∀ l < depth r k d,
      ent (C c) (depth r k c) (off r k d + l) = ((winEntry (sk c d) (win r d) (depth r k d) l : ℤ) : ZMod p)) :
    IsKNskel r p k sk C :=
  ⟨fun c j col hj hcol => h1 c j hj col hcol, h2⟩

