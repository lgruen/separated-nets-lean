/-- Exact minimum of `torusDist2` over all pairs (Lean) = Python value; `S1_sep` bound. -/
def minD2 {s m p : ℕ} [NeZero p] (C : Fin s → Matrix (Fin m) (Fin m) (ZMod p)) : ℕ :=
  let pts := (List.finRange (p ^ m)).map fun t =>
    digPoint p m C (fun j : Fin m => ((t : ℕ) / p ^ (j : ℕ) : ℕ))
  (pts.zipIdx.flatMap fun (x, i) => (pts.drop (i + 1)).map fun y => torusDist2 (p ^ m) x y).foldl min (p ^ (2 * m) * s)
