/-! ## The explicit net of Definition `def:S1` -/

/-- `framePsi` with a given matrix `Bi` in place of `(frameBox s k p)⁻¹`. -/
def framePsiW (s k p : ℕ) (Bi : Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p)) :
    Fin (s * k + (s - 1)) → ZMod p :=
  (fun col : Fin (s * k + (s - 1)) => if h : 0 < s then
      ((ent (frameGen (s * k + (s - 1)) (⟨s - 1, Nat.sub_lt h Nat.one_pos⟩ : Fin s)) k col : ℤ) : ZMod p) else 0) ᵥ* Bi

/-- `gaugeS1` with `framePsiW`. -/
def gaugeS1W (s k p ρ : ℕ) (Bi : Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p)) :
    Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p) :=
  fun r col =>
    if (r : ℕ) % (k + 1) = k ∧ (r : ℕ) / (k + 1) + 1 < s then
      (if col = r then ((ρ ^ ((r : ℕ) / (k + 1) + 1) : ℕ) : ZMod p) * (framePsiW s k p Bi r)⁻¹
       else if (col : ℕ) / (k + 1) = (r : ℕ) / (k + 1) ∧ (col : ℕ) < r then
         -(framePsiW s k p Bi col) * (framePsiW s k p Bi r)⁻¹ else 0)
    else if col = r then 1 else 0

/-- `S1gen` with `Bi` in place of `(frameBox s k p)⁻¹`. -/
def S1genW (s p k ρ : ℕ) (Bi : Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (c : Fin s) : Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p) :=
  fun i col =>
    if (i : ℕ) < depth s k c then (if (col : ℕ) = off k c + i then 1 else 0)
    else if blk s k col = (c : ℕ) then 0
    else (((frameGen (s * k + (s - 1)) c).map (Int.cast : ℤ → ZMod p)) * Bi * gaugeS1W s k p ρ Bi) i col

/-- If `B · Bi = 1` for the box matrix `B = frameBox s k p`, then `S1gen = S1genW Bi`; so the
`#guard`s below (`B · Bi = 1` and `S1genW Bi = Python`) identify `S1gen` with the Python net. -/
theorem S1gen_eq_W (s p k ρ : ℕ) (Bi : Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (h : frameBox s k p * Bi = 1) : S1gen s p k ρ = S1genW s p k ρ Bi := by
  have hB : (frameBox s k p)⁻¹ = Bi := Matrix.inv_eq_right_inv h
  unfold S1gen S1genW gaugeS1 gaugeS1W framePsi framePsiW
  rw [hB]

