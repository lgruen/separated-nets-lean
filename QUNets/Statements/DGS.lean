      ≤ Real.sqrt (∑ c, ((cres (p ^ (3 * k + 2))
          ((Z3NetF.digPointShift p (3 * k + 2) C τ v c : ℤ) -
            (Z3NetF.digPointShift p (3 * k + 2) C τ w c : ℤ)) : ℝ)
