namespace Z3NetKN

open Matrix

/-- **`app:perprime`, the `m ≡ 2` designs** ("which we checked by exact computation for the
designs"): all 17 designs of `table2` satisfy (S2), (N2) and (K). -/
theorem pp2_table : ∀ x ∈ table2, CondS2 x.2.2 ∧ CondN2 x.1 x.2.2 ∧ kap1 x.1 x.2.2 = -1 ∧
    kap2 x.1 x.2.2 = -1 := by
  sorry

/-- **`app:perprime`, the `m ≡ 1` designs**: all 20 designs of `table1` satisfy (S1), (N1)
and (J). -/
theorem pp1_table : ∀ x ∈ table1, CondS1 x.2.2 ∧ CondN1 x.1 x.2.2 ∧ J1 x.1 x.2.2 = 1 ∧
    J2 x.1 x.2.2 = -1 ∧ J3 x.1 x.2.2 = 2 ∧ J4 x.1 x.2.2 = 2 ∧ J5 x.1 x.2.2 = 1 := by
  sorry

/-- **`prop:pp2`.** For every prime `p` and every design `R` for `(p, 2)` with (S2), (N2) and
(K) `κ₁ = κ₂ = -1`, and every `k ≥ 2`, there is a digital `(0,3k+2,3)`-net over `𝔽_p` in graph
form carrying `R` (`IsKN`: the designed geometric rows on the windows and `0` above them, the
deeper rows of every coordinate vanishing on its own cell). -/
theorem pp2_net (p k : ℕ) (hp : p.Prime) (R : Rows) (hS : CondS2 R) (hN : CondN2 p R)
    (hK1 : kap1 p R = -1) (hK2 : kap2 p R = -1) (hk : 2 ≤ k) :
    ∃ C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p),
      IsKN 2 p k R C ∧ IsNet0 p (3 * k + 2) (digPoint p (3 * k + 2) C) := by
  sorry

/-- **`prop:pp1`** (every odd prime `p`). For every design `R` for `(p, 1)` with (S1), (N1) and
(J) `(J₁, …, J₅) = (1, -1, 2, 2, 1)`, and every `k ≥ 3`, there is a digital `(0,3k+1,3)`-net
over `𝔽_p` in graph form carrying `R`. -/
theorem pp1_net (p k : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (R : Rows) (hS : CondS1 R)
    (hN : CondN1 p R) (hJ1 : J1 p R = 1) (hJ2 : J2 p R = -1) (hJ3 : J3 p R = 2)
    (hJ4 : J4 p R = 2) (hJ5 : J5 p R = 1) (hk : 3 ≤ k) :
    ∃ C : Fin 3 → Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p),
      IsKN 1 p k R C ∧ IsNet0 p (3 * k + 1) (digPoint p (3 * k + 1) C) := by
  sorry

/-- **`rem:ppshift`** (general form): `prop:ppsep` holds verbatim, with the same certificate `(T, Rg)`
(`def:pprelax`), for every digital shift `τ` (`def:dshift`) of every graph form `C` carrying the design `R` (net or not):
the points of `P ⊕ τ` satisfy `‖X(w) − X(v)‖²_torus ≥ T u²` for all indices `v ≠ w` (integer coordinates on the torus
of side `N = p^(3k+r)`, `u = p^(m−k−2)`). Here `p` is any prime (the unshifted `ppsep_general` assumes `p` odd). -/
theorem ppsep_shift (p r k T : ℕ) (hp : p.Prime) (hk : (r = 1 ∧ 3 ≤ k) ∨ (r = 2 ∧ 2 ≤ k)) (R : Rows)
    (Rg : Fin 3 → ℕ) (hcert : IsPPCert p r Rg R T)
    (C : Fin 3 → Matrix (Fin (3 * k + r)) (Fin (3 * k + r)) (ZMod p)) (hC : IsKN r p k R C)
    (τ : Fin 3 → Fin (3 * k + r) → ZMod p) (v w : Fin (3 * k + r) → ZMod p) (hvw : v ≠ w) :
    T * (p ^ (3 * k + r - (k + 2))) ^ 2 ≤
      torusDist2 (p ^ (3 * k + r)) (Z3NetF.digPointShift p (3 * k + r) C τ v)
        (Z3NetF.digPointShift p (3 * k + r) C τ w) := by
  sorry

/-- **`rem:ppshift`**, the per-prime designs with `m ≡ 1` (`table1`, `tab:perprime`): for each design `(p, T_p, R)`,
every `k ≥ 3`, every graph form `C` with these rows, every digital shift `τ` and distinct indices `v ≠ w`, with
`N = p^(3k+1)`: `T_p · p^(4k-2) ≤ N² δ²` for the points of `P ⊕ τ`, i.e. `δ ≥ √T_p · p^(-5/3) · N^(-1/3)`. -/
theorem KN1_sep_shift (p T : ℕ) (R : Rows) (hmem : (p, T, R) ∈ table1) (k : ℕ) (hk : 3 ≤ k)
    (C : Fin 3 → Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p)) (hC : IsKN 1 p k R C)
    (τ : Fin 3 → Fin (3 * k + 1) → ZMod p) (v w : Fin (3 * k + 1) → ZMod p) (hvw : v ≠ w) :
    T * p ^ (4 * k - 2) ≤
      torusDist2 (p ^ (3 * k + 1)) (Z3NetF.digPointShift p (3 * k + 1) C τ v)
        (Z3NetF.digPointShift p (3 * k + 1) C τ w) := by
  sorry

/-- **`rem:ppshift`**, the per-prime designs with `m ≡ 2` (`table2`, `tab:perprime`): for each design `(p, T_p, R)`,
every `k ≥ 2`, every graph form `C` with these rows, every digital shift `τ` and `v ≠ w`, with `N = p^(3k+2)`:
`T_p · p^(4k) ≤ N² δ²` for the points of `P ⊕ τ`, i.e. `δ ≥ √T_p · p^(-4/3) · N^(-1/3)`. -/
theorem KN2_sep_shift (p T : ℕ) (R : Rows) (hmem : (p, T, R) ∈ table2) (k : ℕ) (hk : 2 ≤ k)
    (C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p)) (hC : IsKN 2 p k R C)
    (τ : Fin 3 → Fin (3 * k + 2) → ZMod p) (v w : Fin (3 * k + 2) → ZMod p) (hvw : v ≠ w) :
    T * p ^ (4 * k) ≤
      torusDist2 (p ^ (3 * k + 2)) (Z3NetF.digPointShift p (3 * k + 2) C τ v)
        (Z3NetF.digPointShift p (3 * k + 2) C τ w) := by
  sorry

end Z3NetKN

namespace Z3NetPI

open Matrix

/-- **`lem:ppinv` (a), restriction to the windows.** -/
theorem ppinv_window {F : Type*} [Field F] {a b : ℕ} (A : Matrix (Fin a) (Fin b) F)
    (L : Matrix (Fin a) (Fin a) F) (U : Matrix (Fin b) (Fin b) F)
    (hL : ∀ i j : Fin a, i < j → L i j = 0) (hU : ∀ i j : Fin b, i < j → U i j = 0)
    (hb : 3 ≤ b) :
    winB (L * A * U) = winL L * winB A * winU U ∧ winL L 0 1 = 0 ∧
      ∀ i i' : Fin 3, i' < i → winU U i i' = 0 := by
  sorry

/-- **`lem:ppinv` (a), `m ≡ 2`:** where defined, `κ₁`, `κ₂` are unchanged by the moves. -/
theorem ppinv_a2 {F : Type*} [Field F] (L : Fin 3 → Matrix (Fin 2) (Fin 2) F)
    (U : Fin 3 → Matrix (Fin 3) (Fin 3) F) (μ : Fin 3 → Fin 3 → F)
    (W W' : Fin 3 → Fin 3 → Matrix (Fin 2) (Fin 3) F)
    (hL : ∀ c, L c 0 1 = 0 ∧ L c 0 0 ≠ 0 ∧ L c 1 1 ≠ 0)
    (hU : ∀ d, (∀ i i' : Fin 3, i' < i → U d i i' = 0) ∧ ∀ i, U d i i ≠ 0)
    (hμ : ∀ c d, c ≠ d → μ c d ≠ 0)
    (hW' : ∀ c d, c ≠ d → W' c d = μ c d • (L c * W c d * U d)) (hW : DefK W) :
    DefK W' ∧ kapW1 W' = kapW1 W ∧ kapW2 W' = kapW2 W := by
  sorry

/-- **`lem:ppinv` (a), `m ≡ 1`:** where defined, `J₁, …, J₅` are unchanged by the moves. -/
theorem ppinv_a1 {F : Type*} [Field F] (L : Fin 3 → Matrix (Fin 2) (Fin 2) F)
    (U : Fin 3 → Matrix (Fin 3) (Fin 3) F) (μ : Fin 3 → Fin 3 → F)
    (W W' : Fin 3 → Fin 3 → Matrix (Fin 2) (Fin 3) F)
    (hL : ∀ c, L c 0 1 = 0 ∧ L c 0 0 ≠ 0 ∧ L c 1 1 ≠ 0)
    (hU : ∀ d, (∀ i i' : Fin 3, i' < i → U d i i' = 0) ∧ ∀ i, U d i i ≠ 0)
    (hμ : ∀ c d, c ≠ d → μ c d ≠ 0)
    (hW' : ∀ c d, c ≠ d → W' c d = μ c d • (L c * W c d * U d)) (hW : DefJ W) :
    DefJ W' ∧ JW1 W' = JW1 W ∧ JW2 W' = JW2 W ∧ JW3 W' = JW3 W ∧ JW4 W' = JW4 W ∧
      JW5 W' = JW5 W := by
  sorry

/-- **`lem:ppinv` (b), `m ≡ 2`:** for every prime `p` and every `k ≥ 1`, `Φ^F` has
`κ₁ = κ₂ = -1` (and both are defined). -/
theorem ppinv_b2 (p k : ℕ) [Fact p.Prime] (hk : 1 ≤ k) :
    DefK (winF 2 p k) ∧ kapW1 (winF 2 p k) = -1 ∧ kapW2 (winF 2 p k) = -1 := by
  sorry

/-- **`lem:ppinv` (b), `m ≡ 1`:** for every prime `p` and every `k ≥ 2`, `Φ^F` has
`(J₁, …, J₅) = (1, -1, 2, 2, 1)` (and all are defined). -/
theorem ppinv_b1 (p k : ℕ) [Fact p.Prime] (hk : 2 ≤ k) :
    DefJ (winF 1 p k) ∧ JW1 (winF 1 p k) = 1 ∧ JW2 (winF 1 p k) = -1 ∧ JW3 (winF 1 p k) = 2 ∧
      JW4 (winF 1 p k) = 2 ∧ JW5 (winF 1 p k) = 1 := by
  sorry

end Z3NetPI

namespace Z3NetKN

/-- **`prop:pp1`** for every prime `p` (including `p = 2`; `pp1_net` above assumes `p ≠ 2`). For
every design `R` for `(p, 1)` with (S1), (N1) and (J) `(J₁, …, J₅) = (1, -1, 2, 2, 1)` in `𝔽_p`, and
every `k ≥ 3`, there is a digital `(0,3k+1,3)`-net over `𝔽_p` in graph form carrying `R`. -/
theorem pp1_net_all (p k : ℕ) (hp : p.Prime) (R : Rows) (hS : CondS1 R)
    (hN : CondN1 p R) (hJ1 : J1 p R = 1) (hJ2 : J2 p R = -1) (hJ3 : J3 p R = 2)
    (hJ4 : J4 p R = 2) (hJ5 : J5 p R = 1) (hk : 3 ≤ k) :
    ∃ C : Fin 3 → Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p),
      IsKN 1 p k R C ∧ IsNet0 p (3 * k + 1) (digPoint p (3 * k + 1) C) := by
  sorry

/-- **`prop:ppsep`** (general form). Let `p` be an odd prime, `R` a design for `(p, r)`
(`r ∈ {1, 2}`) with a certificate `(T, Rg)` (`def:pprelax`), and `k ≥ 3` (`r = 1`) resp. `k ≥ 2`
(`r = 2`). Every graph form `C` over `𝔽_p` with depths `K` carrying `R`, net or not, has
`‖X(w) − X(v)‖²_torus ≥ T u²` for all indices `v ≠ w` (integer coordinates on the torus of side
`N = p^(3k+r)`, `u = p^(m−k−2)`); i.e. `δ N^(1/3) ≥ √T p^(−5/3)` (`r = 1`) resp. `√T p^(−4/3)`
(`r = 2`). -/
theorem ppsep_general (p r k T : ℕ) (hp : p.Prime) (_hp2 : p ≠ 2)
    (hk : (r = 1 ∧ 3 ≤ k) ∨ (r = 2 ∧ 2 ≤ k)) (R : Rows) (Rg : Fin 3 → ℕ)
    (hcert : IsPPCert p r Rg R T)
    (C : Fin 3 → Matrix (Fin (3 * k + r)) (Fin (3 * k + r)) (ZMod p)) (hC : IsKN r p k R C)
    (v w : Fin (3 * k + r) → ZMod p) (hvw : v ≠ w) :
    T * (p ^ (3 * k + r - (k + 2))) ^ 2 ≤
      torusDist2 (p ^ (3 * k + r)) (digPoint p (3 * k + r) C v) (digPoint p (3 * k + r) C w) := by
  sorry

end Z3NetKN
