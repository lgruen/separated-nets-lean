theorem covering_of_net {s q k : ℕ} (hs : 1 ≤ s) (hq : 2 ≤ q)
    (X : (Fin (s * k) → ZMod q) → Fin s → ℕ) (hX : IsNet0 s q (s * k) X) (x : Fin s → ℝ)
    (hx : ∀ c, 0 ≤ x c ∧ x c ≤ 1) :
    ∃ v, ∑ c, (x c - (X v c : ℝ) / (q : ℝ) ^ (s * k)) ^ 2 ≤ (s : ℝ) / ((q : ℝ) ^ k) ^ 2 := by
