theorem Ustar_adm {s : ℕ} [NeZero s] (hs : 3 ≤ s) (d : Fin s) (j : ℕ) (hj : j ≤ s - 2) :
    AdmCol d j (fun c => if c = d then 0 else Msum (UstarF s) j c d) := by
