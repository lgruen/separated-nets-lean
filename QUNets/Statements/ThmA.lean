theorem A_hom (s q : ℕ) [NeZero s] (hs : 3 ≤ s) (hq : AdmBase s q) :
    Nonempty (RS s →+* ZMod q) ∧ ∀ ψ ψ' : RS s →+* ZMod q, ψ = ψ' := by
