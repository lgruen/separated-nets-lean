namespace Z3NetF

open Matrix Finset

/-- **`prop:P`(1)**: a Cauchy layer over `𝔽_p` with `2 W_xy ≡ h_xy (mod p)` for the twelve ordered
pairs of four distinct coordinates, `h_xy` odd with `|h_xy| ≤ H`: `p` divides a nonzero (odd)
integer `Z` with `|Z| ≤ 13 H^16`. -/
theorem P_half_mod {ι : Type*} (p : ℕ) [Fact p.Prime] (α β lam mu : ι → ZMod p)
    (h : CauchyOK α β lam mu) (a b c d : ι) (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (hh : ι → ι → ℤ) (H : ℕ)
    (hodd : ∀ x y, (x = a ∨ x = b ∨ x = c ∨ x = d) → (y = a ∨ y = b ∨ y = c ∨ y = d) → x ≠ y →
      Odd (hh x y) ∧ |hh x y| ≤ H ∧ 2 * cauchyW α β lam mu x y = (hh x y : ZMod p)) :
    ∃ Z : ℤ, Odd Z ∧ |Z| ≤ 13 * (H : ℤ) ^ 16 ∧ (p : ℤ) ∣ Z := by
  sorry

/-- **`prop:P`(1)**, "in particular": impossible for `p > 13 H^16`. -/
theorem P_half_mod_large {ι : Type*} (p : ℕ) [Fact p.Prime] (α β lam mu : ι → ZMod p)
    (h : CauchyOK α β lam mu) (a b c d : ι) (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (H : ℕ) (hp : 13 * H ^ 16 < p) :
    ¬ ∃ hh : ι → ι → ℤ, ∀ x y, (x = a ∨ x = b ∨ x = c ∨ x = d) →
      (y = a ∨ y = b ∨ y = c ∨ y = d) → x ≠ y →
        Odd (hh x y) ∧ |hh x y| ≤ H ∧ 2 * cauchyW α β lam mu x y = (hh x y : ZMod p) := by
  sorry

/-- **`prop:P`(2)**: over `ℚ`, the twelve entries `W_xy` (`x ≠ y` among four distinct
coordinates) of a Cauchy layer do not all lie in `1/2 + ℤ`. -/
theorem P_half_rat {ι : Type*} (α β lam mu : ι → ℚ) (h : CauchyOK α β lam mu) (a b c d : ι)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    ¬ ∀ x y, (x = a ∨ x = b ∨ x = c ∨ x = d) → (y = a ∨ y = b ∨ y = c ∨ y = d) → x ≠ y →
      ∃ n : ℤ, cauchyW α β lam mu x y = n + 1 / 2 := by
  sorry

/-- **`lem:Tsplit`**, value: the box matrix of the split frame is the Hermite matrix of the `2s`
points with the multiplicities `splitMult`, so its determinant is, up to sign, the confluent
Vandermonde product (any commutative ring, `m = s k`). -/
theorem Tsplit_minor {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R) (d : Fin s → ℕ)
    (hd : ∑ c, d c = s * k) :
    Z3NetF.boxMatrix (splitRead (s * k) k u v) d = hermiteMat (s * k) (splitPts u v) (splitMult k d) 0 ∧
      ((boxMatrix (splitRead (s * k) k u v) d).det = ∏ Q : Fin (2 * s), ∏ P : Fin (2 * s),
          (if P < Q then (splitPts u v Q - splitPts u v P) ^ (splitMult k d P * splitMult k d Q) else 1) ∨
        (boxMatrix (splitRead (s * k) k u v) d).det = -∏ Q : Fin (2 * s), ∏ P : Fin (2 * s),
          (if P < Q then (splitPts u v Q - splitPts u v P) ^ (splitMult k d P * splitMult k d Q) else 1)) := by
  sorry

/-- **`lem:Tsplit`**, net criterion: for `s ≥ 4`, `k ≥ 1` and rational points with denominators
prime to `q`, the split frame (reduced modulo `q`) is a `(0,sk,s)`-net over `ℤ/qℤ` iff the `2s`
points are pairwise distinct modulo every prime factor of `q`. -/
theorem Tsplit_net_iff {s q k : ℕ} (hs : 4 ≤ s) (hk : 1 ≤ k) (hq : 2 ≤ q) (u v : Fin s → ℚ)
    (hden : ∀ c, Nat.Coprime (u c).den q ∧ Nat.Coprime (v c).den q) :
    IsNet0 s q (s * k) (digPoint q (s * k)
        (splitRead (s * k) k (fun c => ratRed q (u c)) (fun c => ratRed q (v c)))) ↔
      ∀ p : ℕ, p.Prime → p ∣ q → Function.Injective (fun P => ratRed p (splitPts u v P)) := by
  sorry

/-- **`lem:Tsplit`**, the parenthetical consequence: distinctness of the `2s` points modulo `p`
needs `p ≥ 2s`. -/
theorem Tsplit_prime_bound {s p : ℕ} (u v : Fin s → ℚ)
    (h : Function.Injective (fun P => ratRed p (splitPts u v P))) (hp : p.Prime) : 2 * s ≤ p := by
  sorry

/-- **The graph form of the split frame** (after `lem:Tsplit`): the `(k, …, k)` box of the split
frame is invertible, and `Φ^S` is its graph form: `C^S_c = graphGenK (k, …, k) Φ^S c · G`. -/
theorem split_spec {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (huv : SplitOK u v) :
    IsUnit (boxMatrix (splitRead (s * k) k u v) (fun _ => k)).det ∧
      ∀ c, graphGenK (m := s * k) (fun _ => k) (splitGraph R k u v) c *
        boxMatrix (splitRead (s * k) k u v) (fun _ => k) = splitRead (s * k) k u v c := by
  sorry

/-- **Box minors of `Φ^S`** (after `lem:Tsplit`): every box minor of the graph form `Φ^S` is the
box minor of the split frame (`lem:Tsplit`) divided by the unit `(k, …, k)` minor. -/
theorem split_boxMinor {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (huv : SplitOK u v) (d : Fin s → ℕ) (hd : ∑ c, d c = s * k) :
    (boxMatrix (graphGenK (m := s * k) (fun _ => k) (splitGraph R k u v)) d).det *
        (boxMatrix (splitRead (s * k) k u v) (fun _ => k)).det =
      (boxMatrix (splitRead (s * k) k u v) d).det := by
  sorry

/-- **`lem:Rsplit`**: for every `k ≥ 1` and `c ≠ d`, row `0` of `Φ^S_cd` has the generating
function `P_c^k / (Π_d(v_d + x) (ϑ_cd - x))` in the `x`-index: level `j` carries
`[x^(k-1-j)]` of it. -/
theorem Rsplit_row0 {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (huv : SplitOK u v) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k)) (hr : (r : ℕ) = 0)
    (j : Fin k) :
    splitGraph R k u v c d r j = PowerSeries.coeff (k - 1 - (j : ℕ)) (rsSplit k u v c d) := by
  sorry

/-- **`prop:Gsplit`, normal form**: with `L_c = diag(P_c^(-k), 1, …, 1)` and
`U_d = Toep(Π_d(v_d + x))`, row `0` of `L_c Φ^S_cd U_d` (`c ≠ d`) carries `w_cd y_cd^n` at the
`x`-index `n` (level `k-1-n`), `w_cd = y_cd = 1/(u_c - v_d)`, independently of `k`. -/
theorem Gsplit_normal {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (huv : SplitOK u v) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k)) (hr : (r : ℕ) = 0)
    (j : Fin k) :
    (Lgauge (s * k - k) (Ring.inverse (Psplit u v c ^ k)) * splitGraph R k u v c d *
        toep k (piSplit k v d)) r j = ySplit u v c d * ySplit u v c d ^ (k - 1 - (j : ℕ)) := by
  sorry

/-- **`prop:Gsplit`, the nodes**: `w_cd = y_cd` is a unit, and within each column `d` the
`y_cd` (`c ≠ d`) are pairwise distinct with unit differences
`y_cd - y_c'd = (u_c' - u_c)/(ϑ_cd ϑ_c'd)`. -/
theorem Gsplit_nodes {R : Type*} [CommRing R] {s : ℕ} (u v : Fin s → R) (huv : SplitOK u v)
    (c c' d : Fin s) (hc : c ≠ d) (hc' : c' ≠ d) :
    IsUnit (ySplit u v c d) ∧
      ySplit u v c d - ySplit u v c' d = (u c' - u c) * Ring.inverse ((u c - v d) * (u c' - v d)) ∧
      (c ≠ c' → IsUnit (ySplit u v c d - ySplit u v c' d)) := by
  sorry

/-- **`prop:Gsplit`** (`prop:Gs` verbatim): the coefficients `β_n` exist and are unique
(`n ≥ s-1`, every column `d`). -/
theorem Gsplit_beta {R : Type*} [CommRing R] {s : ℕ} (hs : 2 ≤ s) (u v : Fin s → R)
    (huv : SplitOK u v) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (hres : ResidualS u v F lam Ur) (d : Fin s) (n : ℕ) :
    ∃! b : Fin (s - 1) → R, ∀ c, c ≠ d →
      lam c * (ySplit u v c d * ySplit u v c d ^ n) = ∑ i : Fin (s - 1), b i * F i c d := by
  sorry

/-- **`prop:Gsplit`** (`prop:Gs` verbatim, the gauge): `L_c` and `U_d` are lower triangular with
unit diagonal (for any `β`), so they are gauge moves of `lem:box`(c). -/
theorem Gsplit_gauge {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (huv : SplitOK u v) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : ResidualS u v F lam Ur) :
    (∀ c i j, i < j → LmatS k u v lam c i j = 0) ∧ (∀ c i, IsUnit (LmatS k u v lam c i i)) ∧
      (∀ d i j, i < j → UgaugeS k v Ur β d i j = 0) ∧
      (∀ d i, IsUnit (UgaugeS k v Ur β d i i)) := by
  sorry

/-- **`prop:Gsplit`** (`prop:Gs` verbatim): row `0` of `L_c Φ^S_cd U_d` equals the design on the
`x`-indices `< s-1` (truncated if `k < s-1`) and vanishes below, every `k ≥ 1`, `c ≠ d`. -/
theorem Gsplit_row0 {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (huv : SplitOK u v) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : ResidualS u v F lam Ur)
    (hβ : BetaRelS u v F lam β) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k))
    (hr : (r : ℕ) = 0) (j : Fin k) :
    (LmatS k u v lam c * splitGraph R k u v c d * UgaugeS k v Ur β d) r j =
      if k - 1 - (j : ℕ) < s - 1 then F (k - 1 - (j : ℕ)) c d else 0 := by
  sorry

/-- **`prop:Gsplit`** (`cor:tsk` verbatim): every box minor of `𝒫^{u,v,F}_k` over `R` is a unit
of `R` (any `β`). -/
theorem Gsplit_tsk_unit {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (huv : SplitOK u v) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : ResidualS u v F lam Ur)
    (d : Fin s → ℕ) (hd : ∑ c, d c = s * k) :
    IsUnit (boxMatrix (PGenS k u v F lam Ur β) d).det := by
  sorry

/-- **`prop:Gsplit`** (`def:Ns`, `cor:tsk` verbatim): for every ring homomorphism
`ψ : R → ℤ/qℤ` (for `R = ℤ[1/D D']`, every `q` coprime to `D D'`), the reduction of
`𝒫^{u,v,F}_k` is a digital `(0,sk,s)`-net over `ℤ/qℤ` with one point in every cell, every
`k ≥ 1`. -/
theorem Gsplit_tsk_net {R : Type*} [CommRing R] {s q : ℕ} [NeZero q] (ψ : R →+* ZMod q) (k : ℕ)
    (u v : Fin s → R) (huv : SplitOK u v) (F : ℕ → Fin s → Fin s → R)
    (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R)
    (hres : ResidualS u v F lam Ur) :
    IsNet0 s q (s * k) (digPoint q (s * k) fun c => (PGenS k u v F lam Ur β c).map ψ) := by
  sorry

/-- **`prop:Gsplit`, reachability** (`prop:F` verbatim, both directions): for `k ≥ s-1`, the
off-diagonal part of the design is reachable from the split frame by column gauges `U_d` (lower
triangular, unit diagonal) with row scalars `λ'_c P_c^(-k)` iff the residual problem is solvable
with these `λ'`. -/
theorem Gsplit_reach_iff {R : Type*} [CommRing R] {s : ℕ} (hs : 2 ≤ s) (k : ℕ) (hk : s - 1 ≤ k)
    (u v : Fin s → R) (huv : SplitOK u v) (F : ℕ → Fin s → Fin s → R)
    (lam : Fin s → R) (hlam : ∀ c, IsUnit (lam c)) :
    (∃ U : Fin s → Matrix (Fin k) (Fin k) R, (∀ d i j, i < j → U d i j = 0) ∧
      (∀ d i, IsUnit (U d i i)) ∧ ∀ c d, c ≠ d → ∀ (r : Fin (s * k - k)), (r : ℕ) = 0 →
        ∀ j : Fin k, (LmatS k u v lam c * splitGraph R k u v c d * U d) r j =
          if k - 1 - (j : ℕ) < s - 1 then F (k - 1 - (j : ℕ)) c d else 0) ↔
    ∃ Ur : Fin s → ℕ → ℕ → R, ResidualS u v F lam Ur := by
  sorry

/-- **`prop:Gsplit`, the reachability criterion** (`prop:F` verbatim): the residual problem is
solvable with the row scalars `λ'` iff for every column `d` and every `j ≤ s-2`,
`M^(j)[c][d] = λ'_c g_{d,j}(y_cd)/(u_c - v_d)` (`c ≠ d`) for a polynomial `g_{d,j}` of degree `j`
with unit leading coefficient. -/
theorem Gsplit_poly_iff {R : Type*} [CommRing R] [Nontrivial R] {s : ℕ} (u v : Fin s → R)
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (hlam : ∀ c, IsUnit (lam c)) :
    (∃ Ur : Fin s → ℕ → ℕ → R, ResidualS u v F lam Ur) ↔
      ∀ d : Fin s, ∀ j, j < s - 1 → ∃ g : Polynomial R, g.natDegree = j ∧
        IsUnit g.leadingCoeff ∧ ∀ c, c ≠ d →
          Msum F j c d = lam c * g.eval (ySplit u v c d) * Ring.inverse (u c - v d) := by
  sorry

end Z3NetF

namespace Z3NetHL

open Matrix Finset

/-- **Lemma T′** (split-frame box minors, exact value). For every `s`, `m`, `k` and every
composition `d` of `m`, the box minor of the split frame equals the confluent Vandermonde
determinant of the `2s` points in the order `(0,0) < (0,1) < (1,0) < …` (`(c,0) = v_c`,
`(c,1) = u_c`) with multiplicities `splitMult`:
`∏_{(c',e') < (c,e)} (x_(c,e) - x_(c',e'))^(mult(c',e') · mult(c,e))`. -/
theorem HL_frameMinor (s m k : ℕ) (u v : Fin s → ℤ) (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    (boxMatrix (splitGen m k u v) d).det =
      ∏ c : Fin s, ∏ e : Fin 2, ∏ c' : Fin s, ∏ e' : Fin 2,
        (if c' < c ∨ (c' = c ∧ e' < e) then
          (splitPt u v c e - splitPt u v c' e') ^ (splitMult k d c' e' * splitMult k d c e)
        else 1) := by
  sorry

/-- **Prop N′** (the Cauchy kernel): over `ℚ`, for `c ≠ d` with `u_c ≠ v_{d'}` for all `d'`,
`Ψ_cd[0, j] = P_c^k · y_cd^(k-j)` (so `P_c^(-k) Ψ_cd[0, ·]` is `w_cd y_cd^n` at `x`-index
`n = k-1-j`, `w = y = 1/(u_c - v_d)`). -/
theorem HL_propN (s k : ℕ) (u v : Fin s → ℤ) (c d : Fin s) (hcd : c ≠ d)
    (huv : ∀ d', u c ≠ v d') (r : Fin (s * k - k)) (hr : (r : ℕ) = 0) (j : Fin k) :
    (Psi k u v c d r j : ℚ) =
      (∏ d' : Fin s, ((u c - v d' : ℤ) : ℚ)) ^ k * yQ u v c d ^ (k - (j : ℕ)) := by
  sorry

/-- **(H1).** For admissible `q` and every `k ≥ 1`, row `0` of every block `Φ'_cd` of the net is
the design: level `j` carries `F_{k-1-j}[c][d]` (`0` for `k-1-j ≥ s-1`). -/
theorem HL_row0 (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (hs : 2 ≤ s) (hq : HLAdm s q u v lam gco) (hden : HLDen s q gco dg)
    (hk : 1 ≤ k) (c d : Fin s) (r : Fin (s * k - k)) (hr : (r : ℕ) = 0) (j : Fin k) :
    HLPhi s q k u v lam gco dg c d r j = qr q (HLdes u v lam gco dg (k - 1 - (j : ℕ)) c d) := by
  sorry

/-- **Split-frame nets are `(0,sk,s)`-nets.** For every `s ≥ 2`, every admissible `q` (composite
allowed) and every `k ≥ 1`, the net is a digital `(0,sk,s)`-net over `ℤ/qℤ`. -/
theorem HL_net (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (hs : 2 ≤ s) (hq : HLAdm s q u v lam gco) (hk : 1 ≤ k) :
    IsNet0 s q (s * k) (HLpoint s q k u v lam gco dg) := by
  sorry

/-- **(H1) as `RowDesign`.** For admissible `q` and `k ≥ 1`, the split-frame net satisfies the
row-`0` hypothesis of Prop H_k with the doubled design `F2 = 2F` (so `GF_relax`, `GF_dom`,
`GF_dom_real`, `GF_upper` apply to `HLpoint = GFpoint … (HLPhi …)`); only the design levels
`< min(k, s-1)` need to be half-integral. -/
theorem HL_rowDesign (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s)
    (hq : HLAdm s q u v lam gco) (hden : HLDen s q gco dg)
    (hF2 : ∀ x c d, x < min k (s - 1) → 2 * HLdes u v lam gco dg x c d = F2 x c d) (hk : 1 ≤ k) :
    RowDesign s q k (HLPhi s q k u v lam gco dg) F2 ∧
      ∀ x, HLpoint s q k u v lam gco dg x = GFpoint s q k (HLPhi s q k u v lam gco dg) x := by
  sorry

/-- **(H1) per level.** As `HL_row0` (entry HL), with admissibility only up to level
`min(k, s-1)`: row `0` of every block of the net is the design. -/
theorem HL_row0_lev (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (hs : 2 ≤ s) (hq : HLAdmL s q (min k (s - 1)) u v lam gco)
    (hden : HLDen s q gco dg) (hk : 1 ≤ k) (c d : Fin s) (r : Fin (s * k - k)) (hr : (r : ℕ) = 0)
    (j : Fin k) :
    HLPhi s q k u v lam gco dg c d r j = qr q (HLdes u v lam gco dg (k - 1 - (j : ℕ)) c d) := by
  sorry

/-- **Split-frame nets, per level.** For every `s ≥ 2`, every `k ≥ 1` and every `q` admissible up
to level `min(k, s-1)` (composite allowed), the net is a digital `(0,sk,s)`-net over `ℤ/qℤ`. -/
theorem HL_net_lev (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (hs : 2 ≤ s) (hq : HLAdmL s q (min k (s - 1)) u v lam gco) (hk : 1 ≤ k) :
    IsNet0 s q (s * k) (HLpoint s q k u v lam gco dg) := by
  sorry

/-- **`prop:Hk`(1) per level** (the carry relaxation), as `HL_relax` (entry HL) with admissibility
only up to level `min(k, s-1)`. -/
theorem HL_relax_lev (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s)
    (hq : HLAdmL s q (min k (s - 1)) u v lam gco) (hden : HLDen s q gco dg) (hq7 : 7 ≤ q)
    (hF2 : ∀ x c d, 2 * HLdes u v lam gco dg x c d = F2 x c d) (hk : 1 ≤ k)
    (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    4 * (q : ℤ) ^ (2 * (s * k - k)) ≤
        (torusDist2 (q ^ (s * k)) (HLpoint s q k u v lam gco dg x) (HLpoint s q k u v lam gco dg y) : ℤ) ∨
      ∃ (E : Fin s → ℤ) (J : Fin s → ℕ) (Δ : Fin s → ℤ),
        (∀ c, |E c| ≤ 2) ∧ (∃ c, E c ≠ 0) ∧ (∀ c, J c < min k (s - 1)) ∧
        (∀ c, (q : ℤ) ∣ 2 * Δ c - sig2 F2 E J c) ∧ (∀ c, |Δ c| < q) ∧
        (q : ℤ) ^ (2 * (s * k - k - 1)) * ∑ c, (max 0 (|(q : ℤ) * E c + Δ c| - 1)) ^ 2 ≤
          (torusDist2 (q ^ (s * k)) (HLpoint s q k u v lam gco dg x) (HLpoint s q k u v lam gco dg y) : ℤ) := by
  sorry

/-- **`prop:Hk`(2) per level** (dominance limit, exact integer form), as `HL_dom` (entry HL) with
admissibility only up to level `min(k, s-1)`. -/
theorem HL_dom_lev (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s)
    (hq : HLAdmL s q (min k (s - 1)) u v lam gco) (hden : HLDen s q gco dg) (hqodd : Odd q)
    (hF2 : ∀ x c d, 2 * HLdes u v lam gco dg x c d = F2 x c d)
    (hhalf0 : ∀ c d, Odd (F2 0 c d)) (hhalf : ∀ x c d, 1 ≤ x → Even (F2 x c d))
    (hdiag : ∀ x c, 1 ≤ x → F2 x c c = 0) (hdom : ∀ c, (A2 s F2 c : ℤ) ≤ -F2 0 c c)
    (hqB : 2 * Bdom s F2 + 2 ≤ q) (hk : 1 ≤ k) (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    (q : ℤ) ^ (2 * (s * k - k - 1)) *
        min ((s : ℤ) * ((q : ℤ) - 2 * Bdom s F2 - 2) ^ 2) (8 * ((q : ℤ) - Bdom s F2 - 1) ^ 2) ≤
      4 * (torusDist2 (q ^ (s * k)) (HLpoint s q k u v lam gco dg x) (HLpoint s q k u v lam gco dg y) : ℤ) := by
  sorry

/-- **`prop:Hk`(2) per level, real form**: `δ N^(1/s) ≥ min(√s (1/2 - η), √2 (1 - η))`,
`η = (B + 1)/q`, under the hypotheses of `HL_dom_lev`. -/
theorem HL_dom_lev_real (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s)
    (hq : HLAdmL s q (min k (s - 1)) u v lam gco) (hden : HLDen s q gco dg) (hqodd : Odd q)
    (hF2 : ∀ x c d, 2 * HLdes u v lam gco dg x c d = F2 x c d)
    (hhalf0 : ∀ c d, Odd (F2 0 c d)) (hhalf : ∀ x c d, 1 ≤ x → Even (F2 x c d))
    (hdiag : ∀ x c, 1 ≤ x → F2 x c c = 0) (hdom : ∀ c, (A2 s F2 c : ℤ) ≤ -F2 0 c c)
    (hqB : 2 * Bdom s F2 + 2 ≤ q) (hk : 1 ≤ k) (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    min (Real.sqrt s * (1 / 2 - ((Bdom s F2 : ℝ) + 1) / q)) (Real.sqrt 2 * (1 - ((Bdom s F2 : ℝ) + 1) / q)) *
        ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (s * k))
          ((HLpoint s q k u v lam gco dg x c : ℤ) - (HLpoint s q k u v lam gco dg y c : ℤ)) : ℝ)
            / (q : ℝ) ^ (s * k)) ^ 2) := by
  sorry

/-- **`lem:Hs`** (half-integer designs): `u_c` even, `v_d` odd, `λ'_c = Λ_c/2`, `g_{d,j} = 1 + 2y^j`
(`gcoH`), `c ≠ d`, `j ≤ s-2`: `M^(j)[c][d] = Λ_c/(2ϑ_cd) + [j ≥ 1] Λ_c/ϑ_cd^(j+1) ∈ ½ + ℤ`, `F_j ∈ ℤ` (`j ≥ 1`). -/
theorem HL_halfDesign (s : ℕ) (u v : Fin s → ℤ) (hu : ∀ c, Even (u c)) (hv : ∀ d, Odd (v d))
    (dg : Fin s → ℕ → ℚ) (c d : Fin s) (hcd : c ≠ d) (j : ℕ) (hj : j ≤ s - 2) :
    let Λ : Fin s → ℚ := fun c' => ∏ d' ∈ univ.erase c', ((u c' - v d' : ℤ) : ℚ) ^ (s - 1)
    let θ : ℚ := ((u c - v d : ℤ) : ℚ)
    let M := ∑ n ∈ range (j + 1), HLdes u v (fun c' => Λ c' / 2) gcoH dg n c d
    M = Λ c / (2 * θ) + (if j = 0 then 0 else Λ c / θ ^ (j + 1)) ∧ (∃ z : ℤ, M = z + 1 / 2) ∧
      (1 ≤ j → ∃ z : ℤ, HLdes u v (fun c' => Λ c' / 2) gcoH dg j c d = z) := by
  sorry

/-- **`lem:Hs`** for `H_s` (`s ≥ 2`): every prime `q ≥ 2s` is admissible (the primes of `DD'` are
`≤ 2s - 1`), and the completed design is half-integer: `2F_x` integral, odd at `x = 0`, even at `x ≥ 1`. -/
theorem HL_Hs (s q : ℕ) (hs : 2 ≤ s) (hq : q.Prime) (hqs : 2 * s ≤ q) :
    HLAdm s q uH vH (lamH s) gcoH ∧ HLDen s q gcoH (dgH s) ∧ ∀ x c d, ∃ z : ℤ,
      2 * HLdes uH vH (lamH s) gcoH (dgH s) x c d = z ∧ (x = 0 → Odd z) ∧ (1 ≤ x → Even z) := by
  sorry

/-- **Prop H_k(a)** (the carry relaxation). Let `F2 = 2 F` be the doubled design (integers).
For admissible `q ≥ 7`, every `k ≥ 1` and distinct indices `x ≠ y` (with `D² = torusDist2` at
scale `N = q^(sk)`): either `D² ≥ 4 q^(2(s-1)k)` (two cells apart in some coordinate), or there
are cell steps `E ∈ {-2,…,2}^s \ {0}`, carry lengths `J_d < min(k, s-1)` and first-offset-digit
changes `Δ_c` with `2Δ_c ≡ 2σ_c (mod q)` (`2σ_c = sig2 F2 E J c`), `|Δ_c| < q`, and
`D² ≥ q^(2(s-1)k-2) ∑_c max(0, |q E_c + Δ_c| - 1)²`. -/
theorem HL_relax (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s)
    (hq : HLAdm s q u v lam gco) (hden : HLDen s q gco dg) (hq7 : 7 ≤ q)
    (hF2 : ∀ x c d, 2 * HLdes u v lam gco dg x c d = F2 x c d) (hk : 1 ≤ k)
    (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    4 * (q : ℤ) ^ (2 * (s * k - k)) ≤
        (torusDist2 (q ^ (s * k)) (HLpoint s q k u v lam gco dg x) (HLpoint s q k u v lam gco dg y) : ℤ) ∨
      ∃ (E : Fin s → ℤ) (J : Fin s → ℕ) (Δ : Fin s → ℤ),
        (∀ c, |E c| ≤ 2) ∧ (∃ c, E c ≠ 0) ∧ (∀ c, J c < min k (s - 1)) ∧
        (∀ c, (q : ℤ) ∣ 2 * Δ c - sig2 F2 E J c) ∧ (∀ c, |Δ c| < q) ∧
        (q : ℤ) ^ (2 * (s * k - k - 1)) * ∑ c, (max 0 (|(q : ℤ) * E c + Δ c| - 1)) ^ 2 ≤
          (torusDist2 (q ^ (s * k)) (HLpoint s q k u v lam gco dg x) (HLpoint s q k u v lam gco dg y) : ℤ) := by
  sorry

/-- **Prop H_k(b)** (dominance limit), exact integer form. For a half-integer design
(`2F_0` odd including the diagonal, `2F_x` even and with zero diagonal for `x ≥ 1`) with dominant
diagonal (`2a_c = -2F_0[c][c] ≥ 2A_c`), odd admissible `q ≥ 2B + 2` (`B = Bdom`), every `k ≥ 1`
and distinct indices: `q^(2(s-1)k-2) · min(s (q - 2B - 2)², 8 (q - B - 1)²) ≤ 4 D²`,
i.e. `δ N^(1/s) ≥ min(√s (1/2 - η), √2 (1 - η))` with `η = (B + 1)/q`. -/
theorem HL_dom (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s)
    (hq : HLAdm s q u v lam gco) (hden : HLDen s q gco dg) (hqodd : Odd q)
    (hF2 : ∀ x c d, 2 * HLdes u v lam gco dg x c d = F2 x c d)
    (hhalf0 : ∀ c d, Odd (F2 0 c d)) (hhalf : ∀ x c d, 1 ≤ x → Even (F2 x c d))
    (hdiag : ∀ x c, 1 ≤ x → F2 x c c = 0) (hdom : ∀ c, (A2 s F2 c : ℤ) ≤ -F2 0 c c)
    (hqB : 2 * Bdom s F2 + 2 ≤ q) (hk : 1 ≤ k) (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    (q : ℤ) ^ (2 * (s * k - k - 1)) *
        min ((s : ℤ) * ((q : ℤ) - 2 * Bdom s F2 - 2) ^ 2) (8 * ((q : ℤ) - Bdom s F2 - 1) ^ 2) ≤
      4 * (torusDist2 (q ^ (s * k)) (HLpoint s q k u v lam gco dg x) (HLpoint s q k u v lam gco dg y) : ℤ) := by
  sorry

/-- **Prop H_k(b), real form.** Under the hypotheses of `HL_dom`, the toroidal distance between
any two distinct points (points `X / N`, `N = q^(sk)`) is at least
`min(√s (1/2 - η), √2 (1 - η)) · N^(-1/s)`, `η = (B + 1)/q`. -/
theorem HL_dom_real (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s)
    (hq : HLAdm s q u v lam gco) (hden : HLDen s q gco dg) (hqodd : Odd q)
    (hF2 : ∀ x c d, 2 * HLdes u v lam gco dg x c d = F2 x c d)
    (hhalf0 : ∀ c d, Odd (F2 0 c d)) (hhalf : ∀ x c d, 1 ≤ x → Even (F2 x c d))
    (hdiag : ∀ x c, 1 ≤ x → F2 x c c = 0) (hdom : ∀ c, (A2 s F2 c : ℤ) ≤ -F2 0 c c)
    (hqB : 2 * Bdom s F2 + 2 ≤ q) (hk : 1 ≤ k) (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    min (Real.sqrt s * (1 / 2 - ((Bdom s F2 : ℝ) + 1) / q)) (Real.sqrt 2 * (1 - ((Bdom s F2 : ℝ) + 1) / q)) *
        ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (s * k))
          ((HLpoint s q k u v lam gco dg x c : ℤ) - (HLpoint s q k u v lam gco dg y c : ℤ)) : ℝ)
            / (q : ℝ) ^ (s * k)) ^ 2) := by
  sorry

/-- **Prop H_k(1)** (`prop:Hk`(1)), for an arbitrary graph form over `ℤ/qℤ`, `q` odd (prime or
not), whose row `0` is a design satisfying (Half) on the levels `< L = min(k, s-1)`. If
`q > 2 max|σ_c| = max |sig2|` over all `E ∈ {-2,…,2}^s` and carry lengths `J_d < L`, then any
`LB` below `min(2, |b|/q)` for every `E ≠ 0` and `J` (with `|b| = √(∑ (2b_c)²)/2`, `bOpt2`; the
paper's `LB` is the least such value) satisfies `δ N^(1/s) ≥ LB` (toroidal distance). -/
theorem GF_relax (s q k : ℕ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 3 ≤ s) (hqodd : Odd q) (hk : 1 ≤ k)
    (hrow : RowDesign s q k Φ F2) (hhalf0 : ∀ c d, Odd (F2 0 c d))
    (hhalf : ∀ x c d, 1 ≤ x → x < min k (s - 1) → Even (F2 x c d))
    (hσ : ∀ (E : Fin s → ℤ) (J : Fin s → ℕ) (c : Fin s), (∀ d, |E d| ≤ 2) →
      (∀ d, J d < min k (s - 1)) → |sig2 F2 E J c| < q)
    (LB : ℝ) (hLB : ∀ (E : Fin s → ℤ) (J : Fin s → ℕ), (∀ d, |E d| ≤ 2) → (∃ d, E d ≠ 0) →
      (∀ d, J d < min k (s - 1)) →
      LB ≤ min 2 (Real.sqrt (∑ c, ((bOpt2 q F2 E J c : ℤ) : ℝ) ^ 2) / (2 * q)))
    (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    LB * ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (s * k))
          ((GFpoint s q k Φ x c : ℤ) - (GFpoint s q k Φ y c : ℤ)) : ℝ) / (q : ℝ) ^ (s * k)) ^ 2) := by
  sorry

/-- **Prop H_k(2)** (`prop:Hk`(2)) as printed, integer form, for an arbitrary graph form over
`ℤ/qℤ` (`q` odd): (Half), zero deeper diagonal and dominance `a_c ≥ A_c` only on the levels
`< L = min(k, s-1)`; if `q ≥ 2B + 2` (`B = BdomL s L F2`), then
`q^(2(s-1)k-2) · min(s (q - 2B - 2)², 8 (q - B - 1)²) ≤ 4 D²`. -/
theorem GF_dom (s q k : ℕ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s) (hqodd : Odd q) (hk : 1 ≤ k)
    (hrow : RowDesign s q k Φ F2) (hhalf0 : ∀ c d, Odd (F2 0 c d))
    (hhalf : ∀ x c d, 1 ≤ x → x < min k (s - 1) → Even (F2 x c d))
    (hdiag : ∀ x c, 1 ≤ x → x < min k (s - 1) → F2 x c c = 0)
    (hdom : ∀ c, (A2L s (min k (s - 1)) F2 c : ℤ) ≤ -F2 0 c c)
    (hqB : 2 * BdomL s (min k (s - 1)) F2 + 2 ≤ q) (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    (q : ℤ) ^ (2 * (s * k - k - 1)) *
        min ((s : ℤ) * ((q : ℤ) - 2 * BdomL s (min k (s - 1)) F2 - 2) ^ 2)
          (8 * ((q : ℤ) - BdomL s (min k (s - 1)) F2 - 1) ^ 2) ≤
      4 * (torusDist2 (q ^ (s * k)) (GFpoint s q k Φ x) (GFpoint s q k Φ y) : ℤ) := by
  sorry

/-- **Prop H_k(2)** as printed, real form, under the paper's hypothesis `q > 2B`:
`δ N^(1/s) ≥ min(√s (1/2 - η), √2 (1 - η))`, `η = (B + 1)/q`, `B` over the levels `< L`. -/
theorem GF_dom_real (s q k : ℕ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s) (hqodd : Odd q) (hk : 1 ≤ k)
    (hrow : RowDesign s q k Φ F2) (hhalf0 : ∀ c d, Odd (F2 0 c d))
    (hhalf : ∀ x c d, 1 ≤ x → x < min k (s - 1) → Even (F2 x c d))
    (hdiag : ∀ x c, 1 ≤ x → x < min k (s - 1) → F2 x c c = 0)
    (hdom : ∀ c, (A2L s (min k (s - 1)) F2 c : ℤ) ≤ -F2 0 c c)
    (hqB : 2 * BdomL s (min k (s - 1)) F2 < q) (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    min (Real.sqrt s * (1 / 2 - ((BdomL s (min k (s - 1)) F2 : ℝ) + 1) / q))
        (Real.sqrt 2 * (1 - ((BdomL s (min k (s - 1)) F2 : ℝ) + 1) / q)) *
        ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (s * k))
          ((GFpoint s q k Φ x c : ℤ) - (GFpoint s q k Φ y c : ℤ)) : ℝ) / (q : ℝ) ^ (s * k)) ^ 2) := by
  sorry

/-- **Prop H_k(3)** (`prop:Hk`(3)), for an arbitrary graph form over `𝔽_q`: if `F_0` is
half-integral and `q > 4sC + 2` (`2C = C2max`), there are two distinct points at Euclidean
(hence also toroidal) distance at most `(min(√s/2, √2) + √s (2C + 1)/q) N^(-1/s)`. -/
theorem GF_upper (s q k : ℕ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 3 ≤ s) (hq : q.Prime) (hk : 1 ≤ k)
    (hrow : RowDesign s q k Φ F2) (hhalf0 : ∀ c d, Odd (F2 0 c d))
    (hqC : 2 * s * C2max s F2 + 2 < q) :
    ∃ x y : Fin (s * k) → ZMod q, x ≠ y ∧
      Real.sqrt (∑ c, (((GFpoint s q k Φ x c : ℝ) - (GFpoint s q k Φ y c : ℝ)) / (q : ℝ) ^ (s * k)) ^ 2)
        ≤ (min (Real.sqrt s / 2) (Real.sqrt 2) + Real.sqrt s * ((C2max s F2 : ℝ) + 1) / q) *
          ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ))) := by
  sorry

/-- **Prop H_k(2) as printed, for the split-frame nets** (real form): the design data only on
the levels `< L = min(k, s-1)` (`2F` integral there, (Half), zero deeper diagonal, dominance
with `A_c` over `j < L`), odd admissible `q > 2B` (`B = BdomL s L F2`), every `k ≥ 1`:
`δ N^(1/s) ≥ min(√s (1/2 - η), √2 (1 - η))`, `η = (B + 1)/q`. -/
theorem HL_domL_real (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (F2 : ℕ → Fin s → Fin s → ℤ) (hs : 2 ≤ s)
    (hq : HLAdm s q u v lam gco) (hden : HLDen s q gco dg) (hqodd : Odd q)
    (hF2 : ∀ x c d, x < min k (s - 1) → 2 * HLdes u v lam gco dg x c d = F2 x c d)
    (hhalf0 : ∀ c d, Odd (F2 0 c d))
    (hhalf : ∀ x c d, 1 ≤ x → x < min k (s - 1) → Even (F2 x c d))
    (hdiag : ∀ x c, 1 ≤ x → x < min k (s - 1) → F2 x c c = 0)
    (hdom : ∀ c, (A2L s (min k (s - 1)) F2 c : ℤ) ≤ -F2 0 c c)
    (hqB : 2 * BdomL s (min k (s - 1)) F2 < q) (hk : 1 ≤ k) (x y : Fin (s * k) → ZMod q)
    (hxy : x ≠ y) :
    min (Real.sqrt s * (1 / 2 - ((BdomL s (min k (s - 1)) F2 : ℝ) + 1) / q))
        (Real.sqrt 2 * (1 - ((BdomL s (min k (s - 1)) F2 : ℝ) + 1) / q)) *
        ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (s * k))
          ((HLpoint s q k u v lam gco dg x c : ℤ) - (HLpoint s q k u v lam gco dg y c : ℤ)) : ℝ)
            / (q : ℝ) ^ (s * k)) ^ 2) := by
  sorry

/-- **Theorem HL** (the explicit design `H_s`, Lemma 2). For every `s ≥ 2`, every prime
`q ≥ max(2s, 2 B_s + 2)` and every `k ≥ 1`, the net of `H_s` is a digital `(0,sk,s)`-net over
`𝔽_q`, and any two distinct points satisfy
`q^(2(s-1)k-2) · min(s (q - 2B_s - 2)², 8 (q - B_s - 1)²) ≤ 4 D²`. -/
theorem HL_main (s q k : ℕ) (hs : 2 ≤ s) (hq : q.Prime) (hqs : 2 * s ≤ q) (hqB : 2 * BH s + 2 ≤ q)
    (hk : 1 ≤ k) :
    IsNet0 s q (s * k) (HLpoint s q k uH vH (lamH s) gcoH (dgH s)) ∧
      ∀ x y : Fin (s * k) → ZMod q, x ≠ y →
        (q : ℤ) ^ (2 * (s * k - k - 1)) *
            min ((s : ℤ) * ((q : ℤ) - 2 * BH s - 2) ^ 2) (8 * ((q : ℤ) - BH s - 1) ^ 2) ≤
          4 * (torusDist2 (q ^ (s * k)) (HLpoint s q k uH vH (lamH s) gcoH (dgH s) x)
            (HLpoint s q k uH vH (lamH s) gcoH (dgH s) y) : ℤ) := by
  sorry

/-- **Theorem HL, real form**: `δ N^(1/s) ≥ min(√s (1/2 - η), √2 (1 - η))`, `η = (B_s + 1)/q`,
uniformly in `k` (which tends to `min(√s/2, √2)` as `q → ∞`). -/
theorem HL_main_real (s q k : ℕ) (hs : 2 ≤ s) (hq : q.Prime) (hqs : 2 * s ≤ q)
    (hqB : 2 * BH s + 2 ≤ q) (hk : 1 ≤ k) (x y : Fin (s * k) → ZMod q) (hxy : x ≠ y) :
    min (Real.sqrt s * (1 / 2 - ((BH s : ℝ) + 1) / q)) (Real.sqrt 2 * (1 - ((BH s : ℝ) + 1) / q)) *
        ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (s * k))
          ((HLpoint s q k uH vH (lamH s) gcoH (dgH s) x c : ℤ) -
            (HLpoint s q k uH vH (lamH s) gcoH (dgH s) y c : ℤ)) : ℝ) / (q : ℝ) ^ (s * k)) ^ 2) := by
  sorry

/-- **Theorem HL, upper bound** (`thm:HL`). For the design `H_s`, every `s ≥ 3`, every prime
`q ≥ 2s` with `q > 4 s C_s + 2` (`2C_s = CH2 s = max_c 2a_c`) and every `k ≥ 1` there are two
distinct points at Euclidean (hence toroidal) distance at most
`(min(√s/2, √2) + √s (2C_s + 1)/q) N^(-1/s)`. -/
theorem HL_upper (s q k : ℕ) (hs : 3 ≤ s) (hq : q.Prime) (hqs : 2 * s ≤ q)
    (hqC : 2 * s * CH2 s + 2 < q) (hk : 1 ≤ k) :
    ∃ x y : Fin (s * k) → ZMod q, x ≠ y ∧
      Real.sqrt (∑ c, (((HLpoint s q k uH vH (lamH s) gcoH (dgH s) x c : ℝ) -
          (HLpoint s q k uH vH (lamH s) gcoH (dgH s) y c : ℝ)) / (q : ℝ) ^ (s * k)) ^ 2)
        ≤ (min (Real.sqrt s / 2) (Real.sqrt 2) + Real.sqrt s * ((CH2 s : ℝ) + 1) / q) *
          ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ))) := by
  sorry

/-- **Theorem HL, the limit** (`thm:HL`, last sentence): `δ N^(1/s) → min(√s/2, √2)` as the
prime `q → ∞`, uniformly in `k`: for every `ε > 0` there is `P` such that for every prime
`q ≥ P` and every `k ≥ 1` all distinct points have toroidal distance `≥ (min - ε) N^(-1/s)`, and
some two distinct points have Euclidean distance `≤ (min + ε) N^(-1/s)`. -/
theorem HL_limit (s : ℕ) (hs : 3 ≤ s) (ε : ℝ) (hε : 0 < ε) :
    ∃ P : ℕ, ∀ q k : ℕ, q.Prime → P ≤ q → 1 ≤ k →
      (∀ x y : Fin (s * k) → ZMod q, x ≠ y →
        (min (Real.sqrt s / 2) (Real.sqrt 2) - ε) * ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ)))
          ≤ Real.sqrt (∑ c, ((cres (q ^ (s * k))
              ((HLpoint s q k uH vH (lamH s) gcoH (dgH s) x c : ℤ) -
                (HLpoint s q k uH vH (lamH s) gcoH (dgH s) y c : ℤ)) : ℝ) / (q : ℝ) ^ (s * k)) ^ 2)) ∧
      ∃ x y : Fin (s * k) → ZMod q, x ≠ y ∧
        Real.sqrt (∑ c, (((HLpoint s q k uH vH (lamH s) gcoH (dgH s) x c : ℝ) -
            (HLpoint s q k uH vH (lamH s) gcoH (dgH s) y c : ℝ)) / (q : ℝ) ^ (s * k)) ^ 2)
          ≤ (min (Real.sqrt s / 2) (Real.sqrt 2) + ε) * ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ))) := by
  sorry

/-- **Growth of `B_s`** (`thm:HL`, `B_s = e^(O(s² log s))`): for every `s ≥ 2`,
`B_s ≤ 6 (s-1) (2s-1)^((s-1)²) + 2` and `B_s ≤ (2s)^(s²) = e^(s² log 2s)`. -/
theorem HL_Bbound (s : ℕ) (hs : 2 ≤ s) :
    BH s ≤ 6 * (s - 1) * (2 * s - 1) ^ ((s - 1) ^ 2) + 2 ∧ BH s ≤ (2 * s) ^ (s ^ 2) := by
  sorry

/-- **`lem:R2`** (the two-digit relaxation): let `q` be odd (the paper: an odd prime), `s ≥ 3`, and let a graph form
over `ℤ/qℤ` with depths `(1, …, 1)` have first offset rows `F₀ = F2/2 ∈ (½ + ℤ)^{s×s}` (`F2` odd, `½ ≡ (q+1)/2`)
and second offset rows `D₁ ∈ ℤ^{s×s}` (deeper rows arbitrary; a digital net or not). If `q > |2β_c|` and
`q > |v_c|` (`β = F₀E`, `v = D₁E`) for all `E ∈ {-2, …, 2}^s` and all `c`, then `δ N^(1/s) ≥ LB₂(q)` for the
toroidal distance (`N = q^s`; `LB₂` with the options of `prop:Hk` for the first digit and `{v_c, v_c − q sgn v_c}`
for the second). -/
theorem R2_sep (s q : ℕ) (Φ : Fin s → Fin s → Matrix (Fin (s * 1 - 1)) (Fin 1) (ZMod q))
    (F2 D1 : Fin s → Fin s → ℤ) (hs : 3 ≤ s) (hqodd : Odd q)
    (hrow : RowDesign s q 1 Φ (fun _ => F2)) (hrow1 : Row1Design s q Φ D1) (hodd : ∀ c d, Odd (F2 c d))
    (hβ : ∀ (E : Fin s → ℤ) (c : Fin s), (∀ d, |E d| ≤ 2) → |dotR F2 E c| < q)
    (hv : ∀ (E : Fin s → ℤ) (c : Fin s), (∀ d, |E d| ≤ 2) → |dotR D1 E c| < q)
    (x y : Fin (s * 1) → ZMod q) (hxy : x ≠ y) :
    LB2R q F2 D1 * ((q : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (s * 1))
          ((GFpoint s q 1 Φ x c : ℤ) - (GFpoint s q 1 Φ y c : ℤ)) : ℝ) / (q : ℝ) ^ (s * 1)) ^ 2) := by
  sorry

/-- **The graph forms of `prop:half`.** For odd `p`, `halfPhi s p M2 D` has row `0` equal to the
layer `M = M2/2` (`½ ≡ (p+1)/2`), i.e. it satisfies `RowDesign s p 1 · (fun _ => M2)`. -/
theorem halfPhi_row (s p : ℕ) (hs : 2 ≤ s) (hp : Odd p) (M2 : Fin s → Fin s → ℤ)
    (D : Fin s → ℕ → Fin s → ℤ) :
    RowDesign s p 1 (halfPhi s p M2 D) (fun _ => M2) := by
  sorry

/-- **`prop:half`(1), separation.** For every half-integer layer, every odd prime
`p > 2(2A+1)` and every graph form with depths `(1, …, 1)` whose row `0` is the layer (deeper rows
arbitrary): `δ N^(1/s) ≥ LB₂(p)` (toroidal distance, `N = p^s`). -/
theorem half_sep (s p : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hp2 : p ≠ 2)
    (M2 : Fin s → Fin s → ℤ) (hodd : ∀ c d, Odd (M2 c d)) (hpA : 2 * halfA2 M2 + 2 < p)
    (Φ : Fin s → Fin s → Matrix (Fin (s * 1 - 1)) (Fin 1) (ZMod p))
    (hrow : RowDesign s p 1 Φ (fun _ => M2)) (x y : Fin (s * 1) → ZMod p) (hxy : x ≠ y) :
    halfLB2 p M2 * ((p : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (s * 1))
          ((GFpoint s p 1 Φ x c : ℤ) - (GFpoint s p 1 Φ y c : ℤ)) : ℝ) / (p : ℝ) ^ (s * 1)) ^ 2) := by
  sorry

/-- **`prop:half`(1), the second inequality**: `LB₂(p) ≥ λ(M) - √s (2A+1)/p` (every `p ≥ 1`). -/
theorem half_LB2_ge (s p : ℕ) (hs : 2 ≤ s) (hp : 1 ≤ p) (M2 : Fin s → Fin s → ℤ) :
    halfLam M2 - Real.sqrt s * ((halfA2 M2 : ℝ) + 1) / p ≤ halfLB2 p M2 := by
  sorry

/-- **`prop:half`(1)**: `λ(M) ≤ min(√s/2, √2)` for every `M`. -/
theorem half_lam_le (s : ℕ) (hs : 2 ≤ s) (M2 : Fin s → Fin s → ℤ) :
    halfLam M2 ≤ min (Real.sqrt s / 2) (Real.sqrt 2) := by
  sorry

/-- **`prop:half`(1)**: equality `λ(M) = min(√s/2, √2)` if `M` is weakly diagonally dominant,
`M_cc ≤ -∑_{d ≠ c} |M_cd|` for every `c`. -/
theorem half_lam_dom (s : ℕ) (hs : 2 ≤ s) (M2 : Fin s → Fin s → ℤ)
    (hdom : ∀ c, M2 c c ≤ -∑ d ∈ univ.erase c, |M2 c d|) :
    halfLam M2 = min (Real.sqrt s / 2) (Real.sqrt 2) := by
  sorry

/-- **The matching upper bound** (after `prop:half`; `prop:Hk`(3) at `k = 1`): with
`C = max |M_cd|` and a prime `p > 4sC + 2`, every graph form whose row `0` is a half-integer
layer has two distinct points at Euclidean (hence toroidal) distance at most
`(min(√s/2, √2) + √s (2C+1)/p) N^(-1/s)`. -/
theorem half_upper (s p : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (M2 : Fin s → Fin s → ℤ)
    (hodd : ∀ c d, Odd (M2 c d)) (hpC : 2 * s * C2max s (fun _ => M2) + 2 < p)
    (Φ : Fin s → Fin s → Matrix (Fin (s * 1 - 1)) (Fin 1) (ZMod p))
    (hrow : RowDesign s p 1 Φ (fun _ => M2)) :
    ∃ x y : Fin (s * 1) → ZMod p, x ≠ y ∧
      Real.sqrt (∑ c, (((GFpoint s p 1 Φ x c : ℝ) - (GFpoint s p 1 Φ y c : ℝ)) / (p : ℝ) ^ (s * 1)) ^ 2)
        ≤ (min (Real.sqrt s / 2) (Real.sqrt 2) + Real.sqrt s * ((C2max s (fun _ => M2) : ℝ) + 1) / p) *
          ((p : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ))) := by
  sorry

/-- **The limit** ("The packing", after `prop:half`): for a half-integer layer with
`λ(M) = min(√s/2, √2)` (in particular a dominant one), `δ N^(1/s) → min(√s/2, √2)` as the prime
`p → ∞`, for every choice of the deeper rows. -/
theorem half_limit (s : ℕ) (hs : 3 ≤ s) (M2 : Fin s → Fin s → ℤ) (hodd : ∀ c d, Odd (M2 c d))
    (hlam : halfLam M2 = min (Real.sqrt s / 2) (Real.sqrt 2)) (ε : ℝ) (hε : 0 < ε) :
    ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
      ∀ Φ : Fin s → Fin s → Matrix (Fin (s * 1 - 1)) (Fin 1) (ZMod p),
        RowDesign s p 1 Φ (fun _ => M2) →
        (∀ x y : Fin (s * 1) → ZMod p, x ≠ y →
          (min (Real.sqrt s / 2) (Real.sqrt 2) - ε) * ((p : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ)))
            ≤ Real.sqrt (∑ c, ((cres (p ^ (s * 1))
                ((GFpoint s p 1 Φ x c : ℤ) - (GFpoint s p 1 Φ y c : ℤ)) : ℝ) / (p : ℝ) ^ (s * 1)) ^ 2)) ∧
        ∃ x y : Fin (s * 1) → ZMod p, x ≠ y ∧
          Real.sqrt (∑ c, (((GFpoint s p 1 Φ x c : ℝ) - (GFpoint s p 1 Φ y c : ℝ)) / (p : ℝ) ^ (s * 1)) ^ 2)
            ≤ (min (Real.sqrt s / 2) (Real.sqrt 2) + ε) * ((p : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ))) := by
  sorry

/-- **`prop:half`(2)**: if every square submatrix of `M` with disjoint row and column index sets
has nonzero determinant, there are integer deeper rows such that the graph form is a digital
`(0,s,s)`-net over `𝔽_p` for all but finitely many primes `p`. -/
theorem half_net_generic (s : ℕ) (M2 : Fin s → Fin s → ℤ) (hM : DisjMinors M2) :
    ∃ D : Fin s → ℕ → Fin s → ℤ, ∃ S : Finset ℕ, ∀ p : ℕ, p.Prime → p ∉ S →
      IsNet0 s p (s * 1) (GFpoint s p 1 (halfPhi s p M2 D)) := by
  sorry

/-- **`prop:half`(2)**, existence: there are off-diagonal entries in `½ + ℤ` such that, with any
diagonal, every disjoint square minor is nonzero; in particular a weakly dominant half-integer
`M` with this property exists (for every `s`; the paper states `s ≥ 4`). -/
theorem half_M_exists (s : ℕ) :
    (∃ O : Fin s → Fin s → ℤ, (∀ c d, c ≠ d → Odd (O c d)) ∧
      ∀ M2 : Fin s → Fin s → ℤ, (∀ c d, c ≠ d → M2 c d = O c d) → DisjMinors M2) ∧
    ∃ M2 : Fin s → Fin s → ℤ, (∀ c d, Odd (M2 c d)) ∧
      (∀ c, M2 c c ≤ -∑ d ∈ univ.erase c, |M2 c d|) ∧ DisjMinors M2 := by
  sorry

/-- **`prop:half5`(1)**: `𝒬*_p` is a digital `(0,5,5)`-net over `𝔽_p` for every prime `p ≥ 7`. -/
theorem qstar_net (p : ℕ) (hp : p.Prime) (h7 : 7 ≤ p) : IsNet0 5 p (5 * 1) (Qstar p) := by
  sorry

/-- **`prop:half5`(2)**: for every prime `p ≥ 37`, `δ N^(1/5) > 1` for `𝒬*_p` (toroidal distance, `N = p⁵`). -/
theorem qstar_sep (p : ℕ) (hp : p.Prime) (h37 : 37 ≤ p) (x y : Fin (5 * 1) → ZMod p) (hxy : x ≠ y) :
    ((p : ℝ) ^ (5 * 1)) ^ (-(1 / (5 : ℝ)))
      < Real.sqrt (∑ c, ((cres (p ^ (5 * 1)) ((Qstar p x c : ℤ) - (Qstar p y c : ℤ)) : ℝ) /
          (p : ℝ) ^ (5 * 1)) ^ 2) := by
  sorry

/-- **`prop:half5`(2), the bounds of the proof of the limit**: for every prime `p > 32`, any two distinct points of
`𝒬*_p` have toroidal distance `≥ (√5/2 − 12√5/p) N^(-1/5)` (`λ − √5(2A+1)/p` with `λ = √5/2`, `A = 11/2`), and some
two distinct points have Euclidean distance `≤ (√5/2 + 4√5/p) N^(-1/5)` (`prop:Hk`(3) with `C = 3/2`). -/
theorem qstar_bounds (p : ℕ) (hp : p.Prime) (h32 : 32 < p) :
    (∀ x y : Fin (5 * 1) → ZMod p, x ≠ y →
      (Real.sqrt 5 / 2 - 12 * Real.sqrt 5 / p) * ((p : ℝ) ^ (5 * 1)) ^ (-(1 / (5 : ℝ)))
        ≤ Real.sqrt (∑ c, ((cres (p ^ (5 * 1)) ((Qstar p x c : ℤ) - (Qstar p y c : ℤ)) : ℝ) /
            (p : ℝ) ^ (5 * 1)) ^ 2)) ∧
    ∃ x y : Fin (5 * 1) → ZMod p, x ≠ y ∧
      Real.sqrt (∑ c, (((Qstar p x c : ℝ) - (Qstar p y c : ℝ)) / (p : ℝ) ^ (5 * 1)) ^ 2)
        ≤ (Real.sqrt 5 / 2 + 4 * Real.sqrt 5 / p) * ((p : ℝ) ^ (5 * 1)) ^ (-(1 / (5 : ℝ))) := by
  sorry

/-- **`prop:half5`(2), the limit**: `δ N^(1/5) → √5/2` as the prime `p → ∞`: for every `ε > 0` there is `P` such that
for every prime `p ≥ P` all distinct points of `𝒬*_p` have toroidal distance `≥ (√5/2 − ε) N^(-1/5)` and some two
distinct points have Euclidean distance `≤ (√5/2 + ε) N^(-1/5)`. -/
theorem qstar_limit (ε : ℝ) (hε : 0 < ε) :
    ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
      (∀ x y : Fin (5 * 1) → ZMod p, x ≠ y →
        (Real.sqrt 5 / 2 - ε) * ((p : ℝ) ^ (5 * 1)) ^ (-(1 / (5 : ℝ)))
          ≤ Real.sqrt (∑ c, ((cres (p ^ (5 * 1)) ((Qstar p x c : ℤ) - (Qstar p y c : ℤ)) : ℝ) /
              (p : ℝ) ^ (5 * 1)) ^ 2)) ∧
      ∃ x y : Fin (5 * 1) → ZMod p, x ≠ y ∧
        Real.sqrt (∑ c, (((Qstar p x c : ℝ) - (Qstar p y c : ℝ)) / (p : ℝ) ^ (5 * 1)) ^ 2)
          ≤ (Real.sqrt 5 / 2 + ε) * ((p : ℝ) ^ (5 * 1)) ^ (-(1 / (5 : ℝ))) := by
  sorry

/-- **`prop:half5`(3)**: for every prime `p ≥ 53`, every graph form over `𝔽_p` with depths `(1, …, 1)` and first
offset rows `F₀*` (row `0` of every block is `F₀*`, `½ ≡ (p+1)/2`; deeper rows arbitrary) has `δ N^(1/5) > 1`
(toroidal). -/
theorem qstar_hk (p : ℕ) (hp : p.Prime) (h53 : 53 ≤ p)
    (Φ : Fin 5 → Fin 5 → Matrix (Fin (5 * 1 - 1)) (Fin 1) (ZMod p))
    (hrow : RowDesign 5 p 1 Φ (fun _ => F2star)) (x y : Fin (5 * 1) → ZMod p) (hxy : x ≠ y) :
    ((p : ℝ) ^ (5 * 1)) ^ (-(1 / (5 : ℝ)))
      < Real.sqrt (∑ c, ((cres (p ^ (5 * 1)) ((GFpoint 5 p 1 Φ x c : ℤ) - (GFpoint 5 p 1 Φ y c : ℤ)) : ℝ) /
          (p : ℝ) ^ (5 * 1)) ^ 2) := by
  sorry

/-- **`δN^{1/5}` as used in `rem:accounting`** (`sepN`, definition in `Z3Net/AcctDefs.lean`): for every `p ≥ 2` and
every point set `X` indexed by `(ℤ/pℤ)⁵` (integer points in `[0, p⁵)⁵`), `sepN p X` is `p` (`= N^{1/5}`) times the
least toroidal distance of two points with distinct indices: it is at most the value of every pair and equal to the
value of some pair. -/
theorem sepN_spec (p : ℕ) (hp : 2 ≤ p) (X : (Fin (5 * 1) → ZMod p) → Fin 5 → ℕ) :
    (∀ x y : Fin (5 * 1) → ZMod p, x ≠ y → sepN p X ≤ (p : ℝ) * Real.sqrt (∑ c,
      ((cres (p ^ (5 * 1)) ((X x c : ℤ) - (X y c : ℤ)) : ℝ) / (p : ℝ) ^ (5 * 1)) ^ 2)) ∧
    ∃ x y : Fin (5 * 1) → ZMod p, x ≠ y ∧ sepN p X = (p : ℝ) * Real.sqrt (∑ c,
      ((cres (p ^ (5 * 1)) ((X x c : ℤ) - (X y c : ℤ)) : ℝ) / (p : ℝ) ^ (5 * 1)) ^ 2) := by
  sorry

/-- **`ℓ` of `rem:accounting`** is the `ℓ` of the proof of `prop:half5` as formalized in S11′: `2ℓ_c(E)` (`ell2`, an
integer) is twice `halfEllInf` (`min(|E_c ± ½|)` for `σ_E` odd, `min_κ |E_c − κ|`, `κ ∈ {0, sgn β_c}`, for `σ_E`
even). -/
theorem ell2_eq_halfEllInf (F2 : Fin 5 → Fin 5 → ℤ) (E : Fin 5 → ℤ) (c : Fin 5) :
    (ell2 F2 E c : ℝ) = 2 * halfEllInf F2 E c := by
  sorry

/-- **`rem:accounting`, `limsup K_eff ≤ dj`** (the upper bound for `K_eff` of the printed proof, via `lem:R2`): let
`F₀ = F2/2 ∈ (½ + ℤ)^{5×5}` (`F2` odd) satisfy (Λ) (`LamHyp`), and let the deeper rows `D` be arbitrary integer
matrices (`D₁ = D c 1`). Then there are `C` and `P` such that for every prime `p ≥ P` the digital point set over
`𝔽_p` with these rows has `δN^{1/5} ≥ (√5/2)(1 − 2dj(F₀,D₁)/(5p)) − C/p²` (toroidal; `dj2 = 2dj`). (`det F₀ ≠ 0`
is not needed here; `C`, `P` are not explicit, as the paper's `O(p⁻²)`.) -/
theorem acct_upper (F2 : Fin 5 → Fin 5 → ℤ) (D : Fin 5 → ℕ → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d))
    (hΛ : LamHyp F2) :
    ∃ C : ℝ, ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
      Real.sqrt 5 / 2 * (1 - (dj2 F2 (fun c d => D c 1 d) : ℝ) / (5 * p)) - C / (p : ℝ) ^ 2
        ≤ sepN p (halfNet p F2 D) := by
  sorry

/-- **`rem:accounting`, `liminf K_eff ≥ dr`** (the lower bound of the printed proof, by an explicit pair): let
`F₀ = F2/2 ∈ (½ + ℤ)^{5×5}` with `det F₀ ≠ 0`, deeper rows `D` arbitrary. Then there are `C` and `P` such that for
every prime `p ≥ P`, `δN^{1/5} ≤ (√5/2)(1 − 2dr(F₀)/(5p)) + C/p²` (toroidal; `drift2 = 2dr`). ((Λ) is not needed
here.) -/
theorem acct_lower (F2 : Fin 5 → Fin 5 → ℤ) (D : Fin 5 → ℕ → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d))
    (hdet : (Matrix.of F2).det ≠ 0) :
    ∃ C : ℝ, ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
      sepN p (halfNet p F2 D) ≤ Real.sqrt 5 / 2 * (1 - (drift2 F2 : ℝ) / (5 * p)) + C / (p : ℝ) ^ 2 := by
  sorry

/-- **`rem:accounting`** (`dr(F₀) ≤ liminf K_eff ≤ limsup K_eff ≤ dj(F₀, D₁)`, in `ε` form): let
`F₀ = F2/2 ∈ (½ + ℤ)^{5×5}` with `det F₀ ≠ 0` satisfy (Λ), and let `D` be arbitrary integer deeper rows. For every
`ε > 0` there is `P` such that for every prime `p ≥ P`, `K_eff(p) = (5p/2)(1 − δN^{1/5}/(√5/2))` of the digital point
set with these rows lies in `[dr(F₀) − ε, dj(F₀, D₁) + ε]` (`drift2 = 2dr`, `dj2 = 2dj`). The `liminf`/`limsup` form
is `acct_liminf`. -/
theorem acct_main (F2 : Fin 5 → Fin 5 → ℤ) (D : Fin 5 → ℕ → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d))
    (hdet : (Matrix.of F2).det ≠ 0) (hΛ : LamHyp F2) (ε : ℝ) (hε : 0 < ε) :
    ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
      (drift2 F2 : ℝ) / 2 - ε ≤ Keff p (halfNet p F2 D) ∧
        Keff p (halfNet p F2 D) ≤ (dj2 F2 (fun c d => D c 1 d) : ℝ) / 2 + ε := by
  sorry

/-- **`rem:accounting`, as printed**: under the hypotheses of `acct_main`,
`dr(F₀) ≤ liminf_{p→∞} K_eff(p) ≤ limsup_{p→∞} K_eff(p) ≤ dj(F₀, D₁)`, the limits taken along the primes (the
filter `atTop ⊓ 𝓟 {p | p prime}`; `K_eff` is bounded along it, so these are genuine `liminf`/`limsup` in `ℝ`). -/
theorem acct_liminf (F2 : Fin 5 → Fin 5 → ℤ) (D : Fin 5 → ℕ → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d))
    (hdet : (Matrix.of F2).det ≠ 0) (hΛ : LamHyp F2) :
    (drift2 F2 : ℝ) / 2 ≤
        Filter.liminf (fun p => Keff p (halfNet p F2 D)) (Filter.atTop ⊓ Filter.principal {p : ℕ | p.Prime}) ∧
      Filter.liminf (fun p => Keff p (halfNet p F2 D)) (Filter.atTop ⊓ Filter.principal {p : ℕ | p.Prime}) ≤
        Filter.limsup (fun p => Keff p (halfNet p F2 D)) (Filter.atTop ⊓ Filter.principal {p : ℕ | p.Prime}) ∧
      Filter.limsup (fun p => Keff p (halfNet p F2 D)) (Filter.atTop ⊓ Filter.principal {p : ℕ | p.Prime}) ≤
        (dj2 F2 (fun c d => D c 1 d) : ℝ) / 2 := by
  sorry

/-- **`rem:accounting`, "in particular"**: under the hypotheses of `acct_main`, if moreover `dj(F₀, D₁) = dr(F₀)`, then
`δN^{1/5} = (√5/2)(1 − 2dr(F₀)/(5p)) + O(p⁻²)` along the primes: `|δN^{1/5} − (√5/2)(1 − 2dr/(5p))| ≤ C/p²` for
every prime `p ≥ P`. -/
theorem acct_exact (F2 : Fin 5 → Fin 5 → ℤ) (D : Fin 5 → ℕ → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d))
    (hdet : (Matrix.of F2).det ≠ 0) (hΛ : LamHyp F2) (heq : dj2 F2 (fun c d => D c 1 d) = drift2 F2) :
    ∃ C : ℝ, ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
      |sepN p (halfNet p F2 D) - Real.sqrt 5 / 2 * (1 - (drift2 F2 : ℝ) / (5 * p))| ≤ C / (p : ℝ) ^ 2 := by
  sorry

/-- **`rem:accounting` for `𝒬*_p`**: `dr(F₀*) = dj(F₀*, D₁) = 17/2`, `det 2F₀* = −880`, `|ℓ(E)|² ≥ 2` (i.e.
`∑_c (2ℓ_c(E))² ≥ 8`) on every non-binding step, hence (Λ), and `δN^{1/5} = (√5/2)(1 − 17/(5p)) + O(p⁻²)` (toroidal)
along the primes (`Qstar p = halfNet p F2star Dstar` by definition). -/
theorem acct_qstar : drift2 F2star = 17 ∧ dj2 F2star D1star = 17 ∧ (Matrix.of F2star).det = -880 ∧
    (∀ E ∈ halfSteps 5, E ∉ bind5 → 8 ≤ ∑ c, ell2 F2star E c ^ 2) ∧ LamHyp F2star ∧
    ∃ C : ℝ, ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
      |sepN p (Qstar p) - Real.sqrt 5 / 2 * (1 - 17 / (5 * p))| ≤ C / (p : ℝ) ^ 2 := by
  sorry

/-- **"(Λ) is a genuine hypothesis"** (`rem:accounting`): the printed layer `2F₀ = F2cex` has odd entries, satisfies
(B2) and (MIN) (`DisjMinors`) and has `det 2F₀ = 560`, but the even step `E = (1, −1, −2, −1, −1)` (in
`{-2, …, 2}⁵ \ {0}`, not binding) has `2β = (4, −6, −2, −2, −2)` and `∑_c (2ℓ_c(E))² = 4`, i.e. `|ℓ(E)| = 1`; so (Λ)
fails. -/
theorem acct_counterexample : (∀ c d, Odd (F2cex c d)) ∧ B2D F2cex ∧ DisjMinors F2cex ∧
    (Matrix.of F2cex).det = 560 ∧ ![1, -1, -2, -1, -1] ∈ halfSteps 5 ∧ ![1, -1, -2, -1, -1] ∉ bind5 ∧
    (fun c => dotR F2cex ![1, -1, -2, -1, -1] c) = ![4, -6, -2, -2, -2] ∧
    ∑ c, ell2 F2cex ![1, -1, -2, -1, -1] c ^ 2 = 4 ∧ ¬ LamHyp F2cex := by
  sorry

/-- **`rem:accounting`, the two-sided expansion of the printed proof**: let `F₀ = F2/2 ∈ (½ + ℤ)^{5×5}` (`F2` odd)
satisfy (Gap) (`LamHyp`), and let `D₁` be any integer matrix. Then `LB₂(p)` of `lem:R2` (`LB2R`) satisfies
`LB₂(p) = (√5/2)(1 − 2dj(F₀, D₁)/(5p)) + O(p⁻²)`: there are `C` and `P` with
`|LB₂(p) − (√5/2)(1 − 2dj/(5p))| ≤ C/p²` for every `p ≥ P` (`dj2 = 2dj`; `det F₀ ≠ 0` is not needed). -/
theorem acct_LB2 (F2 D1 : Fin 5 → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d)) (hΛ : LamHyp F2) :
    ∃ C : ℝ, ∃ P : ℕ, ∀ p : ℕ, P ≤ p →
      |LB2R p F2 D1 - Real.sqrt 5 / 2 * (1 - (dj2 F2 D1 : ℝ) / (5 * p))| ≤ C / (p : ℝ) ^ 2 := by
  sorry

/-- **`rem:accounting`, the expansion of `LB` of `prop:Hk`(1)** ("in the same way `prop:Hk`(1) has
`LB = (√5/2)(1 − 2(dr + 5)/(5p)) + O(p⁻²)`"): let `F₀ = F2/2 ∈ (½ + ℤ)^{5×5}` (`F2` odd) satisfy (Gap) (`LamHyp`).
Then `LB(p)` of `prop:Hk`(1) at `s = 5`, `k = 1` (`L = 1`, no carries: `min(2, min_{0 ≠ E ∈ {-2,…,2}⁵} |b|/p)` with
`2b_c = bOpt2 p F₀ E 0 c`) satisfies `|LB(p) − (√5/2)(1 − 2(dr(F₀) + 5)/(5p))| ≤ C/p²` for every `p ≥ P`, for some
`C`, `P` (`drift2 = 2dr`, so `2(dr + 5) = drift2 + 10`; `p` any integer `≥ P`; `det F₀ ≠ 0` is not needed). -/
theorem acct_LBHk (F2 : Fin 5 → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d)) (hΛ : LamHyp F2) :
    ∃ C : ℝ, ∃ P : ℕ, ∀ p : ℕ, P ≤ p →
      |min 2 (⨅ E : halfSteps 5,
          Real.sqrt (∑ c, ((bOpt2 p (fun _ => F2) (E : Fin 5 → ℤ) (fun _ => 0) c : ℤ) : ℝ) ^ 2) / (2 * p)) -
        Real.sqrt 5 / 2 * (1 - ((drift2 F2 + 10 : ℤ) : ℝ) / (5 * p))| ≤ C / (p : ℝ) ^ 2 := by
  sorry

/-- **`thm:D`** (the least drift), doubled (`F2 = 2F₀`): every `F₀ ∈ (½ + ℤ)^{5×5}` (`F2` odd) with (B2) and (MIN)
(`DisjMinors`: every minor of `F₀` with disjoint row and column sets is nonzero), with entries of any size, has
`dr(F₀) ≥ 17/2`: some binding step `E` (`E ∈ {-1, 0, 1}⁵`, `∑ E` odd) has `2 dr(E) ≥ 17`. -/
theorem thmD (F2 : Fin 5 → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d)) (hB2 : B2D F2)
    (hmin : DisjMinors F2) : 17 ≤ drift2 F2 := by
  sorry

/-- **`thm:D`, attained**: the layer `F₀*` of `prop:half5` satisfies (Half), (B2) and (MIN), and
`dr(F₀*) = 17/2`. -/
theorem thmD_star : (∀ c d, Odd (F2star c d)) ∧ B2D F2star ∧ DisjMinors F2star ∧ drift2 F2star = 17 := by
  sorry

/-- **`thm:D`, the skew layers** (the part of the printed proof by hand): if moreover the off-diagonal part of
`F₀` is skew-symmetric, `dr(F₀) ≥ 17/2`. -/
theorem thmD_skew (F2 : Fin 5 → Fin 5 → ℤ) (hodd : ∀ c d, Odd (F2 c d)) (hB2 : B2D F2)
    (hmin : DisjMinors F2) (hskew : ∀ c d, c ≠ d → F2 c d + F2 d c = 0) : 17 ≤ drift2 F2 := by
  sorry

/-- **The symmetry of `thm:D`** (the normalization in its proof): conjugation by a permutation matrix and a diagonal
sign matrix, `F₀ ↦ (ε_c ε_d F₀[σc][σd])`, keeps `dr`. -/
theorem thmD_conj (F2 : Fin 5 → Fin 5 → ℤ) (σ : Equiv.Perm (Fin 5)) (ε : Fin 5 → ℤ)
    (hε : ∀ c, ε c = 1 ∨ ε c = -1) : drift2 (fun c d => ε c * ε d * F2 (σ c) (σ d)) = drift2 F2 := by
  sorry

/-- **The `s = 5` design is the witness.** `2 F_x[c][d]` of `B₅` (`HLdes` from the points,
`λ'`, the interpolated `f_{d,n}` and the diagonal) is the witness matrix `F2`, for every `x`. -/
theorem B5_design (x : ℕ) (c d : Fin 5) :
    2 * HLdes uB5 vB5 lamB5 gcoB5 dgB5 x c d = F2B5 x c d := by
  sorry

/-- **`B₅` is a net** for every prime `q ∉ {2, 3, 5, 7, 97, 101}` and every `k ≥ 1`. -/
theorem B5_net (q k : ℕ) (hq : q.Prime) (hbad : q ∉ ({2, 3, 5, 7, 97, 101} : Finset ℕ))
    (hk : 1 ≤ k) : IsNet0 5 q (5 * k) (HLpoint 5 q k uB5 vB5 lamB5 gcoB5 dgB5) := by
  sorry

/-- **The `s = 5` headline, integer form.** For every prime `q ≥ 1511`, every `k ≥ 1` and
distinct indices: `1.02652² · q^(8k) ≤ D²` (`D² = torusDist2` at scale `N = q^(5k)`), i.e.
`δ N^(1/5) ≥ 1.02652`. -/
theorem B5_sep (q k : ℕ) (hq : q.Prime) (hq1511 : 1511 ≤ q) (hk : 1 ≤ k)
    (x y : Fin (5 * k) → ZMod q) (hxy : x ≠ y) :
    (102652 : ℤ) ^ 2 * (q : ℤ) ^ (2 * (5 * k - k)) ≤
      100000 ^ 2 * (torusDist2 (q ^ (5 * k)) (HLpoint 5 q k uB5 vB5 lamB5 gcoB5 dgB5 x)
        (HLpoint 5 q k uB5 vB5 lamB5 gcoB5 dgB5 y) : ℤ) := by
  sorry

/-- **The `s = 5` headline, real form**: `δ N^(1/5) > 1.0265` for every prime `q ≥ 1511` and
every `k ≥ 1`. -/
theorem B5_sep_real (q k : ℕ) (hq : q.Prime) (hq1511 : 1511 ≤ q) (hk : 1 ≤ k)
    (x y : Fin (5 * k) → ZMod q) (hxy : x ≠ y) :
    1.0265 * ((q : ℝ) ^ (5 * k)) ^ (-(1 / (5 : ℝ)))
      < Real.sqrt (∑ c, ((cres (q ^ (5 * k))
          ((HLpoint 5 q k uB5 vB5 lamB5 gcoB5 dgB5 x c : ℤ) -
            (HLpoint 5 q k uB5 vB5 lamB5 gcoB5 dgB5 y c : ℤ)) : ℝ) / (q : ℝ) ^ (5 * k)) ^ 2) := by
  sorry

/-- **`prop:HL5`, net clause per level.** For every prime `q ∉ {2, 3, 5, 7}` and every `k ≥ 1`,
with `q ∉ {97, 101}` required only when `k ≥ 4`, the `B₅` net is a digital `(0,5k,5)`-net over
`𝔽_q`. -/
theorem B5_net_lev (q k : ℕ) (hq : q.Prime) (hbad : q ∉ ({2, 3, 5, 7} : Finset ℕ))
    (h4 : 4 ≤ k → q ∉ ({97, 101} : Finset ℕ)) (hk : 1 ≤ k) :
    IsNet0 5 q (5 * k) (HLpoint 5 q k uB5 vB5 lamB5 gcoB5 dgB5) := by
  sorry

end Z3NetHL
