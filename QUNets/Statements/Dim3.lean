namespace Z3Net

open Matrix

/-- **Theorem `thm:t0`, first sentence.** Every box minor of `(L T², L, L T)` is `±1`
(over `ℤ`), for every `k ≥ 1`. -/
theorem P_boxMinor (k : ℕ) (hk : 1 ≤ k) (d : Fin 3 → ℕ) (hd : d 0 + d 1 + d 2 = 3 * k) :
    (boxMatrix (PGen k) d).det = 1 ∨ (boxMatrix (PGen k) d).det = -1 := by
  sorry

/-- **Theorem `thm:t0` / `thm:main`(1).** `𝒫_{k,q}` is a `(0,3k,3)`-net in base `q`, for every
`q ≥ 2` and `k ≥ 1`.  (With `d = (k,k,k)` this is also the cell statement of `thm:main`(2).) -/
theorem P_net (q k : ℕ) (hq : 2 ≤ q) (hk : 1 ≤ k) : IsNet0 q (3 * k) (Ppoint q k) := by
  sorry

/-- **Proposition `prop:cell`** (a), (b), (c) (`k ≥ 2`, every base `q ≥ 2`). Write
`d^c = (PGen k c mod q) *ᵥ v` for the digit vector of coordinate `c` of the point of `𝒫_{k,q}`
with index `v` (digit `0` most significant; the cell `n_c` is given by the digits `0, …, k-1`).
(a) + (c): for every coordinate `c` (indices mod 3, `x → y → z`; `c = x` is (a), `c = y, z` is
the cyclic shift (c)), `d^c_k = -d^c_{k-1} - d^{c+1}_{k-1} + d^{c+2}_{k-1} - d^{c+2}_{k-2}` (the
positions `k, k-1, k-2` are `i0, i1, i2`). (b) + (c): for `j > k`, `d^c_j` is a function of the
cells `(n_{c+1}, n_{c+2})` alone: two indices whose cells of the coordinates `c+1`, `c+2` agree
have the same digits `j > k` in coordinate `c`. -/
theorem cell_digits (q k : ℕ) (hq : 2 ≤ q) (hk : 2 ≤ k) :
    (∀ (v : Fin (3 * k) → ZMod q) (c : Fin 3) (i0 i1 i2 : Fin (3 * k)),
        (i0 : ℕ) = k → (i1 : ℕ) + 1 = k → (i2 : ℕ) + 2 = k →
        ((PGen k c).map (Int.cast : ℤ → ZMod q) *ᵥ v) i0 =
          -((PGen k c).map (Int.cast : ℤ → ZMod q) *ᵥ v) i1
            - ((PGen k (c + 1)).map (Int.cast : ℤ → ZMod q) *ᵥ v) i1
            + ((PGen k (c + 2)).map (Int.cast : ℤ → ZMod q) *ᵥ v) i1
            - ((PGen k (c + 2)).map (Int.cast : ℤ → ZMod q) *ᵥ v) i2) ∧
      (∀ (v w : Fin (3 * k) → ZMod q) (c : Fin 3),
        (∀ j : Fin (3 * k), (j : ℕ) < k →
          ((PGen k (c + 1)).map (Int.cast : ℤ → ZMod q) *ᵥ v) j =
            ((PGen k (c + 1)).map (Int.cast : ℤ → ZMod q) *ᵥ w) j) →
        (∀ j : Fin (3 * k), (j : ℕ) < k →
          ((PGen k (c + 2)).map (Int.cast : ℤ → ZMod q) *ᵥ v) j =
            ((PGen k (c + 2)).map (Int.cast : ℤ → ZMod q) *ᵥ w) j) →
        ∀ j : Fin (3 * k), k < (j : ℕ) →
          ((PGen k c).map (Int.cast : ℤ → ZMod q) *ᵥ v) j =
            ((PGen k c).map (Int.cast : ℤ → ZMod q) *ᵥ w) j) := by
  sorry

/-- **Proposition `prop:cell`, consequence** (`k ≥ 2`, `q ≥ 2`). With the geometric digit
`r_c = d^c_k` and the last two cell digits `ℓ_c = d^c_{k-1}`, `h_c = d^c_{k-2}` (in `ℤ/qℤ`, so
equality is congruence mod `q`): `r = M ℓ + J h` with `M = Mcell` and
`J = !![0,0,-1; -1,0,0; 0,-1,0]`. And the jitter `f_c = ∑_{j>k} (d^c_j mod q) q^(k-j)` does not
depend on `n_c`: `q^(2k-1) f_c` is the integer coordinate `X_c = Ppoint q k v c` modulo
`q^(2k-1)`, and it is the same for two indices whose cells of the coordinates `c+1`, `c+2` agree
(whatever their cells `n_c`). -/
theorem cell_layer (q k : ℕ) (hq : 2 ≤ q) (hk : 2 ≤ k) :
    (∀ (v : Fin (3 * k) → ZMod q) (i0 i1 i2 : Fin (3 * k)),
        (i0 : ℕ) = k → (i1 : ℕ) + 1 = k → (i2 : ℕ) + 2 = k →
        (fun c => ((PGen k c).map (Int.cast : ℤ → ZMod q) *ᵥ v) i0) =
          Mcell.map (Int.cast : ℤ → ZMod q) *ᵥ
              (fun c => ((PGen k c).map (Int.cast : ℤ → ZMod q) *ᵥ v) i1) +
            (!![0, 0, -1; -1, 0, 0; 0, -1, 0] : Matrix (Fin 3) (Fin 3) ℤ).map
                (Int.cast : ℤ → ZMod q) *ᵥ
              (fun c => ((PGen k c).map (Int.cast : ℤ → ZMod q) *ᵥ v) i2)) ∧
      (∀ (v w : Fin (3 * k) → ZMod q) (c : Fin 3),
        (∀ j : Fin (3 * k), (j : ℕ) < k →
          ((PGen k (c + 1)).map (Int.cast : ℤ → ZMod q) *ᵥ v) j =
            ((PGen k (c + 1)).map (Int.cast : ℤ → ZMod q) *ᵥ w) j) →
        (∀ j : Fin (3 * k), (j : ℕ) < k →
          ((PGen k (c + 2)).map (Int.cast : ℤ → ZMod q) *ᵥ v) j =
            ((PGen k (c + 2)).map (Int.cast : ℤ → ZMod q) *ᵥ w) j) →
        Ppoint q k v c % q ^ (2 * k - 1) = Ppoint q k w c % q ^ (2 * k - 1)) := by
  sorry

/-- **`rem:lattice3`**: `M = -I + [u×]` with `u = (1,1,1)`. -/
theorem lat3_cross (v : Fin 3 → ℝ) :
    Mcell.map (Int.cast : ℤ → ℝ) *ᵥ v = -v + crossProduct ![1, 1, 1] v := by
  sorry

/-- **`rem:lattice3`**: `rotU θ` is a rotation (in `SO(3)`) fixing `u` and turning every vector
orthogonal to `u` by the angle `θ`. -/
theorem lat3_rot (θ : ℝ) :
    rotU θ ∈ Matrix.specialOrthogonalGroup (Fin 3) ℝ ∧ rotU θ *ᵥ ![1, 1, 1] = ![1, 1, 1] ∧
      ∀ w : Fin 3 → ℝ, w ⬝ᵥ ![1, 1, 1] = 0 →
        (rotU θ *ᵥ w) ⬝ᵥ w = Real.cos θ * (w ⬝ᵥ w) := by
  sorry

/-- **`rem:lattice3`**: `Λ_q` is `ℤ³` scaled by `1 - 1/q` along `u` and by
`((1-1/q)² + 3/q²)^(1/2)` across it, then rotated by `arctan(√3/(q-1))` about `u`. -/
theorem lat3_decomp (q : ℕ) (hq : 2 ≤ q) :
    latMat q = rotU (Real.arctan (Real.sqrt 3 / ((q : ℝ) - 1))) *
      ((1 - 1 / (q : ℝ)) • projU + Real.sqrt ((1 - 1 / (q : ℝ)) ^ 2 + 3 / (q : ℝ) ^ 2) • (1 - projU)) := by
  sorry

/-- **`rem:lattice3`**: `det(I + M/q) = (1-1/q)((1-1/q)² + 3/q²) < 1`. -/
theorem lat3_det (q : ℕ) (hq : 1 ≤ q) :
    (latMat q).det = (1 - 1 / (q : ℝ)) * ((1 - 1 / (q : ℝ)) ^ 2 + 3 / (q : ℝ) ^ 2) ∧
      (latMat q).det < 1 := by
  sorry

/-- **`rem:lattice3`**: `|(I + M/q) v|² = (1-1/q)² |v|² + (3/q²) |v_⊥|²`. -/
theorem lat3_norm (q : ℕ) (v : Fin 3 → ℝ) :
    (latMat q *ᵥ v) ⬝ᵥ (latMat q *ᵥ v) =
      (1 - 1 / (q : ℝ)) ^ 2 * (v ⬝ᵥ v) + 3 / (q : ℝ) ^ 2 * (v ⬝ᵥ v - (∑ i, v i) ^ 2 / 3) := by
  sorry

/-- **`rem:lattice3`**: for `q ≥ 3`, `λ₁(Λ_q)² ≥ 1 - 2/q + 3/q²` on `ℤ³ \ 0`. -/
theorem lat3_min (q : ℕ) (hq : 3 ≤ q) (v : Fin 3 → ℤ) (hv : v ≠ 0) :
    1 - 2 / (q : ℝ) + 3 / (q : ℝ) ^ 2 ≤
      (latMat q *ᵥ (fun i => (v i : ℝ))) ⬝ᵥ (latMat q *ᵥ (fun i => (v i : ℝ))) := by
  sorry

/-- **`rem:lattice3`**: the minimum is attained at `(I + M/q) e_x = (1 - 1/q, 1/q, -1/q)`. -/
theorem lat3_min_attained (q : ℕ) :
    latMat q *ᵥ ![1, 0, 0] = ![1 - 1 / (q : ℝ), 1 / (q : ℝ), -(1 / (q : ℝ))] ∧
      (latMat q *ᵥ ![1, 0, 0]) ⬝ᵥ (latMat q *ᵥ ![1, 0, 0]) = 1 - 2 / (q : ℝ) + 3 / (q : ℝ) ^ 2 := by
  sorry

/-- **`rem:lattice3`**: `c(q) < λ₁(Λ_q)`. -/
theorem lat3_cP (q : ℕ) (hq : 1 ≤ q) : cP q < Real.sqrt (1 - 2 / (q : ℝ) + 3 / (q : ℝ) ^ 2) := by
  sorry

/-- **`thm:main`(2), covering radius.** Every `x ∈ [0,1]³` has a point of `𝒫_{k,q}` at Euclidean
distance at most `√3 · q^(-k) = √3 N^(-1/3)`. -/
theorem P_covering (q k : ℕ) (hq : 2 ≤ q) (hk : 1 ≤ k) (x : Fin 3 → ℝ)
    (hx : ∀ c, 0 ≤ x c ∧ x c ≤ 1) :
    ∃ v : Fin (3 * k) → ZMod q,
      ∑ c, (x c - (Ppoint q k v c : ℝ) / (q : ℝ) ^ (3 * k)) ^ 2 ≤ 3 / ((q : ℝ) ^ k) ^ 2 := by
  sorry

/-- **Theorem `thm:sep` / `thm:main`(3), exact integer form.** For `q ≥ 4`, `k ≥ 2` and distinct
indices `v ≠ w`, with `N = q^(3k)` and `D² = torusDist2 N X(v) X(w)` (the squared toroidal
distance times `N²`):
`q² D² ≥ q^(4k) · min{(q-1)², (q-2)² + (q-4)², 3(q-3)²}`,
i.e. `δ ≥ c(q) N^(-1/3)` with
`c(q)² = min{(1-1/q)², (1-2/q)² + (1-4/q)², 3(1-3/q)²}`. -/
theorem P_sep (q k : ℕ) (hq : 4 ≤ q) (hk : 2 ≤ k) (v w : Fin (3 * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (4 * k) *
        min (((q : ℤ) - 1) ^ 2) (min (((q : ℤ) - 2) ^ 2 + ((q : ℤ) - 4) ^ 2) (3 * ((q : ℤ) - 3) ^ 2))
      ≤ (q : ℤ) ^ 2 * (torusDist2 (q ^ (3 * k)) (Ppoint q k v) (Ppoint q k w) : ℤ) := by
  sorry

/-- **`thm:main`(3), "in particular".** For `q ≥ 8`: `q² D² ≥ q^(4k) (q-1)²`, i.e.
`δ ≥ (1 - 1/q) N^(-1/3)`. -/
theorem P_sep_ge8 (q k : ℕ) (hq : 8 ≤ q) (hk : 2 ≤ k) (v w : Fin (3 * k) → ZMod q)
    (hvw : v ≠ w) :
    (q : ℤ) ^ (4 * k) * ((q : ℤ) - 1) ^ 2
      ≤ (q : ℤ) ^ 2 * (torusDist2 (q ^ (3 * k)) (Ppoint q k v) (Ppoint q k w) : ℤ) := by
  sorry

/-- **`thm:main`(3), real form.** The toroidal distance between any two distinct points of
`𝒫_{k,q}` (points `X / N` in `[0,1)³`, `N = q^(3k)`) is at least `c(q) · N^(-1/3)`. -/
theorem P_sep_real (q k : ℕ) (hq : 4 ≤ q) (hk : 2 ≤ k) (v w : Fin (3 * k) → ZMod q)
    (hvw : v ≠ w) :
    cP q * ((q : ℝ) ^ (3 * k)) ^ (-(1 / 3 : ℝ))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (3 * k)) ((Ppoint q k v c : ℤ) - (Ppoint q k w c : ℤ)) : ℝ)
          / (q : ℝ) ^ (3 * k)) ^ 2) := by
  sorry

end Z3Net

namespace Z3NetC

open Z3NetF Finset Matrix

/-- **`def:col`** (and the setting of `lem:drift`): the digital net with the digits `n_c`, `a·n`, `ℓ·n`
in every coordinate (`a = (q𝟏 + w)/3`, `∑ w = 0`, `w_c ≡ -q (mod 3)`, `∑ ℓ ≡ 0 (mod q)`) is a column
point set: its point with index `n` is `q² n + φ([n]) 𝟏` with the heights `φ = q (a·n) + ℓ·n`. -/
theorem colW_column {q : ℕ} [NeZero q] (w ℓ : Fin 3 → ℤ) (hw0 : ∑ c, w c = 0)
    (hw3 : ∀ c, (3 : ℤ) ∣ q + w c) (hℓ : (q : ℤ) ∣ ∑ c, ℓ c) :
    IsHeight q (colPhi q w ℓ) ∧ ∀ n, digPoint q 3 (colGenW q w ℓ) n = colPt q (colPhi q w ℓ) n := by
  sorry

/-- **`def:col`**: `𝒞_q` is a column point set (`gcd(q, 6) = 1`). -/
theorem col_column {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) :
    IsHeight q (colPhi q (wCol q) ellCol) ∧
      ∀ n, digPoint q 3 (colGen q) n = colPt q (colPhi q (wCol q) ellCol) n := by
  sorry

/-- **`thm:colmin`**: for every column point set in base `q ≥ 2`, with `G = 3g`
(`g = min_{i,[n]} dist(Δ_i([n]), ⅔q² + q²ℤ)`), the toroidal minimum distance `d` at integer scale `q³`
satisfies `3d² = 2q⁴ + G²` (i.e. `d² = ⅔q⁴ + 3g²`): every pair of distinct points has
`3 d² ≥ 2q⁴ + G²`, and a pair in neighbouring columns `[n]`, `[n + e_i]` attains it. -/
theorem colmin {q : ℕ} [NeZero q] (hq : 2 ≤ q) (φ : (Fin 3 → ZMod q) → ℕ) (hφ : IsHeight q φ) :
    (∀ n n' : Fin 3 → ZMod q, n ≠ n' →
      2 * q ^ 4 + colGap q φ ^ 2 ≤ 3 * torusDist2 (q ^ 3) (colPt q φ n) (colPt q φ n')) ∧
    ∃ (i : Fin 3) (n : Fin 3 → ZMod q) (t : ZMod q), n + Pi.single i 1 + (fun _ => t) ≠ n ∧
      3 * torusDist2 (q ^ 3) (colPt q φ n) (colPt q φ (n + Pi.single i 1 + fun _ => t)) =
        2 * q ^ 4 + colGap q φ ^ 2 := by
  sorry

/-- **`thm:colmin`**: `δN^{1/3} ≥ √(2/3)` for every column point set (`N = q³`, toroidal). -/
theorem colmin_real {q : ℕ} [NeZero q] (hq : 2 ≤ q) (φ : (Fin 3 → ZMod q) → ℕ) (hφ : IsHeight q φ)
    (n n' : Fin 3 → ZMod q) (hne : n ≠ n') :
    Real.sqrt (2 / 3) ≤ Real.sqrt (torusDist2 (q ^ 3) (colPt q φ n) (colPt q φ n') : ℝ) / (q : ℝ) ^ 2 := by
  sorry

/-- **`thm:col`(1)**: for `q ≥ 5` with `gcd(q, 6) = 1`, `𝒞_q` is a digital `(0,3,3)`-net over `ℤ/qℤ`; its
box minors are units, each one of `1`, `±a_x`, `±a_y`, `±a_z`, `a_x + a_y`. -/
theorem col_net {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q) :
    IsNet0 3 q 3 (digPoint q 3 (colGen q)) ∧ ∀ d : Fin 3 → ℕ, ∑ c, d c = 3 →
      IsUnit (boxMatrix (colGen q) d).det ∧
      (boxMatrix (colGen q) d).det ∈ ({1, ((colA q (wCol q) 0 : ℤ) : ZMod q),
        -((colA q (wCol q) 0 : ℤ) : ZMod q), ((colA q (wCol q) 1 : ℤ) : ZMod q),
        -((colA q (wCol q) 1 : ℤ) : ZMod q), -((colA q (wCol q) 2 : ℤ) : ZMod q),
        ((colA q (wCol q) 2 : ℤ) : ZMod q),
        ((colA q (wCol q) 0 : ℤ) : ZMod q) + ((colA q (wCol q) 1 : ℤ) : ZMod q)} : Set (ZMod q)) := by
  sorry

/-- **`thm:col`(1)**: every cell of side `q⁻¹` holds a point of `𝒞_q`, so `h ≤ √3 N^{-1/3}`. -/
theorem col_covering {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (y : Fin 3 → ℝ)
    (hy : ∀ c, 0 ≤ y c ∧ y c < 1) :
    ∃ v : Fin 3 → ZMod q, Real.sqrt (∑ c, (y c - (digPoint q 3 (colGen q) v c : ℝ) / (q : ℝ) ^ 3) ^ 2) ≤
      Real.sqrt 3 * ((q : ℝ) ^ 3) ^ (-(1 / (3 : ℝ))) := by
  sorry

/-- **`thm:col`(2)**: the toroidal minimum distance `d` of `𝒞_q` at integer scale `q³` satisfies
`3d² = 2q⁴ + τ²` (`τ = q² - q - 3` for `q ≡ 2`, `q² - 2q` for `q ≡ 1 (mod 3)`): every pair has
`3 d² ≥ 2q⁴ + τ²`, toroidally and hence Euclidean, and a pair attains it in both. -/
theorem col_mindist {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q) :
    (∀ v w : Fin 3 → ZMod q, v ≠ w →
      2 * (q : ℤ) ^ 4 + tauCol q ^ 2 ≤
        3 * (torusDist2 (q ^ 3) (digPoint q 3 (colGen q) v) (digPoint q 3 (colGen q) w) : ℤ) ∧
      2 * (q : ℤ) ^ 4 + tauCol q ^ 2 ≤
        3 * ∑ c, ((digPoint q 3 (colGen q) w c : ℤ) - (digPoint q 3 (colGen q) v c : ℤ)) ^ 2) ∧
    ∃ v w : Fin 3 → ZMod q, v ≠ w ∧
      3 * ∑ c, ((digPoint q 3 (colGen q) w c : ℤ) - (digPoint q 3 (colGen q) v c : ℤ)) ^ 2 =
        2 * (q : ℤ) ^ 4 + tauCol q ^ 2 ∧
      3 * (torusDist2 (q ^ 3) (digPoint q 3 (colGen q) v) (digPoint q 3 (colGen q) w) : ℤ) =
        2 * (q : ℤ) ^ 4 + tauCol q ^ 2 := by
  sorry

/-- **`thm:col`(2)**, closest pairs: two distinct points of `𝒞_q` are at the minimum distance if and
only if their difference is `±D` modulo `q³` (`D` = `DCol q`). -/
theorem col_closest {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q) (v w : Fin 3 → ZMod q)
    (hvw : v ≠ w) :
    3 * (torusDist2 (q ^ 3) (digPoint q 3 (colGen q) v) (digPoint q 3 (colGen q) w) : ℤ) =
        2 * (q : ℤ) ^ 4 + tauCol q ^ 2 ↔
      (∀ c, (digPoint q 3 (colGen q) w c : ℤ) ≡ (digPoint q 3 (colGen q) v c : ℤ) + DCol q c
        [ZMOD (q : ℤ) ^ 3]) ∨
      (∀ c, (digPoint q 3 (colGen q) w c : ℤ) ≡ (digPoint q 3 (colGen q) v c : ℤ) - DCol q c
        [ZMOD (q : ℤ) ^ 3]) := by
  sorry

/-- **`thm:col`(2)**: for `q ≡ 2 (mod 3)`, `2q⁴ + τ² = 3q⁴ - 2q³ - 5q² + 6q + 9`
(`d² = q⁴ - ⅔q³ - (5/3)q² + 2q + 3`) and `δN^{1/3} = 1 - 1/(3q) - 8/(9q²) + O(q⁻³)`; for `q ≡ 1`,
`2q⁴ + τ² = 3q⁴ - 4q³ + 4q²` (`d² = q⁴ - (4/3)q³ + (4/3)q²`) and `δN^{1/3} = 1 - 2/(3q) + 4/(9q²) + O(q⁻³)`;
with the explicit `O(q⁻³)` bounds `2/q³` resp. `1/q³` (`cCol q = √((2q⁴ + τ²)/3)/q²`). -/
theorem col_expansion {q : ℕ} [NeZero q] (hq : 5 ≤ q) :
    (q % 3 = 2 → 2 * (q : ℤ) ^ 4 + tauCol q ^ 2 = 3 * (q : ℤ) ^ 4 - 2 * q ^ 3 - 5 * q ^ 2 + 6 * q + 9 ∧
      |cCol q - (1 - 1 / (3 * q) - 8 / (9 * (q : ℝ) ^ 2))| ≤ 2 / (q : ℝ) ^ 3) ∧
    (q % 3 = 1 → 2 * (q : ℤ) ^ 4 + tauCol q ^ 2 = 3 * (q : ℤ) ^ 4 - 4 * q ^ 3 + 4 * q ^ 2 ∧
      |cCol q - (1 - 2 / (3 * q) + 4 / (9 * (q : ℝ) ^ 2))| ≤ 1 / (q : ℝ) ^ 3) := by
  sorry

/-- **`thm:col`(2)**, real form: `δN^{1/3} = cCol q` for `𝒞_q` (toroidal, `N = q³`). -/
theorem col_sep_real {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q) :
    (∀ v w : Fin 3 → ZMod q, v ≠ w → cCol q * ((q : ℝ) ^ 3) ^ (-(1 / (3 : ℝ))) ≤
      Real.sqrt (∑ c, ((cres (q ^ 3) ((digPoint q 3 (colGen q) v c : ℤ) -
        (digPoint q 3 (colGen q) w c : ℤ)) : ℝ) / (q : ℝ) ^ 3) ^ 2)) ∧
    ∃ v w : Fin 3 → ZMod q, v ≠ w ∧ Real.sqrt (∑ c, ((cres (q ^ 3) ((digPoint q 3 (colGen q) v c : ℤ) -
        (digPoint q 3 (colGen q) w c : ℤ)) : ℝ) / (q : ℝ) ^ 3) ^ 2) =
      cCol q * ((q : ℝ) ^ 3) ^ (-(1 / (3 : ℝ))) := by
  sorry

/-- **`thm:col`(3)**: within each residue class modulo `3`, `δN^{1/3} = cCol q` increases with `q`. -/
theorem col_mono (q q' : ℕ) (hq : 5 ≤ q) (hlt : q < q') (hmod : q % 3 = q' % 3) : cCol q < cCol q' := by
  sorry

/-- **`thm:col`(3)**: `cCol 5 = √513/25 = 0.9059…`, `cCol 7 = √2009/49 = 0.9147…`, `cCol 37 = 0.9823…`,
`cCol 41 > 0.9913`; so `δN^{1/3} > 0.9059` for every `q ≥ 5` coprime to `6`, and `> 0.9823` from
`q ≥ 37` on. -/
theorem col_values :
    cCol 5 = Real.sqrt 513 / 25 ∧ cCol 7 = Real.sqrt 2009 / 49 ∧
    0.9059 < cCol 5 ∧ cCol 5 < 0.9060 ∧ 0.9147 < cCol 7 ∧ cCol 7 < 0.9148 ∧
    0.9823 < cCol 37 ∧ cCol 37 < 0.9824 ∧ 0.9913 < cCol 41 ∧
    ∀ q : ℕ, Nat.Coprime q 6 → 5 ≤ q → 0.9059 < cCol q ∧ (37 ≤ q → 0.9823 < cCol q) := by
  sorry

/-- **`thm:col`(1)**, the parenthetical "as integers the minors of the boxes with depth `3` are `a_x + a_y` and `±a_z`":
the integer generator matrices of `𝒞_q` (rows `e_c`, `a = (q𝟏 + w)/3`, `b = (-1, 1, 0)`, `def:col`) reduce to
`colGen q` modulo `q`, and the box with depth `3` on `c` (all three rows of coordinate `c`) has the integer determinant
`a_x + a_y` for `c = z` and `-a_z` for `c = x, y` (up to the sign of the cofactor expansion along `e_c`, the `2 × 2` minor
of the rows `a`, `b` on the two columns other than `c`: `-a_z`, `a_z`, `a_x + a_y` for `c = x, y, z`). Every `q`. -/
theorem col_boxMinor_int (q : ℕ) :
    (∀ c : Fin 3, (Matrix.of ![(Pi.single c 1 : Fin 3 → ℤ), fun d => colA q (wCol q) d, ellCol]).map
        (Int.cast : ℤ → ZMod q) = colGen q c) ∧
    ∀ c : Fin 3, (boxMatrix (fun c : Fin 3 =>
        Matrix.of ![(Pi.single c 1 : Fin 3 → ℤ), fun d => colA q (wCol q) d, ellCol]) (Pi.single c 3)).det =
      if c = 2 then colA q (wCol q) 0 + colA q (wCol q) 1 else -colA q (wCol q) 2 := by
  sorry

/-- **`lem:shared`**: in a `(0,m,s)`-net in base `q`, digital or not (a family `X` of `q^m` points at
integer scale `q^m`), for two coordinates `a ≠ b` and `2(j+1) ≤ m`, every value `(α, β)` of the pair of
digits with index `j` of `a` and `b` occurs at exactly `q^{m-2}` points. -/
theorem shared_count {s q m : ℕ} [NeZero q] (X : (Fin m → ZMod q) → Fin s → ℕ)
    (hX : IsNet0 s q m X) (a b : Fin s) (hab : a ≠ b) (j : ℕ) (hj : 2 * (j + 1) ≤ m)
    (α β : ℕ) (hα : α < q) (hβ : β < q) :
    (univ.filter fun v : Fin m → ZMod q =>
        X v a / q ^ (m - 1 - j) % q = α ∧ X v b / q ^ (m - 1 - j) % q = β).card = q ^ (m - 2) := by
  sorry

/-- **`lem:shared`**: if the digit with index `j` of `b` is a function `f` of the digit with index `j`
of `a` at every point (`q ≥ 2`), then `2(j+1) > m`. -/
theorem shared_fun {s q m : ℕ} [NeZero q] (hq : 2 ≤ q) (X : (Fin m → ZMod q) → Fin s → ℕ)
    (hX : IsNet0 s q m X) (a b : Fin s) (hab : a ≠ b) (j : ℕ) (f : ℕ → ℕ)
    (hf : ∀ v, X v b / q ^ (m - 1 - j) % q = f (X v a / q ^ (m - 1 - j) % q)) :
    m < 2 * (j + 1) := by
  sorry

/-- **`prop:colfree`**: points `X(n) = q² n + q h(n) 𝟏 + j(n)` (one per cell `n`, integer scale `q³`),
`h(n) ∈ [0, q)` with `h(n) ≡ a·n + β (mod q)`, `a = (q𝟏 + w)/3` (`∑ w = 0`, `w_c ≡ -q (mod 3)`), and
arbitrary `j(n) ∈ [0, q)³`: any two distinct points have toroidal distance at least
`q² - ((‖w‖₁ + 3) q - 3)/√3`. -/
theorem colfree {q : ℕ} [NeZero q] (hq : 2 ≤ q) (w : Fin 3 → ℤ) (hw0 : ∑ c, w c = 0)
    (hw3 : ∀ c, (3 : ℤ) ∣ q + w c) (β : ℤ) (h : (Fin 3 → ZMod q) → ℕ)
    (j : (Fin 3 → ZMod q) → Fin 3 → ℕ) (hh : ∀ n, h n < q)
    (hcong : ∀ n, ((h n : ℕ) : ZMod q) = colH q w n + β) (hj : ∀ n c, j n c < q)
    (n n' : Fin 3 → ZMod q) (hne : n ≠ n') :
    (q : ℝ) ^ 2 - (((∑ c, |w c|) + 3) * q - 3) / Real.sqrt 3 ≤
      Real.sqrt (torusDist2 (q ^ 3) (fun c => q ^ 2 * (n c).val + q * h n + j n c)
        (fun c => q ^ 2 * (n' c).val + q * h n' + j n' c) : ℝ) := by
  sorry

/-- **`prop:colshift`(1)**: if the digital shift `τ` of `𝒞_q` has equal second digits `τ_{c,2}` and equal
third digits `τ_{c,3}` (Lean: `sh c 1`, `sh c 2`), the minimum distance of `𝒞_q ⊕ τ` is that of `𝒞_q`:
`3d² = 2q⁴ + τ²` (toroidal). -/
theorem colshift_eq {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q)
    (sh : Fin 3 → Fin 3 → ZMod q) (h2 : sh 0 1 = sh 1 1 ∧ sh 1 1 = sh 2 1)
    (h3 : sh 0 2 = sh 1 2 ∧ sh 1 2 = sh 2 2) :
    (∀ v w : Fin 3 → ZMod q, v ≠ w → 2 * (q : ℤ) ^ 4 + tauCol q ^ 2 ≤
      3 * (torusDist2 (q ^ 3) (digPointShift q 3 (colGen q) sh v)
        (digPointShift q 3 (colGen q) sh w) : ℤ)) ∧
    ∃ v w : Fin 3 → ZMod q, v ≠ w ∧
      3 * (torusDist2 (q ^ 3) (digPointShift q 3 (colGen q) sh v)
        (digPointShift q 3 (colGen q) sh w) : ℤ) = 2 * (q : ℤ) ^ 4 + tauCol q ^ 2 := by
  sorry

/-- **`prop:colshift`(2)**: equal second shift digits: `δN^{1/3} ≥ 1 - (7q - 3)/(√3 q²)` (toroidal; integer
scale: `d ≥ q² - (7q - 3)/√3`). -/
theorem colshift_agree2 {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q)
    (sh : Fin 3 → Fin 3 → ZMod q) (h2 : sh 0 1 = sh 1 1 ∧ sh 1 1 = sh 2 1) (v w : Fin 3 → ZMod q)
    (hvw : v ≠ w) :
    (q : ℝ) ^ 2 - (7 * q - 3) / Real.sqrt 3 ≤
      Real.sqrt (torusDist2 (q ^ 3) (digPointShift q 3 (colGen q) sh v)
        (digPointShift q 3 (colGen q) sh w) : ℝ) := by
  sorry

/-- **`prop:colshift`(3)**, lower bound: for every digital shift,
`δN^{1/3} ≥ (1 - (W+3)/q + 3/q²)/√3` (`W = 2` for `q ≡ 2`, `4` for `q ≡ 1 (mod 3)`; integer scale:
`d ≥ (q² - (W+3)q + 3)/√3`), and this exceeds `0.4693` for every `q ≥ 37`. -/
theorem colshift_lower {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q)
    (sh : Fin 3 → Fin 3 → ZMod q) :
    (∀ v w : Fin 3 → ZMod q, v ≠ w →
      ((q : ℝ) ^ 2 - ((if q % 3 = 2 then (2 : ℤ) else 4 : ℤ) + 3) * q + 3) / Real.sqrt 3 ≤
        Real.sqrt (torusDist2 (q ^ 3) (digPointShift q 3 (colGen q) sh v)
          (digPointShift q 3 (colGen q) sh w) : ℝ)) ∧
    (37 ≤ q → 0.4693 < (1 - ((if q % 3 = 2 then (2 : ℤ) else 4 : ℤ) + 3) / (q : ℝ) + 3 / (q : ℝ) ^ 2) /
      Real.sqrt 3) := by
  sorry

/-- **`prop:colshift`(3)**, upper bound: if the second shift digits are not all equal, some pair of points
of `𝒞_q ⊕ τ` has Euclidean (hence toroidal) distance at most `√3 (q a_max + q - 1)` at integer scale
`q³`, `a_max = max_c a_c`; i.e. `δN^{1/3} ≤ (1 + (3 + w_max)/q - 3/q²)/√3`, `w_max = max_c w_c`
(`3 a_max = q + w_max`). -/
theorem colshift_upper {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q)
    (sh : Fin 3 → Fin 3 → ZMod q) (hne : ¬ (sh 0 1 = sh 1 1 ∧ sh 1 1 = sh 2 1)) :
    3 * univ.sup' univ_nonempty (colA q (wCol q)) = q + univ.sup' univ_nonempty (wCol q) ∧
    ∃ v w : Fin 3 → ZMod q, v ≠ w ∧
      (∀ c, |(digPointShift q 3 (colGen q) sh w c : ℤ) - (digPointShift q 3 (colGen q) sh v c : ℤ)| ≤
        q * univ.sup' univ_nonempty (colA q (wCol q)) + q - 1) ∧
      Real.sqrt (∑ c, ((digPointShift q 3 (colGen q) sh w c : ℝ) -
          (digPointShift q 3 (colGen q) sh v c : ℝ)) ^ 2) / (q : ℝ) ^ 2 ≤
        (1 + (3 + univ.sup' univ_nonempty (wCol q)) / (q : ℝ) - 3 / (q : ℝ) ^ 2) / Real.sqrt 3 ∧
      Real.sqrt (torusDist2 (q ^ 3) (digPointShift q 3 (colGen q) sh v)
          (digPointShift q 3 (colGen q) sh w) : ℝ) / (q : ℝ) ^ 2 ≤
        (1 + (3 + univ.sup' univ_nonempty (wCol q)) / (q : ℝ) - 3 / (q : ℝ) ^ 2) / Real.sqrt 3 := by
  sorry

/-- **`prop:colshift`(1), Euclidean exactness**: with equal second and third shift digits some two points of
`𝒞_q ⊕ τ` differ by exactly `D` (no coordinate wraps), so the Euclidean minimum distance is the toroidal one:
`3‖D‖² = 2q⁴ + τ²`. -/
theorem colshift_eq_eucl {q : ℕ} [NeZero q] (h6 : Nat.Coprime q 6) (hq : 5 ≤ q)
    (sh : Fin 3 → Fin 3 → ZMod q) (h2 : sh 0 1 = sh 1 1 ∧ sh 1 1 = sh 2 1)
    (h3 : sh 0 2 = sh 1 2 ∧ sh 1 2 = sh 2 2) :
    ∃ v w : Fin 3 → ZMod q, v ≠ w ∧
      (∀ c, (digPointShift q 3 (colGen q) sh w c : ℤ) - digPointShift q 3 (colGen q) sh v c = DCol q c) ∧
      3 * ∑ c, ((digPointShift q 3 (colGen q) sh w c : ℤ) - digPointShift q 3 (colGen q) sh v c) ^ 2 =
        2 * (q : ℤ) ^ 4 + tauCol q ^ 2 := by
  sorry

end Z3NetC

namespace Z3NetKN

open Matrix

/-- **`def:B` (`𝓑²`) and `prop:Bnet`.** For every prime `p`, every `k ≥ 1` and every
`ρ ≢ 0 (mod p)`, the explicit net `𝓑²_{k,p,ρ}` is in graph form with the skeleton digit
`S_z = ρ x_k + ρ² y_k` (rows `skB2 ρ`) and is a `(0,3k+2,3)`-net over `𝔽_p`. -/
theorem B2gen_net (p k ρ : ℕ) (hp : p.Prime) (hk : 1 ≤ k) (hρ : ¬ p ∣ ρ) :
    IsKNskel 2 p k (skB2 ρ) (B2gen p k ρ) ∧
      IsNet0 p (3 * k + 2) (digPoint p (3 * k + 2) (B2gen p k ρ)) := by
  sorry

/-- **`def:B` (`𝓑¹`) and `prop:Bnet`.** For every prime `p`, every `k ≥ 1` and every
`ρ ≢ 0 (mod p)`, the explicit net `𝓑¹_{k,p,ρ}` is in graph form with the skeleton digits
`S_y = ρ x_k + z_{k-1}`, `S_z = ρ² x_k + x_{k-1} + y_{k-1} - z_{k-1}` (rows `skB1 ρ`) and is a
`(0,3k+1,3)`-net over `𝔽_p`. -/
theorem B1gen_net (p k ρ : ℕ) (hp : p.Prime) (hk : 1 ≤ k) (hρ : ¬ p ∣ ρ) :
    IsKNskel 1 p k (skB1 ρ) (B1gen p k ρ) ∧
      IsNet0 p (3 * k + 1) (digPoint p (3 * k + 1) (B1gen p k ρ)) := by
  sorry

/-- **`m ≡ 2`, all primes, net part.** For every prime `p`, `k ≥ 1` and `ρ ≥ 1` with
`ρ(1 + ρ + ρ²) ≤ p` there is a `(0,3k+2,3)`-net over `𝔽_p` with skeleton rows `skB2 ρ`. -/
theorem B2_net (p k ρ : ℕ) (hp : p.Prime) (hk : 1 ≤ k) (hρ : 1 ≤ ρ)
    (hρp : ρ * (1 + ρ + ρ ^ 2) ≤ p) :
    ∃ C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p),
      IsKNskel 2 p k (skB2 ρ) C ∧ IsNet0 p (3 * k + 2) (digPoint p (3 * k + 2) C) := by
  sorry

/-- **`m ≡ 2`, all primes, separation.** Same hypotheses; every net with skeleton rows
`skB2 ρ` has `(ρ - 1)² p^(4k+2) ≤ N² δ²` (`N = p^(3k+2)`), i.e.
`δ ≥ (ρ - 1) p^(-1/3) N^(-1/3)`. -/
theorem B2_sep (p k ρ : ℕ) (hp : p.Prime) (hk : 1 ≤ k) (hρ : 1 ≤ ρ)
    (hρp : ρ * (1 + ρ + ρ ^ 2) ≤ p)
    (C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p))
    (hC : IsKNskel 2 p k (skB2 ρ) C) (v w : Fin (3 * k + 2) → ZMod p) (hvw : v ≠ w) :
    (ρ - 1) ^ 2 * p ^ (4 * k + 2) ≤
      torusDist2 (p ^ (3 * k + 2)) (digPoint p (3 * k + 2) C v) (digPoint p (3 * k + 2) C w) := by
  sorry

/-- **`rem:B2`, the two skeleton predicates coincide**: for `s = 3`, entry S1's predicate (depths
`(k+1, k+1, k)`, skeleton digit `S_z = ρ x_k + ρ² y_k`) is entry KN's `IsKNskel 2 p k (skB2 ρ)`. -/
theorem B2_skel_iff (p k ρ : ℕ) (C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p)) :
    IsS1skel 3 p k ρ C ↔ IsKNskel 2 p k (skB2 ρ) C := by
  sorry

/-- **`rem:B2`, separation (integer form)** under the remark's hypothesis `ρ ≥ 1`, `ρ³ < p` (for
`ρ = 1` the bound is `0`): every graph form with skeleton rows `skB2 ρ` has
`(ρ - 1)² p^(4k+2) ≤ N² δ²` (`N = p^(3k+2)`, toroidal). -/
theorem B2_rem_sep (p k ρ : ℕ) (hp : p.Prime) (hρ : 1 ≤ ρ) (hρp : ρ ^ 3 < p)
    (C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p))
    (hC : IsKNskel 2 p k (skB2 ρ) C) (v w : Fin (3 * k + 2) → ZMod p) (hvw : v ≠ w) :
    (ρ - 1) ^ 2 * p ^ (4 * k + 2) ≤
      torusDist2 (p ^ (3 * k + 2)) (digPoint p (3 * k + 2) C v) (digPoint p (3 * k + 2) C w) := by
  sorry

/-- **`rem:B2`, separation (real form)**: same hypotheses, `δ ≥ (ρ - 1) p^(-1/3) N^(-1/3)`
(toroidal distance of the points `X / N ∈ [0,1)³`). -/
theorem B2_rem_sep_real (p k ρ : ℕ) (hp : p.Prime) (hρ : 1 ≤ ρ) (hρp : ρ ^ 3 < p)
    (C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p))
    (hC : IsKNskel 2 p k (skB2 ρ) C) (v w : Fin (3 * k + 2) → ZMod p) (hvw : v ≠ w) :
    ((ρ : ℝ) - 1) * (p : ℝ) ^ (-(1 / (3 : ℝ))) * ((p : ℝ) ^ (3 * k + 2)) ^ (-(1 / (3 : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (3 * k + 2))
          ((digPoint p (3 * k + 2) C v c : ℤ) - (digPoint p (3 * k + 2) C w c : ℤ)) : ℝ)
          / (p : ℝ) ^ (3 * k + 2)) ^ 2) := by
  sorry

/-- **`rem:B2`, the free-jitter relaxation and its binding step.** For `ρ ≥ 1`, `ρ³ < p`: every
nonzero `a` of the lattice `Λ₂ = {a ∈ ℤ³ : a_z ≡ ρ a_x + ρ² a_y (mod p)}` (a fine-cell difference)
has jitter-relaxed squared length `∑_c ((|a_c| - 1)₊)² ≥ (ρ - 1)²`, and the step
`b = (-ρ, 1, 0) ∈ Λ₂` attains it: the relaxation equals `(ρ - 1)` (in fine cells) exactly. -/
theorem B2_relax (p ρ : ℕ) (hρ : 1 ≤ ρ) (hρp : ρ ^ 3 < p) :
    (∀ a : Fin 3 → ℤ, (p : ℤ) ∣ a 2 - (ρ : ℤ) * a 0 - (ρ : ℤ) ^ 2 * a 1 → a ≠ 0 →
      ((ρ : ℤ) - 1) ^ 2 ≤ ∑ c, (max (|a c| - 1) 0) ^ 2) ∧
    ((p : ℤ) ∣ (![-(ρ : ℤ), 1, 0] : Fin 3 → ℤ) 2 - (ρ : ℤ) * (![-(ρ : ℤ), 1, 0] : Fin 3 → ℤ) 0
        - (ρ : ℤ) ^ 2 * (![-(ρ : ℤ), 1, 0] : Fin 3 → ℤ) 1) ∧
    (![-(ρ : ℤ), 1, 0] : Fin 3 → ℤ) ≠ 0 ∧
    ∑ c, (max (|(![-(ρ : ℤ), 1, 0] : Fin 3 → ℤ) c| - 1) 0) ^ 2 = ((ρ : ℤ) - 1) ^ 2 := by
  sorry

/-- **`rem:B2`, constants.** With `ρ = ρ_3(p)` maximal (`ρ³ < p`) the bound `(ρ - 1) p^(-1/3)`
exceeds `0.9` at `p = 1361`, at no smaller prime, and at every prime `p ≥ 6863` (where `ρ ≥ 19`). -/
theorem B2_const :
    Nat.Prime 1361 ∧ 0.9 < ((rhoS 3 1361 : ℝ) - 1) * (1361 : ℝ) ^ (-(1 / (3 : ℝ))) ∧
    (∀ p : ℕ, p.Prime → p < 1361 → ((rhoS 3 p : ℝ) - 1) * (p : ℝ) ^ (-(1 / (3 : ℝ))) ≤ 0.9) ∧
    (∀ p : ℕ, p.Prime → 6863 ≤ p →
      19 ≤ rhoS 3 p ∧ 0.9 < ((rhoS 3 p : ℝ) - 1) * (p : ℝ) ^ (-(1 / (3 : ℝ)))) := by
  sorry

/-- **`m ≡ 1`, all primes, net part.** For every prime `p`, `k ≥ 1` and `ρ ≥ 2` with
`ρ²(ρ + 1) ≤ p` there is a `(0,3k+1,3)`-net over `𝔽_p` with skeleton rows `skB1 ρ`. -/
theorem B1_net (p k ρ : ℕ) (hp : p.Prime) (hk : 1 ≤ k) (hρ : 2 ≤ ρ)
    (hρp : ρ ^ 2 * (ρ + 1) ≤ p) :
    ∃ C : Fin 3 → Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p),
      IsKNskel 1 p k (skB1 ρ) C ∧ IsNet0 p (3 * k + 1) (digPoint p (3 * k + 1) C) := by
  sorry

/-- **`m ≡ 1`, all primes, separation.** Same hypotheses; every net with skeleton rows
`skB1 ρ` has `(ρ² - 4)² p^(4k) ≤ N² δ²` (`N = p^(3k+1)`), i.e.
`δ ≥ (ρ² - 4) p^(-2/3) N^(-1/3)`. -/
theorem B1_sep (p k ρ : ℕ) (hp : p.Prime) (hk : 1 ≤ k) (hρ : 2 ≤ ρ)
    (hρp : ρ ^ 2 * (ρ + 1) ≤ p)
    (C : Fin 3 → Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p))
    (hC : IsKNskel 1 p k (skB1 ρ) C) (v w : Fin (3 * k + 1) → ZMod p) (hvw : v ≠ w) :
    (ρ ^ 2 - 4) ^ 2 * p ^ (4 * k) ≤
      torusDist2 (p ^ (3 * k + 1)) (digPoint p (3 * k + 1) C v) (digPoint p (3 * k + 1) C w) := by
  sorry

/-- **`thm:allm`, `ρ` maximal**: for `p ≥ 12`, `ρ = rhoB1 p` satisfies `ρ ≥ 2`, `ρ²(ρ+1) ≤ p` and
`p < (ρ+1)²(ρ+2)`. -/
theorem B1_rho_spec (p : ℕ) (hp : 12 ≤ p) :
    2 ≤ rhoB1 p ∧ rhoB1 p ^ 2 * (rhoB1 p + 1) ≤ p ∧ p < (rhoB1 p + 1) ^ 2 * (rhoB1 p + 2) := by
  sorry

/-- **`thm:allm`, separation (real form)**: for every prime `p`, `k ≥ 1`, `ρ ≥ 2` with
`ρ²(ρ+1) ≤ p` and every graph form with skeleton rows `skB1 ρ` (in particular `𝓑¹_{k,p,ρ}`),
`δ ≥ (ρ² - 4) p^(-2/3) N^(-1/3)` (`N = p^(3k+1)`, toroidal). -/
theorem B1_sep_real (p k ρ : ℕ) (hp : p.Prime) (hk : 1 ≤ k) (hρ : 2 ≤ ρ)
    (hρp : ρ ^ 2 * (ρ + 1) ≤ p)
    (C : Fin 3 → Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p))
    (hC : IsKNskel 1 p k (skB1 ρ) C) (v w : Fin (3 * k + 1) → ZMod p) (hvw : v ≠ w) :
    ((ρ : ℝ) ^ 2 - 4) * (p : ℝ) ^ (-(2 / (3 : ℝ))) * ((p : ℝ) ^ (3 * k + 1)) ^ (-(1 / (3 : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (3 * k + 1))
          ((digPoint p (3 * k + 1) C v c : ℤ) - (digPoint p (3 * k + 1) C w c : ℤ)) : ℝ)
          / (p : ℝ) ^ (3 * k + 1)) ^ 2) := by
  sorry

/-- **`thm:allm`: with `ρ` maximal the bound tends to `1`.** -/
theorem B1_tendsto : Filter.Tendsto bndB1 Filter.atTop (nhds 1) := by
  sorry

/-- **`thm:allm`, "Constants": `ρ ≥ 27` iff `p ≥ 20412`** (`= 27² · 28`). -/
theorem B1_rho27 (p : ℕ) : 27 ≤ rhoB1 p ↔ 20412 ≤ p := by
  sorry

/-- **`thm:allm`: the bound exceeds `0.9` whenever `ρ ≥ 27`, i.e. for every prime `p ≥ 20431`**
(the least prime `≥ 20412`). -/
theorem B1_gt09 :
    (∀ p : ℕ, 27 ≤ rhoB1 p → 0.9 < bndB1 p) ∧ (∀ p : ℕ, p.Prime → 20431 ≤ p → 0.9 < bndB1 p) ∧
    Nat.Prime 20431 ∧ (∀ p : ℕ, p.Prime → 20412 ≤ p → 20431 ≤ p) := by
  sorry

/-- **`thm:allm`, "Constants": `c³ > g(ρ)`** for `ρ = rhoB1 p ≥ 3` (`c = (ρ² - 4) p^(-2/3)`). -/
theorem B1_g_lt (p : ℕ) (h3 : 3 ≤ rhoB1 p) : gB1 (rhoB1 p) < bndB1 p ^ 3 := by
  sorry

/-- **`thm:allm`, "Constants": `g` increases for `ρ ≥ 3`.** -/
theorem gB1_strictMonoOn : StrictMonoOn gB1 (Set.Ici 3) := by
  sorry

/-- **`thm:allm`, "Constants": `g` tends to `1`.** -/
theorem gB1_tendsto : Filter.Tendsto gB1 Filter.atTop (nhds 1) := by
  sorry

/-- **`thm:allm`, "Constants": `g(27)^(1/3) = 0.9033…`.** -/
theorem gB1_27 : 0.9033 < gB1 27 ^ ((1 : ℝ) / 3) ∧ gB1 27 ^ ((1 : ℝ) / 3) < 0.9034 := by
  sorry

/-- **`cor:allm`.** For every prime `p ≥ 37` and every `m ≥ 3` there is a digital `(0,m,3)`-net over
`𝔽_p` (the nets of `thm:col` (the column net `𝒞_p`) for `m = 3`, `thm:main` for `m ≡ 0`, `m ≥ 6`, `thm:allm` (`𝓑¹`) for
`m ≡ 1`, `thm:S1` at `s = 3` (`𝓑²`) for `m ≡ 2`, with `ρ` maximal) whose toroidal minimum distance
satisfies `δ N^(1/3) ≥ bndDim3 p` (`N = p^m`), and whose covering radius satisfies
`h N^(1/3) ≤ √3`, `p^(1/3) √(2 + p^(-2))`, `min{p^(2/3) √(1 + 2p^(-2)), 4.264}` for
`m ≡ 0, 1, 2 (mod 3)`. -/
theorem cor_allm (p m : ℕ) (hp : p.Prime) (hp37 : 37 ≤ p) (hm : 3 ≤ m) :
    ∃ C : Fin 3 → Matrix (Fin m) (Fin m) (ZMod p),
      IsNet0 p m (digPoint p m C) ∧
      (∀ v w : Fin m → ZMod p, v ≠ w →
        bndDim3 p * ((p : ℝ) ^ m) ^ (-(1 / (3 : ℝ))) ≤
          Real.sqrt (∑ c, ((cres (p ^ m) ((digPoint p m C v c : ℤ) - (digPoint p m C w c : ℤ)) : ℝ)
            / (p : ℝ) ^ m) ^ 2)) ∧
      (∀ y : Fin 3 → ℝ, (∀ c, 0 ≤ y c ∧ y c < 1) → ∃ v : Fin m → ZMod p,
        Real.sqrt (∑ c, (y c - (digPoint p m C v c : ℝ) / (p : ℝ) ^ m) ^ 2) ≤
          (if m % 3 = 0 then Real.sqrt 3
           else if m % 3 = 1 then (p : ℝ) ^ (1 / (3 : ℝ)) * Real.sqrt (2 + 1 / (p : ℝ) ^ 2)
           else min ((p : ℝ) ^ (2 / (3 : ℝ)) * Real.sqrt (1 + 2 / (p : ℝ) ^ 2)) 4.264) *
            ((p : ℝ) ^ m) ^ (-(1 / (3 : ℝ)))) := by
  sorry

/-- **`cor:allm`, the uniform constants**: for every prime `p ≥ 37`, `bndDim3 p > 0.2715`, and
`> 0.4250` if `p ≥ 83`. -/
theorem bndDim3_gt (p : ℕ) (hp : p.Prime) (hp37 : 37 ≤ p) :
    0.2715 < bndDim3 p ∧ (83 ≤ p → 0.4250 < bndDim3 p) := by
  sorry

/-- **`cor:allm`: the lower bound tends to `1`.** -/
theorem bndDim3_tendsto : Filter.Tendsto bndDim3 Filter.atTop (nhds 1) := by
  sorry

/-- **`cor:allm`: quasi-uniformity.** For every prime `p ≥ 37` the mesh ratio is bounded uniformly
in `m`: there is `M` such that for every `m ≥ 3` some digital `(0,m,3)`-net over `𝔽_p` has every
`y ∈ [0,1)³` within `M δ_T(w, w')` of a net point, for all distinct indices `w ≠ w'`. -/
theorem cor_allm_mesh (p : ℕ) (hp : p.Prime) (hp37 : 37 ≤ p) :
    ∃ M : ℝ, ∀ m : ℕ, 3 ≤ m → ∃ C : Fin 3 → Matrix (Fin m) (Fin m) (ZMod p),
      IsNet0 p m (digPoint p m C) ∧
      ∀ y : Fin 3 → ℝ, (∀ c, 0 ≤ y c ∧ y c < 1) → ∃ v : Fin m → ZMod p,
        ∀ w w' : Fin m → ZMod p, w ≠ w' →
          Real.sqrt (∑ c, (y c - (digPoint p m C v c : ℝ) / (p : ℝ) ^ m) ^ 2) ≤
            M * Real.sqrt (∑ c, ((cres (p ^ m)
              ((digPoint p m C w c : ℤ) - (digPoint p m C w' c : ℤ)) : ℝ) / (p : ℝ) ^ m) ^ 2) := by
  sorry

/-- **`cor:allm`, `m ≡ 2`**: for every prime `p ≥ 11` and every `k ≥ 1` (`m = 3k + 2 ≥ 5`) the net
`𝓑²_{k,p,ρ}` with `ρ = ρ_3(p)` is a `(0,m,3)`-net over `𝔽_p` with covering radius
`h N^(1/3) < 4.264` and mesh ratio `h/δ ≤ 7√3` (against the toroidal `δ`). -/
theorem cor_allm_mesh2 (p k : ℕ) (hp : p.Prime) (hp11 : 11 ≤ p) (hk : 1 ≤ k) :
    IsNet0 p (3 * k + 2) (digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p))) ∧
    ∀ y : Fin 3 → ℝ, (∀ c, 0 ≤ y c ∧ y c < 1) → ∃ v : Fin (3 * k + 2) → ZMod p,
      Real.sqrt (∑ c, (y c - (digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p)) v c : ℝ)
          / (p : ℝ) ^ (3 * k + 2)) ^ 2) < 4.264 * ((p : ℝ) ^ (3 * k + 2)) ^ (-(1 / (3 : ℝ))) ∧
      ∀ w w' : Fin (3 * k + 2) → ZMod p, w ≠ w' →
        Real.sqrt (∑ c, (y c - (digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p)) v c : ℝ)
          / (p : ℝ) ^ (3 * k + 2)) ^ 2) ≤
        7 * Real.sqrt 3 * Real.sqrt (∑ c, ((cres (p ^ (3 * k + 2))
          ((digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p)) w c : ℤ) -
            (digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p)) w' c : ℤ)) : ℝ)
          / (p : ℝ) ^ (3 * k + 2)) ^ 2) := by
  sorry

/-- **`cor:allm`, the `m ≡ 2` constants** (`ρ = ρ_3(p)`, `μ = ⌈p/ρ²⌉`): for every prime `p ≥ 11`,
`√3 (μ + 1) p^(-1/3) < 4.264` and `(μ + 1)/(ρ - 1) ≤ 7`; both maxima are attained at `p = 23`
(`4.2633…` and `7`). -/
theorem cor_allm_consts :
    (∀ p : ℕ, p.Prime → 11 ≤ p →
      Real.sqrt 3 * ((muS 3 p (rhoS 3 p) : ℝ) + 1) * (p : ℝ) ^ (-(1 / (3 : ℝ))) < 4.264 ∧
      ((muS 3 p (rhoS 3 p) : ℝ) + 1) / ((rhoS 3 p : ℝ) - 1) ≤ 7) ∧
    4.2633 < Real.sqrt 3 * ((muS 3 23 (rhoS 3 23) : ℝ) + 1) * (23 : ℝ) ^ (-(1 / (3 : ℝ))) ∧
    ((muS 3 23 (rhoS 3 23) : ℝ) + 1) / ((rhoS 3 23 : ℝ) - 1) = 7 := by
  sorry

/-- **`m ≡ 1`, net part.** For each design of `table1` and every `k ≥ 3` there is a
`(0,3k+1,3)`-net over `𝔽_p` in graph form with exactly these rows. -/
theorem KN1_net (p T : ℕ) (R : Rows) (hmem : (p, T, R) ∈ table1) (k : ℕ) (hk : 3 ≤ k) :
    ∃ C : Fin 3 → Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p),
      IsKN 1 p k R C ∧ IsNet0 p (3 * k + 1) (digPoint p (3 * k + 1) C) := by
  sorry

/-- **`m ≡ 1`, separation.** For each design `(p, T_p, R)` of `table1`, every `k ≥ 3`, every net
`C` with these rows and distinct indices `v ≠ w`, with `N = p^(3k+1)`:
`T_p · p^(4k-2) ≤ N² δ²`, i.e. `δ ≥ √T_p · p^(-5/3) · N^(-1/3)`. -/
theorem KN1_sep (p T : ℕ) (R : Rows) (hmem : (p, T, R) ∈ table1) (k : ℕ) (hk : 3 ≤ k)
    (C : Fin 3 → Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p)) (hC : IsKN 1 p k R C)
    (v w : Fin (3 * k + 1) → ZMod p) (hvw : v ≠ w) :
    T * p ^ (4 * k - 2) ≤
      torusDist2 (p ^ (3 * k + 1)) (digPoint p (3 * k + 1) C v) (digPoint p (3 * k + 1) C w) := by
  sorry

/-- **`m ≡ 2`, net part.** For each design of `table2` and every `k ≥ 2` there is a
`(0,3k+2,3)`-net over `𝔽_p` in graph form with exactly these rows. -/
theorem KN2_net (p T : ℕ) (R : Rows) (hmem : (p, T, R) ∈ table2) (k : ℕ) (hk : 2 ≤ k) :
    ∃ C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p),
      IsKN 2 p k R C ∧ IsNet0 p (3 * k + 2) (digPoint p (3 * k + 2) C) := by
  sorry

/-- **`m ≡ 2`, separation.** For each design `(p, T_p, R)` of `table2`, every `k ≥ 2`, every net
`C` with these rows and `v ≠ w`, with `N = p^(3k+2)`: `T_p · p^(4k) ≤ N² δ²`,
i.e. `δ ≥ √T_p · p^(-4/3) · N^(-1/3)`. -/
theorem KN2_sep (p T : ℕ) (R : Rows) (hmem : (p, T, R) ∈ table2) (k : ℕ) (hk : 2 ≤ k)
    (C : Fin 3 → Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p)) (hC : IsKN 2 p k R C)
    (v w : Fin (3 * k + 2) → ZMod p) (hvw : v ≠ w) :
    T * p ^ (4 * k) ≤
      torusDist2 (p ^ (3 * k + 2)) (digPoint p (3 * k + 2) C v) (digPoint p (3 * k + 2) C w) := by
  sorry

end Z3NetKN
