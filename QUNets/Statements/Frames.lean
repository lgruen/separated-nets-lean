open Matrix Finset

/-- `sec:frames`, "Cauchy identities": the layer `λ_c μ_d w_cd` (`c ≠ d`) of the frame of `s`
places (`prop:Ns`) is a Cauchy layer in the homogeneous coordinates `a_c = [x_c : 1]`,
`∞ = [1 : 0]`, the sign of `D_{c∞} = -1` absorbed into `μ_∞`. -/
theorem wN_cauchy {R : Type*} [CommRing R] {s : ℕ} (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (lam mu : Fin s → R) (hl : ∀ c, IsUnit (lam c))
    (hm : ∀ d, IsUnit (mu d)) :
    CauchyOK (fun c => if c = inf then 1 else x c) (fun c => if c = inf then 0 else 1) lam
        (fun d => if d = inf then -mu d else mu d) ∧
      ∀ c d, c ≠ d → lam c * mu d * wN inf x c d =
        cauchyW (fun c => if c = inf then 1 else x c) (fun c => if c = inf then 0 else 1) lam
          (fun d => if d = inf then -mu d else mu d) c d := by
  sorry

/-- **`lem:hermite`**: `det H = ± ∏_{P < Q} (x_Q - x_P)^(α_P α_Q)`, over any commutative ring. -/
theorem hermite_det {R : Type*} [CommRing R] {n m : ℕ} (x : Fin n → R) (α : Fin n → ℕ)
    (αinf : ℕ) (hm : ∑ P, α P + αinf = m) :
    (hermiteMat m x α αinf).det =
        ∏ Q : Fin n, ∏ P : Fin n, (if P < Q then (x Q - x P) ^ (α P * α Q) else 1) ∨
      (hermiteMat m x α αinf).det =
        -∏ Q : Fin n, ∏ P : Fin n, (if P < Q then (x Q - x P) ^ (α P * α Q) else 1) := by
  sorry

/-- **`lem:hermite`**, consequence: over a field, `H` is invertible if the points with
`α_P ≥ 1` are pairwise distinct. -/
theorem hermite_ne_zero {K : Type*} [Field K] {n m : ℕ} (x : Fin n → K) (α : Fin n → ℕ)
    (αinf : ℕ) (hm : ∑ P, α P + αinf = m)
    (hx : ∀ P Q, P ≠ Q → 1 ≤ α P → 1 ≤ α Q → x P ≠ x Q) :
    (hermiteMat m x α αinf).det ≠ 0 := by
  sorry

/-- **`lem:hermite`**, consequence: if two points with `α_P, α_Q ≥ 1` coincide, `H` has two equal
rows (over any commutative ring). -/
theorem hermite_rows {R : Type*} [CommRing R] {n m : ℕ} (x : Fin n → R) (α : Fin n → ℕ)
    (αinf : ℕ) (hm : ∑ P, α P + αinf = m) (P Q : Fin n) (hPQ : P ≠ Q) (hP : 1 ≤ α P)
    (hQ : 1 ≤ α Q) (hx : x P = x Q) :
    ∃ r r' : Fin m, r ≠ r' ∧ hermiteMat m x α αinf r = hermiteMat m x α αinf r' := by
  sorry

/-- **`lem:Ts`**, value: every box minor of the frame is `± ∏_{c' < c} (a_c - a_c')^(d_c' d_c)`
over the pairs of finite places, over any commutative ring. -/
theorem frame_minor {R : Type*} [CommRing R] {s m : ℕ} (inf : Fin s) (x : Fin s → R)
    (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    (boxMatrix (frameRead m inf x) d).det = ∏ c : Fin s, ∏ c' : Fin s,
        (if c' < c ∧ c ≠ inf ∧ c' ≠ inf then (x c - x c') ^ (d c' * d c) else 1) ∨
      (boxMatrix (frameRead m inf x) d).det = -∏ c : Fin s, ∏ c' : Fin s,
        (if c' < c ∧ c ≠ inf ∧ c' ≠ inf then (x c - x c') ^ (d c' * d c) else 1) := by
  sorry

/-- **`lem:Ts`**, net criterion: for `m ≥ 2` and `q` prime to the denominators of the finite
places, the frame (reduced modulo `q`) is a `(0,m,s)`-net over `ℤ/qℤ` iff the finite places are
pairwise distinct modulo every prime factor of `q`. -/
theorem frame_net_iff {s q m : ℕ} (hq : 2 ≤ q) (hm : 2 ≤ m) (inf : Fin s) (a : Fin s → ℚ)
    (hden : ∀ c, c ≠ inf → Nat.Coprime (a c).den q) :
    IsNet0 s q m (digPoint q m (frameRead m inf (fun c => ratRed q (a c)))) ↔
      ∀ p : ℕ, p.Prime → p ∣ q → ∀ c c', c ≠ inf → c' ≠ inf → c ≠ c' →
        ratRed p (a c) ≠ ratRed p (a c') := by
  sorry

/-- The frame's `(k, …, k)` box is invertible, and `Φ^F` is its graph form: `C^F_c = graphGenK
(k, …, k) Φ^F c · G` (`sec:frames`, before `lem:Rs`). -/
theorem frameGraph_spec {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) :
    IsUnit (boxMatrix (frameRead (s * k) inf x) (fun _ => k)).det ∧
      ∀ c, graphGenK (m := s * k) (fun _ => k) (frameGraph R k inf x) c *
        boxMatrix (frameRead (s * k) inf x) (fun _ => k) = frameRead (s * k) inf x c := by
  sorry

/-- **`lem:Rs`**: for `c ≠ d`, row `0` of `Φ^F_cd` has the generating function `rsGen`:
level `j` carries `[x^(k-1-j)] rsGen`. -/
theorem Rs_row0 {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k)) (hr : (r : ℕ) = 0)
    (j : Fin k) :
    frameGraph R k inf x c d r j = PowerSeries.coeff (k - 1 - (j : ℕ)) (rsGen k inf x c d) := by
  sorry

/-- **`prop:Ns`**: with `L_c = diag(Q_c^(-k), 1, …, 1)` and `U_d = Toep(uN_d)`, row `0` of
`L_c Φ^F_cd U_d` carries `w_cd y_cd^n` at the `x`-index `n` (level `k-1-n`), for every `k`. -/
theorem Ns_row0 {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k)) (hr : (r : ℕ) = 0)
    (j : Fin k) :
    (Lgauge (s * k - k) (Ring.inverse (Qf inf x c ^ k)) * frameGraph R k inf x c d *
        toep k (uN k inf x d)) r j = wN inf x c d * yN inf x c d ^ (k - 1 - (j : ℕ)) := by
  sorry

/-- **`prop:Gs`**, the coefficients `β_n` exist and are unique (`n ≥ s-1`, every column `d`). -/
theorem Gs_beta {R : Type*} [CommRing R] {s : ℕ} (hs : 2 ≤ s) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur) (d : Fin s) (n : ℕ) :
    ∃! b : Fin (s - 1) → R, ∀ c, c ≠ d →
      lam c * (wN inf x c d * yN inf x c d ^ n) = ∑ i : Fin (s - 1), b i * F i c d := by
  sorry

/-- **`prop:Gs`**, the gauge: `L_c` and `U_d` are lower triangular with unit diagonal (for any
`β`), so they are gauge moves of `lem:box`(c). -/
theorem Gs_gauge {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur) :
    (∀ c i j, i < j → Lmat k inf x lam c i j = 0) ∧ (∀ c i, IsUnit (Lmat k inf x lam c i i)) ∧
      (∀ d i j, i < j → Ugauge k inf x Ur β d i j = 0) ∧
      (∀ d i, IsUnit (Ugauge k inf x Ur β d i i)) := by
  sorry

/-- **`prop:Gs`**: row `0` of `L_c Φ^F_cd U_d` equals the design on the `x`-indices `< s-1`
(truncated if `k < s-1`) and vanishes below, every `k ≥ 1`, `c ≠ d`. -/
theorem Gs_row0 {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur)
    (hβ : BetaRel inf x F lam β) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k))
    (hr : (r : ℕ) = 0) (j : Fin k) :
    (Lmat k inf x lam c * frameGraph R k inf x c d * Ugauge k inf x Ur β d) r j =
      if k - 1 - (j : ℕ) < s - 1 then F (k - 1 - (j : ℕ)) c d else 0 := by
  sorry

/-- **`prop:Gs`, `def:Ns`**, the net does not depend on the choices: for places with unit
differences (`PlacesOK`), any two solutions `U'`, `U''` of the residual problem of a design `F`
(with the same `λ'`) and any two `β`, `β'` with the defining relation of `prop:Gs` give the same
generator matrices of `𝒫^F_k`. (`U'^(k)_d` reads `U'_d` only on `n', n ≤ s - 2`, where it is unique,
and `β_n` only for `n ≥ s - 1`, where it is unique.) -/
theorem PGen_indep {R : Type*} [CommRing R] {s : ℕ} (hs : 2 ≤ s) (k : ℕ) (inf : Fin s)
    (x : Fin s → R) (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur Ur' β β' : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur)
    (hres' : Residual inf x F lam Ur') (hβ : BetaRel inf x F lam β)
    (hβ' : BetaRel inf x F lam β') :
    PGen k inf x F lam Ur β = PGen k inf x F lam Ur' β' := by
  sorry

/-- **`cor:tsk`**: every box minor of `𝒫^F_k` over `R` is a unit of `R` (any `β`). -/
theorem tsk_unit {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur)
    (d : Fin s → ℕ) (hd : ∑ c, d c = s * k) :
    IsUnit (boxMatrix (PGen k inf x F lam Ur β) d).det := by
  sorry

/-- **`cor:tsk`**: for every ring homomorphism `ψ : R → ℤ/qℤ` (for `R = ℤ[1/D D']` it exists iff
`gcd(q, D D') = 1`, `away_hom`), the reduction of `𝒫^F_k` is a digital `(0,sk,s)`-net over `ℤ/qℤ`,
every `k ≥ 1` (one point in every cell). -/
theorem tsk_net {R : Type*} [CommRing R] {s q : ℕ} [NeZero q] (ψ : R →+* ZMod q) (k : ℕ)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R)
    (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R)
    (hres : Residual inf x F lam Ur) :
    IsNet0 s q (s * k) (digPoint q (s * k) fun c => (PGen k inf x F lam Ur β c).map ψ) := by
  sorry

/-- `ℤ[1/D] → ℤ/qℤ` exists when `gcd(q, D) = 1` (`def:Ns`). -/
theorem away_hom (q D : ℕ) (h : Nat.Coprime q D) :
    Nonempty (Localization.Away (D : ℤ) →+* ZMod q) := by
  sorry

/-- **`rem:projlines`, the frame** (the reversal symmetry of the two-dimensional Hammersley set, transported to every
pair of places). Let `m = 2r + 1`, let the differences of the finite places be units (`PlacesOK`), and let `a ≠ b`.
Digit `r` of the reading `b` of the frame of `s` places (`lem:Ts`) equals `g` times digit `r` of the reading `a` plus a
linear combination of the more significant digits `0, …, r-1` of both readings (`RowRel`) if and only if
`g = projSign inf a b r`, i.e. `+1` if one of the two places is `∞` and `(-1)^r` if both are finite. So the relation
exists and its coefficient is unique. Any `m = 2r + 1`; the paper's `m = sk` is the case used below. -/
theorem projlines_frame {R : Type*} [CommRing R] {s m r : ℕ} (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (hm : m = 2 * r + 1) {a b : Fin s} (hab : a ≠ b) (g : R) :
    RowRel (frameRead m inf x a) (frameRead m inf x b) r g ↔ g = (projSign inf a b r : R) := by
  sorry

/-- **`rem:projlines` for `𝒫^F_k`** (`def:Ns`, over the ring `R` of the places and of the residual solution). Let
`m = s k` be odd with `(s, k) ≠ (3, 1)` and `r* = (m - 1)/2`. For any two coordinates `a ≠ b`, digit `r*` of
coordinate `b` equals `g` times digit `r*` of coordinate `a` plus a linear combination of the more significant digits of
both coordinates iff `g = projSign inf a b r*`: `+1` if one of the two places is `∞`, `(-1)^{r*}` otherwise. (The
lower-triangular scrambles of `cor:tsk` keep the frame's relation, as `r* ≥ k + 1`.) Any `β`; no hypothesis on the
diagonal of the design. -/
theorem projlines {R : Type*} [CommRing R] {s k : ℕ} (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x)
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (Ur β : Fin s → ℕ → ℕ → R)
    (hres : Residual inf x F lam Ur) (hodd : Odd (s * k)) (hsk : (s, k) ≠ (3, 1)) {a b : Fin s}
    (hab : a ≠ b) (g : R) :
    RowRel (PGen k inf x F lam Ur β a) (PGen k inf x F lam Ur β b) ((s * k - 1) / 2) g ↔
      g = (projSign inf a b ((s * k - 1) / 2) : R) := by
  sorry

/-- **`rem:projlines` for the net `𝒫^F_{k,q}` over `ℤ/qℤ`** (the reduction of `𝒫^F_k` along any ring homomorphism
`ψ : R → ℤ/qℤ`, as in `tsk_net`): with `m = s k` odd, `(s, k) ≠ (3, 1)`, `r* = (m-1)/2` and `a ≠ b`, the relation
between digit `r*` of the coordinates `b` and `a` holds over `ℤ/qℤ` exactly for the coefficient `projSign inf a b r*`
(`+1` if one place is `∞`, `(-1)^{r*}` otherwise). -/
theorem projlines_zmod {R : Type*} [CommRing R] {s k q : ℕ} (ψ : R →+* ZMod q) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (Ur β : Fin s → ℕ → ℕ → R)
    (hres : Residual inf x F lam Ur) (hodd : Odd (s * k)) (hsk : (s, k) ≠ (3, 1)) {a b : Fin s}
    (hab : a ≠ b) (g : ZMod q) :
    RowRel ((PGen k inf x F lam Ur β a).map ψ) ((PGen k inf x F lam Ur β b).map ψ) ((s * k - 1) / 2) g ↔
      g = (projSign inf a b ((s * k - 1) / 2) : ZMod q) := by
  sorry

/-- **`rem:projlines`, the general lemma behind "up to a sign"**: for any digital point set over a commutative ring
with `m = 2r + 1` and two coordinates `a ≠ b`, if the box with depths `r + 1` at `a`, `r` at `b` (`pairDepth a b r`) and
the box with depths `r` at `a`, `r + 1` at `b` have unit determinants, then digit `r` of coordinate `b` is `g` times
digit `r` of coordinate `a` plus more significant digits of both, for a unique `g`, and `g` is a unit. (For a
`(0,m,s)`-net over `ℤ/qℤ` both boxes are units by `lem:nie`; what is specific to the frame nets is `g = ±1`.) -/
theorem projlines_box {R : Type*} [CommRing R] {s m : ℕ} (C : Fin s → Matrix (Fin m) (Fin m) R) {a b : Fin s}
    (hab : a ≠ b) {r : ℕ} (hm : m = 2 * r + 1) (h1 : IsUnit (boxMatrix C (pairDepth a b r)).det)
    (h2 : IsUnit (boxMatrix C (pairDepth b a r)).det) :
    ∃ g, IsUnit g ∧ RowRel (C a) (C b) r g ∧ ∀ g', RowRel (C a) (C b) r g' → g' = g := by
  sorry

/-- **`rem:projlines`, the remedy and `t`** (`eq:scr` for the diagonal scramble that rescales row `r`): rescaling row
`r` of every generator matrix `C_c` by `ρ_c` (`rowScale`) multiplies the box minor with depths `d` (`∑ d = m`) by the
product of the `ρ_c` over the coordinates with `r < d_c`. -/
theorem rowScale_box {R : Type*} [CommRing R] {s m : ℕ} (C : Fin s → Matrix (Fin m) (Fin m) R) (r : ℕ)
    (ρ : Fin s → R) (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    (boxMatrix (rowScale C r ρ) d).det = (∏ c, if r < d c then ρ c else 1) * (boxMatrix C d).det := by
  sorry

/-- **`rem:projlines`, the remedy keeps `t = 0`**: for units `ρ_c` of `ℤ/qℤ`, the digital point set with row `r` of
every generator matrix rescaled by `ρ_c` is a `(0,m,s)`-net iff the original one is (any generator matrices, any `r`). -/
theorem rowScale_net {s q m : ℕ} [NeZero q] (C : Fin s → Matrix (Fin m) (Fin m) (ZMod q)) (r : ℕ)
    (ρ : Fin s → ZMod q) (hρ : ∀ c, IsUnit (ρ c)) :
    IsNet0 s q m (digPoint q m (rowScale C r ρ)) ↔ IsNet0 s q m (digPoint q m C) := by
  sorry

/-- **`rem:projlines`, the remedy on `𝒫^F_{k,q}`** (with `cor:tsk`): rescaling any row `r` of the generator matrices of
`𝒫^F_{k,q}` by units `ρ_c` of `ℤ/qℤ` gives a digital `(0,sk,s)`-net. -/
theorem tsk_net_rowScale {R : Type*} [CommRing R] {s q : ℕ} [NeZero q] (ψ : R →+* ZMod q) (k : ℕ)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur β : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur) (r : ℕ) (ρ : Fin s → ZMod q)
    (hρ : ∀ c, IsUnit (ρ c)) :
    IsNet0 s q (s * k) (digPoint q (s * k) (rowScale (fun c => (PGen k inf x F lam Ur β c).map ψ) r ρ)) := by
  sorry

/-- **`rem:projlines`, the remedy's effect on the relation**: if digit `r` of `C_b` is `g` times digit `r` of `C_a` plus
more significant digits, then after rescaling row `r` by `ρ` (with `ρ_a` a unit) the coefficient is `ρ_b g ρ_a⁻¹`. -/
theorem rowScale_rowRel {R : Type*} [CommRing R] {s m : ℕ} (C : Fin s → Matrix (Fin m) (Fin m) R) (r : ℕ)
    (ρ : Fin s → R) {a b : Fin s} {g : R} (ha : IsUnit (ρ a)) (h : RowRel (C a) (C b) r g) :
    RowRel (rowScale C r ρ a) (rowScale C r ρ b) r (ρ b * g * Ring.inverse (ρ a)) := by
  sorry

/-- **`rem:projlines`, the remedy and `lem:Ss`**: the statement of `Ss_sep` (every `k ≥ 1`, (H1), (H2), the same bound)
for the graph form with row `r ≥ k + 1` of every generator matrix rescaled by arbitrary `ρ_c` (units are not needed
here; they are needed only for `t = 0`, `rowScale_net`). The rescaled point set is the graph form whose offset row
`r - k ≥ 1` of every block is rescaled, which keeps (H1) and (H2). -/
theorem Ss_sep_rowScale {s q k L : ℕ} [NeZero q] (hs : 2 ≤ s) (hq : 3 ≤ q) (hk : 1 ≤ k) (hL : 1 ≤ L)
    (hLk : L ≤ k) (F : ℕ → Fin s → Fin s → ℤ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (h1 : H1 F L Φ) (h2 : H2 Φ) (B : ℤ) (hBq : B ≤ (q : ℤ) ^ 2)
    (hB : ∀ e j, IsConfig k e j → B ≤ ∑ i, bval q F L e j i ^ 2) {r : ℕ} (hr : k + 1 ≤ r)
    (ρ : Fin s → ZMod q) (v w : Fin (s * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (2 * (s * k - k)) * B ≤ (q : ℤ) ^ 2 *
      (torusDist2 (q ^ (s * k))
        (digPoint q (s * k) (rowScale (graphGenK (m := s * k) (fun _ => k) Φ) r ρ) v)
        (digPoint q (s * k) (rowScale (graphGenK (m := s * k) (fun _ => k) Φ) r ρ) w) : ℤ) := by
  sorry

/-- **`rem:projlines`, the remedy and `prop:D`**: the statement of `D_sep` (`𝒫^F_{k,q}` of a dominant reachable design,
`q ≥ 5a + 4`, every `k ≥ 1`, the bound `δ ≥ (1 - a/q) N^(-1/s)`) for `𝒫^F_{k,q}` with row `r ≥ k + 1` of every
generator matrix rescaled by arbitrary `ρ_c`. -/
theorem D_sep_rowScale {R : Type*} [CommRing R] {s q a : ℕ} [NeZero q] (hs : 2 ≤ s) (ψ : R →+* ZMod q)
    (k : ℕ) (hk : 1 ≤ k) (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x)
    (F : ℕ → Fin s → Fin s → ℤ) (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R)
    (β : Fin s → ℕ → ℕ → R) (hres : Residual inf x (fun n c d => (F n c d : R)) lam Ur)
    (hβ : BetaRel inf x (fun n c d => (F n c d : R)) lam β)
    (α : Fin s → ℕ) (h0 : ∀ c, F 0 c c = -(α c : ℤ)) (hdiag : ∀ n c, 1 ≤ n → F n c c = 0)
    (hdom : ∀ c, ∑ d ∈ univ.filter (fun d => d ≠ c),
      (range (s - 1)).sup (fun j => (Msum F j c d).natAbs) ≤ α c)
    (ha : ∀ c, α c ≤ a) (hq : 5 * a + 4 ≤ q) {r : ℕ} (hr : k + 1 ≤ r) (ρ : Fin s → ZMod q)
    (v w : Fin (s * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (2 * (s * k - k)) * ((q : ℤ) - a) ^ 2 ≤ (q : ℤ) ^ 2 *
      (torusDist2 (q ^ (s * k))
        (digPoint q (s * k) (rowScale (fun c => (PGen k inf x (fun n c d => (F n c d : R)) lam Ur β c).map ψ) r ρ) v)
        (digPoint q (s * k) (rowScale (fun c => (PGen k inf x (fun n c d => (F n c d : R)) lam Ur β c).map ψ) r ρ) w) :
          ℤ) := by
  sorry

/-- **`prop:F`**, reachability: for `k ≥ s-1`, the off-diagonal part of the design is reachable
from the frame by column gauges `U_d` (lower triangular, unit diagonal) with row scalars
`λ'_c Q_c^(-k)` iff the residual problem is solvable with these `λ'`. -/
theorem F_reach_iff {R : Type*} [CommRing R] {s : ℕ} (hs : 2 ≤ s) (k : ℕ) (hk : s - 1 ≤ k)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R)
    (lam : Fin s → R) (hlam : ∀ c, IsUnit (lam c)) :
    (∃ U : Fin s → Matrix (Fin k) (Fin k) R, (∀ d i j, i < j → U d i j = 0) ∧
      (∀ d i, IsUnit (U d i i)) ∧ ∀ c d, c ≠ d → ∀ (r : Fin (s * k - k)), (r : ℕ) = 0 →
        ∀ j : Fin k, (Lmat k inf x lam c * frameGraph R k inf x c d * U d) r j =
          if k - 1 - (j : ℕ) < s - 1 then F (k - 1 - (j : ℕ)) c d else 0) ↔
    ∃ Ur : Fin s → ℕ → ℕ → R, Residual inf x F lam Ur := by
  sorry

/-- **`prop:F`**: the residual problem is solvable with the row scalars `λ'` iff for every column
`d` and every `j ≤ s-2`, `M^(j)[c][d] = λ'_c w_cd g_{d,j}(y_cd)` (`c ≠ d`) for a polynomial
`g_{d,j}` of degree `j` with unit leading coefficient. -/
theorem F_poly_iff {R : Type*} [CommRing R] [Nontrivial R] {s : ℕ} (inf : Fin s) (x : Fin s → R)
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (hlam : ∀ c, IsUnit (lam c)) :
    (∃ Ur : Fin s → ℕ → ℕ → R, Residual inf x F lam Ur) ↔
      ∀ d : Fin s, ∀ j, j < s - 1 → ∃ g : Polynomial R, g.natDegree = j ∧
        IsUnit g.leadingCoeff ∧ ∀ c, c ≠ d →
          Msum F j c d = lam c * wN inf x c d * g.eval (yN inf x c d) := by
  sorry

/-- **`prop:F`**, finite `c, d`: `λ'_c w_cd g(y_cd) = λ'_c h(z_cd)` with `z_cd = 1/(a_c - a_d)` and
`h = z g`, of degree `j + 1` without constant term. -/
theorem F_finite {R : Type*} [CommRing R] [Nontrivial R] {s : ℕ} (inf : Fin s) (x : Fin s → R)
    (lam : Fin s → R) (c d : Fin s) (hc : c ≠ inf) (hd : d ≠ inf) (g : Polynomial R) (j : ℕ)
    (hg : g.natDegree = j) (hgu : IsUnit g.leadingCoeff) :
    lam c * wN inf x c d * g.eval (yN inf x c d) =
        lam c * (Polynomial.X * g).eval (Ring.inverse (x c - x d)) ∧
      (Polynomial.X * g).natDegree = j + 1 ∧ (Polynomial.X * g).coeff 0 = 0 := by
  sorry

/-- **`lem:CH`(C)**, ring identity: for distinct `c, d, e`, `W_cd W_de W_ec = -W_dc W_ed W_ce`. -/
theorem CH_C {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R)
    (h : CauchyOK α β lam mu) (c d e : ι) (hcd : c ≠ d) (hde : d ≠ e) (hce : c ≠ e) :
    cauchyW α β lam mu c d * cauchyW α β lam mu d e * cauchyW α β lam mu e c =
      -(cauchyW α β lam mu d c * cauchyW α β lam mu e d * cauchyW α β lam mu c e) := by
  sorry

/-- **`lem:CH`(C)** over an ordered field: `π_cd π_de π_ec < 0` for distinct `c, d, e`. -/
theorem CH_C_neg {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] {ι : Type*}
    (α β lam mu : ι → K) (h : CauchyOK α β lam mu) (c d e : ι) (hcd : c ≠ d) (hde : d ≠ e)
    (hce : c ≠ e) :
    cauchyPi α β lam mu c d * cauchyPi α β lam mu d e * cauchyPi α β lam mu e c < 0 := by
  sorry

/-- **`lem:CH`(C)** over an ordered field: "`c ∼ d` iff `π_cd < 0`" (with `c ∼ c`) is an
equivalence relation with at most two classes (of any three coordinates, two are equivalent). -/
theorem CH_C_classes {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] {ι : Type*}
    (α β lam mu : ι → K) (h : CauchyOK α β lam mu) :
    Equivalence (fun c d : ι => c = d ∨ cauchyPi α β lam mu c d < 0) ∧
      ∀ c d e : ι, (c = d ∨ cauchyPi α β lam mu c d < 0) ∨ (d = e ∨ cauchyPi α β lam mu d e < 0) ∨
        (c = e ∨ cauchyPi α β lam mu c e < 0) := by
  sorry

/-- **`lem:CH`(P)**: for distinct `a, b, c, d`, `χ - ψ = 1`, `χ² = π_ab π_cd / (π_ac π_bd)`,
`ψ² = π_ab π_cd / (π_ad π_bc)`, and `(χ² - ψ² - 1)² = 4ψ²`. -/
theorem CH_P {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R)
    (h : CauchyOK α β lam mu) (a b c d : ι) (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    chiCH α β a b c d - psiCH α β a b c d = 1 ∧
      chiCH α β a b c d ^ 2 = cauchyPi α β lam mu a b * cauchyPi α β lam mu c d *
        Ring.inverse (cauchyPi α β lam mu a c * cauchyPi α β lam mu b d) ∧
      psiCH α β a b c d ^ 2 = cauchyPi α β lam mu a b * cauchyPi α β lam mu c d *
        Ring.inverse (cauchyPi α β lam mu a d * cauchyPi α β lam mu b c) ∧
      (chiCH α β a b c d ^ 2 - psiCH α β a b c d ^ 2 - 1) ^ 2 = 4 * psiCH α β a b c d ^ 2 := by
  sorry

/-- **`lem:CH`(H)** (`R ⊆ ℝ`): for distinct `i, j, k, l`, the largest of
`|π_ij π_kl|^(-1/2)`, `|π_ik π_jl|^(-1/2)`, `|π_il π_jk|^(-1/2)` is the sum of the other two (the
three numbers are positive, and one of them is the sum of the other two). -/
theorem CH_H {ι : Type*} (α β lam mu : ι → ℝ) (h : CauchyOK α β lam mu) (i j k l : ι)
    (hij : i ≠ j) (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l) :
    0 < 1 / Real.sqrt |cauchyPi α β lam mu i j * cauchyPi α β lam mu k l| ∧
      0 < 1 / Real.sqrt |cauchyPi α β lam mu i k * cauchyPi α β lam mu j l| ∧
      0 < 1 / Real.sqrt |cauchyPi α β lam mu i l * cauchyPi α β lam mu j k| ∧
      (1 / Real.sqrt |cauchyPi α β lam mu i j * cauchyPi α β lam mu k l| =
          1 / Real.sqrt |cauchyPi α β lam mu i k * cauchyPi α β lam mu j l| +
            1 / Real.sqrt |cauchyPi α β lam mu i l * cauchyPi α β lam mu j k| ∨
        1 / Real.sqrt |cauchyPi α β lam mu i k * cauchyPi α β lam mu j l| =
          1 / Real.sqrt |cauchyPi α β lam mu i j * cauchyPi α β lam mu k l| +
            1 / Real.sqrt |cauchyPi α β lam mu i l * cauchyPi α β lam mu j k| ∨
        1 / Real.sqrt |cauchyPi α β lam mu i l * cauchyPi α β lam mu j k| =
          1 / Real.sqrt |cauchyPi α β lam mu i j * cauchyPi α β lam mu k l| +
            1 / Real.sqrt |cauchyPi α β lam mu i k * cauchyPi α β lam mu j l|) := by
  sorry

/-- **`lem:CH`(X)**: for distinct `i, j, l, d`,
`W_ji W_ld / (W_jd W_li) + W_ij W_ld / (W_id W_lj) = 1`. -/
theorem CH_X {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R)
    (h : CauchyOK α β lam mu) (i j l d : ι) (hij : i ≠ j) (hil : i ≠ l) (hid : i ≠ d)
    (hjl : j ≠ l) (hjd : j ≠ d) (hld : l ≠ d) :
    cauchyW α β lam mu j i * cauchyW α β lam mu l d *
        Ring.inverse (cauchyW α β lam mu j d * cauchyW α β lam mu l i) +
      cauchyW α β lam mu i j * cauchyW α β lam mu l d *
        Ring.inverse (cauchyW α β lam mu i d * cauchyW α β lam mu l j) = 1 := by
  sorry

end Z3NetF

namespace Z3Net

open Matrix

/-- **`prop:faure`**, `Λ_m` is lower unitriangular. -/
theorem faure_Lam (m : ℕ) : (∀ i, LamF m i i = 1) ∧ ∀ i j, i < j → LamF m i j = 0 := by
  sorry

/-- **`prop:faure`**: `τ = Λ_m P`. -/
theorem faure_tau (m : ℕ) (hm : 1 ≤ m) : tau m = LamF m * pascalP m := by
  sorry

/-- **`prop:faure`**: `τ² = D_± J P`. -/
theorem faure_tau2 (m : ℕ) (hm : 1 ≤ m) : tau m ^ 2 = Dpm m * Jrev m * pascalP m := by
  sorry

/-- **`prop:faure`**, the re-indexing `v ↦ D_± P v` is an involution: `(D_± P)² = I` (so the
re-indexed generator matrices are `C_c (D_± P)⁻¹ = C_c D_± P`). -/
theorem faure_DP (m : ℕ) : (Dpm m * pascalP m) * (Dpm m * pascalP m) = 1 := by
  sorry

/-- **`prop:faure`, consequence.** For `m = 3k` and any `L` (lower triangular in the paper), the
net `(L T², L, L T)` re-indexed by `v ↦ D_± P v` has generator matrices
`((-1)^(m-1) L J, (L D_±) P, (s_k L Λ_m D_±) I)`, `s_k = (-1)^(k+1)`: the Hammersley net (`J`) of
the generalized Faure sequence `(A_1, A_2 P)` with `A_1 = s_k L Λ_m D_±`, `A_2 = L D_±`. -/
theorem faure_reindex (k : ℕ) (hk : 1 ≤ k) (L : Matrix (Fin (3 * k)) (Fin (3 * k)) ℤ) :
    L * T k ^ 2 * (Dpm (3 * k) * pascalP (3 * k)) = (-1 : ℤ) ^ (3 * k - 1) • (L * Jrev (3 * k)) ∧
      L * (Dpm (3 * k) * pascalP (3 * k)) = L * Dpm (3 * k) * pascalP (3 * k) ∧
      L * T k * (Dpm (3 * k) * pascalP (3 * k)) =
        (-1 : ℤ) ^ (k + 1) • (L * LamF (3 * k) * Dpm (3 * k)) := by
  sorry

/-- **`rem:projlines` for `𝒫_{k,q}`** (`def:net`; "up to a sign"): for `k` odd, `r* = (3k - 1)/2` and two coordinates
`a ≠ b`, there is an integer sign `g = ±1`, the same for every base `q`, such that over every `ℤ/qℤ` digit `r*` of
coordinate `b` is `g'` times digit `r*` of coordinate `a` plus more significant digits of both iff `g' = g`. (The box
minors `±1` of `thm:t0` and `projlines_box`; the value of `g` is computed, not stated. Any odd `k ≥ 1`.) -/
theorem projlines_P (k : ℕ) (hk : Odd k) {a b : Fin 3} (hab : a ≠ b) :
    ∃ g : ℤ, (g = 1 ∨ g = -1) ∧ ∀ (q : ℕ) (g' : ZMod q),
      Z3NetF.RowRel ((PGen k a).map (Int.cast : ℤ → ZMod q)) ((PGen k b).map (Int.cast : ℤ → ZMod q))
        ((3 * k - 1) / 2) g' ↔ g' = g := by
  sorry

/-- **`rem:projlines`, the remedy on `𝒫_{k,q}`** (with `thm:t0`): rescaling any row `r` of the three generator matrices
of `𝒫_{k,q}` by units `ρ_c` of `ℤ/qℤ` gives a digital `(0,3k,3)`-net (every `k ≥ 1`, every `q ≥ 1`). -/
theorem P_net_rowScale (q : ℕ) [NeZero q] (k : ℕ) (hk : 1 ≤ k) (r : ℕ) (ρ : Fin 3 → ZMod q)
    (hρ : ∀ c, IsUnit (ρ c)) :
    Z3NetF.IsNet0 3 q (3 * k) (Z3NetF.digPoint q (3 * k)
      (Z3NetF.rowScale (fun c => (PGen k c).map (Int.cast : ℤ → ZMod q)) r ρ)) := by
  sorry

/-- **`rem:projlines`, the remedy and `thm:sep`**: the statement of `P_sep` (`q ≥ 4`, `k ≥ 2`, exact integer form,
`δ ≥ c(q) N^(-1/3)`) for `𝒫_{k,q}` with row `r ≥ k + 1` of each of the three generator matrices multiplied by an
arbitrary `ρ_c ∈ ℤ/qℤ` (the proof of `thm:sep` uses the digits below the geometric digit only through `prop:cell`(b),
which the rescaling keeps). -/
theorem P_sep_rowScale (q k r : ℕ) (hq : 4 ≤ q) (hk : 2 ≤ k) (hr : k + 1 ≤ r) (ρ : Fin 3 → ZMod q)
    (v w : Fin (3 * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (4 * k) *
        min (((q : ℤ) - 1) ^ 2) (min (((q : ℤ) - 2) ^ 2 + ((q : ℤ) - 4) ^ 2) (3 * ((q : ℤ) - 3) ^ 2))
      ≤ (q : ℤ) ^ 2 * (torusDist2 (q ^ (3 * k))
          (digPoint q (3 * k) (Z3NetF.rowScale (fun c => (PGen k c).map (Int.cast : ℤ → ZMod q)) r ρ) v)
          (digPoint q (3 * k) (Z3NetF.rowScale (fun c => (PGen k c).map (Int.cast : ℤ → ZMod q)) r ρ) w) :
            ℤ) := by
  sorry

end Z3Net

namespace Z3NetU

open Matrix Finset

/-- **Frame box minors** (Lemma T_s, exact value: the confluent Vandermonde determinant). For
every `s ≥ 1`, `m` and composition `d` of `m`, the box minor of the frame (rows: the top `d 0`
coefficients for `∞`, the first `d c` Taylor coefficients at `a_c = c - 1` for `c ≥ 1`) is
`± ∏_{0 < c' < c} (a_c - a_c')^(d_c' d_c)` (the factors are `1, …, s-2`). Consequently all box
minors are units mod `q` iff every prime factor of `q` is `≥ s - 1` (`s ≥ 3`, `m ≥ 2`; for the
converse take `d_1 = d_(p+1) = 1`); this consequence is not separately formalized. -/
theorem U_frameMinor (s m : ℕ) (hs : 1 ≤ s) (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    (boxMatrix (frameGen (s := s) m) d).det = ∏ c : Fin s, ∏ c' : Fin s,
        (if 0 < (c' : ℕ) ∧ c' < c then ((c : ℤ) - c') ^ (d c' * d c) else 1) ∨
      (boxMatrix (frameGen (s := s) m) d).det = -∏ c : Fin s, ∏ c' : Fin s,
        (if 0 < (c' : ℕ) ∧ c' < c then ((c : ℤ) - c') ^ (d c' * d c) else 1) := by
  sorry

/-- **Proposition N_s** in the `E`-basis (faithfulness of `Ψ`): over `ℚ`, for `c ≠ d` and every
`k ≥ 1`, `Q_c^(-k) Ψ_cd[0, j] = w_cd y_cd^(k-1-j)` (the Cauchy kernel). -/
theorem U_propN (s : ℕ) (hs : 3 ≤ s) (k : ℕ) (hk : 1 ≤ k) (c d : Fin s) (hcd : c ≠ d)
    (r : Fin (s * k - k)) (hr : (r : ℕ) = 0) (j : Fin k) :
    Qinv (fun i => ((i : ℕ) : ℚ)⁻¹) k c * (Psi k c d r j : ℚ) =
      wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ (k - 1 - (j : ℕ)) := by
  sorry

/-- **Proposition G_s**, the defining relation of `γ_n` (`n ≥ s-1`): over `ℚ`, for every `c ≠ d`,
`w_cd y_cd^n = ∑_{i < s-1} γ_{n,i} w_cd y_cd^i`. (The `s-1` nodes `y_cd`, `c ≠ d`, are distinct,
so this determines `γ_n`; and `γ_n = U'_d β_n` for the `β_n` of the note.) -/
theorem U_propG (s : ℕ) (hs : 3 ≤ s) (c d : Fin s) (hcd : c ≠ d) (n : ℕ) (hn : s - 1 ≤ n) :
    wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ n =
      ∑ i ∈ range (s - 1), gam (fun i => ((i : ℕ) : ℚ)⁻¹) d n i *
        (wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ i) := by
  sorry

/-- **Proposition G_s, uniqueness.** Over `ℚ`, `γ_n` is the only coefficient vector with the
defining relation of `U_propG` (the `s-1` nodes `y_cd`, `c ≠ d`, are distinct). Hence the gauge
column `e_n - γ_n` is exactly the note's `e_n - ∑_i β_{n,i} (column i of U'_d)`, whose `β_n` solves
`λ' ⊙ v_n = ∑_i β_{n,i} F_i[·][d]` (that relation says `γ := U'_d β_n` satisfies the relation). -/
theorem U_gam_unique (s : ℕ) (hs : 3 ≤ s) (d : Fin s) (n : ℕ) (g : ℕ → ℚ)
    (hg : ∀ c : Fin s, c ≠ d → ∑ i ∈ range (s - 1), g i *
      (wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ i) =
        wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ n) :
    ∀ i < s - 1, g i = gam (fun i => ((i : ℕ) : ℚ)⁻¹) d n i := by
  sorry

/-- **Definition N_s, literally.** Over `ℚ` (entries in `ℤ[1/(s-2)!]`), every off-diagonal block of
the Challenge net is `Φ'_cd = L_c Φ^F_cd U_d` with the raw frame graph form `Φ^F` (Mathlib
inverse of the frame's `(k,…,k)` box matrix), `L_c = diag(λ'_c Q_c^(-k), 1, …, 1)` and
`U_d = Q_d^k Toep(g_d) U'^(k)_d`; every `k ≥ 1`. -/
theorem U_defN (s k : ℕ) (hs : 3 ≤ s) (hk : 1 ≤ k) (c d : Fin s) (hcd : c ≠ d)
    (r : Fin (s * k - k)) (l : Fin k) :
    UPhi ℚ (fun i => ((i : ℕ) : ℚ)⁻¹) k c d r l =
      (if (r : ℕ) = 0 then (lamRes c : ℚ) * (Qval c ^ k)⁻¹ else 1) * (frameGraph k c d * Ulit k d) r l := by
  sorry

/-- **The design is reachable** (Proposition F with `λ'`, `U'`): over `ℚ`, for `c ≠ d` and
`n < s - 1`, `F_n[c][d] = λ'_c ∑_{n' ≤ n} w_cd y_cd^(n') U'_d[n', n]`. -/
theorem U_design (s : ℕ) (hs : 3 ≤ s) (c d : Fin s) (hcd : c ≠ d) (n : ℕ) (hn : n < s - 1) :
    (Fdes s n c d : ℚ) = (lamRes c : ℚ) * ∑ n' ∈ range (n + 1),
      wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ n' *
        Ures (fun i => ((i : ℕ) : ℚ)⁻¹) d n' n := by
  sorry

end Z3NetU

namespace Z3NetA

open Matrix Finset Z3NetF

/-- **`rem:projlines`, the remedy and `thm:A`(2)**: the statement of `A_sep` (`q ≥ 5 a*_s + 4` admissible, every
`k ≥ 1`, `δ ≥ (1 - a*_s/q) N^(-1/s)`) for `𝒫^{U*_s}_{k,q}` (generator matrices `AGen`) with row `r ≥ k + 1` of every
generator matrix rescaled by arbitrary `ρ_c` (the bound goes through `prop:D` and `lem:Ss`). -/
theorem A_sep_rowScale (s q k : ℕ) [NeZero s] (hs : 3 ≤ s) (hq : AdmBase s q) (hqa : 5 * aStar s + 4 ≤ q)
    (hk : 1 ≤ k) {r : ℕ} (hr : k + 1 ≤ r) (ρ : Fin s → ZMod q) (v w : Fin (s * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (2 * (s * k - k)) * ((q : ℤ) - aStar s) ^ 2 ≤
      (q : ℤ) ^ 2 * (torusDist2 (q ^ (s * k)) (digPoint q (s * k) (rowScale (AGen s q k) r ρ) v)
        (digPoint q (s * k) (rowScale (AGen s q k) r ρ) w) : ℤ) := by
  sorry

end Z3NetA
