/-- **(H1).** For admissible `q` and every `k ≥ 1`, row `0` of every block `Φ'_cd` of `𝒫^s_{k,q}`
is the design: level `j` carries `F_{k-1-j}[c][d]` (`0` for `k-1-j ≥ s-1`). -/
theorem U_row0 (s q k : ℕ) (hs : 3 ≤ s) (hq : Admissible s q) (hk : 1 ≤ k) (c d : Fin s)
    (r : Fin (s * k - k)) (hr : (r : ℕ) = 0) (j : Fin k) :
    UPhi (ZMod q) (fun i => ((i : ℕ) : ZMod q)⁻¹) k c d r j = ((Fdes s (k - 1 - (j : ℕ)) c d : ℤ) : ZMod q) := by
  sorry

