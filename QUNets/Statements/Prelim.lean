namespace Z3NetF

open Matrix Finset

/-- Paper, `sec:prelim`: if the box matrix `G` of a digital point set for the depths `K` is
invertible, the point set is a graph form in the cells `G v`: `C_c = graphGenK K Φ c · G`. -/
theorem graphForm_of_box {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (C : Fin s → Matrix (Fin m) (Fin m) R) (hG : IsUnit (boxMatrix C K).det) :
    ∃ Φ : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R,
      ∀ c, graphGenK K Φ c * boxMatrix C K = C c := by
  sorry

/-- **`lem:nie`**, one shape. Over a commutative ring `R` with `q` elements (digits read through
`e`), every elementary box with `d_c` digits in coordinate `c` contains exactly one point iff the
box minor for `d` is a unit of `R`. -/
theorem nie_box {R : Type*} [CommRing R] {q s m : ℕ} (e : R ≃ Fin q)
    (C : Fin s → Matrix (Fin m) (Fin m) R) (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    BoxExact e C d ↔ IsUnit (boxMatrix C d).det := by
  sorry

/-- **`lem:nie`**: `(0,m,s)`-net iff every box minor is a unit of `R`. -/
theorem nie_net {R : Type*} [CommRing R] {q s m : ℕ} (e : R ≃ Fin q)
    (C : Fin s → Matrix (Fin m) (Fin m) R) :
    IsNet0E e C ↔ ∀ d : Fin s → ℕ, ∑ c, d c = m → IsUnit (boxMatrix C d).det := by
  sorry

/-- **`lem:nie`** over a finite field: `(0,m,s)`-net iff every box minor is nonzero. -/
theorem nie_net_field {K : Type*} [Field K] {q s m : ℕ} (e : K ≃ Fin q)
    (C : Fin s → Matrix (Fin m) (Fin m) K) :
    IsNet0E e C ↔ ∀ d : Fin s → ℕ, ∑ c, d c = m → (boxMatrix C d).det ≠ 0 := by
  sorry

/-- **`lem:nie`** over `ℤ/qℤ` with the standard digits `ZMod.val`. -/
theorem nie_zmod {s q m : ℕ} [NeZero q] (C : Fin s → Matrix (Fin m) (Fin m) (ZMod q)) :
    IsNet0 s q m (digPoint q m C) ↔ ∀ d : Fin s → ℕ, ∑ c, d c = m → IsUnit (boxMatrix C d).det := by
  sorry

/-- **`lem:box`**: the box minor of a graph form for `d` equals, up to a sign that depends only
on `K` and `d`, the determinant of the reduced box matrix (top `d_c - K_c` offset rows of the
over coordinates on the last `K_e - d_e` levels of the under coordinates); such a squaring
bijection `σ` exists. In particular the diagonal blocks never enter. -/
theorem box_minor {R : Type*} [CommRing R] {s m : ℕ} (K d : Fin s → ℕ) (hK : ∑ c, K c = m)
    (hd : ∑ c, d c = m) :
    Nonempty (UnderCols K d ≃ OverRows K d) ∧
      ∀ σ : UnderCols K d ≃ OverRows K d, ∃ ε : R, (ε = 1 ∨ ε = -1) ∧
        ∀ Φ : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R,
          (boxMatrix (graphGenK K Φ) d).det = ε * (redBox K d Φ σ).det := by
  sorry

/-- **`lem:box`**: the box minor for `d = K` is `1`. -/
theorem box_minor_self {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (Φ : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R) :
    (boxMatrix (graphGenK K Φ) K).det = 1 := by
  sorry

/-- **`lem:box`**, gauge move (a): replacing the diagonal blocks does not change any box minor. -/
theorem gauge_diag {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (Φ Φ' : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R)
    (h : ∀ c d, c ≠ d → Φ' c d = Φ c d) (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    (boxMatrix (graphGenK K Φ') d).det = (boxMatrix (graphGenK K Φ) d).det := by
  sorry

/-- **`lem:box`**, gauge move (c) (with (a)): `Φ'_cd = L_c Φ_cd U_d` (`c ≠ d`, diagonal blocks
arbitrary) with `L_c`, `U_d` lower triangular with unit diagonal multiplies every box minor by a
unit of `R` that does not depend on `Φ`. -/
theorem gauge_LU {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (L : (c : Fin s) → Matrix (Fin (m - K c)) (Fin (m - K c)) R)
    (U : (d : Fin s) → Matrix (Fin (K d)) (Fin (K d)) R)
    (hL : ∀ c i j, i < j → L c i j = 0) (hLu : ∀ c i, IsUnit (L c i i))
    (hU : ∀ d i j, i < j → U d i j = 0) (hUu : ∀ d i, IsUnit (U d i i))
    (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    ∃ u : R, IsUnit u ∧ ∀ Φ Φ' : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R,
      (∀ c d, c ≠ d → Φ' c d = L c * Φ c d * U d) →
        (boxMatrix (graphGenK K Φ') d).det = u * (boxMatrix (graphGenK K Φ) d).det := by
  sorry

/-- **`lem:box`**, gauge move (b), `s = 3`: block scalings `Φ'_cd = μ_cd Φ_cd` (`c ≠ d`, units
`μ_cd`) multiply every box minor by a unit of `R` that does not depend on `Φ`. -/
theorem gauge_scale3 {R : Type*} [CommRing R] {m : ℕ} (K : Fin 3 → ℕ) (hK : ∑ c, K c = m)
    (μ : Fin 3 → Fin 3 → R) (hμ : ∀ c d, c ≠ d → IsUnit (μ c d))
    (d : Fin 3 → ℕ) (hd : ∑ c, d c = m) :
    ∃ u : R, IsUnit u ∧ ∀ Φ Φ' : (c d : Fin 3) → Matrix (Fin (m - K c)) (Fin (K d)) R,
      (∀ c d, c ≠ d → Φ' c d = μ c d • Φ c d) →
        (boxMatrix (graphGenK K Φ') d).det = u * (boxMatrix (graphGenK K Φ) d).det := by
  sorry

/-- **`lem:box`**, consequence: the moves (a) and (c) map `(0,m,s)`-nets over a finite
commutative ring (`ℤ/qℤ`, `𝔽_q`, …) to `(0,m,s)`-nets. -/
theorem gauge_net {R : Type*} [CommRing R] {q s m : ℕ} (e : R ≃ Fin q) (K : Fin s → ℕ)
    (hK : ∑ c, K c = m)
    (L : (c : Fin s) → Matrix (Fin (m - K c)) (Fin (m - K c)) R)
    (U : (d : Fin s) → Matrix (Fin (K d)) (Fin (K d)) R)
    (hL : ∀ c i j, i < j → L c i j = 0) (hLu : ∀ c i, IsUnit (L c i i))
    (hU : ∀ d i j, i < j → U d i j = 0) (hUu : ∀ d i, IsUnit (U d i i))
    (Φ Φ' : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R)
    (h : ∀ c d, c ≠ d → Φ' c d = L c * Φ c d * U d) :
    IsNet0E e (graphGenK K Φ) → IsNet0E e (graphGenK K Φ') := by
  sorry

/-- **`lem:box`**, consequence for `s = 3`: block scalings map `(0,m,3)`-nets to `(0,m,3)`-nets. -/
theorem gauge_net3 {R : Type*} [CommRing R] {q m : ℕ} (e : R ≃ Fin q) (K : Fin 3 → ℕ)
    (hK : ∑ c, K c = m) (μ : Fin 3 → Fin 3 → R) (hμ : ∀ c d, c ≠ d → IsUnit (μ c d))
    (Φ Φ' : (c d : Fin 3) → Matrix (Fin (m - K c)) (Fin (K d)) R)
    (h : ∀ c d, c ≠ d → Φ' c d = μ c d • Φ c d) :
    IsNet0E e (graphGenK K Φ) → IsNet0E e (graphGenK K Φ') := by
  sorry

/-- **`lem:Ss`**, the coordinate bounds, every `k ≥ 1`. Let a digital net over `ℤ/qℤ` be in graph form
with depths `(k, …, k)` satisfying (H1), (H2), and let the cells of `w` be the toroidal neighbours
`n + e` of those of `v`, with carry lengths `j`. Then `q |Δ_i| ≥ b_i` for every `i`, where
`q^(m-k) Δ_i = e_i q^(m-k) + (X_i(w) mod q^(m-k)) - (X_i(v) mod q^(m-k))` (cell units). -/
theorem Ss_coord {s q k L : ℕ} [NeZero q] (hs : 2 ≤ s) (hq : 3 ≤ q) (hk : 1 ≤ k) (hL : 1 ≤ L) (hLk : L ≤ k)
    (F : ℕ → Fin s → Fin s → ℤ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (h1 : H1 F L Φ) (h2 : H2 Φ) (v w : Fin (s * k) → ZMod q) (e : Fin s → ℤ)
    (he : ∀ d, -1 ≤ e d ∧ e d ≤ 1)
    (hcell : ∀ d, ((digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) w d /
        q ^ (s * k - k) : ℕ) : ℤ) = ((digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) v d /
        q ^ (s * k - k) : ℕ) + e d) % (q ^ k : ℕ))
    (i : Fin s) :
    bval q F L e (fun d => carryLen q k (digPoint q (s * k) (graphGenK (m := s * k)
        (fun _ => k) Φ) v d / q ^ (s * k - k)) (e d)) i * (q ^ (s * k - k) : ℕ) ≤
      (q : ℤ) * |e i * (q ^ (s * k - k) : ℕ) +
        ((digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) w i % q ^ (s * k - k) : ℕ) : ℤ) -
        ((digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) v i % q ^ (s * k - k) : ℕ) : ℤ)| := by
  sorry

/-- **`lem:Ss`**, the separation, every `k ≥ 1` (at `k = 1` the torus has period `q ≥ 3` cells; the
toroidal case split of the proof): `δ q^k ≥ LB = min(1, min_{e,j} (∑_i b_i²)^(1/2)/q)`, in the
integer form: for every `B ≤ q²` with `B ≤ ∑_i b_i²` for all steps `(e, j)`,
`q^(2(m-k)) B ≤ q² D²` for any two distinct points (`D²` the squared toroidal distance times
`N²`, `N = q^m`, `m = s k`). -/
theorem Ss_sep {s q k L : ℕ} [NeZero q] (hs : 2 ≤ s) (hq : 3 ≤ q) (hk : 1 ≤ k) (hL : 1 ≤ L) (hLk : L ≤ k)
    (F : ℕ → Fin s → Fin s → ℤ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (h1 : H1 F L Φ) (h2 : H2 Φ) (B : ℤ) (hBq : B ≤ (q : ℤ) ^ 2)
    (hB : ∀ e j, IsConfig k e j → B ≤ ∑ i, bval q F L e j i ^ 2)
    (v w : Fin (s * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (2 * (s * k - k)) * B ≤ (q : ℤ) ^ 2 *
      (torusDist2 (q ^ (s * k)) (digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) v)
        (digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) w) : ℤ) := by
  sorry

/-- **`rem:K`**, the degenerate case: if some own partial sum `M^(j)[a][a]` (`j < L`) is positive,
or some multi-axis step has no backward coordinate, then `LB = O(1/q)`. -/
theorem remK_bad {s L k : ℕ} (hL : 1 ≤ L) (hLk : L ≤ k) (F : ℕ → Fin s → Fin s → ℤ)
    (hbad : (∃ a, ∃ j < L, 0 < Msum F j a a) ∨
      ∃ e j, IsConfig k e j ∧ 2 ≤ (moving e).card ∧ ∀ i, e i ≠ 0 → 0 < e i * sigma F L e j i) :
    ∃ C : ℝ, ∀ q : ℕ, 1 ≤ q → LBval q F L k ≤ C / q := by
  sorry

/-- **`rem:K`**, the first-order expansion: otherwise (every own partial sum is `≤ 0` and every
multi-axis step has a backward coordinate) `LB = 1 - K/q + O(q⁻²)`, with `K = Kexp F L k`. -/
theorem remK_good {s L k : ℕ} (hs : 1 ≤ s) (hL : 1 ≤ L) (hLk : L ≤ k) (F : ℕ → Fin s → Fin s → ℤ)
    (hown : ∀ a, ∀ j < L, Msum F j a a ≤ 0)
    (hmulti : ∀ e j, IsConfig k e j → 2 ≤ (moving e).card → ∃ i, e i ≠ 0 ∧ e i * sigma F L e j i ≤ 0) :
    ∃ C : ℝ, ∃ q₀ : ℕ, ∀ q : ℕ, q₀ ≤ q →
      1 - (Kexp F L k : ℝ) / q ≤ LBval q F L k ∧
        LBval q F L k ≤ 1 - (Kexp F L k : ℝ) / q + C / (q : ℝ) ^ 2 := by
  sorry

/-- **`def:dshift`**: the digitally shifted digital point set `P ⊕ τ` (`digPointShift`: the digits `C_c v + τ_c`
of the point with index `v`, added digit by digit modulo `q` without carries) is the shift `dshiftPt q m τ`
of the points of `P`, where the digits of an integer coordinate `x ∈ [0, q^m)` are read off `x`
(`⌊x/q^(m-1-j)⌋ mod q`, digit `0` most significant). -/
theorem digPointShift_eq_dshiftPt {s q m : ℕ} [NeZero q] (C : Fin s → Matrix (Fin m) (Fin m) (ZMod q))
    (τ : Fin s → Fin m → ZMod q) (v : Fin m → ZMod q) :
    digPointShift q m C τ v = dshiftPt q m τ (digPoint q m C v) := by
  sorry

/-- **`def:dshift`**: a digital net is the unshifted (`τ = 0`) digitally shifted net. -/
theorem digPointShift_zero {s q m : ℕ} (C : Fin s → Matrix (Fin m) (Fin m) (ZMod q)) :
    digPointShift q m C 0 = digPoint q m C := by
  sorry

end Z3NetF

namespace Z3NetU

