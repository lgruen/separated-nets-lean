/-- **Parameters of `prop:twocoset`.**  For a prime `p ≥ 5`: `θ = 8r − p ∈ {±1, ±3}`; `r` is
the integer nearest to `p/8` (`|8r − p| ≤ |8r' − p|` for every integer `r'`); `2h = −1` in `𝔽_p`;
and `1 ≤ r < p`. -/
theorem TC_params (p : ℕ) (hp : p.Prime) (hp5 : 5 ≤ p) :
    (thetaTC p = -3 ∨ thetaTC p = -1 ∨ thetaTC p = 1 ∨ thetaTC p = 3) ∧
    (∀ r' : ℤ, |thetaTC p| ≤ |8 * r' - p|) ∧ 2 * hTC p = -1 ∧ 1 ≤ rTC p ∧ rTC p < p := by
  exact tc_params' hp hp5

/-- **`prop:twocoset` (1), one point per cell.**  For every prime `p ≥ 5` (including
`p = 23`) every cell of side `p⁻¹` (the box with one digit in each coordinate) holds exactly one
point of `𝒯_p`. -/
theorem TC_cells (p : ℕ) (hp : p.Prime) (hp5 : 5 ≤ p) (b : Fin 3 → ℕ) (hb : ∀ c, b c < p) :
    ∃! x : ℕ, x < p ^ 3 ∧ ∀ c, digitalPt p (genTC p) x c / p ^ 2 = b c := by
  exact tc_cells hp hp5 b hb

/-- **`prop:twocoset` (1).**  For a prime `p ≥ 5`, `𝒯_p` is a `(0,3,3)`-net in base `p` if and
only if `p ≠ 23`. -/
theorem TC_net (p : ℕ) (hp : p.Prime) (hp5 : 5 ≤ p) :
    IsDigitalNet033 p (genTC p) ↔ p ≠ 23 := by
  exact ⟨fun h h23 => tc_not_net23 (h23 ▸ h), tc_net hp hp5⟩

/-- **`prop:twocoset` (2) for arbitrary jitter.**  Let `p ≥ 41` be prime.  Place one point in each
cell `n ∈ [0,p)³` at `p²n + p·g(n) + f(n)` (integer scale `p³`), with geometric digits
`g(n) ∈ [0,p)³`, `g_x(n) ≡ h(n_y + n_z)`, `g_y(n) ≡ r n_x − n_y + n_z (mod p)`, `g_z(n) = g_y(n)`
(the `y`- and `z`-digits are shared, so they wrap together), and arbitrary third digits
`f(n) ∈ [0,p)³`.  Then for distinct cells `n ≠ n'` and every torus translate `p³·t`, the
squared length of the difference is at least `(p²(√(33/32 − 41/(16p)) − √3/p))²`. -/
theorem TC_freeJitter (p : ℕ) (hp : p.Prime) (hp41 : 41 ≤ p) (g f : (Fin 3 → ℕ) → Fin 3 → ℕ)
    (hg : ∀ n : Fin 3 → ℕ, (∀ c, n c < p) → ∀ c, g n c < p)
    (hgx : ∀ n : Fin 3 → ℕ, (∀ c, n c < p) →
      ((g n 0 : ℕ) : ZMod p) = hTC p * ((n 1 : ZMod p) + (n 2 : ZMod p)))
    (hgy : ∀ n : Fin 3 → ℕ, (∀ c, n c < p) →
      ((g n 1 : ℕ) : ZMod p) = (rTC p : ZMod p) * (n 0 : ZMod p) - (n 1 : ZMod p) + (n 2 : ZMod p))
    (hgz : ∀ n : Fin 3 → ℕ, (∀ c, n c < p) → g n 2 = g n 1)
    (hf : ∀ n : Fin 3 → ℕ, (∀ c, n c < p) → ∀ c, f n c < p)
    (n n' : Fin 3 → ℕ) (hn : ∀ c, n c < p) (hn' : ∀ c, n' c < p) (hne : n ≠ n')
    (t : Fin 3 → ℤ) :
    ((p : ℝ) ^ 2 * (Real.sqrt (33 / 32 - 41 / (16 * (p : ℝ))) - Real.sqrt 3 / p)) ^ 2 ≤
      ∑ c : Fin 3, ((((p : ℤ) ^ 2 * ((n' c : ℤ) - n c) + p * ((g n' c : ℤ) - g n c)
        + ((f n' c : ℤ) - f n c) + (p : ℤ) ^ 3 * t c : ℤ)) : ℝ) ^ 2 := by
  exact tc_freeJitter' hp hp41 g f hg hgx hgy hgz hf n n' hn hn' hne t

/-- **`prop:twocoset` (2), integer scale.**  For every prime `p ≥ 41`, every pair of distinct
points of `𝒯_p` and every torus translate `p³·t`, the squared length of the difference is at
least `(p²(√(33/32 − 41/(16p)) − √3/p))²`. -/
theorem TC_sep (p : ℕ) (hp : p.Prime) (hp41 : 41 ≤ p) (x x' : ℕ) (hx : x < p ^ 3)
    (hx' : x' < p ^ 3) (hne : x ≠ x') (t : Fin 3 → ℤ) :
    ((p : ℝ) ^ 2 * (Real.sqrt (33 / 32 - 41 / (16 * (p : ℝ))) - Real.sqrt 3 / p)) ^ 2 ≤
      (sepSqG p (genTC p) x x' t : ℝ) := by
  exact tc_sep' hp hp41 x x' hx hx' hne t

/-- **`prop:twocoset` (2), normalized.**  For every prime `p ≥ 41`: `0 < c(p)` and, for every
pair of distinct points and every torus translate, the distance in the unit torus times
`N^{1/3}` (`N = p³`) is at least `c(p) = √(33/32 − 41/(16p)) − √3/p`. -/
theorem TC_sep_real (p : ℕ) (hp : p.Prime) (hp41 : 41 ≤ p) :
    0 < cTC p ∧ ∀ x x' : ℕ, x < p ^ 3 → x' < p ^ 3 → x ≠ x' → ∀ t : Fin 3 → ℤ,
      cTC p ≤ Real.sqrt (sepSqG p (genTC p) x x' t : ℝ) / (p : ℝ) ^ 3 *
        ((p : ℝ) ^ 3) ^ ((1 : ℝ) / 3) := by
  exact tc_sep_real' hp hp41

/-- **`prop:twocoset` (2), the bound.**  `c(p) = √(33/32 − 41/(16p)) − √3/p` increases with `p`
(`p ≥ 41`); it exceeds `√66/8 − 3.014/p` for `p ≥ 83` and `1` for `p ≥ 197`; `c(197) = 1.0002…`
and `c(193) < 1`. -/
theorem TC_bound :
    (∀ p p' : ℕ, 41 ≤ p → p ≤ p' → cTC p ≤ cTC p') ∧
    (∀ p : ℕ, 83 ≤ p → Real.sqrt 66 / 8 - 3.014 / p < cTC p) ∧
    (∀ p : ℕ, 197 ≤ p → 1 < cTC p) ∧
    1.0002 < cTC 197 ∧ cTC 197 < 1.0003 ∧ cTC 193 < 1 := by
  exact ⟨fun _ _ h h' => cTC_mono h h', fun _ h => cTC_ge83 h, fun _ h => cTC_gt1 h, cTC_197.1,
    cTC_197.2, cTC_193⟩

/-- **`prop:twocoset` (3), the pair.**  For every prime `p ≥ 7` the points of the cells `0` (index
`0`) and `(p − 1)𝟙` (index `p³ − 1`) have squared toroidal distance `d_*²` at integer scale `p³`,
`d_*² = (p² − 2p + 3)² + ((r − 1)p + 4)² + ((r − 1)p + 6)²`: it is attained at the translate
`t = −𝟙` and no translate gives less. -/
theorem TC_pair (p : ℕ) (hp : p.Prime) (hp7 : 7 ≤ p) :
    sepSqG p (genTC p) 0 (p ^ 3 - 1) (fun _ => -1) = dstarSqTC p ∧
    ∀ t : Fin 3 → ℤ, dstarSqTC p ≤ sepSqG p (genTC p) 0 (p ^ 3 - 1) t := by
  exact tc_pair' hp hp7

/-- **`prop:twocoset` (3), the bound.**  For every prime `p ≥ 53`, `d_*/p² < √66/8 − 2/p`. -/
theorem TC_pair_lt (p : ℕ) (hp : p.Prime) (hp53 : 53 ≤ p) :
    Real.sqrt (dstarSqTC p : ℝ) / (p : ℝ) ^ 2 < Real.sqrt 66 / 8 - 2 / p := by
  exact tc_pair_lt' hp hp53

/-- **`prop:twocoset` (2)–(3) for `δ N^{1/3}`.**  For every prime `p ≥ 41` the normalized toroidal
minimum distance `δ N^{1/3}` of `𝒯_p` (`deltaTC p`) satisfies `c(p) ≤ δ N^{1/3} ≤ d_*/p²`. -/
theorem TC_delta (p : ℕ) (hp : p.Prime) (hp41 : 41 ≤ p) :
    cTC p ≤ deltaTC p ∧ deltaTC p ≤ Real.sqrt (dstarSqTC p : ℝ) / (p : ℝ) ^ 2 := by
  exact tc_delta' hp hp41

/-- **`prop:twocoset` (3), the limit.**  `δ N^{1/3} → √66/8 = 1.0155…` as the prime `p → ∞`. -/
theorem TC_limit : ∀ ε : ℝ, 0 < ε → ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
    |deltaTC p - Real.sqrt 66 / 8| < ε := by
  exact tc_limit'

