/-! ## Statements -/

/-- **`tab:s5r2`, the table.** The designs are those of the seven primes
`31, 37, 53, 71, 101, 151, 199`, with the printed values `(λ_∞(Λ_κ), ⌊p^(3/5)⌋, M_p,
(M_p − 1)p^(−3/5), J_p², J_p p^(−3/5))` (the bounds in thousandths); the caption's structure: the
`z`-places are `0, 1, τ`, every `g_ij` (`i ≠ j`) is `±1`, the columns of `η` and the columns of `H`
are unit vectors; and the condition (N1) of `lem:skelnec` (every entry and every `2 × 2` minor of
`κ` is nonzero modulo `p`). -/
theorem s5r2_table :
    s5r2Table.map S5Design.p = [31, 37, 53, 71, 101, 151, 199] ∧
    s5r2Table.map (fun D => (D.lat, D.pig, D.M, D.tabM, D.J2, D.tabJ)) =
      [(6, 7, 4, 382, 18, 540), (7, 8, 5, 458, 30, 627), (9, 10, 6, 461, 54, 678), (10, 12, 7, 464, 97, 763), (13, 15, 8, 439, 149, 765), (16, 20, 14, 640, 283, 828), (19, 23, 16, 626, 456, 891)] ∧
    (∀ D ∈ s5r2Table, D.p.Prime) ∧
    (∀ D ∈ s5r2Table, D.pl 2 = 0 ∧ D.pl 3 = 1) ∧
    (∀ D ∈ s5r2Table, ∀ i j : Fin 3, i ≠ j → D.g i j = 1 ∨ D.g i j = -1) ∧
    (∀ D ∈ s5r2Table, ∀ (i : Fin 3) (d : Fin 2), D.η i d = if i = 0 then 1 else 0) ∧
    (∀ D ∈ s5r2Table, ∀ j : Fin 3, ∃ i : Fin 3, i ≠ j ∧ D.H i j = 1 ∧ ∀ i' : Fin 3, i' ≠ i → D.H i' j = 0) ∧
    (∀ D ∈ s5r2Table, ∀ (i : Fin 3) (d : Fin 2), ¬ (D.p : ℤ) ∣ D.κ i d) ∧
    (∀ D ∈ s5r2Table, ∀ i i' : Fin 3, i ≠ i' →
      ¬ (D.p : ℤ) ∣ D.κ i 0 * D.κ i' 1 - D.κ i 1 * D.κ i' 0) := by
  exact Proofs.s5r2_table

/-- **`prop:s5r2`, reachability.** For every design, the five places of the paper are distinct
modulo `p`; their images under the Möbius map `t ↦ 1/(t - b_1)` (`s5Places`, with `x_1` at `∞`) are
admissible, and for every `k ≥ 1` the moves of `lem:box` (`Φ = L Φ^F U` off the diagonal, row and
column gauges lower triangular with unit diagonal, diagonal blocks free) turn the graph form of this
frame with depths `(k+1, k+1, k, k, k)` into one whose skeleton digits are those of the design; it is
a digital `(0, 5k+2, 5)`-net over `𝔽_p`. -/
theorem s5r2_reach (D : S5Design) (hD : D ∈ s5r2Table) :
    (∀ c d : Fin 5, c ≠ d → (D.pl c : ZMod D.p) ≠ (D.pl d : ZMod D.p)) ∧
    PlacesOK 0 (s5Places D) ∧ ∀ k, 1 ≤ k →
      ∃ (L : (c : Fin 5) → Matrix (Fin (5 * k + 2 - skDepth 2 k c))
          (Fin (5 * k + 2 - skDepth 2 k c)) (ZMod D.p))
        (U : (d : Fin 5) → Matrix (Fin (skDepth 2 k d)) (Fin (skDepth 2 k d)) (ZMod D.p))
        (Φ : (c d : Fin 5) → Matrix (Fin (5 * k + 2 - skDepth 2 k c)) (Fin (skDepth 2 k d))
          (ZMod D.p)),
        (∀ c, IsLTU (L c)) ∧ (∀ d, IsLTU (U d)) ∧
        (∀ c d, c ≠ d → Φ c d =
          L c * frameGraphK (ZMod D.p) (5 * k + 2) (skDepth 2 k) 0 (s5Places D) c d * U d) ∧
        (∀ (i : Fin 3) (d : Fin 2) (l : Fin (skDepth 2 k (s5x d))),
          ent (Φ (s5z i) (s5x d)) 0 l = ((s5xCoef D k i d l : ℤ) : ZMod D.p)) ∧
        (∀ (i j : Fin 3) (l : Fin (skDepth 2 k (s5z j))),
          ent (Φ (s5z i) (s5z j)) 0 l = ((s5zCoef D k i j l : ℤ) : ZMod D.p)) ∧
        IsNet0 5 D.p (5 * k + 2)
          (digPoint D.p (5 * k + 2) (graphGenK (m := 5 * k + 2) (skDepth 2 k) Φ)) := by
  exact Proofs.s5r2_reach D hD

/-- **`prop:s5r2`, net.** For every design and every `k ≥ 1` there is a digital
`(0, 5k+2, 5)`-net over `𝔽_p` in graph form with the depths `(k+1, k+1, k, k, k)` and the skeleton
digits of the design. -/
theorem s5r2_net (D : S5Design) (hD : D ∈ s5r2Table) (k : ℕ) (hk : 1 ≤ k) :
    ∃ C : Fin 5 → Matrix (Fin (5 * k + 2)) (Fin (5 * k + 2)) (ZMod D.p),
      IsS5skel D k C ∧ IsNet0 5 D.p (5 * k + 2) (digPoint D.p (5 * k + 2) C) := by
  exact Proofs.s5r2_net D hD k hk

/-- **`prop:s5r2`, separation in the maximum norm (integer form).** For every design, every
`k ≥ 1` and every graph form with its skeleton digits (net or not), two distinct points have squared
toroidal distance (times `N²`, `N = p^(5k+2)`) at least `(M_p - 1)² f²`, `f = p^(4k+1)`. -/
theorem s5r2_sep (D : S5Design) (hD : D ∈ s5r2Table) (k : ℕ) (hk : 1 ≤ k)
    (C : Fin 5 → Matrix (Fin (5 * k + 2)) (Fin (5 * k + 2)) (ZMod D.p)) (hC : IsS5skel D k C)
    (v w : Fin (5 * k + 2) → ZMod D.p) (hvw : v ≠ w) :
    (D.M - 1) ^ 2 * D.p ^ (2 * (4 * k + 1)) ≤
      torusDist2 (D.p ^ (5 * k + 2)) (digPoint D.p (5 * k + 2) C v)
        (digPoint D.p (5 * k + 2) C w) := by
  exact Proofs.s5r2_sep D hD k hk C hC v w hvw

/-- **`prop:s5r2`, Euclidean separation (integer form).** For every design, every `k ≥ 1` and
every graph form with its skeleton digits (net or not), two distinct points have squared toroidal
distance (times `N²`) at least `J_p² f²`, `f = p^(4k+1)`. -/
theorem s5r2_sepJ (D : S5Design) (hD : D ∈ s5r2Table) (k : ℕ) (hk : 1 ≤ k)
    (C : Fin 5 → Matrix (Fin (5 * k + 2)) (Fin (5 * k + 2)) (ZMod D.p)) (hC : IsS5skel D k C)
    (v w : Fin (5 * k + 2) → ZMod D.p) (hvw : v ≠ w) :
    D.J2 * D.p ^ (2 * (4 * k + 1)) ≤
      torusDist2 (D.p ^ (5 * k + 2)) (digPoint D.p (5 * k + 2) C v)
        (digPoint D.p (5 * k + 2) C w) := by
  exact Proofs.s5r2_sepJ D hD k hk C hC v w hvw

/-- **`prop:s5r2`, separation (real form):** `δ N^(1/5) ≥ (M_p − 1) p^(−3/5)` (toroidal), for every
`k ≥ 1` and every graph form with the skeleton digits of the design. -/
theorem s5r2_sep_real (D : S5Design) (hD : D ∈ s5r2Table) (k : ℕ) (hk : 1 ≤ k)
    (C : Fin 5 → Matrix (Fin (5 * k + 2)) (Fin (5 * k + 2)) (ZMod D.p)) (hC : IsS5skel D k C)
    (v w : Fin (5 * k + 2) → ZMod D.p) (hvw : v ≠ w) :
    ((D.M : ℝ) - 1) * (D.p : ℝ) ^ (-(3 / 5 : ℝ)) * ((D.p : ℝ) ^ (5 * k + 2)) ^ (-(1 / 5 : ℝ))
      ≤ Real.sqrt (∑ c, ((cres (D.p ^ (5 * k + 2))
          ((digPoint D.p (5 * k + 2) C v c : ℤ) - (digPoint D.p (5 * k + 2) C w c : ℤ)) : ℝ)
          / (D.p : ℝ) ^ (5 * k + 2)) ^ 2) := by
  exact Proofs.s5r2_sep_real D hD k hk C hC v w hvw

/-- **`prop:s5r2`, Euclidean separation (real form):** `δ N^(1/5) ≥ J_p p^(−3/5)` (toroidal), for
every `k ≥ 1` and every graph form with the skeleton digits of the design. -/
theorem s5r2_sepJ_real (D : S5Design) (hD : D ∈ s5r2Table) (k : ℕ) (hk : 1 ≤ k)
    (C : Fin 5 → Matrix (Fin (5 * k + 2)) (Fin (5 * k + 2)) (ZMod D.p)) (hC : IsS5skel D k C)
    (v w : Fin (5 * k + 2) → ZMod D.p) (hvw : v ≠ w) :
    Real.sqrt (D.J2 : ℝ) * (D.p : ℝ) ^ (-(3 / 5 : ℝ)) * ((D.p : ℝ) ^ (5 * k + 2)) ^ (-(1 / 5 : ℝ))
      ≤ Real.sqrt (∑ c, ((cres (D.p ^ (5 * k + 2))
          ((digPoint D.p (5 * k + 2) C v c : ℤ) - (digPoint D.p (5 * k + 2) C w c : ℤ)) : ℝ)
          / (D.p : ℝ) ^ (5 * k + 2)) ^ 2) := by
  exact Proofs.s5r2_sepJ_real D hD k hk C hC v w hvw

/-- **`prop:s5r2`, the constant `M_p`:** `M_p` of `tab:s5r2` is the least `|a|_∞` of a nonzero
solution of the relaxation `S5Rel` of the proof. -/
theorem s5r2_M (D : S5Design) (hD : D ∈ s5r2Table) :
    IsLeast {n : ℤ | ∃ a ξ1 ξ2 : Fin 5 → ℤ, S5Rel D a ξ1 ξ2 ∧ a ≠ 0 ∧ n = s5MaxAbs a}
      (D.M : ℤ) := by
  exact Proofs.s5r2_M D hD

/-- **`prop:s5r2`, the constant `J_p`:** `J_p²` of `tab:s5r2` is the least `∑_c (|a_c| − 1)₊²` of a
nonzero solution of the relaxation `S5Rel` of the proof. -/
theorem s5r2_J (D : S5Design) (hD : D ∈ s5r2Table) :
    IsLeast {n : ℕ | ∃ a ξ1 ξ2 : Fin 5 → ℤ, S5Rel D a ξ1 ξ2 ∧ a ≠ 0 ∧ n = jitNorm2 a} D.J2 := by
  exact Proofs.s5r2_J D hD

/-- **`tab:s5r2`, the column `λ_∞(Λ_κ)`:** the minimum in the maximum norm of the skeleton lattice
`Λ_κ = {u ∈ ℤ⁵ : u_{z_i} ≡ κ_i1 u_{x_1} + κ_i2 u_{x_2} (mod p)}` (without faults). -/
theorem s5r2_lat (D : S5Design) (hD : D ∈ s5r2Table) :
    IsLeast {n : ℤ | ∃ u : Fin 5 → ℤ, u ≠ 0 ∧
      (∀ i : Fin 3, (D.p : ℤ) ∣ u (s5z i) - ∑ d : Fin 2, D.κ i d * u (s5x d)) ∧
      n = s5MaxAbs u} (D.lat : ℤ) := by
  exact Proofs.s5r2_lat D hD

/-- **`tab:s5r2`, the printed values:** `(M_p − 1) p^(−3/5)` and `J_p p^(−3/5)` truncated to three
digits are the printed values, `⌊p^(3/5)⌋` is the printed pigeonhole bound, and `λ_∞(Λ_κ) ≤ ⌊p^(3/5)⌋`. -/
theorem s5r2_tab (D : S5Design) (hD : D ∈ s5r2Table) :
    (D.tabM : ℝ) / 1000 ≤ ((D.M : ℝ) - 1) * (D.p : ℝ) ^ (-(3 / 5 : ℝ)) ∧
      ((D.M : ℝ) - 1) * (D.p : ℝ) ^ (-(3 / 5 : ℝ)) < ((D.tabM : ℝ) + 1) / 1000 ∧
      (D.tabJ : ℝ) / 1000 ≤ Real.sqrt (D.J2 : ℝ) * (D.p : ℝ) ^ (-(3 / 5 : ℝ)) ∧
      Real.sqrt (D.J2 : ℝ) * (D.p : ℝ) ^ (-(3 / 5 : ℝ)) < ((D.tabJ : ℝ) + 1) / 1000 ∧
      (D.pig : ℝ) ≤ (D.p : ℝ) ^ (3 / 5 : ℝ) ∧ (D.p : ℝ) ^ (3 / 5 : ℝ) < (D.pig : ℝ) + 1 ∧
      D.lat ≤ D.pig := by
  exact Proofs.s5r2_tab D hD

/-- **`prop:s5r2`.** For every prime `p ∈ {31, 37, 53, 71, 101, 151, 199}` there is an explicit
design with five distinct finite places, `M_p ≥ 2` and `J_p² ≥ 1`, such that for every `k ≥ 1` its
skeleton digits complete to a digital `(0, 5k+2, 5)`-net over `𝔽_p`, and every graph form with these
skeleton digits satisfies `δ N^(1/5) ≥ J_p p^(−3/5)` and `δ N^(1/5) ≥ (M_p − 1) p^(−3/5)` (toroidal). -/
theorem s5r2_main (p : ℕ) (hp : p ∈ [31, 37, 53, 71, 101, 151, 199]) :
    ∃ D ∈ s5r2Table, D.p = p ∧ (∀ c d : Fin 5, c ≠ d → (D.pl c : ZMod D.p) ≠ (D.pl d : ZMod D.p)) ∧
      2 ≤ D.M ∧ 1 ≤ D.J2 ∧ ∀ k, 1 ≤ k →
      (∃ C : Fin 5 → Matrix (Fin (5 * k + 2)) (Fin (5 * k + 2)) (ZMod D.p),
        IsS5skel D k C ∧ IsNet0 5 D.p (5 * k + 2) (digPoint D.p (5 * k + 2) C)) ∧
      ∀ C : Fin 5 → Matrix (Fin (5 * k + 2)) (Fin (5 * k + 2)) (ZMod D.p), IsS5skel D k C →
        ∀ v w : Fin (5 * k + 2) → ZMod D.p, v ≠ w →
          Real.sqrt (D.J2 : ℝ) * (D.p : ℝ) ^ (-(3 / 5 : ℝ)) * ((D.p : ℝ) ^ (5 * k + 2)) ^ (-(1 / 5 : ℝ)) ≤ Real.sqrt (∑ c, ((cres (D.p ^ (5 * k + 2))
          ((digPoint D.p (5 * k + 2) C v c : ℤ) - (digPoint D.p (5 * k + 2) C w c : ℤ)) : ℝ)
          / (D.p : ℝ) ^ (5 * k + 2)) ^ 2) ∧
          ((D.M : ℝ) - 1) * (D.p : ℝ) ^ (-(3 / 5 : ℝ)) * ((D.p : ℝ) ^ (5 * k + 2)) ^ (-(1 / 5 : ℝ)) ≤ Real.sqrt (∑ c, ((cres (D.p ^ (5 * k + 2))
          ((digPoint D.p (5 * k + 2) C v c : ℤ) - (digPoint D.p (5 * k + 2) C w c : ℤ)) : ℝ)
          / (D.p : ℝ) ^ (5 * k + 2)) ^ 2) := by
  exact Proofs.s5r2_main p hp

