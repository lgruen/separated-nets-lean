/-! ## New definitions (entry HL8) -/

/-- **Admissibility up to level `L`**: `q ≥ 2`; the `2s` points pairwise distinct modulo every
prime factor of `q`; `λ'_c` units mod `q`; the leading coefficients `gco d n n` units mod `q`
for `n < L` only. -/
def HLAdmL (s q L : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ) : Prop :=
  2 ≤ q ∧
  (∀ c e c' e', (c, e) ≠ (c', e') → Int.gcd (splitPt u v c e - splitPt u v c' e') q = 1) ∧
  (∀ c, Int.gcd (lam c).num q = 1 ∧ Nat.Coprime (lam c).den q) ∧
  (∀ d, ∀ n < L, Int.gcd (gco d n n).num q = 1 ∧ Nat.Coprime (gco d n n).den q)

