namespace Z3NetU

open Matrix Finset

lemma Proofs.ivOK_rat (s : ℕ) : Proofs.IvOK (fun i => ((i : ℕ) : ℚ)⁻¹) (s - 2) :=
  fun i h1 _ => mul_inv_cancel₀ (by exact_mod_cast (show i ≠ 0 by omega))

/-! ## Theorem U -/

/-- **Definition N_s, literally.** Over `ℚ` (entries in `ℤ[1/(s-2)!]`), every off-diagonal block of
the Challenge net is `Φ'_cd = L_c Φ^F_cd U_d` with the raw frame graph form `Φ^F` (Mathlib
inverse of the frame's `(k,…,k)` box matrix), `L_c = diag(λ'_c Q_c^(-k), 1, …, 1)` and
`U_d = Q_d^k Toep(g_d) U'^(k)_d`; every `k ≥ 1`. -/
theorem U_defN (s k : ℕ) (hs : 3 ≤ s) (hk : 1 ≤ k) (c d : Fin s) (hcd : c ≠ d)
    (r : Fin (s * k - k)) (l : Fin k) :
    UPhi ℚ (fun i => ((i : ℕ) : ℚ)⁻¹) k c d r l =
      (if (r : ℕ) = 0 then (lamRes c : ℚ) * (Qval c ^ k)⁻¹ else 1) * (frameGraph k c d * Ulit k d) r l :=
  Proofs.U_defN s k hs hk c d hcd r l

/-- **Proposition N_s** in the `E`-basis (faithfulness of `Ψ`): over `ℚ`, for `c ≠ d` and every
`k ≥ 1`, `Q_c^(-k) Ψ_cd[0, j] = w_cd y_cd^(k-1-j)` (the Cauchy kernel). -/
theorem U_propN (s : ℕ) (hs : 3 ≤ s) (k : ℕ) (hk : 1 ≤ k) (c d : Fin s) (hcd : c ≠ d)
    (r : Fin (s * k - k)) (hr : (r : ℕ) = 0) (j : Fin k) :
    Qinv (fun i => ((i : ℕ) : ℚ)⁻¹) k c * (Psi k c d r j : ℚ) =
      wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ (k - 1 - (j : ℕ)) :=
  Proofs.propN hs (Proofs.ivOK_rat s) k c d hcd r hr j

/-- **Proposition G_s**, the defining relation of `γ_n` (`n ≥ s-1`): over `ℚ`, for every `c ≠ d`,
`w_cd y_cd^n = ∑_{i < s-1} γ_{n,i} w_cd y_cd^i`. (The `s-1` nodes `y_cd`, `c ≠ d`, are distinct,
so this determines `γ_n`; and `γ_n = U'_d β_n` for the `β_n` of the note.) -/
theorem U_propG (s : ℕ) (hs : 3 ≤ s) (c d : Fin s) (hcd : c ≠ d) (n : ℕ) (hn : s - 1 ≤ n) :
    wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ n =
      ∑ i ∈ range (s - 1), gam (fun i => ((i : ℕ) : ℚ)⁻¹) d n i *
        (wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ i) :=
  Proofs.propG hs c d hcd n

/-- **Proposition G_s, uniqueness.** Over `ℚ`, `γ_n` is the only coefficient vector with the
defining relation of `U_propG` (the `s-1` nodes `y_cd`, `c ≠ d`, are distinct). Hence the gauge
column `e_n - γ_n` is exactly the note's `e_n - ∑_i β_{n,i} (column i of U'_d)`, whose `β_n` solves
`λ' ⊙ v_n = ∑_i β_{n,i} F_i[·][d]` (that relation says `γ := U'_d β_n` satisfies the relation). -/
theorem U_gam_unique (s : ℕ) (hs : 3 ≤ s) (d : Fin s) (n : ℕ) (g : ℕ → ℚ)
    (hg : ∀ c : Fin s, c ≠ d → ∑ i ∈ range (s - 1), g i *
      (wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ i) =
        wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ n) :
    ∀ i < s - 1, g i = gam (fun i => ((i : ℕ) : ℚ)⁻¹) d n i :=
  Proofs.U_gam_unique s hs d n g hg

/-- **The design is reachable** (Proposition F with `λ'`, `U'`): over `ℚ`, for `c ≠ d` and
`n < s - 1`, `F_n[c][d] = λ'_c ∑_{n' ≤ n} w_cd y_cd^(n') U'_d[n', n]`. -/
theorem U_design (s : ℕ) (hs : 3 ≤ s) (c d : Fin s) (hcd : c ≠ d) (n : ℕ) (hn : n < s - 1) :
    (Fdes s n c d : ℚ) = (lamRes c : ℚ) * ∑ n' ∈ range (n + 1),
      wN (fun i => ((i : ℕ) : ℚ)⁻¹) c d * yN (fun i => ((i : ℕ) : ℚ)⁻¹) c d ^ n' *
        Ures (fun i => ((i : ℕ) : ℚ)⁻¹) d n' n :=
  Proofs.design_eq hs (Proofs.ivOK_rat s) c d hcd n hn

/-- **(H1).** For admissible `q` and every `k ≥ 1`, row `0` of every block `Φ'_cd` of `𝒫^s_{k,q}`
is the design: level `j` carries `F_{k-1-j}[c][d]` (`0` for `k-1-j ≥ s-1`). -/
theorem U_row0 (s q k : ℕ) (hs : 3 ≤ s) (hq : Admissible s q) (hk : 1 ≤ k) (c d : Fin s)
    (r : Fin (s * k - k)) (hr : (r : ℕ) = 0) (j : Fin k) :
    UPhi (ZMod q) (fun i => ((i : ℕ) : ZMod q)⁻¹) k c d r j = ((Fdes s (k - 1 - (j : ℕ)) c d : ℤ) : ZMod q) :=
  Proofs.row0 hs (Proofs.ivOK_zmod s q hq) k c d r hr j

/-- **Theorem U(1).** For every `s ≥ 3`, every `q ≥ 2` whose prime factors are all `≥ s - 1`
(composite allowed) and every `k ≥ 1`, `𝒫^s_{k,q}` is a digital `(0,sk,s)`-net over `ℤ/qℤ`.
(With `d = (k,…,k)` this is the one-point-per-cell statement.) -/
theorem U_net (s q k : ℕ) (hs : 3 ≤ s) (hq : Admissible s q) (hk : 1 ≤ k) :
    IsNet0 s q (s * k) (Upoint s q k) :=
  Proofs.U_net s q k hs hq hk

/-- **Box minors.** Over `ℚ` (`iv i = 1/i`, i.e. the `ℤ[1/(s-2)!]` matrices of Definition N_s),
every box minor of the generator matrices of `𝒫^s_{k,·}` is nonzero and has `p`-adic valuation
`0` for every prime `p ≥ s - 1` (so it is `± ∏_{p ≤ s-2} p^(e_p)`, `e_p ∈ ℤ`), every `k ≥ 1`. -/
theorem U_boxMinor (s k : ℕ) (hs : 3 ≤ s) (hk : 1 ≤ k) (d : Fin s → ℕ) (hd : ∑ c, d c = s * k) :
    (boxMatrix (graphGen s k (UPhi ℚ (fun i => ((i : ℕ) : ℚ)⁻¹) k)) d).det ≠ 0 ∧
      ∀ p : ℕ, p.Prime → s - 1 ≤ p →
        padicValRat p (boxMatrix (graphGen s k (UPhi ℚ (fun i => ((i : ℕ) : ℚ)⁻¹) k)) d).det = 0 :=
  Proofs.U_boxMinor s k hs hk d hd

/-- **Frame box minors** (Lemma T_s, exact value: the confluent Vandermonde determinant). For
every `s ≥ 1`, `m` and composition `d` of `m`, the box minor of the frame (rows: the top `d 0`
coefficients for `∞`, the first `d c` Taylor coefficients at `a_c = c - 1` for `c ≥ 1`) is
`± ∏_{0 < c' < c} (a_c - a_c')^(d_c' d_c)` (the factors are `1, …, s-2`). Consequently all box
minors are units mod `q` iff every prime factor of `q` is `≥ s - 1` (`s ≥ 3`, `m ≥ 2`; for the
converse take `d_1 = d_(p+1) = 1`); this consequence is not separately formalized. -/
theorem U_frameMinor (s m : ℕ) (hs : 1 ≤ s) (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    (boxMatrix (frameGen (s := s) m) d).det = ∏ c : Fin s, ∏ c' : Fin s,
        (if 0 < (c' : ℕ) ∧ c' < c then ((c : ℤ) - c') ^ (d c' * d c) else 1) ∨
      (boxMatrix (frameGen (s := s) m) d).det = -∏ c : Fin s, ∏ c' : Fin s,
        (if 0 < (c' : ℕ) ∧ c' < c then ((c : ℤ) - c') ^ (d c' * d c) else 1) :=
  Proofs.U_frameMinor s m hs d hd

/-- **Theorem U(1), covering radius.** Every `x ∈ [0,1]^s` has a point of `𝒫^s_{k,q}` at
Euclidean distance at most `√s q^(-k) = √s N^(-1/s)` (`N = q^(sk)`; every base `q ≥ 2`, the graph
form puts one point in every cell). -/
theorem U_covering (s q k : ℕ) (hs : 3 ≤ s) (hq : 2 ≤ q) (hk : 1 ≤ k) (x : Fin s → ℝ)
    (hx : ∀ c, 0 ≤ x c ∧ x c ≤ 1) :
    ∃ v : Fin (s * k) → ZMod q,
      ∑ c, (x c - (Upoint s q k v c : ℝ) / (q : ℝ) ^ (s * k)) ^ 2 ≤ (s : ℝ) / ((q : ℝ) ^ k) ^ 2 :=
  Proofs.U_covering s q k hs hq hk x hx

/-- **Theorem U(2), exact integer form.** For admissible `q ≥ 5 a_s + 4`, `k ≥ 2` and distinct
indices `v ≠ w`, with `N = q^(sk)` and `D² = torusDist2 N X(v) X(w)` (the squared toroidal distance
times `N²`): `q² D² ≥ (q - a_s)² q^(2(s-1)k)`, i.e. `δ ≥ (1 - a_s/q) N^(-1/s)`. -/
theorem U_sep (s q k : ℕ) (hs : 3 ≤ s) (hq : Admissible s q) (hqa : 5 * aU s + 4 ≤ q)
    (hk : 2 ≤ k) (v w : Fin (s * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (2 * (s * k - k)) * ((q : ℤ) - aU s) ^ 2 ≤
      (q : ℤ) ^ 2 * (torusDist2 (q ^ (s * k)) (Upoint s q k v) (Upoint s q k w) : ℤ) :=
  Proofs.U_sep s q k hs hq hqa hk v w hvw

/-- **Theorem U(2), real form.** The toroidal distance between any two distinct points of
`𝒫^s_{k,q}` (points `X / N` in `[0,1)^s`, `N = q^(sk)`) is at least `(1 - a_s/q) · N^(-1/s)`. -/
theorem U_sep_real (s q k : ℕ) (hs : 3 ≤ s) (hq : Admissible s q) (hqa : 5 * aU s + 4 ≤ q)
    (hk : 2 ≤ k) (v w : Fin (s * k) → ZMod q) (hvw : v ≠ w) :
    (1 - (aU s : ℝ) / q) * ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (q ^ (s * k)) ((Upoint s q k v c : ℤ) - (Upoint s q k w c : ℤ)) : ℝ)
          / (q : ℝ) ^ (s * k)) ^ 2) :=
  Proofs.U_sep_real s q k hs hq hqa hk v w hvw

/-- **The constant.** `a_s ≤ L_s (s² + 2^(s-2))`. -/
theorem U_aBound (s : ℕ) (hs : 3 ≤ s) : aU s ≤ Lcst s * (s ^ 2 + 2 ^ (s - 2)) :=
  Proofs.U_aBound s hs

/-! ## Stage 6 additions: the constants `a_3, a_4, a_5`, growth, first-order sharpness -/

/-- **`thm:U`, the constant `a_3`.** `a_3 = 4`. -/
theorem U_a3 : aU 3 = 4 :=
  Proofs.U_a3

/-- **`thm:U`, the constant `a_4`.** `a_4 = 63`. -/
theorem U_a4 : aU 4 = 63 :=
  Proofs.U_a4

/-- **`thm:U`, the constant `a_5`.** `a_5 = 17407`. -/
theorem U_a5 : aU 5 = 17407 :=
  Proofs.U_a5

/-- **Lower bound for `a_s`** (behind "the base needed for separation grows like `e^{Θ(s²)}`"):
`L_s ≤ a_s`. -/
theorem U_aLower (s : ℕ) (hs : 3 ≤ s) : Lcst s ≤ aU s :=
  Proofs.U_aLower s hs

/-- **Growth of `a_s`** (`thm:U`, `a_s ≤ L_s (s² + 2^(s-2)) = e^{(1+o(1))s²}`, in the form provable
from Chebyshev's bounds): for every `ε > 0`, eventually in `s`,
`(log 2 - ε) s² ≤ log a_s` and `log (L_s (s² + 2^(s-2))) ≤ (log 4 + ε) s²`. (The constant `1` in
the exponent needs the prime number theorem, `ψ(n) ~ n`, which is not used here.) -/
theorem U_growth (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ s : ℕ in Filter.atTop, (Real.log 2 - ε) * (s : ℝ) ^ 2 ≤ Real.log (aU s : ℝ) ∧
      Real.log ((Lcst s : ℝ) * ((s : ℝ) ^ 2 + 2 ^ (s - 2))) ≤ (Real.log 4 + ε) * (s : ℝ) ^ 2 :=
  Proofs.U_growth ε hε

/-- **Theorem U(2), first-order sharpness of `a_s`.** For admissible `q ≥ 5 a_s + 4` and `k ≥ 2`
some two distinct points of `𝒫^s_{k,q}` have squared Euclidean and squared toroidal distance, in
cell units (side `q^(-k) = N^(-1/s)`), `< (1 - a_s/q)² + (s-1)(L_s+1)²/q²`. -/
theorem U_sharp (s q k : ℕ) (hs : 3 ≤ s) (hq : Admissible s q) (hqa : 5 * aU s + 4 ≤ q)
    (hk : 2 ≤ k) :
    ∃ v w : Fin (s * k) → ZMod q, v ≠ w ∧
      (q : ℝ) ^ (2 * k) * ∑ c, (((Upoint s q k v c : ℝ) - Upoint s q k w c) / (q : ℝ) ^ (s * k)) ^ 2
        < (1 - (aU s : ℝ) / q) ^ 2 + ((s : ℝ) - 1) * ((Lcst s : ℝ) + 1) ^ 2 / (q : ℝ) ^ 2 ∧
      (q : ℝ) ^ (2 * k) * ∑ c, ((cres (q ^ (s * k))
          ((Upoint s q k v c : ℤ) - (Upoint s q k w c : ℤ)) : ℝ) / (q : ℝ) ^ (s * k)) ^ 2
        < (1 - (aU s : ℝ) / q) ^ 2 + ((s : ℝ) - 1) * ((Lcst s : ℝ) + 1) ^ 2 / (q : ℝ) ^ 2 :=
  Proofs.U_sharp s q k hs hq hqa hk

/-- **Theorem U(2), first-order sharpness, real form**: the toroidal minimum distance satisfies
`δ < (1 - a_s/q + (s-1)(L_s+1)²/q²) N^(-1/s)`, against `δ ≥ (1 - a_s/q) N^(-1/s)` of `U_sep_real`. -/
theorem U_sharp_real (s q k : ℕ) (hs : 3 ≤ s) (hq : Admissible s q) (hqa : 5 * aU s + 4 ≤ q)
    (hk : 2 ≤ k) :
    ∃ v w : Fin (s * k) → ZMod q, v ≠ w ∧
      Real.sqrt (∑ c, ((cres (q ^ (s * k)) ((Upoint s q k v c : ℤ) - (Upoint s q k w c : ℤ)) : ℝ)
          / (q : ℝ) ^ (s * k)) ^ 2) <
        (1 - (aU s : ℝ) / q + ((s : ℝ) - 1) * ((Lcst s : ℝ) + 1) ^ 2 / (q : ℝ) ^ 2) *
          ((q : ℝ) ^ (s * k)) ^ (-(1 / (s : ℝ))) :=
  Proofs.U_sharp_real s q k hs hq hqa hk

