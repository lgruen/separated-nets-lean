/-! ### `lem:skellat`(G), `def:G2rule`, `lem:G2N1` -/

/-- **`lem:skellat`(G)** (`ℓ = 2`, `r ≥ 3`): if `c_1 > √2 B`, `c_l² + 1 > B` (`2 ≤ l ≤ r - 1`) and
`B (1 + ‖A_j‖₁) < p` for both rows, every nonzero `(x, z) ∈ ℤ^(r+2)` with `z ≡ A x (mod p)` has
maximum norm at least `B + 1`. -/
theorem skellat_G (r p B : ℕ) (hr : 3 ≤ r) (hB : 1 ≤ B) (c : ℕ → ℤ)
    (hc1 : Real.sqrt 2 * (B : ℝ) < (c 0 : ℝ)) (hc : ∀ l, 1 ≤ l → l + 2 ≤ r → (B : ℤ) < c l ^ 2 + 1)
    (hp : ∀ i : Fin 2, (B : ℤ) * (1 + ∑ d ∈ range r, |gaussA r c i d|) < p)
    (x : Fin r → ℤ) (z : Fin 2 → ℤ)
    (hz : ∀ i, (p : ℤ) ∣ z i - ∑ d : Fin r, gaussA r c i (d : ℕ) * x d) (hne : ¬(x = 0 ∧ z = 0)) :
    (B : ℤ) + 1 ≤ |z 0| ∨ (B : ℤ) + 1 ≤ |z 1| ∨ ∃ d, (B : ℤ) + 1 ≤ |x d| :=
  Proofs.skellat_G r p B hr hB c hc1 hc hp x z hz hne

/-- **`def:G2rule`**: `B(p)` is nondecreasing in `p`. -/
theorem Bp_mono (s p p' : ℕ) (h : p ≤ p') : Bp s p ≤ Bp s p' :=
  Proofs.Bp_mono s p p' h

/-- **`lem:G2N1`(a)**: if `B ≥ 1` and `B (1 + max_j ‖A_j(B)‖₁) < p`, then `c_j² + 1 < p` for every
`j` (`s ≥ 5`). -/
theorem G2N1_a (s B p : ℕ) (hs : 5 ≤ s) (hB : 1 ≤ B) (hp : (B : ℤ) * (1 + normA s B) < p) (j : ℕ)
    (hj : j + 4 ≤ s) : cG B j ^ 2 + 1 < p :=
  Proofs.G2N1_a s B p hs hB hp j hj

/-- **`lem:G2N1`(b)**: under the hypothesis of (a), if `∑_{j=1}^{r-1} arctan(1/c_j) < π/2`, every
entry and every `2 × 2` minor of `A(B)` is nonzero modulo `p`, i.e. `A(B)` satisfies (N1). -/
theorem G2N1_b (s B p : ℕ) [Fact p.Prime] (hs : 5 ≤ s) (hB : 1 ≤ B)
    (hp : (B : ℤ) * (1 + normA s B) < p)
    (harc : ∑ j ∈ range (s - 3), Real.arctan (1 / (cG B j : ℝ)) < Real.pi / 2) :
    (∀ (i : Fin 2) (d : ℕ), d + 2 < s → ((AG s B i d : ℤ) : ZMod p) ≠ 0) ∧
      ∀ d d', d + 2 < s → d' + 2 < s → d ≠ d' →
        ((AG s B 0 d * AG s B 1 d' - AG s B 0 d' * AG s B 1 d : ℤ) : ZMod p) ≠ 0 :=
  Proofs.G2N1_b s B p hs hB hp harc

/-- **`lem:G2N1`(c)**: the hypothesis of (b) holds if `s ≤ 8` and `B ≥ F + 1`, and, for every `s`,
if `B > (2(r - 1)/π)²`. -/
theorem G2N1_c (s B : ℕ) (hs : 5 ≤ s)
    (h : (s ≤ 8 ∧ Fs s + 1 ≤ B) ∨ (2 * ((s : ℝ) - 3) / Real.pi) ^ 2 < B) :
    ∑ j ∈ range (s - 3), Real.arctan (1 / (cG B j : ℝ)) < Real.pi / 2 :=
  Proofs.G2N1_c s B hs h

/-! ### `thm:S2` (two skeleton coordinates), `def:S2` -/

/-- **`thm:S2`(1)**, net: for every prime `p ≥ 5` and `k ≥ 1`, there is a digital
`(0, 4k+2, 4)`-net over `𝔽_p` with the skeleton digits of `def:S2` (`s = 4`, `D_1 = {2}`). -/
theorem S2_net4 (p k : ℕ) [Fact p.Prime] (hp : 5 ≤ p) (hk : 1 ≤ k) :
    ∃ C : Fin 4 → Matrix (Fin (4 * k + 2)) (Fin (4 * k + 2)) (ZMod p),
      IsS2skel 4 p k {1} C ∧ IsNet0 4 p (4 * k + 2) (digPoint p (4 * k + 2) C) :=
  Proofs.S2_net4 p k hp hk

/-- **`thm:S2`(1)**, separation (integer form): every graph form with the skeleton digits of
`def:S2` (`s = 4`) has `(ρ - 4)² p^(2(3k+1)) ≤ N² δ²`, i.e. `δ N^(1/4) ≥ (ρ - 4) p^(-1/2)`. -/
theorem S2_sep4 (p k : ℕ) [Fact p.Prime] (hp : 5 ≤ p) (hk : 1 ≤ k)
    (C : Fin 4 → Matrix (Fin (4 * k + 2)) (Fin (4 * k + 2)) (ZMod p)) (hC : IsS2skel 4 p k {1} C)
    (v w : Fin (4 * k + 2) → ZMod p) (hvw : v ≠ w) :
    (rhoT p - 4) ^ 2 * p ^ (2 * (3 * k + 1)) ≤
      torusDist2 (p ^ (4 * k + 2)) (digPoint p (4 * k + 2) C v) (digPoint p (4 * k + 2) C w) :=
  Proofs.S2_sep4 p k hp hk C hC v w hvw

/-- **`thm:S2`(1)**, separation (real form): `δ N^(1/4) ≥ (ρ - 4) p^(-1/2)` (toroidal). -/
theorem S2_sep4_real (p k : ℕ) [Fact p.Prime] (hp : 5 ≤ p) (hk : 1 ≤ k)
    (C : Fin 4 → Matrix (Fin (4 * k + 2)) (Fin (4 * k + 2)) (ZMod p)) (hC : IsS2skel 4 p k {1} C)
    (v w : Fin (4 * k + 2) → ZMod p) (hvw : v ≠ w) :
    ((rhoT p : ℝ) - 4) * (p : ℝ) ^ (-(1 / 2 : ℝ)) * ((p : ℝ) ^ (4 * k + 2)) ^ (-(1 / 4 : ℝ))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (4 * k + 2))
          ((digPoint p (4 * k + 2) C v c : ℤ) - (digPoint p (4 * k + 2) C w c : ℤ)) : ℝ)
          / (p : ℝ) ^ (4 * k + 2)) ^ 2) :=
  Proofs.S2_sep4_real p k hp hk C hC v w hvw

/-- **`thm:S2`(1)**, constants: for primes `p ≥ 5` the bound is positive (`ρ ≥ 5`) iff `p ≥ 23`,
and `(ρ - 4) p^(-1/2) → 1`. -/
theorem S2_const4 :
    (∀ p : ℕ, p.Prime → 5 ≤ p → (5 ≤ rhoT p ↔ 23 ≤ p)) ∧
      Filter.Tendsto (fun p : ℕ => ((rhoT p : ℝ) - 4) * (p : ℝ) ^ (-(1 / 2 : ℝ)))
        Filter.atTop (nhds 1) :=
  Proofs.S2_const4

/-- **`thm:S2`(2), (3)**, net: for `s ≥ 5`, every prime `p` with `B(p) ≥ F + 1` and
`∑_j arctan(1/c_j) < π/2` at `B = B(p)`, every `k ≥ 1` and every choice of `D_1`, there is a
digital `(0, sk+s-2, s)`-net over `𝔽_p` with the skeleton digits of `def:S2`. -/
theorem S2_net (s p k : ℕ) [Fact p.Prime] (hs : 5 ≤ s) (hk : 1 ≤ k) (D1 : Finset ℕ)
    (hD1 : D1 ⊆ range (s - 2)) (hB : Fs s + 1 ≤ Bp s p)
    (harc : ∑ j ∈ range (s - 3), Real.arctan (1 / (cG (Bp s p) j : ℝ)) < Real.pi / 2) :
    ∃ C : Fin s → Matrix (Fin (s * k + (s - 2))) (Fin (s * k + (s - 2))) (ZMod p),
      IsS2skel s p k D1 C ∧ IsNet0 s p (s * k + (s - 2)) (digPoint p (s * k + (s - 2)) C) :=
  Proofs.S2_net s p k hs hk D1 hD1 hB harc

/-- **`thm:S2`(2), (3)**, separation (integer form): for `s ≥ 5`, `|D_1| = ⌊(s-2)/2⌋`, every graph
form with the skeleton digits of `def:S2` has `(B(p) - F)² p^(2((s-1)k + s - 3)) ≤ N² δ²`, i.e.
`δ N^(1/s) ≥ (B(p) - F) p^(-2/s)`. -/
theorem S2_sep (s p k : ℕ) [Fact p.Prime] (hs : 5 ≤ s) (hk : 1 ≤ k) (D1 : Finset ℕ)
    (hD1 : D1 ⊆ range (s - 2)) (hD1c : D1.card = (s - 2) / 2)
    (C : Fin s → Matrix (Fin (s * k + (s - 2))) (Fin (s * k + (s - 2))) (ZMod p))
    (hC : IsS2skel s p k D1 C) (v w : Fin (s * k + (s - 2)) → ZMod p) (hvw : v ≠ w) :
    (Bp s p - Fs s) ^ 2 * p ^ (2 * ((s - 1) * k + s - 3)) ≤
      torusDist2 (p ^ (s * k + (s - 2))) (digPoint p (s * k + (s - 2)) C v)
        (digPoint p (s * k + (s - 2)) C w) :=
  Proofs.S2_sep s p k hs hk D1 hD1 hD1c C hC v w hvw

/-- **`thm:S2`(2), (3)**, separation (real form): `δ N^(1/s) ≥ (B(p) - F) p^(-2/s)` (toroidal). -/
theorem S2_sep_real (s p k : ℕ) [Fact p.Prime] (hs : 5 ≤ s) (hk : 1 ≤ k) (D1 : Finset ℕ)
    (hD1 : D1 ⊆ range (s - 2)) (hD1c : D1.card = (s - 2) / 2)
    (C : Fin s → Matrix (Fin (s * k + (s - 2))) (Fin (s * k + (s - 2))) (ZMod p))
    (hC : IsS2skel s p k D1 C) (v w : Fin (s * k + (s - 2)) → ZMod p) (hvw : v ≠ w) :
    ((Bp s p : ℝ) - Fs s) * (p : ℝ) ^ (-(2 / (s : ℝ))) *
        ((p : ℝ) ^ (s * k + (s - 2))) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (s * k + (s - 2)))
          ((digPoint p (s * k + (s - 2)) C v c : ℤ) - (digPoint p (s * k + (s - 2)) C w c : ℤ)) : ℝ)
          / (p : ℝ) ^ (s * k + (s - 2))) ^ 2) :=
  Proofs.S2_sep_real s p k hs hk D1 hD1 hD1c C hC v w hvw

/-- **`thm:S2`(2)**, thresholds: for `5 ≤ s ≤ 8`, `B(p) ≥ F + 1` exactly for `p > 132, 440, 2170,
6095`, and for primes this is `p ≥ 137, 443, 2179, 6101`. -/
theorem S2_thr (s p : ℕ) (hs5 : 5 ≤ s) (hs8 : s ≤ 8) :
    (Fs s + 1 ≤ Bp s p ↔ S2thr s < p) ∧ (p.Prime → (S2thr s < p ↔ S2pthr s ≤ p)) :=
  Proofs.S2_thr s p hs5 hs8

/-- **`thm:S2`(2)**: for `5 ≤ s ≤ 8`, every prime `p ≥ 137, 443, 2179, 6101`, every `k ≥ 1` and every
`D_1` with `|D_1| = ⌊(s-2)/2⌋`: `B(p) ≥ F + 1`, there is a digital `(0, sk+s-2, s)`-net over `𝔽_p`
with the skeleton digits of `def:S2`, and every such net has `δ N^(1/s) ≥ (B(p) - F) p^(-2/s) > 0`. -/
theorem S2_main58 (s p k : ℕ) [Fact p.Prime] (hs5 : 5 ≤ s) (hs8 : s ≤ 8) (hp : S2pthr s ≤ p)
    (hk : 1 ≤ k) (D1 : Finset ℕ) (hD1 : D1 ⊆ range (s - 2)) (hD1c : D1.card = (s - 2) / 2) :
    Fs s + 1 ≤ Bp s p ∧
      (∃ C : Fin s → Matrix (Fin (s * k + (s - 2))) (Fin (s * k + (s - 2))) (ZMod p),
        IsS2skel s p k D1 C ∧ IsNet0 s p (s * k + (s - 2)) (digPoint p (s * k + (s - 2)) C)) ∧
      ∀ C : Fin s → Matrix (Fin (s * k + (s - 2))) (Fin (s * k + (s - 2))) (ZMod p),
        IsS2skel s p k D1 C → ∀ v w : Fin (s * k + (s - 2)) → ZMod p, v ≠ w →
          (Bp s p - Fs s) ^ 2 * p ^ (2 * ((s - 1) * k + s - 3)) ≤
            torusDist2 (p ^ (s * k + (s - 2))) (digPoint p (s * k + (s - 2)) C v)
              (digPoint p (s * k + (s - 2)) C w) :=
  Proofs.S2_main58 s p k hs5 hs8 hp hk D1 hD1 hD1c

/-- **`thm:S2`(3)**: for every `s ≥ 5` the hypotheses `B(p) > F` and `B(p) > (2(s-3)/π)²` (which
gives the arctangent condition by `lem:G2N1`(c)) hold for all sufficiently large `p`. -/
theorem S2_eventually (s : ℕ) (hs : 5 ≤ s) :
    ∃ p0 : ℕ, ∀ p, p0 ≤ p → Fs s + 1 ≤ Bp s p ∧ (2 * ((s : ℝ) - 3) / Real.pi) ^ 2 < Bp s p :=
  Proofs.S2_eventually s hs

/-- **`thm:S2`**, `B(p) ≍ p^(2/s)`: for every `s ≥ 5` there are constants `0 < c₁ ≤ c₂` with
`c₁ p^(2/s) ≤ B(p) ≤ c₂ p^(2/s)` for all large `p`. -/
theorem Bp_asymp (s : ℕ) (hs : 5 ≤ s) :
    ∃ c₁ c₂ : ℝ, 0 < c₁ ∧ 0 < c₂ ∧ ∃ p0 : ℕ, ∀ p, p0 ≤ p →
      c₁ * (p : ℝ) ^ (2 / (s : ℝ)) ≤ Bp s p ∧ (Bp s p : ℝ) ≤ c₂ * (p : ℝ) ^ (2 / (s : ℝ)) :=
  Proofs.Bp_asymp s hs

/-! ### `cor:dim4` -/

/-- **`cor:dim4`**, the residues `m ≢ 1 (mod 4)` (the residue `m ≡ 1` needs `prop:t3s4`, which is
not formalized here): for every prime `23 ≤ p ≤ 83` there is `C_p` such that for `m = 3` and every
`m ≥ 6` with `m ≢ 1 (mod 4)` there is a digital `(0,m,4)`-net over `𝔽_p` (the nets of `thm:4D`,
`thm:S2`, `thm:S1`) with toroidal `δ N^(1/4) ≥ 1/√31` and covering radius `h N^(1/4) ≤ C_p`
(Euclidean, in `[0,1)⁴`). -/
theorem dim4 (p : ℕ) [Fact p.Prime] (h23 : 23 ≤ p) (h83 : p ≤ 83) :
    ∃ Cp : ℝ, ∀ m : ℕ, 3 ≤ m → m ≠ 4 → m % 4 ≠ 1 →
      ∃ C : Fin 4 → Matrix (Fin m) (Fin m) (ZMod p), IsNet0 4 p m (digPoint p m C) ∧
        (∀ v w : Fin m → ZMod p, v ≠ w →
          1 / Real.sqrt 31 * ((p : ℝ) ^ m) ^ (-(1 / 4 : ℝ)) ≤
            Real.sqrt (∑ c, ((cres (p ^ m) ((digPoint p m C v c : ℤ) - (digPoint p m C w c : ℤ)) : ℝ)
              / (p : ℝ) ^ m) ^ 2)) ∧
        ∀ y : Fin 4 → ℝ, (∀ c, 0 ≤ y c ∧ y c < 1) → ∃ v : Fin m → ZMod p,
          Real.sqrt (∑ c, (y c - (digPoint p m C v c : ℝ) / (p : ℝ) ^ m) ^ 2) ≤
            Cp * ((p : ℝ) ^ m) ^ (-(1 / 4 : ℝ)) :=
  Proofs.dim4 p h23 h83

