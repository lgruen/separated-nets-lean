/-
Development copy (Solution side) of the new definitions of ChallengeDim3 (entry Dim3).
Generated by `scripts/sync_dim3defs.py` up to V14 stage S0 (the entry files are deleted since); V14 stage
S9′ edited `bndDim3` by hand (the `m = 3` term is now the column net `𝒞_p`, `Z3NetC.cCol`). The
definitions that ChallengeDim3 repeats from ChallengeKN are those of `Z3Net/KNDefs.lean`.
-/
module
public import Z3Net.KNDefs
public import Z3Net.ColDefs

@[expose] public section

namespace Z3NetKN

open Matrix

/-! ## New definitions (entry Dim3) -/

/-! ### Entry S1's skeleton predicate (`ChallengeS1.lean`; helpers renamed) -/

/-- Coarse depth of coordinate `c` for `m = s k + (s - 1)` (entry S1's `depth`): `k + 1` for the
full coordinates `c < s - 1`, `k` for the skeleton coordinate `c = s - 1`. -/
def depthS1 (s k : ℕ) (c : Fin s) : ℕ := if (c : ℕ) + 1 < s then k + 1 else k

/-- First index digit of block `c` (entry S1's `off`): `c (k + 1)`. -/
def offS1 (k : ℕ) {s : ℕ} (c : Fin s) : ℕ := (c : ℕ) * (k + 1)

/-- Coefficient of index digit `col` in the S1 skeleton digit (entry S1's `skRow`): `ρ^(d+1)` if
`col` is the last coarse level `k` of the full block `d` (`col = d (k+1) + k`, `d < s - 1`),
else `0`. -/
def skRowS1 (s k ρ col : ℕ) : ℕ :=
  if col % (k + 1) = k ∧ col / (k + 1) + 1 < s then ρ ^ (col / (k + 1) + 1) else 0

/-- Entry S1's skeleton predicate (`IsS1skel` of `ChallengeS1.lean`): `C` is in graph form with
depths `depthS1 s k` and the skeleton digit is `S_z = ∑_{d < s-1} ρ^(d+1) x_{d,k}`. -/
def IsS1skel (s p k ρ : ℕ)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p)) : Prop :=
  (∀ c : Fin s, ∀ j < depthS1 s k c, ∀ col < s * k + (s - 1),
      ent (C c) j col = if col = offS1 k c + j then 1 else 0) ∧
  (∀ z : Fin s, (z : ℕ) + 1 = s → ∀ col < s * k + (s - 1),
      ent (C z) k col = ((skRowS1 s k ρ col : ℕ) : ZMod p))

/-- `ρ_s(p)`: the largest `ρ ≤ p` with `ρ^s < p` (entry S1's `rhoS`; `= ⌊p^(1/s)⌋` for prime `p`). -/
def rhoS (s p : ℕ) : ℕ := Nat.findGreatest (fun ρ => ρ ^ s < p) p

/-- `μ = ⌈p / ρ^(s-1)⌉` (entry S1's `muS`). -/
def muS (s p ρ : ℕ) : ℕ := (p + ρ ^ (s - 1) - 1) / ρ ^ (s - 1)

/-! ### The Möbius frame `(τ², I, τ)` in graph form with unequal depths -/

/-- `τ` on `ℤ[t]_{<m}`, `(τV)(t) = (1-t)^(m-1) V(1/(1-t))` (as `tau` in `Challenge.lean`). -/
def tauD (m : ℕ) : Matrix (Fin m) (Fin m) ℤ :=
  fun i l => (-1) ^ (i : ℕ) * ((m - 1 - (l : ℕ)).choose (i : ℕ) : ℤ)

/-- The frame reading of coordinate `c` (`c = 0, 1, 2`): `τ²`, `I`, `τ`. -/
def frameZD (m c : ℕ) : Matrix (Fin m) (Fin m) ℤ :=
  if c = 0 then tauD m * tauD m else if c = 1 then 1 else tauD m

/-- Coarse depth of coordinate `c` (a natural number) for `m = 3k + r`. -/
def depN (r k c : ℕ) : ℕ := if c < r then k + 1 else k

/-- First index digit of block `c`. -/
def offN (r k c : ℕ) : ℕ :=
  if c = 0 then 0 else if c = 1 then depN r k 0 else depN r k 0 + depN r k 1

/-- Block (`0, 1, 2`) of the index digit `i`. -/
def blkN (r k i : ℕ) : ℕ :=
  if i < depN r k 0 then 0 else if i < depN r k 0 + depN r k 1 then 1 else 2

/-- Box matrix of the frame for the depths `depN r k`: row `i` is digit `i - offN (blkN i)` of the
reading `blkN i`. -/
def frameBoxD (r k : ℕ) : Matrix (Fin (3 * k + r)) (Fin (3 * k + r)) ℤ :=
  fun i col => ent (frameZD (3 * k + r) (blkN r k i)) ((i : ℕ) - offN r k (blkN r k i)) col

/-- The frame's graph form `Φ^F` over `𝔽_p`: the reading `c` times the inverse box matrix. -/
noncomputable def frameGrN (r p k c : ℕ) : Matrix (Fin (3 * k + r)) (Fin (3 * k + r)) (ZMod p) :=
  (frameZD (3 * k + r) c).map (Int.cast : ℤ → ZMod p) *
    ((frameBoxD r k).map (Int.cast : ℤ → ZMod p))⁻¹

/-! ### `def:B`, family `𝓑²` (`K = (k+1, k+1, k)`) -/

/-- The first offset row `Z0` of `z` in the frame's graph form (`m = 3k + 2`). -/
noncomputable def aB2 (p k j : ℕ) : ZMod p := ent (frameGrN 2 p k 2) k j

/-- Column gauge of `𝓑²` (move (c)): in block `x` subtract `Z0|x_l / Z0|x_k` times level `x_k` from
every level `x_l`, `l < k`, and scale level `x_k` by `ρ / Z0|x_k`; the same in block `y` (last
level `y_k`, index digit `2k + 1`) with target `ρ²`. -/
noncomputable def gaugeB2 (p k ρ : ℕ) : Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p) :=
  fun i j =>
    if (j : ℕ) ≤ k then
      (if (i : ℕ) = k then
        (if (j : ℕ) = k then (ρ : ZMod p) * (aB2 p k k)⁻¹ else -(aB2 p k j) * (aB2 p k k)⁻¹)
       else if i = j then 1 else 0)
    else if (j : ℕ) ≤ 2 * k + 1 then
      (if (i : ℕ) = 2 * k + 1 then
        (if (j : ℕ) = 2 * k + 1 then (ρ : ZMod p) ^ 2 * (aB2 p k (2 * k + 1))⁻¹
         else -(aB2 p k j) * (aB2 p k (2 * k + 1))⁻¹)
       else if i = j then 1 else 0)
    else if i = j then 1 else 0

/-- **The net `𝓑²_{k,p,ρ}` of Definition `def:B`**: coarse rows in graph form, diagonal blocks `0`,
every other entry that of `Φ^F · gaugeB2` (the frame's graph form after the column gauge). -/
noncomputable def B2gen (p k ρ : ℕ) (c : Fin 3) :
    Matrix (Fin (3 * k + 2)) (Fin (3 * k + 2)) (ZMod p) :=
  fun i col =>
    if (i : ℕ) < depN 2 k c then (if (col : ℕ) = offN 2 k c + i then 1 else 0)
    else if blkN 2 k col = (c : ℕ) then 0
    else (frameGrN 2 p k c * gaugeB2 p k ρ) i col

/-! ### `def:B`, family `𝓑¹` (`K = (k+1, k, k)`) -/

/-- The first offset row `Y0` of `y` in the frame's graph form (`m = 3k + 1`). -/
noncomputable def yB1 (p k j : ℕ) : ZMod p := ent (frameGrN 1 p k 1) k j

/-- The first offset row `Z0` of `z` in the frame's graph form (`m = 3k + 1`). -/
noncomputable def zB1 (p k j : ℕ) : ZMod p := ent (frameGrN 1 p k 2) k j

/-- The `2 × 2` pivot `Y0|x_k Z0|x_{k-1} - Y0|x_{k-1} Z0|x_k` (box `(k-1, k+1, k+1)`). -/
noncomputable def detB1 (p k : ℕ) : ZMod p :=
  yB1 p k k * zB1 p k (k - 1) - yB1 p k (k - 1) * zB1 p k k

/-- Column gauge of `𝓑¹` (moves (c)). Block `x` (index digits `0..k`): with the levels `x_k`,
`x_{k-1}` make `Y0`, `Z0` vanish on the levels `l < k - 1` (Cramer's rule with `detB1`), then add
`-Y0|x_{k-1}/Y0|x_k` times `x_k` to `x_{k-1}`, and scale `x_k` by
`σ = ρ² detB1 / (Z0|x_k Y0|x_k)`. Block `y` (digits `k+1..2k`, last level `2k`): subtract
`Z0|y_l / Z0|y_{k-1}` times the last level. Block `z` (digits `2k+1..3k`, last level `3k`): the
same with `Y0`. -/
noncomputable def gaugeB1 (p k ρ : ℕ) : Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p) :=
  fun i j =>
    if (j : ℕ) ≤ k then
      (if (j : ℕ) = k then
        (if (i : ℕ) = k then
          (ρ : ZMod p) ^ 2 * detB1 p k * (zB1 p k k * yB1 p k k)⁻¹ else 0)
       else if (j : ℕ) + 1 = k then
        (if (i : ℕ) = k then -(yB1 p k (k - 1)) * (yB1 p k k)⁻¹
         else if i = j then 1 else 0)
       else
        (if (i : ℕ) = k then
          -(zB1 p k (k - 1) * yB1 p k j - yB1 p k (k - 1) * zB1 p k j) * (detB1 p k)⁻¹
         else if (i : ℕ) + 1 = k then
          -(yB1 p k k * zB1 p k j - zB1 p k k * yB1 p k j) * (detB1 p k)⁻¹
         else if i = j then 1 else 0))
    else if (j : ℕ) ≤ 2 * k then
      (if (j : ℕ) < 2 * k ∧ (i : ℕ) = 2 * k then -(zB1 p k j) * (zB1 p k (2 * k))⁻¹
       else if i = j then 1 else 0)
    else
      (if (j : ℕ) < 3 * k ∧ (i : ℕ) = 3 * k then -(yB1 p k j) * (yB1 p k (3 * k))⁻¹
       else if i = j then 1 else 0)

/-- Block scalings of `𝓑¹` (move (b)): `Φ_zx` by `Y0|x_k / detB1` (so that `Z0|x_{k-1} = 1`),
`Φ_yx` by `Z0|x_k / (ρ detB1)` (so that `Y0|x_k = ρ`), `Φ_zy` by `1 / Z0|y_{k-1}`, `Φ_yz` by
`1 / Y0|z_{k-1}`; all other blocks unscaled. -/
noncomputable def scalB1 (p k ρ c d : ℕ) : ZMod p :=
  if c = 2 ∧ d = 0 then yB1 p k k * (detB1 p k)⁻¹
  else if c = 1 ∧ d = 0 then zB1 p k k * ((ρ : ZMod p) * detB1 p k)⁻¹
  else if c = 2 ∧ d = 1 then (zB1 p k (2 * k))⁻¹
  else if c = 1 ∧ d = 2 then (yB1 p k (3 * k))⁻¹
  else 1

/-- **The net `𝓑¹_{k,p,ρ}` of Definition `def:B`**: coarse rows in graph form; diagonal blocks `0`
except `Z0|z_{k-1} = -1` (move (a)); every other entry that of `Φ^F · gaugeB1`, scaled by
`scalB1` of its block. -/
noncomputable def B1gen (p k ρ : ℕ) (c : Fin 3) :
    Matrix (Fin (3 * k + 1)) (Fin (3 * k + 1)) (ZMod p) :=
  fun i col =>
    if (i : ℕ) < depN 1 k c then (if (col : ℕ) = offN 1 k c + i then 1 else 0)
    else if blkN 1 k col = (c : ℕ) then
      (if (c : ℕ) = 2 ∧ (i : ℕ) = k ∧ (col : ℕ) = 3 * k then -1 else 0)
    else scalB1 p k ρ c (blkN 1 k col) * (frameGrN 1 p k c * gaugeB1 p k ρ) i col

/-! ### Constants -/

/-- `ρ` maximal for `𝓑¹`: the largest `ρ ≤ p` with `ρ²(ρ+1) ≤ p`. -/
def rhoB1 (p : ℕ) : ℕ := Nat.findGreatest (fun ρ => ρ ^ 2 * (ρ + 1) ≤ p) p

/-- `g(ρ) = (ρ-2)³(ρ+2)/(ρ+1)⁴` (proof of `thm:allm`, "Constants"). -/
noncomputable def gB1 (ρ : ℝ) : ℝ :=
  (ρ - ((2 : ℕ) : ℝ)) ^ 3 * (ρ + ((2 : ℕ) : ℝ)) / (ρ + 1) ^ 4

/-- The `𝓑¹` bound `(ρ² - 4) p^(-2/3)` with `ρ = rhoB1 p` (`thm:allm`). -/
noncomputable def bndB1 (p : ℕ) : ℝ :=
  ((rhoB1 p : ℝ) ^ 2 - ((4 : ℕ) : ℝ)) * (p : ℝ) ^ (-(((2 : ℕ) : ℝ) / ((3 : ℕ) : ℝ)))

/-- The `𝓑²` bound `(ρ - 1) p^(-1/3)` with `ρ = ρ_3(p)` (`thm:S1` at `s = 3`, `rem:B2`). -/
noncomputable def bndB2 (p : ℕ) : ℝ :=
  ((rhoS 3 p : ℝ) - 1) * (p : ℝ) ^ (-(1 / ((3 : ℕ) : ℝ)))

/-- The uniform lower bound of `cor:allm`: the minimum of the bounds of the four families
(`thm:col`, the column net `𝒞_p` with its exact constant `Z3NetC.cCol p`; `thm:main` with
`c(p) = 1 - 1/p`; `thm:allm`; `thm:S1` at `s = 3`). (Until V14 stage S9′ the `m = 3` term was the bound
of the former `thm:E1`, removed from the paper in revision 15.0.) -/
noncomputable def bndDim3 (p : ℕ) : ℝ :=
  min (min (Z3NetC.cCol p) (1 - 1 / (p : ℝ))) (min (bndB1 p) (bndB2 p))

end Z3NetKN
