/-
Solution-side restatement of ChallengeHalf.lean (generated by scripts/gen_mainmod.py): each compared
statement, verbatim, closed by the corresponding Proofs.* theorem.
-/
module
public import Z3Net.HalfDefs
public import Z3Net.HalfLam
public import Z3Net.HalfSep
public import Z3Net.HalfGen
public import Z3Net.HalfLam68
public import Z3Net.HalfTab

@[expose] public section

namespace Z3NetHL

open Matrix Finset

/-- **The graph forms of `prop:half`.** For odd `p`, `halfPhi s p M2 D` has row `0` equal to the
layer `M = M2/2` (`½ ≡ (p+1)/2`), i.e. it satisfies `RowDesign s p 1 · (fun _ => M2)`. -/
theorem halfPhi_row (s p : ℕ) (hs : 2 ≤ s) (hp : Odd p) (M2 : Fin s → Fin s → ℤ)
    (D : Fin s → ℕ → Fin s → ℤ) :
    RowDesign s p 1 (halfPhi s p M2 D) (fun _ => M2) :=
  Proofs.halfPhi_row s p hs hp M2 D

/-- **`prop:half`(1), separation.** For every half-integer layer, every odd prime
`p > 2(2A+1)` and every graph form with depths `(1, …, 1)` whose row `0` is the layer (deeper rows
arbitrary): `δ N^(1/s) ≥ LB₂(p)` (toroidal distance, `N = p^s`). -/
theorem half_sep (s p : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hp2 : p ≠ 2)
    (M2 : Fin s → Fin s → ℤ) (hodd : ∀ c d, Odd (M2 c d)) (hpA : 2 * halfA2 M2 + 2 < p)
    (Φ : Fin s → Fin s → Matrix (Fin (s * 1 - 1)) (Fin 1) (ZMod p))
    (hrow : RowDesign s p 1 Φ (fun _ => M2)) (x y : Fin (s * 1) → ZMod p) (hxy : x ≠ y) :
    halfLB2 p M2 * ((p : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (s * 1))
          ((GFpoint s p 1 Φ x c : ℤ) - (GFpoint s p 1 Φ y c : ℤ)) : ℝ) / (p : ℝ) ^ (s * 1)) ^ 2) :=
  Proofs.half_sep s p hs hp hp2 M2 hodd hpA Φ hrow x y hxy

/-- **`prop:half`(1), the second inequality**: `LB₂(p) ≥ λ(M) - √s (2A+1)/p` (every `p ≥ 1`). -/
theorem half_LB2_ge (s p : ℕ) (hs : 2 ≤ s) (hp : 1 ≤ p) (M2 : Fin s → Fin s → ℤ) :
    halfLam M2 - Real.sqrt s * ((halfA2 M2 : ℝ) + 1) / p ≤ halfLB2 p M2 :=
  Proofs.half_LB2_ge s p hs hp M2

/-- **`prop:half`(1)**: `λ(M) ≤ min(√s/2, √2)` for every `M`. -/
theorem half_lam_le (s : ℕ) (hs : 2 ≤ s) (M2 : Fin s → Fin s → ℤ) :
    halfLam M2 ≤ min (Real.sqrt s / 2) (Real.sqrt 2) :=
  Proofs.half_lam_le s hs M2

/-- **`prop:half`(1)**: equality `λ(M) = min(√s/2, √2)` if `M` is weakly diagonally dominant,
`M_cc ≤ -∑_{d ≠ c} |M_cd|` for every `c`. -/
theorem half_lam_dom (s : ℕ) (hs : 2 ≤ s) (M2 : Fin s → Fin s → ℤ)
    (hdom : ∀ c, M2 c c ≤ -∑ d ∈ univ.erase c, |M2 c d|) :
    halfLam M2 = min (Real.sqrt s / 2) (Real.sqrt 2) :=
  Proofs.half_lam_dom s hs M2 hdom

/-- **The matching upper bound** (after `prop:half`; `prop:Hk`(3) at `k = 1`): with
`C = max |M_cd|` and a prime `p > 4sC + 2`, every graph form whose row `0` is a half-integer
layer has two distinct points at Euclidean (hence toroidal) distance at most
`(min(√s/2, √2) + √s (2C+1)/p) N^(-1/s)`. -/
theorem half_upper (s p : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (M2 : Fin s → Fin s → ℤ)
    (hodd : ∀ c d, Odd (M2 c d)) (hpC : 2 * s * C2max s (fun _ => M2) + 2 < p)
    (Φ : Fin s → Fin s → Matrix (Fin (s * 1 - 1)) (Fin 1) (ZMod p))
    (hrow : RowDesign s p 1 Φ (fun _ => M2)) :
    ∃ x y : Fin (s * 1) → ZMod p, x ≠ y ∧
      Real.sqrt (∑ c, (((GFpoint s p 1 Φ x c : ℝ) - (GFpoint s p 1 Φ y c : ℝ)) / (p : ℝ) ^ (s * 1)) ^ 2)
        ≤ (min (Real.sqrt s / 2) (Real.sqrt 2) + Real.sqrt s * ((C2max s (fun _ => M2) : ℝ) + 1) / p) *
          ((p : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ))) :=
  Proofs.half_upper s p hs hp M2 hodd hpC Φ hrow

/-- **The limit** ("The packing", after `prop:half`): for a half-integer layer with
`λ(M) = min(√s/2, √2)` (in particular a dominant one), `δ N^(1/s) → min(√s/2, √2)` as the prime
`p → ∞`, for every choice of the deeper rows. -/
theorem half_limit (s : ℕ) (hs : 3 ≤ s) (M2 : Fin s → Fin s → ℤ) (hodd : ∀ c d, Odd (M2 c d))
    (hlam : halfLam M2 = min (Real.sqrt s / 2) (Real.sqrt 2)) (ε : ℝ) (hε : 0 < ε) :
    ∃ P : ℕ, ∀ p : ℕ, p.Prime → P ≤ p →
      ∀ Φ : Fin s → Fin s → Matrix (Fin (s * 1 - 1)) (Fin 1) (ZMod p),
        RowDesign s p 1 Φ (fun _ => M2) →
        (∀ x y : Fin (s * 1) → ZMod p, x ≠ y →
          (min (Real.sqrt s / 2) (Real.sqrt 2) - ε) * ((p : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ)))
            ≤ Real.sqrt (∑ c, ((cres (p ^ (s * 1))
                ((GFpoint s p 1 Φ x c : ℤ) - (GFpoint s p 1 Φ y c : ℤ)) : ℝ) / (p : ℝ) ^ (s * 1)) ^ 2)) ∧
        ∃ x y : Fin (s * 1) → ZMod p, x ≠ y ∧
          Real.sqrt (∑ c, (((GFpoint s p 1 Φ x c : ℝ) - (GFpoint s p 1 Φ y c : ℝ)) / (p : ℝ) ^ (s * 1)) ^ 2)
            ≤ (min (Real.sqrt s / 2) (Real.sqrt 2) + ε) * ((p : ℝ) ^ (s * 1)) ^ (-(1 / (s : ℝ))) :=
  Proofs.half_limit s hs M2 hodd hlam ε hε

/-- **`prop:half`(2)**: if every square submatrix of `M` with disjoint row and column index sets
has nonzero determinant, there are integer deeper rows such that the graph form is a digital
`(0,s,s)`-net over `𝔽_p` for all but finitely many primes `p`. -/
theorem half_net_generic (s : ℕ) (M2 : Fin s → Fin s → ℤ) (hM : DisjMinors M2) :
    ∃ D : Fin s → ℕ → Fin s → ℤ, ∃ S : Finset ℕ, ∀ p : ℕ, p.Prime → p ∉ S →
      IsNet0 s p (s * 1) (GFpoint s p 1 (halfPhi s p M2 D)) :=
  Proofs.half_net_generic s M2 hM

/-- **`prop:half`(2)**, existence: there are off-diagonal entries in `½ + ℤ` such that, with any
diagonal, every disjoint square minor is nonzero; in particular a weakly dominant half-integer
`M` with this property exists (for every `s`; the paper states `s ≥ 4`). -/
theorem half_M_exists (s : ℕ) :
    (∃ O : Fin s → Fin s → ℤ, (∀ c d, c ≠ d → Odd (O c d)) ∧
      ∀ M2 : Fin s → Fin s → ℤ, (∀ c d, c ≠ d → M2 c d = O c d) → DisjMinors M2) ∧
    ∃ M2 : Fin s → Fin s → ℤ, (∀ c d, Odd (M2 c d)) ∧
      (∀ c, M2 c c ≤ -∑ d ∈ univ.erase c, |M2 c d|) ∧ DisjMinors M2 :=
  Proofs.half_M_exists s

/-- **`tab:half`, the certified values** `LB₂(p)` (truncated to four digits), for the designs
`M5h`, `M6h`, `M8h`. -/
theorem half_tab_LB2 :
    ((1.0056 : ℝ) ≤ halfLB2 89 M5h ∧ (1.0188 : ℝ) ≤ halfLB2 101 M5h ∧
      (1.0704 : ℝ) ≤ halfLB2 211 M5h ∧ (1.1080 : ℝ) ≤ halfLB2 1009 M5h ∧
      (1.1179 : ℝ) ≤ halfLB2 100003 M5h) ∧
    ((1.1113 : ℝ) ≤ halfLB2 211 M6h ∧ (1.2009 : ℝ) ≤ halfLB2 1009 M6h ∧
      (1.2223 : ℝ) ≤ halfLB2 10007 M6h ∧ (1.2247 : ℝ) ≤ halfLB2 1000003 M6h) ∧
    ((1.3488 : ℝ) ≤ halfLB2 1009 M8h ∧ (1.4076 : ℝ) ≤ halfLB2 10007 M8h ∧
      (1.4141 : ℝ) ≤ halfLB2 1000003 M8h) :=
  Proofs.half_tab_LB2 

/-- **`tab:half` as lower bounds for `δ N^(1/5)`** (design `M5h`): for every tabulated pair
`(p, v)` and every graph form whose row `0` is the design (deeper rows arbitrary),
`δ N^(1/5) ≥ v` (toroidal distance). -/
theorem half5_tab_sep (p : ℕ) (v : ℝ)
    (hv : (p = 89 ∧ v = 1.0056) ∨
      (p = 101 ∧ v = 1.0188) ∨
      (p = 211 ∧ v = 1.0704) ∨
      (p = 1009 ∧ v = 1.1080) ∨
      (p = 100003 ∧ v = 1.1179))
    (Φ : Fin 5 → Fin 5 → Matrix (Fin (5 * 1 - 1)) (Fin 1) (ZMod p))
    (hrow : RowDesign 5 p 1 Φ (fun _ => M5h)) (x y : Fin (5 * 1) → ZMod p) (hxy : x ≠ y) :
    v * ((p : ℝ) ^ (5 * 1)) ^ (-(1 / (5 : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (5 * 1))
          ((GFpoint 5 p 1 Φ x c : ℤ) - (GFpoint 5 p 1 Φ y c : ℤ)) : ℝ) / (p : ℝ) ^ (5 * 1)) ^ 2) :=
  Proofs.half5_tab_sep p v hv Φ hrow x y hxy

/-- **`tab:half` as lower bounds for `δ N^(1/6)`** (design `M6h`): for every tabulated pair
`(p, v)` and every graph form whose row `0` is the design (deeper rows arbitrary),
`δ N^(1/6) ≥ v` (toroidal distance). -/
theorem half6_tab_sep (p : ℕ) (v : ℝ)
    (hv : (p = 211 ∧ v = 1.1113) ∨
      (p = 1009 ∧ v = 1.2009) ∨
      (p = 10007 ∧ v = 1.2223) ∨
      (p = 1000003 ∧ v = 1.2247))
    (Φ : Fin 6 → Fin 6 → Matrix (Fin (6 * 1 - 1)) (Fin 1) (ZMod p))
    (hrow : RowDesign 6 p 1 Φ (fun _ => M6h)) (x y : Fin (6 * 1) → ZMod p) (hxy : x ≠ y) :
    v * ((p : ℝ) ^ (6 * 1)) ^ (-(1 / (6 : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (6 * 1))
          ((GFpoint 6 p 1 Φ x c : ℤ) - (GFpoint 6 p 1 Φ y c : ℤ)) : ℝ) / (p : ℝ) ^ (6 * 1)) ^ 2) :=
  Proofs.half6_tab_sep p v hv Φ hrow x y hxy

/-- **`tab:half` as lower bounds for `δ N^(1/8)`** (design `M8h`): for every tabulated pair
`(p, v)` and every graph form whose row `0` is the design (deeper rows arbitrary),
`δ N^(1/8) ≥ v` (toroidal distance). -/
theorem half8_tab_sep (p : ℕ) (v : ℝ)
    (hv : (p = 1009 ∧ v = 1.3488) ∨
      (p = 10007 ∧ v = 1.4076) ∨
      (p = 1000003 ∧ v = 1.4141))
    (Φ : Fin 8 → Fin 8 → Matrix (Fin (8 * 1 - 1)) (Fin 1) (ZMod p))
    (hrow : RowDesign 8 p 1 Φ (fun _ => M8h)) (x y : Fin (8 * 1) → ZMod p) (hxy : x ≠ y) :
    v * ((p : ℝ) ^ (8 * 1)) ^ (-(1 / (8 : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (8 * 1))
          ((GFpoint 8 p 1 Φ x c : ℤ) - (GFpoint 8 p 1 Φ y c : ℤ)) : ℝ) / (p : ℝ) ^ (8 * 1)) ^ 2) :=
  Proofs.half8_tab_sep p v hv Φ hrow x y hxy

/-- **`tab:half`, `t = 0` "checked"** (`s = 6, 8`): at every tabulated prime there are integer
deeper rows giving a digital `(0,s,s)`-net over `𝔽_p`. -/
theorem half_tab_t0 :
    (∀ p ∈ ({211, 1009, 10007, 1000003} : Finset ℕ), ∃ D : Fin 6 → ℕ → Fin 6 → ℤ,
      IsNet0 6 p (6 * 1) (GFpoint 6 p 1 (halfPhi 6 p M6h D))) ∧
    (∀ p ∈ ({1009, 10007, 1000003} : Finset ℕ), ∃ D : Fin 8 → ℕ → Fin 8 → ℤ,
      IsNet0 8 p (8 * 1) (GFpoint 8 p 1 (halfPhi 8 p M8h D))) :=
  Proofs.half_tab_t0 

/-- **The `s = 5` design** (caption of `tab:half`): it is not dominant, but `λ(M) = √5/2`,
attained at `E = -𝟙`; and `A = 13/2`. -/
theorem half5_lam :
    halfLam M5h = Real.sqrt 5 / 2 ∧
      Real.sqrt (∑ c, halfEllInf M5h (fun _ => -1) c ^ 2) = Real.sqrt 5 / 2 ∧
      halfA2 M5h = 13 ∧ ¬ ∀ c, M5h c c ≤ -∑ d ∈ univ.erase c, |M5h c d| :=
  Proofs.half5_lam 

/-- **The `s = 6, 8` designs** (caption of `tab:half`): they are weakly dominant, so
`λ(M) = min(√s/2, √2)` (`prop:half`(1)), i.e. `√6/2` and `√2`, the column "limit". -/
theorem half68_lam :
    (∀ c, M6h c c ≤ -∑ d ∈ univ.erase c, |M6h c d|) ∧ halfLam M6h = Real.sqrt 6 / 2 ∧
    (∀ c, M8h c c ≤ -∑ d ∈ univ.erase c, |M8h c d|) ∧ halfLam M8h = Real.sqrt 2 :=
  Proofs.half68_lam 

/-- **`tab:half`, `t = 0` "explicit"** (`s = 5`): with the integer deeper rows `D5h`, the graph
form is a digital `(0,5,5)`-net over `𝔽_p` for every prime `p ∉ {2,3,5,7,11,13,17,29,41,47,257}`. -/
theorem half5_net (p : ℕ) (hp : p.Prime)
    (hS : p ∉ ({2, 3, 5, 7, 11, 13, 17, 29, 41, 47, 257} : Finset ℕ)) :
    IsNet0 5 p (5 * 1) (GFpoint 5 p 1 (halfPhi 5 p M5h D5h)) :=
  Proofs.half5_net p hp hS

/-- **"Positioning", the threshold**: `LB₂(83) < 1` and `LB₂(p) > 1` for every prime `p ≥ 89`
(exact evaluation for `89 ≤ p < 269`, `prop:half`(1) with `λ(M) = √5/2`, `A = 13/2` above). -/
theorem half5_threshold :
    halfLB2 83 M5h < 1 ∧ ∀ p : ℕ, p.Prime → 89 ≤ p → 1 < halfLB2 p M5h :=
  Proofs.half5_threshold 

/-- **"Positioning"**: the `s = 5` design gives digital `(0,5,5)`-nets with `δ N^(1/5) > 1` for
every prime `p ≥ 89` other than `257` (and the separation bound holds at `p = 257` and for every
choice of the deeper rows). -/
theorem half5_main (p : ℕ) (hp : p.Prime) (hp89 : 89 ≤ p) :
    (p ≠ 257 → IsNet0 5 p (5 * 1) (GFpoint 5 p 1 (halfPhi 5 p M5h D5h))) ∧
    ∀ Φ : Fin 5 → Fin 5 → Matrix (Fin (5 * 1 - 1)) (Fin 1) (ZMod p),
      RowDesign 5 p 1 Φ (fun _ => M5h) → ∀ x y : Fin (5 * 1) → ZMod p, x ≠ y →
        ((p : ℝ) ^ (5 * 1)) ^ (-(1 / (5 : ℝ)))
          < Real.sqrt (∑ c, ((cres (p ^ (5 * 1))
              ((GFpoint 5 p 1 Φ x c : ℤ) - (GFpoint 5 p 1 Φ y c : ℤ)) : ℝ) / (p : ℝ) ^ (5 * 1)) ^ 2) :=
  Proofs.half5_main p hp hp89

end Z3NetHL
