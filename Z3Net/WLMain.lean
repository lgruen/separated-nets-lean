/-- **`lem:hom` (additive digit functionals).**  Let `q ≥ 2`, `j ≥ 1`, `β_0, …, β_{j−1} ∈ ℤ/qℤ` and
`φ(P) = ∑_{i<j} β_i d_i(P)` for `P ∈ ℤ/q^jℤ` (digits of the representative in `[0, q^j)`, counted
from the least significant one).  Then `φ` is a homomorphism `ℤ/q^jℤ → ℤ/qℤ` if and only if
`β_i = 0` for every `i ≥ 1`. -/
theorem hom_iff (q j : ℕ) (hq : 2 ≤ q) (hj : 1 ≤ j) (β : Fin j → ZMod q) :
    (∀ P P' : ZMod (q ^ j), phiDig q j β (P + P') = phiDig q j β P + phiDig q j β P') ↔
      ∀ i : Fin j, 1 ≤ (i : ℕ) → β i = 0 := by
  exact hom_iff' q j hq hj β

/-- **`cor:linoff` (a) (one level).**  Linear conditions `H (Y mod q) = b` on the lowest base-`q`
digits of the coordinates of `Y ∈ ℤ^s` (all higher digits free): the solutions of the homogeneous
system form an additive subgroup `Λ ⊇ qℤ^s`, equal to `C + qℤ^s` for the code `C = ker H`
(Construction A), and the solutions of `H (Y mod q) = b` form a coset `Y₀ + Λ` (if nonempty). -/
theorem linoff_a (q : ℕ) [NeZero q] {s k : ℕ} (H : Matrix (Fin k) (Fin s) (ZMod q))
    (b : Fin k → ZMod q) :
    (∃ L : AddSubgroup (Fin s → ℤ), (∀ Y, Y ∈ L ↔ H *ᵥ modVec q Y = 0) ∧
      ∀ z : Fin s → ℤ, (q : ℤ) • z ∈ L) ∧
    (∀ Y : Fin s → ℤ, H *ᵥ modVec q Y = 0 ↔
      ∃ v : Fin s → ZMod q, H *ᵥ v = 0 ∧ ∃ z : Fin s → ℤ, Y = liftVec q v + (q : ℤ) • z) ∧
    (∀ Y₀ Y : Fin s → ℤ, H *ᵥ modVec q Y₀ = b →
      (H *ᵥ modVec q Y = b ↔ H *ᵥ modVec q (Y - Y₀) = 0)) := by
  exact linoff_a' q H b

/-- **`cor:linoff` (b) (two levels).**  For `q ≥ 2` and `B ∈ (ℤ/qℤ)^{s×s}`,
`T_B = {qℓ + (Bℓ mod q)} ⊂ (ℤ/q²ℤ)^s` is a subgroup iff `Bc ≡ 0 (mod q)` for the carry vector
`c = (⌊(v_i + v'_i)/q⌋)_i` of every two vectors `v = Bℓ mod q`, `v' = Bℓ' mod q`; and if `s ≥ 1`
and `B` is invertible, `T_B` is not a subgroup. -/
theorem linoff_b (q : ℕ) (hq : 2 ≤ q) {s : ℕ} (B : Matrix (Fin s) (Fin s) (ZMod q)) :
    ((∃ G : AddSubgroup (Fin s → ZMod (q ^ 2)), (G : Set (Fin s → ZMod (q ^ 2))) = TB q B) ↔
      ∀ ℓ ℓ' : Fin s → ZMod q,
        B *ᵥ (fun i => ((carryVec q (fun i => ((B *ᵥ ℓ) i).val) (fun i => ((B *ᵥ ℓ') i).val) i :
          ℕ) : ZMod q)) = 0) ∧
    (0 < s → IsUnit B →
      ¬ ∃ G : AddSubgroup (Fin s → ZMod (q ^ 2)), (G : Set (Fin s → ZMod (q ^ 2))) = TB q B) := by
  exact linoff_b' q hq B

/-- **`cor:linoff` (c) (locally a lattice).**  Let a digital net over `ℤ/qℤ` be in graph form `Φ`
with depths `(k, …, k)` (`gfPt`; `a = sk − k` offset digits per coordinate), with geometric layer
`M̃` (`M c d ≡ (Φ_cd)_{0,k−1}`, any integer representatives), and let the cells of `w` and `v`
differ only in their last level, by `E ∈ ℤ^s` (no carry: `cell(w) = cell(v) + E` and
`(cell(v) mod q) + E ∈ [0, q)` in every coordinate).  If the geometric digits `r` of `v` satisfy
`r + M̃E ∈ [0, q)^s`, then the geometric digits of `w` are `r + M̃E`, and in each coordinate
`X(w) − X(v) = q^a E + q^(a−1) (M̃E) + (deep(w) − deep(v))`, i.e. in cell units the points differ by
`(I + M̃/q)E + (f' − f)/q` with `f = deep/q^(a−1) ∈ [0, 1)`. -/
theorem linoff_c (q s k : ℕ) [NeZero q] (hq : 2 ≤ q) (hs : 2 ≤ s) (hk : 1 ≤ k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q)) (M : Fin s → Fin s → ℤ)
    (hM : ∀ c d (r : Fin (s * k - k)) (l : Fin k), (r : ℕ) = 0 → (l : ℕ) = k - 1 →
      ((M c d : ℤ) : ZMod q) = Φ c d r l)
    (v w : Fin (s * k) → ZMod q) (E : Fin s → ℤ)
    (hcell : ∀ d, (cellPart q (s * k - k) (gfPt q s k Φ w d) : ℤ) =
      cellPart q (s * k - k) (gfPt q s k Φ v d) + E d)
    (hnc : ∀ d, 0 ≤ ((cellPart q (s * k - k) (gfPt q s k Φ v d) % q : ℕ) : ℤ) + E d ∧
      ((cellPart q (s * k - k) (gfPt q s k Φ v d) % q : ℕ) : ℤ) + E d < q)
    (hr : ∀ c, 0 ≤ (geoPart q (s * k - k) (gfPt q s k Φ v c) : ℤ) + ∑ d, M c d * E d ∧
      (geoPart q (s * k - k) (gfPt q s k Φ v c) : ℤ) + ∑ d, M c d * E d < q) (c : Fin s) :
    (geoPart q (s * k - k) (gfPt q s k Φ w c) : ℤ) =
        geoPart q (s * k - k) (gfPt q s k Φ v c) + ∑ d, M c d * E d ∧
      (gfPt q s k Φ w c : ℤ) - gfPt q s k Φ v c =
        (q : ℤ) ^ (s * k - k) * E c + (q : ℤ) ^ (s * k - k - 1) * ∑ d, M c d * E d +
          ((deepPart q (s * k - k) (gfPt q s k Φ w c) : ℤ) -
            deepPart q (s * k - k) (gfPt q s k Φ v c)) := by
  exact linoff_c' q s k hq hs hk Φ M hM v w E hcell hnc hr c

/-- **`lem:phase` (i) (phase closure).**  Over `𝔽_p` with depths `(1, …, 1)`, the geometric digit
of the cell `n` is `r(n) = Bn ∈ [0, p)^s`.  For `E ∈ ℤ^s`, `β = BE mod p` and `n' ≡ n + E`:
`r(n') = r(n) + β − pκ` with `κ_c = [r_c(n) + β_c ≥ p]`, and `κ_c = 0` whenever `β_c = 0`. -/
theorem phase_i (p : ℕ) (hp : p.Prime) {s : ℕ} (B : Matrix (Fin s) (Fin s) (ZMod p))
    (n : Fin s → ZMod p) (E : Fin s → ℤ) (c : Fin s) :
    (geoR p B (n + fun i => ((E i : ℤ) : ZMod p)) c : ℤ) =
      geoR p B n c + betaE p B E c - p * wrapK p B n E c ∧
    (betaE p B E c = 0 → wrapK p B n E c = 0) := by
  exact phase_i' p hp B n E c

/-- **`lem:phase` (i), free wraps.**  If `B` is invertible, every `κ ∈ {0, 1}^s` with `κ_c = 0`
whenever `β_c = 0` is the wrap vector of some cell `n`. -/
theorem phase_i_free (p : ℕ) (hp : p.Prime) {s : ℕ} (B : Matrix (Fin s) (Fin s) (ZMod p))
    (hB : IsUnit B) (E : Fin s → ℤ) (κ : Fin s → ℕ) (hκ : ∀ c, κ c ≤ 1)
    (hκβ : ∀ c, betaE p B E c = 0 → κ c = 0) :
    ∃ n : Fin s → ZMod p, ∀ c, wrapK p B n E c = κ c := by
  exact phase_i_free' p hp B hB E κ hκ hκβ

/-- **`lem:phase` (ii) (unit minors).**  Let a digital `(0, sk, s)`-net over `ℤ/qℤ`, `k ≥ 1`, be in
graph form with depths `(k, …, k)` and geometric layer `M̃` (`M c d = (Φ_cd)_{0,k−1}`).  For
disjoint `T, Z ⊂ {1, …, s}` with `|T| = |Z|` (a bijection `σ : Z ≃ T`), `det M̃_{T,Z}` is a unit
of `ℤ/qℤ`. -/
theorem phase_ii (q s k : ℕ) [NeZero q] (hk : 1 ≤ k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPt q s k Φ)) (M : Fin s → Fin s → ZMod q)
    (hM : ∀ c d (r : Fin (s * k - k)) (l : Fin k), (r : ℕ) = 0 → (l : ℕ) = k - 1 →
      M c d = Φ c d r l)
    (T Z : Finset (Fin s)) (hTZ : Disjoint T Z) (σ : Z ≃ T) :
    IsUnit (Matrix.of fun a b : Z => M (σ a) b).det := by
  exact phase_ii' q s k hk Φ hnet M hM T Z hTZ σ

/-- **`lem:phase` (ii), rank.**  In the situation of `phase_ii`, `M̃` has rank at least `⌊s/2⌋` modulo
every prime factor `ℓ` of `q`. -/
theorem phase_ii_rank (q s k : ℕ) [NeZero q] (hk : 1 ≤ k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPt q s k Φ)) (M : Fin s → Fin s → ZMod q)
    (hM : ∀ c d (r : Fin (s * k - k)) (l : Fin k), (r : ℕ) = 0 → (l : ℕ) = k - 1 →
      M c d = Φ c d r l) :
    ∀ ℓ : ℕ, ℓ.Prime → ∀ h : ℓ ∣ q,
      s / 2 ≤ (Matrix.map (M : Matrix (Fin s) (Fin s) (ZMod q)) (ZMod.castHom h (ZMod ℓ))).rank := by
  exact phase_ii_rank' q s k hk Φ hnet M hM

/-- **`prop:cube` (i), reduction to Hajós's theorem.**  If `L` is an additive subgroup of `ℝ^s` with
one point per unit cube and `ℤ^s + L` is dense, then (given Hajós's theorem `HajosProp s`, not
proved here) `L` contains a unit vector `e_c`; so `μ(L) ≤ 1`. -/
theorem cube_i {s : ℕ} (hajos : HajosProp s) (L : AddSubgroup (Fin s → ℝ))
    (h1 : OnePerCube (L : Set (Fin s → ℝ))) (hdense : Dense (intPlus (L : Set (Fin s → ℝ)))) :
    ∃ c, unitVec c ∈ L ∧ minDist (L : Set (Fin s → ℝ)) ≤ 1 := by
  exact cube_i' hajos L h1 hdense

/-- **`prop:cube` (ii), reduction to Hajós's theorem.**  If `L ⊂ ℚ^s` is a lattice (here: a finitely
generated subgroup with rational coordinates) with one point per unit cube whose phase group
`(L + ℤ^s)/ℤ^s` is the product of its coordinate projections, then (given `HajosProp s`) `L`
contains a unit vector `e_c`; so `μ(L) ≤ 1`. -/
theorem cube_ii {s : ℕ} (hajos : HajosProp s) (L : AddSubgroup (Fin s → ℝ)) (hfg : L.FG)
    (hrat : ∀ ℓ ∈ L, ∀ c, ∃ r : ℚ, ℓ c = r) (h1 : OnePerCube (L : Set (Fin s → ℝ)))
    (hprod : ∀ x : Fin s → ℝ, (∀ c, ∃ ℓ ∈ L, ∃ n : ℤ, x c = ℓ c + n) →
      x ∈ intPlus (L : Set (Fin s → ℝ))) :
    ∃ c, unitVec c ∈ L ∧ minDist (L : Set (Fin s → ℝ)) ≤ 1 := by
  exact cube_ii' hajos L hfg hrat h1 hprod

/-- **`prop:cube` (iii), reduction to Keller's property.**  If `s ≤ 7`, `S` has one point per unit
cube, is periodic under `Π` (`S + Π ⊆ S`) and `ℤ^s + Π` is dense, then (given Keller's property
`KellerProp s`, a theorem for `s ≤ 7` (Perron; Brakensiek–Heule–Mackey–Narváez), not proved here)
two points of `S` differ by a unit vector; so `μ(S) ≤ 1`. -/
theorem cube_iii {s : ℕ} (hs : s ≤ 7) (keller : KellerProp s) (S : Set (Fin s → ℝ))
    (P : AddSubgroup (Fin s → ℝ)) (h1 : OnePerCube S) (hper : ∀ σ ∈ S, ∀ π ∈ P, σ + π ∈ S)
    (hdense : Dense (intPlus (P : Set (Fin s → ℝ)))) :
    ∃ σ ∈ S, ∃ c, σ + unitVec c ∈ S ∧ minDist S ≤ 1 := by
  exact cube_iii' hs keller S P h1 hper hdense

/-- **`prop:cube` (iv), rationality.**  If `S − x ⊂ ℚ^s`, all squared distances in `S` are rational. -/
theorem cube_iv_rat {s : ℕ} (S : Set (Fin s → ℝ)) (x : Fin s → ℝ)
    (hrat : ∀ σ ∈ S, ∀ c, ∃ r : ℚ, σ c - x c = r) :
    ∀ σ ∈ S, ∀ σ' ∈ S, ∃ r : ℚ, ∑ c, (σ c - σ' c) ^ 2 = r := by
  exact cube_iv_rat' S x hrat

/-- **`prop:cube` (iv), the minimum.**  For a periodic one-per-cube set `S` (`S + Π ⊆ S`, with
`Nℤ^s ⊆ Π` for some `N ≥ 1`, which holds for every full-rank `Π` in the rational case) with
`S − x ⊂ ℚ^s` and `s ≥ 1`, the minimum distance `μ(S)` is attained by a pair of points and
`μ(S)²` is a positive rational. -/
theorem cube_iv_min {s : ℕ} (hs : 0 < s) (S : Set (Fin s → ℝ)) (P : AddSubgroup (Fin s → ℝ))
    (h1 : OnePerCube S) (hper : ∀ σ ∈ S, ∀ π ∈ P, σ + π ∈ S) (N : ℕ) (hN : 0 < N)
    (hPN : ∀ z : Fin s → ℤ, (fun c => (N : ℝ) * z c) ∈ P) (x : Fin s → ℝ)
    (hrat : ∀ σ ∈ S, ∀ c, ∃ r : ℚ, σ c - x c = r) :
    (∃ σ ∈ S, ∃ σ' ∈ S, σ ≠ σ' ∧ minDist S = Real.sqrt (∑ c, (σ c - σ' c) ^ 2)) ∧
      ∃ r : ℚ, 0 < r ∧ minDist S ^ 2 = r := by
  exact cube_iv_min' hs S P h1 hper N hN hPN x hrat

/-- **`prop:cube` (iv), the values.**  In the situation of `cube_iv_min`: for `s = 2, 3`, `μ(S)` differs
from the optimal packing value at density `1`, `(4/3)^{1/4}` resp. `2^{1/6}`, so the packing
bound `μ(S) ≤` value (Thue resp. Hales, not proved here; an explicit hypothesis) gives
`μ(S) <` value; for `4 ≤ s ≤ 7`, `μ(S)²` differs from the squared minima `√2`, `2^{3/5}`,
`2·3^{−1/6}`, `2^{6/7}` of `D₄`, `D₅`, `E₆`, `E₇` at density `1`. -/
theorem cube_iv_vals {s : ℕ} (hs : 0 < s) (S : Set (Fin s → ℝ)) (P : AddSubgroup (Fin s → ℝ))
    (h1 : OnePerCube S) (hper : ∀ σ ∈ S, ∀ π ∈ P, σ + π ∈ S) (N : ℕ) (hN : 0 < N)
    (hPN : ∀ z : Fin s → ℤ, (fun c => (N : ℝ) * z c) ∈ P) (x : Fin s → ℝ)
    (hrat : ∀ σ ∈ S, ∀ c, ∃ r : ℚ, σ c - x c = r) :
    (s = 2 → minDist S ≠ (4 / 3 : ℝ) ^ ((1 : ℝ) / 4) ∧
      (minDist S ≤ (4 / 3 : ℝ) ^ ((1 : ℝ) / 4) → minDist S < (4 / 3 : ℝ) ^ ((1 : ℝ) / 4))) ∧
    (s = 3 → minDist S ≠ (2 : ℝ) ^ ((1 : ℝ) / 6) ∧
      (minDist S ≤ (2 : ℝ) ^ ((1 : ℝ) / 6) → minDist S < (2 : ℝ) ^ ((1 : ℝ) / 6))) ∧
    (s = 4 → minDist S ^ 2 ≠ Real.sqrt 2) ∧
    (s = 5 → minDist S ^ 2 ≠ (2 : ℝ) ^ ((3 : ℝ) / 5)) ∧
    (s = 6 → minDist S ^ 2 ≠ 2 * (3 : ℝ) ^ (-(1 : ℝ) / 6)) ∧
    (s = 7 → minDist S ^ 2 ≠ (2 : ℝ) ^ ((6 : ℝ) / 7)) := by
  exact cube_iv_vals' hs S P h1 hper N hN hPN x hrat

