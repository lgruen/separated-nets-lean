/-! ## Stage 6 additions -/

/-! ### `thm:two`: the expansion of `c*(q)` -/

/-- **`thm:two`, the expansion** `c*(q) = 1 - 1/q + 1/q² - O(q^(-3))`, with explicit constant:
`1 - 1/q + 1/q² - 3/q³ ≤ c*(q) < 1 - 1/q + 1/q²` for every `q ≥ 2`. -/
theorem cQ_expansion (q : ℕ) (hq : 2 ≤ q) :
    1 - 1 / (q : ℝ) + 1 / (q : ℝ) ^ 2 - 3 / (q : ℝ) ^ 3 ≤ cQ q ∧
      cQ q < 1 - 1 / (q : ℝ) + 1 / (q : ℝ) ^ 2 :=
  Proofs.cQ_expansion q hq

/-! ### `prop:Qnet`: the explicit value, even `q`, and `𝒬_{2,q}` -/

/-- **`prop:Qnet`, explicit value.** For `k ≥ 2` the box minor of `QGen k` for `d` is
`± ∏_{c : d_c < k} ∏_{j = d_c}^{k-1} Γ_jj` (`Γ = Vmat k`). -/
theorem Q_boxMinor_value (k : ℕ) (hk : 2 ≤ k) (d : Fin 3 → ℕ) (hd : d 0 + d 1 + d 2 = 3 * k) :
    (boxMatrix (QGen k) d).det =
        ∏ c : Fin 3, ∏ j : Fin k, (if d c ≤ (j : ℕ) then Vmat k j j else 1) ∨
      (boxMatrix (QGen k) d).det =
        -∏ c : Fin 3, ∏ j : Fin k, (if d c ≤ (j : ℕ) then Vmat k j j else 1) :=
  Proofs.QVal.Q_boxMinor_value k hk d hd

/-- **`prop:Qnet`, even `q`.** For even `q` and `k ≥ 3`, `𝒬_{k,q}` is not a `(0,3k,3)`-net
(the box `(k+3, k-3, k)` has minor `±2`). -/
theorem Q_not_net_even (q k : ℕ) (hq : Even q) (hq2 : 2 ≤ q) (hk : 3 ≤ k) :
    ¬ IsNet0 q (3 * k) (Qpoint q k) :=
  Proofs.QVal.Q_not_net_even q k hq hq2 hk

/-- **`𝒬_{2,q}` in every base** (text after `prop:Qnet`): for `k = 2`, `Γ = diag(1, -1)`, so
`𝒬_{2,q}` is a `(0,6,3)`-net over `ℤ/qℤ` for every `q ≥ 2`. -/
theorem Q2_net (q : ℕ) (hq : 2 ≤ q) : IsNet0 q (3 * 2) (Qpoint q 2) :=
  Proofs.QVal.Q2_net q hq

/-! ### `prop:faure`: the frame is the Faure–Hammersley net -/

/-- **`prop:faure`**, `Λ_m` is lower unitriangular. -/
theorem faure_Lam (m : ℕ) : (∀ i, LamF m i i = 1) ∧ ∀ i j, i < j → LamF m i j = 0 :=
  Proofs.Faure.faure_Lam m

/-- **`prop:faure`**: `τ = Λ_m P`. -/
theorem faure_tau (m : ℕ) (hm : 1 ≤ m) : tau m = LamF m * pascalP m :=
  Proofs.Faure.faure_tau m hm

/-- **`prop:faure`**: `τ² = D_± J P`. -/
theorem faure_tau2 (m : ℕ) (hm : 1 ≤ m) : tau m ^ 2 = Dpm m * Jrev m * pascalP m :=
  Proofs.Faure.faure_tau2 m hm

/-- **`prop:faure`**, the re-indexing `v ↦ D_± P v` is an involution: `(D_± P)² = I` (so the
re-indexed generator matrices are `C_c (D_± P)⁻¹ = C_c D_± P`). -/
theorem faure_DP (m : ℕ) : (Dpm m * pascalP m) * (Dpm m * pascalP m) = 1 :=
  Proofs.Faure.faure_DP m

/-- **`prop:faure`, consequence.** For `m = 3k` and any `L` (lower triangular in the paper), the
net `(L T², L, L T)` re-indexed by `v ↦ D_± P v` has generator matrices
`((-1)^(m-1) L J, (L D_±) P, (s_k L Λ_m D_±) I)`, `s_k = (-1)^(k+1)`: the Hammersley net (`J`) of
the generalized Faure sequence `(A_1, A_2 P)` with `A_1 = s_k L Λ_m D_±`, `A_2 = L D_±`. -/
theorem faure_reindex (k : ℕ) (hk : 1 ≤ k) (L : Matrix (Fin (3 * k)) (Fin (3 * k)) ℤ) :
    L * T k ^ 2 * (Dpm (3 * k) * pascalP (3 * k)) = (-1 : ℤ) ^ (3 * k - 1) • (L * Jrev (3 * k)) ∧
      L * (Dpm (3 * k) * pascalP (3 * k)) = L * Dpm (3 * k) * pascalP (3 * k) ∧
      L * T k * (Dpm (3 * k) * pascalP (3 * k)) =
        (-1 : ℤ) ^ (k + 1) • (L * LamF (3 * k) * Dpm (3 * k)) :=
  Proofs.Faure.faure_reindex k hk L

/-! ### `rem:lattice3`: the lattice reading of `𝒫_{k,q}` -/

/-- **`rem:lattice3`**: `M = -I + [u×]` with `u = (1,1,1)`. -/
theorem lat3_cross (v : Fin 3 → ℝ) :
    Mcell.map (Int.cast : ℤ → ℝ) *ᵥ v = -v + crossProduct ![1, 1, 1] v :=
  Proofs.lat3_cross v

/-- **`rem:lattice3`**: `rotU θ` is a rotation (in `SO(3)`) fixing `u` and turning every vector
orthogonal to `u` by the angle `θ`. -/
theorem lat3_rot (θ : ℝ) :
    rotU θ ∈ Matrix.specialOrthogonalGroup (Fin 3) ℝ ∧ rotU θ *ᵥ ![1, 1, 1] = ![1, 1, 1] ∧
      ∀ w : Fin 3 → ℝ, w ⬝ᵥ ![1, 1, 1] = 0 →
        (rotU θ *ᵥ w) ⬝ᵥ w = Real.cos θ * (w ⬝ᵥ w) :=
  Proofs.lat3_rot θ

/-- **`rem:lattice3`**: `Λ_q` is `ℤ³` scaled by `1 - 1/q` along `u` and by
`((1-1/q)² + 3/q²)^(1/2)` across it, then rotated by `arctan(√3/(q-1))` about `u`. -/
theorem lat3_decomp (q : ℕ) (hq : 2 ≤ q) :
    latMat q = rotU (Real.arctan (Real.sqrt 3 / ((q : ℝ) - 1))) *
      ((1 - 1 / (q : ℝ)) • projU + Real.sqrt ((1 - 1 / (q : ℝ)) ^ 2 + 3 / (q : ℝ) ^ 2) • (1 - projU)) :=
  Proofs.lat3_decomp q hq

/-- **`rem:lattice3`**: `det(I + M/q) = (1-1/q)((1-1/q)² + 3/q²) < 1`. -/
theorem lat3_det (q : ℕ) (hq : 1 ≤ q) :
    (latMat q).det = (1 - 1 / (q : ℝ)) * ((1 - 1 / (q : ℝ)) ^ 2 + 3 / (q : ℝ) ^ 2) ∧
      (latMat q).det < 1 :=
  Proofs.lat3_det q hq

/-- **`rem:lattice3`**: `|(I + M/q) v|² = (1-1/q)² |v|² + (3/q²) |v_⊥|²`. -/
theorem lat3_norm (q : ℕ) (v : Fin 3 → ℝ) :
    (latMat q *ᵥ v) ⬝ᵥ (latMat q *ᵥ v) =
      (1 - 1 / (q : ℝ)) ^ 2 * (v ⬝ᵥ v) + 3 / (q : ℝ) ^ 2 * (v ⬝ᵥ v - (∑ i, v i) ^ 2 / 3) :=
  Proofs.lat3_norm q v

/-- **`rem:lattice3`**: for `q ≥ 3`, `λ₁(Λ_q)² ≥ 1 - 2/q + 3/q²` on `ℤ³ \ 0`. -/
theorem lat3_min (q : ℕ) (hq : 3 ≤ q) (v : Fin 3 → ℤ) (hv : v ≠ 0) :
    1 - 2 / (q : ℝ) + 3 / (q : ℝ) ^ 2 ≤
      (latMat q *ᵥ (fun i => (v i : ℝ))) ⬝ᵥ (latMat q *ᵥ (fun i => (v i : ℝ))) :=
  Proofs.lat3_min q hq v hv

/-- **`rem:lattice3`**: the minimum is attained at `(I + M/q) e_x = (1 - 1/q, 1/q, -1/q)`. -/
theorem lat3_min_attained (q : ℕ) :
    latMat q *ᵥ ![1, 0, 0] = ![1 - 1 / (q : ℝ), 1 / (q : ℝ), -(1 / (q : ℝ))] ∧
      (latMat q *ᵥ ![1, 0, 0]) ⬝ᵥ (latMat q *ᵥ ![1, 0, 0]) = 1 - 2 / (q : ℝ) + 3 / (q : ℝ) ^ 2 :=
  Proofs.lat3_min_attained q

/-- **`rem:lattice3`**: `c(q) < λ₁(Λ_q)`. -/
theorem lat3_cP (q : ℕ) (hq : 1 ≤ q) : cP q < Real.sqrt (1 - 2 / (q : ℝ) + 3 / (q : ℝ) ^ 2) :=
  Proofs.lat3_cP q hq

/-! ### `rem:sign`: the flipped diagonal -/

/-- **`rem:sign`, `t = 0` is kept**: every box minor of the flipped generator matrices
`(L' T², L', L' T)` is `±1` (`k ≥ 1`). -/
theorem sign_boxMinor (k : ℕ) (hk : 1 ≤ k) (d : Fin 3 → ℕ) (hd : d 0 + d 1 + d 2 = 3 * k) :
    (boxMatrix (PGenFlip k) d).det = 1 ∨ (boxMatrix (PGenFlip k) d).det = -1 :=
  Proofs.Sign.sign_boxMinor k hk d hd

/-- **`rem:sign`**: the flipped `𝒫_{k,q}` is a `(0,3k,3)`-net in every base `q ≥ 2`. -/
theorem sign_net (q k : ℕ) (hq : 2 ≤ q) (hk : 1 ≤ k) : IsNet0 q (3 * k) (PpointFlip q k) :=
  Proofs.Sign.sign_net q k hq hk

/-- **`rem:sign`**: over any field, the flip changes only the entry `(Φ_cc)_{0,k-1}` of the graph
form, by `+2` (from `-1` to `+1`). -/
theorem sign_graph {F : Type*} [Field F] (k : ℕ) (hk : 2 ≤ k) (c d : Fin 3) (r : Fin (2 * k))
    (l : Fin k) :
    graphBlock k (fun c => (PGenFlip k c).map (Int.cast : ℤ → F)) c d r l =
      graphBlock k (fun c => (PGen k c).map (Int.cast : ℤ → F)) c d r l +
        (if (r : ℕ) = 0 ∧ d = c ∧ (l : ℕ) = k - 1 then 2 else 0) :=
  Proofs.Sign.sign_graph k hk c d r l

/-- **`rem:sign`, the cap** (`prop:ceil`(ii)): for an odd prime `p` and `k ≥ 2`, two distinct
points of the flipped `𝒫_{k,p}` are at squared distance `< 12/p²` in cell units, so
`δ N^(1/3) < 2√3/p`. -/
theorem sign_cap (p k : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (hk : 2 ≤ k) :
    ∃ v w : Fin (3 * k) → ZMod p, v ≠ w ∧
      cellDist2 p k (PpointFlip p k v) (PpointFlip p k w) < 12 / (p : ℝ) ^ 2 :=
  Proofs.Sign.sign_cap p k hp hp2 hk

/-! ### `rem:base2`: reading `𝒫_{k,2^j}` in base `2` -/

/-- **`rem:base2`, the proved bound**: for `q = 2^j`, the points of `𝒫_{k,q}` read in base `2`
form a `(t, 3jk, 3)`-net with `t = 2(j-1)`. -/
theorem base2_net (j k : ℕ) (hj : 1 ≤ j) (hk : 1 ≤ k) :
    IsNetT 2 (2 * (j - 1)) (j * (3 * k)) (Ppoint (2 ^ j) k) :=
  Proofs.Base2.base2_net j k hj hk

/-! ### `def:R`, `cor:Rrows`: the nets `ℛ_{k,p}`, `p = 5, 7` -/

/-- **`def:R`**: `Γ_p` is lower triangular with determinant `-s_3 v_4` (`= -2` for `p = 5`,
`2` for `p = 7`), `k ≥ 4`. -/
theorem R_Gamma_det (p k : ℕ) (hk : 4 ≤ k) :
    (∀ i j : Fin k, i < j → Gamp k (Rpar p 2) (Rpar p 3) (Rpar p 4) i j = 0) ∧
      (Gamp k (Rpar p 2) (Rpar p 3) (Rpar p 4)).det = -(Rpar p 2 * Rpar p 3) :=
  Two.RNets.R_Gamma_det p k hk

/-- **`def:R`**: `ℛ_{k,p}` is a `(0,3k,3)`-net over `𝔽_p` for `p = 5, 7` and every `k ≥ 2`. -/
theorem R_net (p k : ℕ) (hp : p = 5 ∨ p = 7) (hk : 2 ≤ k) : IsNet0 p (3 * k) (Rpoint p k) :=
  Two.RNets.R_net p k hp hk

/-- **`cor:Rrows`**: rows `0` and `1` of the blocks `Φ_cd` of `ℛ_{k,p}` (`k ≥ 2`), modulo `p`, are
the table of the paper: `tabR0 (d - c) (k-1-l)` and `tabR1 p (d - c) (k-1-l)` on level `l` (they
vanish outside the levels `k-1, …, k-4`). -/
theorem R_rows (p k : ℕ) (hp : p = 5 ∨ p = 7) (hk : 2 ≤ k) (c d : Fin 3) (l : Fin k) :
    ((RPhiOf p k (frameB k) (frameC k) c d ⟨0, Nat.mul_pos Nat.two_pos (Nat.lt_of_lt_of_le Nat.two_pos hk)⟩ l : ℤ) : ZMod p) =
        ((tabR0 (d - c) (k - 1 - l) : ℤ) : ZMod p) ∧
      ((RPhiOf p k (frameB k) (frameC k) c d
        ⟨1, Nat.lt_of_lt_of_le Nat.one_lt_two (Nat.le_mul_of_pos_right 2 (Nat.lt_of_lt_of_le Nat.two_pos hk))⟩ l : ℤ) : ZMod p) =
        ((tabR1 p (d - c) (k - 1 - l) : ℤ) : ZMod p) :=
  Two.RNets.R_rows p k hp hk c d l

/-- **`cor:Rrows`**: all rows `≥ 1` of the own blocks `Φ_cc` vanish. -/
theorem R_self_row (p k : ℕ) (c : Fin 3) (r : Fin (2 * k)) (hr : (r : ℕ) ≠ 0) (l : Fin k) :
    RPhiOf p k (frameB k) (frameC k) c c r l = 0 :=
  Two.RNets.R_self_row p k c r hr l

/-! ### `rem:q11`: the hypothesis `q ≥ 11` -/

/-- **`rem:q11`**: `𝒬_{3,9}` (a `(0,9,3)`-net over `ℤ/9ℤ` by `Q_net_odd`) has two points in the
toroidally adjacent cells `n` (of the point `v`) and `n - (1,1,1)` (of the point `w`; cell digits
of a point are its coordinates divided by `9^6`) at normalized toroidal distance
`δ N^(1/3) < 0.8763 < c*(9)` (`N = 9^9`, distances at integer scale `N`). -/
theorem Q9_witness : ∃ v w : Fin (3 * 3) → ZMod 9,
    (∀ c, (Qpoint 9 3 w c / 9 ^ 6 + 1) % 9 ^ 3 = Qpoint 9 3 v c / 9 ^ 6) ∧
      Real.sqrt (torusDist2 (9 ^ 9) (Qpoint 9 3 v) (Qpoint 9 3 w)) / 9 ^ 6 < 0.8763 ∧
      (0.8763 : ℝ) < cQ 9 :=
  Proofs.Q11.Q9_witness

