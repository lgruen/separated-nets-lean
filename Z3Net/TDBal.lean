    drift2E G ![1, 1, 1, 1, 1] = -G 0 0 - G 0 1 - G 0 2 - G 0 3 - G 0 4 - G 1 0 - G 1 1 - G 1 2 - G 1 3 - G 1 4 - G 2 0 - G 2 1 - G 2 2 - G 2 3 - G 2 4 - G 3 0 - G 3 1 - G 3 2 - G 3 3 - G 3 4 - G 4 0 - G 4 1 - G 4 2 - G 4 3 - G 4 4 := by
  rw [drift_full G _ (by decide)]
  simp [Fin.sum_univ_five]
  ring

