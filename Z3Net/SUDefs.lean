/-
Development copy (Solution side) of ChallengeU. Note: Theorem U of the research notes (2026-10-07; independently audited
in the research notes): for every dimension `s ≥ 3`, explicit
quasi-uniform digital `(0,sk,s)`-nets over `ℤ/qℤ` (all prime factors of `q` at least `s - 1`),
built from the uniform design `U_s` on the places `∞, 0, 1, …, s-2`.
Author: Leonhard Gruenschloss.
Use of AI: see the section "Use of AI" of `README.md`.
The centred residue `cres` is adapted from Lennart Rudolph's Palomar formalization of the
even-order Grünschloß–Keller nets (github.com/lennrt/palomar-formalizations, MIT licence).
-/
module
public import Mathlib

@[expose] public section

/-!
# Definitions of entry U (verbatim copy of the definitions in `ChallengeU.lean`)

Generated by `scripts/sync_udefs.py`; keep in sync with `ChallengeU.lean` (Comparator checks
that the Solution declarations have the same types and values).
-/

namespace Z3NetU

open Matrix Finset

/-! ## Digital nets, elementary boxes, distances (`s` coordinates) -/

/-- Integer coordinate of the digital point with generator matrix `C` and index `v`:
the digits are `d = C v ∈ (ℤ/qℤ)^m` (digit `0` most significant) and
`coord q m C v = ∑_j val(d_j) · q^(m-1-j) ∈ [0, q^m)`. -/
def coord (q m : ℕ) (C : Matrix (Fin m) (Fin m) (ZMod q)) (v : Fin m → ZMod q) : ℕ :=
  ∑ j : Fin m, ((C *ᵥ v) j).val * q ^ (m - 1 - (j : ℕ))

/-- The integer point (`s` coordinates) of the digital net with generator matrices `C c` at
index `v`. -/
def digPoint {s : ℕ} (q m : ℕ) (C : Fin s → Matrix (Fin m) (Fin m) (ZMod q))
    (v : Fin m → ZMod q) : Fin s → ℕ :=
  fun c => coord q m (C c) v

/-- `(0,m,s)`-net property in base `q` of the family of integer points `X v ∈ [0,q^m)^s` indexed
by `v ∈ (ℤ/qℤ)^m`: for every `d` with `∑_c d c = m` and every elementary box
`∏_c [a_c q^(-d_c), (a_c+1) q^(-d_c))` (`a_c < q^(d_c)`), exactly one index `v` has its point
`X v / q^m` in the box. -/
def IsNet0 (s q m : ℕ) (X : (Fin m → ZMod q) → Fin s → ℕ) : Prop :=
  ∀ d : Fin s → ℕ, ∑ c, d c = m → ∀ a : Fin s → ℕ, (∀ c, a c < q ^ d c) →
    ∃! v : Fin m → ZMod q, ∀ c, X v c / q ^ (m - d c) = a c

/-- Distance from the integer `u` to the lattice `N ℤ`: `min (u mod N) (N - u mod N)`.
(Adapted from `GKEvenNet.cres`.) -/
def cres (N : ℕ) (u : ℤ) : ℕ :=
  min (u % (N : ℤ)).toNat (N - (u % (N : ℤ)).toNat)

/-- Squared toroidal distance, at integer scale `N`, between the integer points `x, y`
(i.e. `N²` times the squared distance of `x / N`, `y / N` on the torus `(ℝ/ℤ)^s`). -/
def torusDist2 {s : ℕ} (N : ℕ) (x y : Fin s → ℕ) : ℕ :=
  ∑ c, cres N ((x c : ℤ) - (y c : ℤ)) ^ 2

/-- Owner of row `r` of a box matrix: for the list `ds` of row counts, `boxLoc ds c₀ r` is the
pair (coordinate, row inside that coordinate), coordinates numbered from `c₀`; the first `ds[0]`
rows belong to coordinate `c₀`, the next `ds[1]` rows to coordinate `c₀ + 1`, and so on. -/
def boxLoc : List ℕ → ℕ → ℕ → ℕ × ℕ
  | [], c, r => (c, r)
  | x :: xs, c, r => if r < x then (c, r) else boxLoc xs (c + 1) (r - x)

/-- Box matrix of `C` for `d`: the first `d 0` rows of `C 0`, then the first `d 1` rows of `C 1`,
…, then the first `d (s-1)` rows of `C (s-1)` (rows past `∑ d` are `0`). -/
def boxMatrix {R : Type*} [Zero R] {s m : ℕ} (C : Fin s → Matrix (Fin m) (Fin m) R)
    (d : Fin s → ℕ) : Matrix (Fin m) (Fin m) R :=
  fun r l =>
    if h : (boxLoc (List.ofFn d) 0 r).1 < s ∧ (boxLoc (List.ofFn d) 0 r).2 < m then
      C ⟨(boxLoc (List.ofFn d) 0 r).1, h.1⟩ ⟨(boxLoc (List.ofFn d) 0 r).2, h.2⟩ l
    else 0

/-! ## The frame: readings at `∞, 0, 1, …, s-2` -/

/-- The finite place `a_c = c - 1` of coordinate `c ≥ 1` (coordinate `0` is the place `∞`; its
entry here is unused). -/
def place {s : ℕ} (c : Fin s) : ℤ := (c : ℤ) - 1

/-- Frame generator matrix of coordinate `c` on `ℤ[t]_{<m}` (index = coefficient vector `v` of
`V = ∑_l v_l t^l`): for `c ≥ 1` digit `i` is the coefficient of `(t - a_c)^i`, i.e.
`∑_l C(l, i) a_c^(l-i) v_l`; for `c = 0` (`∞`) digit `i` is `v_{m-1-i}`. -/
def frameGen {s : ℕ} (m : ℕ) (c : Fin s) : Matrix (Fin m) (Fin m) ℤ :=
  fun i l =>
    if (c : ℕ) = 0 then (if (l : ℕ) + (i : ℕ) + 1 = m then 1 else 0)
    else (((l : ℕ).choose (i : ℕ) : ℕ) : ℤ) * place c ^ ((l : ℕ) - (i : ℕ))

/-! ## The basis polynomials `E_{d,j}` -/

/-- Coefficient list (constant term first) of `(t - a)^e`: entry `i` is `C(e, i) (-a)^(e-i)`. -/
def linPowL (a : ℤ) (e : ℕ) : List ℤ :=
  (List.range (e + 1)).map fun i => ((e.choose i : ℕ) : ℤ) * (-a) ^ (e - i)

/-- Product of coefficient lists (Cauchy convolution; both lists nonempty). -/
def pmul (f g : List ℤ) : List ℤ :=
  (List.range (f.length + g.length - 1)).map fun n =>
    ∑ i ∈ range (n + 1), f.getD i 0 * g.getD (n - i) 0

/-- Root of the factor of coordinate `b` in `E_{d,j}`: `a_b` for `b ≥ 1`, `0` for `b = 0` (the
factor `t^(·)` coming from `∞`). -/
def Eroot {s : ℕ} (b : Fin s) : ℤ := if (b : ℕ) = 0 then 0 else place b

/-- Exponent of the factor of coordinate `b` in `E_{d,j}`: `E_{d,j} = ∏_b (t - Eroot b)^(Eexp)`,
i.e. `(t - a_b)^k` for finite `b ≠ d`, `(t - a_d)^j` for `b = d` finite, and `t^(k-1-j)` from `∞`
when `d = ∞` (`t^0` when `d` is finite). -/
def Eexp {s : ℕ} (k : ℕ) (d b : Fin s) (j : ℕ) : ℕ :=
  if (b : ℕ) = 0 then (if (d : ℕ) = 0 then k - 1 - j else 0) else if b = d then j else k

/-- Coefficient list of `E_{d,j} = ∏_b (t - Eroot b)^(Eexp k d b j)`. -/
def Ecoef {s : ℕ} (k : ℕ) (d : Fin s) (j : ℕ) : List ℤ :=
  (List.finRange s).foldr (fun b acc => pmul (linPowL (Eroot b) (Eexp k d b j)) acc) [1]

/-- Coefficient vector of `E_{d,j}` in `ℤ[t]_{<sk}`. -/
def Evec {s : ℕ} (k : ℕ) (d : Fin s) (j : ℕ) : Fin (s * k) → ℤ :=
  fun i => (Ecoef k d j).getD i 0

/-- `Ψ_cd[r, j]` = digit `k + r` of reading `c` of `E_{d,j}` (`= (Φ^F_cd · Q_d^k Toep(g_d))[r, j]`). -/
def Psi {s : ℕ} (k : ℕ) (c d : Fin s) : Matrix (Fin (s * k - k)) (Fin k) ℤ :=
  fun r j => (frameGen (s * k) c *ᵥ Evec k d j) ⟨k + (r : ℕ), Nat.add_lt_of_lt_sub' r.isLt⟩

/-! ## Inverses, the Cauchy kernel, `Q_c` -/

/-- The inverse of a nonzero integer `z` from the inverses `iv i` of positive integers. -/
def ivz {R : Type*} [CommRing R] (iv : ℕ → R) (z : ℤ) : R :=
  if 0 ≤ z then iv z.toNat else -iv (-z).toNat

/-- `y_cd` of Proposition N_s: `1/(a_c - a_d)` for finite `c, d`; `0` for `c = ∞`; `a_c` for
`d = ∞`. -/
def yN {R : Type*} [CommRing R] (iv : ℕ → R) {s : ℕ} (c d : Fin s) : R :=
  if (c : ℕ) = 0 then 0 else if (d : ℕ) = 0 then ((place c : ℤ) : R) else ivz iv ((c : ℤ) - d)

/-- `w_cd` of Proposition N_s: `1/(a_c - a_d)` for finite `c, d`; `1` if `c = ∞` or `d = ∞`. -/
def wN {R : Type*} [CommRing R] (iv : ℕ → R) {s : ℕ} (c d : Fin s) : R :=
  if (c : ℕ) = 0 ∨ (d : ℕ) = 0 then 1 else ivz iv ((c : ℤ) - d)

/-- `Q_c^(-k)`: `∏_{b finite, b ≠ c} (a_c - a_b)^(-k)` for finite `c`, `1` for `c = ∞`. -/
def Qinv {R : Type*} [CommRing R] (iv : ℕ → R) {s : ℕ} (k : ℕ) (c : Fin s) : R :=
  if (c : ℕ) = 0 then 1
  else (∏ b ∈ univ.filter (fun b : Fin s => (b : ℕ) ≠ 0 ∧ b ≠ c), ivz iv ((c : ℤ) - b)) ^ k

/-! ## The uniform design `U_s` -/

/-- `L_s = lcm(1, …, s-2)^(s-1)`. -/
def Lcst (s : ℕ) : ℕ := ((Finset.Icc 1 (s - 2)).lcm id) ^ (s - 1)

/-- Residual row scalings: `λ'_c = L_s` for finite `c`, `λ'_∞ = 1`. -/
def lamRes {s : ℕ} (c : Fin s) : ℤ := if (c : ℕ) = 0 then 1 else (Lcst s : ℤ)

/-- Signed Stirling numbers of the first kind: `stir n i = [y^i] y(y-1)⋯(y-n+1)`. -/
def stir : ℕ → ℕ → ℤ
  | 0, i => if i = 0 then 1 else 0
  | n + 1, i => (if i = 0 then 0 else stir n (i - 1)) - (n : ℤ) * stir n i

/-- `1/n! = ∏_{i=1}^n iv i`. -/
def invFact {R : Type*} [CommRing R] (iv : ℕ → R) (n : ℕ) : R := ∏ i ∈ range n, iv (i + 1)

/-- Residual gauge `U'_d` (row `n'`, column `n`, `x`-indices `< s-1`): the identity for finite
`d`; for `d = ∞` column `n` is the coefficient vector of `binom(y, n)`. -/
def Ures {R : Type*} [CommRing R] (iv : ℕ → R) {s : ℕ} (d : Fin s) (n' n : ℕ) : R :=
  if (d : ℕ) = 0 then (stir n n' : R) * invFact iv n else if n' = n then 1 else 0

/-- Coefficients (constant term first) of `∏_{y ∈ ys} (X - y)`. -/
def rootsPoly {R : Type*} [CommRing R] : List R → ℕ → R
  | [], i => if i = 0 then 1 else 0
  | y :: ys, i => (if i = 0 then 0 else rootsPoly ys (i - 1)) - y * rootsPoly ys i

/-- Coefficients `[X^i] (X^n mod P)` for the monic `P = X^r + ∑_{i<r} p_i X^i` (`r ≥ 1`, `i < r`):
`X^0 mod P = 1`, `X^(n+1) mod P = X · (X^n mod P) - [X^(r-1)](X^n mod P) · P`. -/
def xpowRem {R : Type*} [CommRing R] (p : ℕ → R) (r : ℕ) : ℕ → ℕ → R
  | 0, i => if i = 0 then 1 else 0
  | n + 1, i => (if i = 0 then 0 else xpowRem p r n (i - 1)) - xpowRem p r n (r - 1) * p i

/-- The nodes `y_cd` (`c ≠ d`) of column `d`. -/
def nodes {R : Type*} [CommRing R] (iv : ℕ → R) {s : ℕ} (d : Fin s) : List R :=
  ((List.finRange s).filter (fun c => c ≠ d)).map (fun c => yN iv c d)

/-- `γ_{n,i} = [X^i] (X^n mod ∏_{c ≠ d} (X - y_cd))` (`i < s - 1`). -/
def gam {R : Type*} [CommRing R] (iv : ℕ → R) {s : ℕ} (d : Fin s) (n i : ℕ) : R :=
  xpowRem (rootsPoly (nodes iv d)) (s - 1) n i

/-- The all-`k` gauge `U'^(k)_d` in `x`-index (row `n'`, column `n`): `U'_d` on `n', n < s-1`;
for `n ≥ s-1` the column `e_n - γ_n`. -/
def Ux {R : Type*} [CommRing R] (iv : ℕ → R) {s : ℕ} (d : Fin s) (n' n : ℕ) : R :=
  if n < s - 1 then (if n' < s - 1 then Ures iv d n' n else 0)
  else if n' = n then 1 else if n' < s - 1 then -gam iv d n n' else 0

/-- `U'^(k)_d` in level index (`k × k`, lower triangular): entry `(i, j)` is
`Ux (k-1-i) (k-1-j)`. -/
def Uk {R : Type*} [CommRing R] (iv : ℕ → R) {s : ℕ} (k : ℕ) (d : Fin s) :
    Matrix (Fin k) (Fin k) R :=
  fun i j => Ux iv d (k - 1 - (i : ℕ)) (k - 1 - (j : ℕ))

/-- Off-diagonal design entries `F_n[c][d]` (`x`-index `n`, i.e. level `k-1-n`):
`L_s/(a_c - a_d)^(n+1)` (finite `c, d`), `[n = 0]` (`c = ∞`), `L_s binom(a_c, n)` (`d = ∞`),
and `0` for `n ≥ s-1`. -/
def Foff (s n : ℕ) (c d : Fin s) : ℤ :=
  if s - 1 ≤ n then 0
  else if (c : ℕ) = 0 then (if n = 0 then 1 else 0)
  else if (d : ℕ) = 0 then (Lcst s : ℤ) * ((((c : ℕ) - 1).choose n : ℕ) : ℤ)
  else (Lcst s : ℤ) / ((c : ℤ) - d) ^ (n + 1)

/-- Partial sums `M^(j)[c][d] = F_0[c][d] + … + F_j[c][d]` (off-diagonal). -/
def Msum (s j : ℕ) (c d : Fin s) : ℤ := ∑ t ∈ range (j + 1), Foff s t c d

/-- `a_c = ∑_{d ≠ c} max_{0 ≤ j ≤ s-2} |M^(j)[c][d]|`. -/
def acoef (s : ℕ) (c : Fin s) : ℕ :=
  ∑ d ∈ univ.filter (fun d : Fin s => d ≠ c), (range (s - 1)).sup fun j => (Msum s j c d).natAbs

/-- The constant `a_s = max_c a_c` of Theorem U. -/
def aU (s : ℕ) : ℕ := univ.sup (acoef s)

/-- The design `U_s`: `F_n[c][d]` (`x`-index `n`), diagonal `F_0[c][c] = -a_c`, deeper diagonal `0`. -/
def Fdes (s n : ℕ) (c d : Fin s) : ℤ :=
  if c = d then (if n = 0 then -(acoef s c : ℤ) else 0) else Foff s n c d

/-! ## The net `𝒫^s_{k,q}` -/

/-- The graph-form blocks `Φ'_cd` (`(sk-k) × k`; rows = offset digits `k + r` of coordinate `c`,
columns = levels of the cell `n_d`) over a ring `R` with `iv i = 1/i`. -/
def UPhi (R : Type*) [CommRing R] (iv : ℕ → R) {s : ℕ} (k : ℕ) (c d : Fin s) :
    Matrix (Fin (s * k - k)) (Fin k) R :=
  fun r j =>
    if c = d then (if (r : ℕ) = 0 then ((Fdes s (k - 1 - (j : ℕ)) c c : ℤ) : R) else 0)
    else (if (r : ℕ) = 0 then (lamRes c : R) * Qinv iv k c else 1) *
      ∑ j' : Fin k, (Psi k c d r j' : R) * Uk iv k d j' j

/-- Generator matrix of coordinate `c` of the digital net with graph form `Φ`: rows `0..k-1` are
the identity on the column block `c` (index digit `c k + i` is level `i` of the cell `n_c`), rows
`k + r` are `(Φ_{c0} | Φ_{c1} | … | Φ_{c(s-1)})` row `r`. Column `j` belongs to block `j / k`,
level `j % k`. -/
def graphGen {R : Type*} [Zero R] [One R] (s k : ℕ)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) R) (c : Fin s) :
    Matrix (Fin (s * k)) (Fin (s * k)) R :=
  fun i j =>
    if hi : (i : ℕ) < k then (if (j : ℕ) = (c : ℕ) * k + (i : ℕ) then 1 else 0)
    else Φ c ⟨(j : ℕ) / k, Nat.div_lt_of_lt_mul (Nat.lt_of_lt_of_eq j.isLt (Nat.mul_comm s k))⟩
      ⟨(i : ℕ) - k, Nat.sub_lt_sub_right (Nat.le_of_not_lt hi) i.isLt⟩
      ⟨(j : ℕ) % k, Nat.mod_lt _ (Nat.pos_of_mul_pos_left (Fin.pos j))⟩

/-- Generator matrices of `𝒫^s_{k,q}` over `ℤ/qℤ` (`iv i = i⁻¹ ∈ ℤ/qℤ`). -/
def UGen (s q k : ℕ) : Fin s → Matrix (Fin (s * k)) (Fin (s * k)) (ZMod q) :=
  graphGen s k (UPhi (ZMod q) (fun i => ((i : ℕ) : ZMod q)⁻¹) k)

/-- The integer point (in `[0, q^(sk))^s`) of `𝒫^s_{k,q}` with index `v ∈ (ℤ/qℤ)^(sk)`. -/
def Upoint (s q k : ℕ) (v : Fin (s * k) → ZMod q) : Fin s → ℕ :=
  digPoint q (s * k) (UGen s q k) v

/-- Admissible bases: every prime factor of `q` is at least `s - 1`. -/
def Admissible (s q : ℕ) : Prop := 2 ≤ q ∧ ∀ p : ℕ, p.Prime → p ∣ q → s - 1 ≤ p

/-! ## Definition N_s, literally (faithfulness of the `E`-basis description) -/

/-- The frame over `ℚ`. -/
def frameQ {s : ℕ} (k : ℕ) (c : Fin s) : Matrix (Fin (s * k)) (Fin (s * k)) ℚ :=
  (frameGen (s * k) c).map (Int.cast : ℤ → ℚ)

/-- The raw graph form of the frame, `Φ^F_cd = O_c G⁻¹` restricted to the columns of block `d`
(rows `r` = offset digit `k + r` of reading `c`, columns `l` = level `l` of the cell `n_d`), where
`G` is the `(k,…,k)` box matrix of the frame, inverted over `ℚ` with Mathlib's `⁻¹`. -/
noncomputable def frameGraph {s : ℕ} (k : ℕ) (c d : Fin s) : Matrix (Fin (s * k - k)) (Fin k) ℚ :=
  fun r l => (frameQ k c * (boxMatrix (frameQ (s := s) k) (fun _ => k))⁻¹ :
      Matrix (Fin (s * k)) (Fin (s * k)) ℚ)
    ⟨k + (r : ℕ), Nat.add_lt_of_lt_sub' r.isLt⟩
    ⟨(d : ℕ) * k + (l : ℕ), Nat.lt_of_lt_of_le (Nat.add_lt_add_left l.isLt ((d : ℕ) * k))
      ((Nat.succ_mul (d : ℕ) k).symm.trans_le (Nat.mul_le_mul_right k d.isLt))⟩

/-- `Q_c = ∏_{b finite, b ≠ c} (a_c - a_b)` (`Q_∞ = 1`). -/
def Qval {s : ℕ} (c : Fin s) : ℚ :=
  if (c : ℕ) = 0 then 1 else ∏ b ∈ univ.filter (fun b : Fin s => (b : ℕ) ≠ 0 ∧ b ≠ c), ((c : ℚ) - b)

/-- The unit series `g_d` of Lemma R_s / Proposition N_s (here polynomials):
`g_d(x) = ∏_{b finite, b ≠ d} (1 + x/(a_d - a_b))^k` for finite `d`,
`g_∞(x) = ∏_{b finite} (1 - a_b x)^k`. -/
noncomputable def gpoly {s : ℕ} (k : ℕ) (d : Fin s) : Polynomial ℚ :=
  if (d : ℕ) = 0 then
    ∏ b ∈ univ.filter (fun b : Fin s => (b : ℕ) ≠ 0), (1 - Polynomial.C ((b : ℚ) - 1) * Polynomial.X) ^ k
  else ∏ b ∈ univ.filter (fun b : Fin s => (b : ℕ) ≠ 0 ∧ b ≠ d),
    (1 + Polynomial.C (((d : ℚ) - b)⁻¹) * Polynomial.X) ^ k

/-- Level-indexed Toeplitz matrix of `g`: entry `(i, j)` is `g_(i-j)` for `i ≥ j`, else `0`
(so that `ρ · Toep(g)` has generating function `ρ(x) g(x)`). -/
noncomputable def toep (k : ℕ) (g : Polynomial ℚ) : Matrix (Fin k) (Fin k) ℚ :=
  fun i j => if j ≤ i then g.coeff ((i : ℕ) - (j : ℕ)) else 0

/-- The note's column gauge `U_d = Q_d^k Toep(g_d) U'^(k)_d`. -/
noncomputable def Ulit {s : ℕ} (k : ℕ) (d : Fin s) : Matrix (Fin k) (Fin k) ℚ :=
  ((Qval d ^ k) • toep k (gpoly k d)) * Uk (fun i => ((i : ℕ) : ℚ)⁻¹) k d

end Z3NetU
