/-! ### `lem:CH` (Cauchy identities) and `rem:pm1` -/

/-- **`lem:CH`(C)**, ring identity: for distinct `c, d, e`, `W_cd W_de W_ec = -W_dc W_ed W_ce`. -/
theorem CH_C {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R)
    (h : CauchyOK α β lam mu) (c d e : ι) (hcd : c ≠ d) (hde : d ≠ e) (hce : c ≠ e) :
    cauchyW α β lam mu c d * cauchyW α β lam mu d e * cauchyW α β lam mu e c =
      -(cauchyW α β lam mu d c * cauchyW α β lam mu e d * cauchyW α β lam mu c e) :=
  Proofs.CH_C α β lam mu h c d e hcd hde hce

/-- **`lem:CH`(C)** over an ordered field: `π_cd π_de π_ec < 0` for distinct `c, d, e`. -/
theorem CH_C_neg {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] {ι : Type*}
    (α β lam mu : ι → K) (h : CauchyOK α β lam mu) (c d e : ι) (hcd : c ≠ d) (hde : d ≠ e)
    (hce : c ≠ e) :
    cauchyPi α β lam mu c d * cauchyPi α β lam mu d e * cauchyPi α β lam mu e c < 0 :=
  Proofs.CH_C_neg α β lam mu h c d e hcd hde hce

/-- **`lem:CH`(C)** over an ordered field: "`c ∼ d` iff `π_cd < 0`" (with `c ∼ c`) is an
equivalence relation with at most two classes (of any three coordinates, two are equivalent). -/
theorem CH_C_classes {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] {ι : Type*}
    (α β lam mu : ι → K) (h : CauchyOK α β lam mu) :
    Equivalence (fun c d : ι => c = d ∨ cauchyPi α β lam mu c d < 0) ∧
      ∀ c d e : ι, (c = d ∨ cauchyPi α β lam mu c d < 0) ∨ (d = e ∨ cauchyPi α β lam mu d e < 0) ∨
        (c = e ∨ cauchyPi α β lam mu c e < 0) :=
  Proofs.CH_C_classes α β lam mu h

/-- **`lem:CH`(P)**: for distinct `a, b, c, d`, `χ - ψ = 1`, `χ² = π_ab π_cd / (π_ac π_bd)`,
`ψ² = π_ab π_cd / (π_ad π_bc)`, and `(χ² - ψ² - 1)² = 4ψ²`. -/
theorem CH_P {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R)
    (h : CauchyOK α β lam mu) (a b c d : ι) (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    chiCH α β a b c d - psiCH α β a b c d = 1 ∧
      chiCH α β a b c d ^ 2 = cauchyPi α β lam mu a b * cauchyPi α β lam mu c d *
        Ring.inverse (cauchyPi α β lam mu a c * cauchyPi α β lam mu b d) ∧
      psiCH α β a b c d ^ 2 = cauchyPi α β lam mu a b * cauchyPi α β lam mu c d *
        Ring.inverse (cauchyPi α β lam mu a d * cauchyPi α β lam mu b c) ∧
      (chiCH α β a b c d ^ 2 - psiCH α β a b c d ^ 2 - 1) ^ 2 = 4 * psiCH α β a b c d ^ 2 :=
  Proofs.CH_P α β lam mu h a b c d hab hac had hbc hbd hcd

/-- **`lem:CH`(H)** (`R ⊆ ℝ`): for distinct `i, j, k, l`, the largest of
`|π_ij π_kl|^(-1/2)`, `|π_ik π_jl|^(-1/2)`, `|π_il π_jk|^(-1/2)` is the sum of the other two (the
three numbers are positive, and one of them is the sum of the other two). -/
theorem CH_H {ι : Type*} (α β lam mu : ι → ℝ) (h : CauchyOK α β lam mu) (i j k l : ι)
    (hij : i ≠ j) (hik : i ≠ k) (hil : i ≠ l) (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l) :
    0 < 1 / Real.sqrt |cauchyPi α β lam mu i j * cauchyPi α β lam mu k l| ∧
      0 < 1 / Real.sqrt |cauchyPi α β lam mu i k * cauchyPi α β lam mu j l| ∧
      0 < 1 / Real.sqrt |cauchyPi α β lam mu i l * cauchyPi α β lam mu j k| ∧
      (1 / Real.sqrt |cauchyPi α β lam mu i j * cauchyPi α β lam mu k l| =
          1 / Real.sqrt |cauchyPi α β lam mu i k * cauchyPi α β lam mu j l| +
            1 / Real.sqrt |cauchyPi α β lam mu i l * cauchyPi α β lam mu j k| ∨
        1 / Real.sqrt |cauchyPi α β lam mu i k * cauchyPi α β lam mu j l| =
          1 / Real.sqrt |cauchyPi α β lam mu i j * cauchyPi α β lam mu k l| +
            1 / Real.sqrt |cauchyPi α β lam mu i l * cauchyPi α β lam mu j k| ∨
        1 / Real.sqrt |cauchyPi α β lam mu i l * cauchyPi α β lam mu j k| =
          1 / Real.sqrt |cauchyPi α β lam mu i j * cauchyPi α β lam mu k l| +
            1 / Real.sqrt |cauchyPi α β lam mu i k * cauchyPi α β lam mu j l|) :=
  Proofs.CH_H α β lam mu h i j k l hij hik hil hjk hjl hkl

/-- **`lem:CH`(X)**: for distinct `i, j, l, d`,
`W_ji W_ld / (W_jd W_li) + W_ij W_ld / (W_id W_lj) = 1`. -/
theorem CH_X {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R)
    (h : CauchyOK α β lam mu) (i j l d : ι) (hij : i ≠ j) (hil : i ≠ l) (hid : i ≠ d)
    (hjl : j ≠ l) (hjd : j ≠ d) (hld : l ≠ d) :
    cauchyW α β lam mu j i * cauchyW α β lam mu l d *
        Ring.inverse (cauchyW α β lam mu j d * cauchyW α β lam mu l i) +
      cauchyW α β lam mu i j * cauchyW α β lam mu l d *
        Ring.inverse (cauchyW α β lam mu i d * cauchyW α β lam mu l j) = 1 :=
  Proofs.CH_X α β lam mu h i j l d hij hil hid hjl hjd hld

/-- `sec:frames`, "Cauchy identities": the layer `λ_c μ_d w_cd` (`c ≠ d`) of the frame of `s`
places (`prop:Ns`) is a Cauchy layer in the homogeneous coordinates `a_c = [x_c : 1]`,
`∞ = [1 : 0]`, the sign of `D_{c∞} = -1` absorbed into `μ_∞`. -/
theorem wN_cauchy {R : Type*} [CommRing R] {s : ℕ} (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (lam mu : Fin s → R) (hl : ∀ c, IsUnit (lam c))
    (hm : ∀ d, IsUnit (mu d)) :
    CauchyOK (fun c => if c = inf then 1 else x c) (fun c => if c = inf then 0 else 1) lam
        (fun d => if d = inf then -mu d else mu d) ∧
      ∀ c d, c ≠ d → lam c * mu d * wN inf x c d =
        cauchyW (fun c => if c = inf then 1 else x c) (fun c => if c = inf then 0 else 1) lam
          (fun d => if d = inf then -mu d else mu d) c d :=
  Proofs.wN_cauchy inf x hx lam mu hl hm

/-- **`rem:pm1`**, general form: over a nontrivial commutative ring with `3 ≠ 0`, no Cauchy layer
on four places has all twelve off-diagonal entries in `{±1}` (by `lem:CH`(X)). -/
theorem pm1_ring {R : Type*} [CommRing R] [Nontrivial R] (h3 : (3 : R) ≠ 0)
    (α β lam mu : Fin 4 → R) (h : CauchyOK α β lam mu) :
    ¬ ∀ c d : Fin 4, c ≠ d → cauchyW α β lam mu c d = 1 ∨ cauchyW α β lam mu c d = -1 :=
  Proofs.pm1_ring h3 α β lam mu h

/-- **`rem:pm1`**: for four places with unit differences and every odd `q ≥ 5`, no Cauchy layer
`λ_c μ_d / D_cd` (`c ≠ d`) has all twelve off-diagonal entries in `{±1}` modulo `q`. -/
theorem pm1 {q : ℕ} (hq : 5 ≤ q) (hodd : Odd q) (α β lam mu : Fin 4 → ZMod q)
    (h : CauchyOK α β lam mu) :
    ¬ ∀ c d : Fin 4, c ≠ d → cauchyW α β lam mu c d = 1 ∨ cauchyW α β lam mu c d = -1 :=
  Proofs.pm1 hq hodd α β lam mu h

/-! ### `prop:shared` (shared rows) -/

/-- **`prop:shared`**, for any row index `j` (as the paper notes after the proof): if two
coordinates of a digital `(0,m,s)`-net over a field share generator row `j`, then
`2(j+1) > m`. -/
theorem shared_row {K : Type*} [Field K] {q s m : ℕ} (e : K ≃ Fin q)
    (C : Fin s → Matrix (Fin m) (Fin m) K) (hC : IsNet0E e C) (a b : Fin s) (hab : a ≠ b)
    (j : Fin m) (hj : C a j = C b j) : m < 2 * ((j : ℕ) + 1) :=
  Proofs.shared_row e C hC a b hab j hj

/-- **`prop:shared`**: for `s ≥ 3` and `k = ⌊m/s⌋`, a shared generator row with index `k` forces
`2(k+1) > m`, hence `m = 1` or `(s, m) = (3, 3)`. -/
theorem shared_only {K : Type*} [Field K] {q s m : ℕ} (hs : 3 ≤ s) (e : K ≃ Fin q)
    (C : Fin s → Matrix (Fin m) (Fin m) K) (hC : IsNet0E e C) (a b : Fin s) (hab : a ≠ b)
    (j : Fin m) (hjk : (j : ℕ) = m / s) (hj : C a j = C b j) :
    m < 2 * (m / s + 1) ∧ (m = 1 ∨ (s = 3 ∧ m = 3)) :=
  Proofs.shared_only hs e C hC a b hab j hjk hj

/-! ### `cor:ceils` (every dimension) -/

/-- **`cor:ceils`(i)**: `s ≥ 3`, `k ≥ 2`, a digital `(0,sk,s)`-net over `ℤ/qℤ` (`q ≥ 3`) in graph
form, a coordinate `a` with `∑_{u ≠ a} |M̃_ua| < q` and `M̃_aa ≤ -1`: two distinct points at
squared distance (cell units, Euclidean and toroidal)
`< (1 - |M̃_aa|/q + q^(1-k))² + ∑_{u ≠ a} (|M̃_ua| + 1)²/q²`. -/
theorem ceils_neg {s q k : ℕ} (hs : 3 ≤ s) (hq : 3 ≤ q) (hk : 2 ≤ k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (a : Fin s)
    (hcol : ∑ u ∈ univ.erase a, |Mt Φ u a| < q) (ha : Mt Φ a a ≤ -1) :
    PairBelow q (s * k) k (gfPoint q k Φ)
      ((1 - ((|Mt Φ a a| : ℤ) : ℝ) / q + 1 / (q : ℝ) ^ (k - 1)) ^ 2 +
        ∑ u ∈ univ.erase a, (((|Mt Φ u a| : ℤ) : ℝ) + 1) ^ 2 / (q : ℝ) ^ 2) :=
  Proofs.ceils_neg hs hq hk Φ hnet a hcol ha

/-- **`cor:ceils`(ii)**: the same setting with `M̃_aa ≥ 1`: two distinct points at squared
distance `< ((M̃_aa + 1)² + ∑_{u ≠ a} (|M̃_ua| + 1)²)/q²`. -/
theorem ceils_pos {s q k : ℕ} (hs : 3 ≤ s) (hq : 3 ≤ q) (hk : 2 ≤ k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (a : Fin s)
    (hcol : ∑ u ∈ univ.erase a, |Mt Φ u a| < q) (ha : 1 ≤ Mt Φ a a) :
    PairBelow q (s * k) k (gfPoint q k Φ)
      (((((Mt Φ a a + 1 : ℤ)) : ℝ) ^ 2 +
        ∑ u ∈ univ.erase a, (((|Mt Φ u a| : ℤ) : ℝ) + 1) ^ 2) / (q : ℝ) ^ 2) :=
  Proofs.ceils_pos hs hq hk Φ hnet a hcol ha

/-- **`cor:ceils`(ii)**, "in particular": if moreover `|M̃| ≤ C`, two distinct points at squared
distance `< s (C+1)²/q²`, i.e. `c < √s (C+1)/q`. -/
theorem ceils_pos_C {s q k C : ℕ} (hs : 3 ≤ s) (hq : 3 ≤ q) (hk : 2 ≤ k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (a : Fin s)
    (hcol : ∑ u ∈ univ.erase a, |Mt Φ u a| < q) (ha : 1 ≤ Mt Φ a a)
    (hC : ∀ c d, |Mt Φ c d| ≤ C) :
    PairBelow q (s * k) k (gfPoint q k Φ) (s * ((C : ℝ) + 1) ^ 2 / (q : ℝ) ^ 2) :=
  Proofs.ceils_pos_C hs hq hk Φ hnet a hcol ha hC

/-! ### `prop:P2` (pair ceiling) -/

/-- **`prop:P2`**: `s ≥ 4`, `3k + 4 ≤ sk`, `a ≠ b`, `ε = ±1`, `σ = sig M̃ a b ε` with `σ_a > 0`,
`ε σ_b < 0` and `∑_c |σ_c| < q`: two distinct points at squared distance
`< (1 - |σ_b|/q + 1/q²)² + ((σ_a + 1)² + ∑_{u ≠ a, b} (|σ_u| + 1)²)/q²`. -/
theorem P2_ceiling {s q k : ℕ} (hs : 4 ≤ s) (h3k : 3 * k + 4 ≤ s * k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (a b : Fin s) (hab : a ≠ b) (ε : ℤ)
    (hε : ε = 1 ∨ ε = -1) (ha : 0 < sig (Mt Φ) a b ε a) (hb : ε * sig (Mt Φ) a b ε b < 0)
    (hsum : ∑ c, |sig (Mt Φ) a b ε c| < q) :
    PairBelow q (s * k) k (gfPoint q k Φ)
      ((1 - ((|sig (Mt Φ) a b ε b| : ℤ) : ℝ) / q + 1 / (q : ℝ) ^ 2) ^ 2 +
        ((((sig (Mt Φ) a b ε a + 1 : ℤ)) : ℝ) ^ 2 +
          ∑ u ∈ (univ.erase a).erase b, (((|sig (Mt Φ) a b ε u| : ℤ) : ℝ) + 1) ^ 2) /
          (q : ℝ) ^ 2) :=
  Proofs.P2_ceiling hs h3k Φ hnet a b hab ε hε ha hb hsum

/-- **`prop:P2`**, second statement: if instead `σ_a > 0` and `ε σ_b > 0` (two forward
coordinates; `3k + 3 ≤ sk`, `∑_c |σ_c| < q`), two distinct points at squared distance
`< ∑_c (|σ_c| + 1)²/q²`. -/
theorem P2_forward {s q k : ℕ} (hs : 4 ≤ s) (h3k : 3 * k + 3 ≤ s * k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (a b : Fin s) (hab : a ≠ b) (ε : ℤ)
    (hε : ε = 1 ∨ ε = -1) (ha : 0 < sig (Mt Φ) a b ε a) (hb : 0 < ε * sig (Mt Φ) a b ε b)
    (hsum : ∑ c, |sig (Mt Φ) a b ε c| < q) :
    PairBelow q (s * k) k (gfPoint q k Φ)
      (∑ c, (((|sig (Mt Φ) a b ε c| : ℤ) : ℝ) + 1) ^ 2 / (q : ℝ) ^ 2) :=
  Proofs.P2_forward hs h3k Φ hnet a b hab ε hε ha hb hsum

/-- **`prop:P2`**, second statement, `O`-form: with `C = max |M̃|`-bound, `c = O(√s C/q)`:
two distinct points at squared distance `< s (2C + 1)²/q²`. -/
theorem P2_forward_C {s q k C : ℕ} (hs : 4 ≤ s) (h3k : 3 * k + 3 ≤ s * k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (a b : Fin s) (hab : a ≠ b) (ε : ℤ)
    (hε : ε = 1 ∨ ε = -1) (ha : 0 < sig (Mt Φ) a b ε a) (hb : 0 < ε * sig (Mt Φ) a b ε b)
    (hsum : ∑ c, |sig (Mt Φ) a b ε c| < q) (hC : ∀ c d, |Mt Φ c d| ≤ C) :
    PairBelow q (s * k) k (gfPoint q k Φ) (s * (2 * (C : ℝ) + 1) ^ 2 / (q : ℝ) ^ 2) :=
  Proofs.P2_forward_C hs h3k Φ hnet a b hab ε hε ha hb hsum hC

/-! ### `def:Ktrue` (the sentence after it), `thm:L` -/

/-- **`def:Ktrue`**, the sentence after it, with explicit constants: for `k ≥ 3`, `3k + 4 ≤ sk`,
a layer with nonzero diagonal, `|M̃| ≤ C` and `q > 4sC`: if `K_pair = K < ∞`, two distinct points
at distance `< 1 - K/q + 6sC²/q²`; if `K_pair = ∞`, at squared distance `< 9sC²/q²`
(distance `< 3√s C/q`). -/
theorem Ktrue_ceiling {s q k C : ℕ} (hs : 4 ≤ s) (hk : 3 ≤ k) (h3k : 3 * k + 4 ≤ s * k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (hdiag : ∀ a, Mt Φ a a ≠ 0)
    (hC : ∀ c d, |Mt Φ c d| ≤ C) (hq : 4 * s * C < q) :
    (Kpair (Mt Φ) = ⊤ →
        PairBelow q (s * k) k (gfPoint q k Φ) (9 * s * (C : ℝ) ^ 2 / (q : ℝ) ^ 2)) ∧
      ∀ K : ℕ, Kpair (Mt Φ) = K → PairBelow q (s * k) k (gfPoint q k Φ)
        ((1 - (K : ℝ) / q + 6 * s * (C : ℝ) ^ 2 / (q : ℝ) ^ 2) ^ 2) :=
  Proofs.Ktrue_ceiling hs hk h3k Φ hnet hdiag hC hq

/-- **`thm:L`**: for a digital `(0,sk,s)`-net over `ℤ/qℤ` (`q ≥ 2`) in graph form, `s ≥ 4`,
`k ≥ 1`, whose layer has no zero diagonal entry, `K_pair(M̃) ≥ √((s-3)/8)` (or `K_pair = ∞`). -/
theorem L_Kpair {s q k : ℕ} (hs : 4 ≤ s) (hq : 2 ≤ q) (hk : 1 ≤ k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (hdiag : ∀ a, Mt Φ a a ≠ 0) :
    Kpair (Mt Φ) = ⊤ ∨ ∃ K : ℕ, Kpair (Mt Φ) = K ∧ Real.sqrt (((s : ℝ) - 3) / 8) ≤ K :=
  Proofs.L_Kpair hs hq hk Φ hnet hdiag

/-- **`thm:L`**, "hence", with explicit constant: for `k ≥ 3`, `3k + 4 ≤ sk`, `|M̃| ≤ C` and
`q > 4sC`, two distinct points at distance `< 1 - √((s-3)/8)/q + 6sC²/q²`. -/
theorem L_ceiling {s q k C : ℕ} (hs : 4 ≤ s) (hk : 3 ≤ k) (h3k : 3 * k + 4 ≤ s * k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) (hdiag : ∀ a, Mt Φ a a ≠ 0)
    (hC : ∀ c d, |Mt Φ c d| ≤ C) (hq : 4 * s * C < q) :
    PairBelow q (s * k) k (gfPoint q k Φ)
      ((1 - Real.sqrt (((s : ℝ) - 3) / 8) / q + 6 * s * (C : ℝ) ^ 2 / (q : ℝ) ^ 2) ^ 2) :=
  Proofs.L_ceiling hs hk h3k Φ hnet hdiag hC hq

/-- The italic statement after `thm:L`: for `s ≥ 5` no digital `(0,sk,s)`-net over `ℤ/qℤ`
(`q ≥ 2`, `k ≥ 1`, in graph form) has all off-diagonal first-digit entries in `{±1}`. -/
theorem L_pm1 {s q k : ℕ} (hs : 5 ≤ s) (hq : 2 ≤ q) (hk : 1 ≤ k)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (hnet : IsNet0 s q (s * k) (gfPoint q k Φ)) :
    ¬ ∀ c d, c ≠ d → Mt Φ c d = 1 ∨ Mt Φ c d = -1 :=
  Proofs.L_pm1 hs hq hk Φ hnet

/-! ### `thm:O5` -/

/-- **`thm:O5`**: `s ≥ 5`, an integer design `F` whose residual problem is solvable over `ℚ` for a
frame of rational places, with nonzero level-`0` diagonal: `K_pair(F_0) ≥ 2`. -/
theorem O5_Kpair {s : ℕ} (hs : 5 ≤ s) (inf : Fin s) (x : Fin s → ℚ) (hx : PlacesOK inf x)
    (F : ℕ → Fin s → Fin s → ℤ) (lam : Fin s → ℚ) (Ur : Fin s → ℕ → ℕ → ℚ)
    (hres : Residual inf x (fun n c d => (F n c d : ℚ)) lam Ur) (hdiag : ∀ c, F 0 c c ≠ 0) :
    2 ≤ Kpair (F 0) :=
  Proofs.O5_Kpair hs inf x hx F lam Ur hres hdiag

/-- **`thm:O5`**, "hence", with explicit constant: the net `𝒫^F_{k,q}` of `def:Ns` over a ring `R`
(e.g. `ℤ[1/DD']`) with ring maps to `ℚ` and to `ℤ/qℤ` (for `ℤ[1/DD']` the latter exists iff
`gcd(q, DD') = 1`), `k ≥ 3`, `3k + 4 ≤ sk`, `|F_0| ≤ C`, `q > q_1(F) = 4sC`: two distinct points at
distance `< 1 - 2/q + 6sC²/q²`. -/
theorem O5_sep {R : Type*} [CommRing R] {s q k C : ℕ} (hs : 5 ≤ s) (hk : 3 ≤ k)
    (h3k : 3 * k + 4 ≤ s * k) (ι : R →+* ℚ) (ψ : R →+* ZMod q) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → ℤ) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R)
    (hres : Residual inf x (fun n c d => (F n c d : R)) lam Ur)
    (hβ : BetaRel inf x (fun n c d => (F n c d : R)) lam β) (hdiag : ∀ c, F 0 c c ≠ 0)
    (hC : ∀ c d, |F 0 c d| ≤ C) (hq : 4 * s * C < q) :
    PairBelow q (s * k) k
      (digPoint q (s * k) fun c => (PGen k inf x (fun n c d => (F n c d : R)) lam Ur β c).map ψ)
      ((1 - 2 / (q : ℝ) + 6 * s * (C : ℝ) ^ 2 / (q : ℝ) ^ 2) ^ 2) :=
  Proofs.O5_sep hs hk h3k ι ψ inf x hx F lam Ur β hres hβ hdiag hC hq

/-! ### `prop:P` (no half-integer frame layer) -/

/-- **`prop:P`(1)**: a Cauchy layer over `𝔽_p` with `2 W_xy ≡ h_xy (mod p)` for the twelve ordered
pairs of four distinct coordinates, `h_xy` odd with `|h_xy| ≤ H`: `p` divides a nonzero (odd)
integer `Z` with `|Z| ≤ 13 H^16`. -/
theorem P_half_mod {ι : Type*} (p : ℕ) [Fact p.Prime] (α β lam mu : ι → ZMod p)
    (h : CauchyOK α β lam mu) (a b c d : ι) (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (hh : ι → ι → ℤ) (H : ℕ)
    (hodd : ∀ x y, (x = a ∨ x = b ∨ x = c ∨ x = d) → (y = a ∨ y = b ∨ y = c ∨ y = d) → x ≠ y →
      Odd (hh x y) ∧ |hh x y| ≤ H ∧ 2 * cauchyW α β lam mu x y = (hh x y : ZMod p)) :
    ∃ Z : ℤ, Odd Z ∧ |Z| ≤ 13 * (H : ℤ) ^ 16 ∧ (p : ℤ) ∣ Z :=
  Proofs.P_half_mod p α β lam mu h a b c d hab hac had hbc hbd hcd hh H hodd

/-- **`prop:P`(1)**, "in particular": impossible for `p > 13 H^16`. -/
theorem P_half_mod_large {ι : Type*} (p : ℕ) [Fact p.Prime] (α β lam mu : ι → ZMod p)
    (h : CauchyOK α β lam mu) (a b c d : ι) (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (H : ℕ) (hp : 13 * H ^ 16 < p) :
    ¬ ∃ hh : ι → ι → ℤ, ∀ x y, (x = a ∨ x = b ∨ x = c ∨ x = d) →
      (y = a ∨ y = b ∨ y = c ∨ y = d) → x ≠ y →
        Odd (hh x y) ∧ |hh x y| ≤ H ∧ 2 * cauchyW α β lam mu x y = (hh x y : ZMod p) :=
  Proofs.P_half_mod_large p α β lam mu h a b c d hab hac had hbc hbd hcd H hp

/-- **`prop:P`(2)**: over `ℚ`, the twelve entries `W_xy` (`x ≠ y` among four distinct
coordinates) of a Cauchy layer do not all lie in `1/2 + ℤ`. -/
theorem P_half_rat {ι : Type*} (α β lam mu : ι → ℚ) (h : CauchyOK α β lam mu) (a b c d : ι)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) :
    ¬ ∀ x y, (x = a ∨ x = b ∨ x = c ∨ x = d) → (y = a ∨ y = b ∨ y = c ∨ y = d) → x ≠ y →
      ∃ n : ℤ, cauchyW α β lam mu x y = n + 1 / 2 :=
  Proofs.P_half_rat α β lam mu h a b c d hab hac had hbc hbd hcd

/-! ### `lem:frameid`, `cor:frameid` -/

/-- **`lem:frameid`**, for arbitrary depths `K ≥ 1` (in particular the skeleton depths with a full
coordinate `d` and skeleton coordinates `z_i`): let `Φ` be obtained from the frame's graph form
over a field by the moves of `lem:box` (`Φ_cd = L_c Φ^F_cd U_d` off the diagonal, `L_c`, `U_d`
lower triangular with unit diagonal; diagonal blocks arbitrary), `κ_i` the deepest-level entry
of row `0` of block `(z_i, d)` and `g_ij` that of block `(z_i, z_j)`. Then for distinct
`z_i, z_j, z_l, d`: `g_ji g_lj / κ_j + g_ij g_li / κ_i = g_li g_lj / κ_l`. -/
theorem frameid {𝕜 : Type*} [Field 𝕜] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (hK1 : ∀ c, 1 ≤ K c) (inf : Fin s) (x : Fin s → 𝕜) (hx : PlacesOK inf x)
    (L : (c : Fin s) → Matrix (Fin (m - K c)) (Fin (m - K c)) 𝕜)
    (U : (d : Fin s) → Matrix (Fin (K d)) (Fin (K d)) 𝕜) (hL : ∀ c, IsLTU (L c))
    (hU : ∀ d, IsLTU (U d)) (Φ : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) 𝕜)
    (hΦ : ∀ c d, c ≠ d → Φ c d = L c * frameGraphK 𝕜 m K inf x c d * U d)
    (zi zj zl d : Fin s) (hij : zi ≠ zj) (hil : zi ≠ zl) (hid : zi ≠ d) (hjl : zj ≠ zl)
    (hjd : zj ≠ d) (hld : zl ≠ d) :
    ent (Φ zj zi) 0 (K zi - 1) * ent (Φ zl zj) 0 (K zj - 1) * (ent (Φ zj d) 0 (K d - 1))⁻¹ +
        ent (Φ zi zj) 0 (K zj - 1) * ent (Φ zl zi) 0 (K zi - 1) * (ent (Φ zi d) 0 (K d - 1))⁻¹ =
      ent (Φ zl zi) 0 (K zi - 1) * ent (Φ zl zj) 0 (K zj - 1) * (ent (Φ zl d) 0 (K d - 1))⁻¹ :=
  Proofs.frameid K hK hK1 inf x hx L U hL hU Φ hΦ zi zj zl d hij hil hid hjl hjd hld

/-- **`cor:frameid`** (the Korobov route needs large faults): integers `ρ, G ≥ 1` with `G² < ρ`
and `p > G²(2ρ² + 1)`; no graph form obtained from a frame over `𝔽_p` by the moves of `lem:box`
(arbitrary depths `K ≥ 1`) has, for distinct `z₁, z₂, z₃, d`, `κ_1, κ_2, κ_3 ≡ ρ, ρ², ρ³` and
centred `|g_ij| ≤ G` for `i ≠ j ≤ 3` (notation of `frameid`). -/
theorem frameid_cor (p : ℕ) [Fact p.Prime] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (hK1 : ∀ c, 1 ≤ K c) (inf : Fin s) (x : Fin s → ZMod p) (hx : PlacesOK inf x)
    (L : (c : Fin s) → Matrix (Fin (m - K c)) (Fin (m - K c)) (ZMod p))
    (U : (d : Fin s) → Matrix (Fin (K d)) (Fin (K d)) (ZMod p)) (hL : ∀ c, IsLTU (L c))
    (hU : ∀ d, IsLTU (U d)) (Φ : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) (ZMod p))
    (hΦ : ∀ c d, c ≠ d → Φ c d = L c * frameGraphK (ZMod p) m K inf x c d * U d)
    (z₁ z₂ z₃ d : Fin s) (h12 : z₁ ≠ z₂) (h13 : z₁ ≠ z₃) (h1d : z₁ ≠ d) (h23 : z₂ ≠ z₃)
    (h2d : z₂ ≠ d) (h3d : z₃ ≠ d) (ρ G : ℕ) (hρ : 1 ≤ ρ) (hG : 1 ≤ G) (hGρ : G ^ 2 < ρ)
    (hp : G ^ 2 * (2 * ρ ^ 2 + 1) < p) :
    ¬ (ent (Φ z₁ d) 0 (K d - 1) = (ρ : ZMod p) ∧ ent (Φ z₂ d) 0 (K d - 1) = (ρ : ZMod p) ^ 2 ∧
      ent (Φ z₃ d) 0 (K d - 1) = (ρ : ZMod p) ^ 3 ∧
      ∀ i j, (i = z₁ ∨ i = z₂ ∨ i = z₃) → (j = z₁ ∨ j = z₂ ∨ j = z₃) → i ≠ j →
        |(ent (Φ i j) 0 (K j - 1)).valMinAbs| ≤ G) :=
  Proofs.frameid_cor p K hK hK1 inf x hx L U hL hU Φ hΦ z₁ z₂ z₃ d h12 h13 h1d h23 h2d h3d ρ G hρ hG hGρ hp

end Z3NetF
