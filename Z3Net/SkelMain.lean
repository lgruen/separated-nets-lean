/-! ### `lem:skelred` (separation reduction) -/

/-- **`lem:skelred`(i)**, one coordinate. Let `X, Y ∈ [0, N)` with `N = Q f` (`Q = p^(k+1)` fine
cells of `f` integer units), fine positions `P = ⌊X/f⌋`, `P' = ⌊Y/f⌋`, and `a` the centred residue
of `P' - P` modulo `Q`. Then the toroidal distance of `X` and `Y` modulo `N` is at least
`(|a| - 1) f`. -/
theorem skelred_coord (Q f X Y : ℕ) (hX : X < Q * f) (hY : Y < Q * f) :
    (|cmod Q ((Y / f : ℕ) - (X / f : ℕ) : ℤ)| - 1) * (f : ℤ) ≤ (cres (Q * f) ((Y : ℤ) - X) : ℤ) :=
  Proofs.skelred_coord Q f X Y hX hY

/-- **`lem:skelred`(i)**, the separation: for any digital point set with `m ≥ k + 1` digits and two
indices whose centred fine difference has some `|a_c| ≥ M`, the squared toroidal distance (times
`N²`) is at least `(M - 1)² f²`, `f = p^(m-k-1)`. -/
theorem skelred_sep {s : ℕ} (p m k M : ℕ) (hp : 2 ≤ p) (hkm : k + 1 ≤ m)
    (C : Fin s → Matrix (Fin m) (Fin m) (ZMod p)) (v w : Fin m → ZMod p)
    (hM : ∃ c, (M : ℤ) ≤ |cmod (p ^ (k + 1)) ((finePos p m k C w c : ℤ) - finePos p m k C v c)|) :
    (M - 1) ^ 2 * p ^ (2 * (m - (k + 1))) ≤
      torusDist2 (p ^ m) (digPoint p m C v) (digPoint p m C w) :=
  Proofs.skelred_sep p m k M hp hkm C v w hM

/-- **`lem:skelred`(i)**, real form: for `m = s k + r` (`r ≤ s`, `ℓ = s - r`) and a pair with
`|a|_∞ ≥ M`, the toroidal distance of the points `X / N` is at least `(M - 1) p^(-ℓ/s) N^(-1/s)`. -/
theorem skelred_sep_real {s : ℕ} (p r k M : ℕ) (hp : 2 ≤ p) (hs : 1 ≤ s) (hr : r ≤ s)
    (hkm : k + 1 ≤ s * k + r)
    (C : Fin s → Matrix (Fin (s * k + r)) (Fin (s * k + r)) (ZMod p))
    (v w : Fin (s * k + r) → ZMod p)
    (hM : ∃ c, (M : ℤ) ≤ |cmod (p ^ (k + 1))
      ((finePos p (s * k + r) k C w c : ℤ) - finePos p (s * k + r) k C v c)|) :
    ((M : ℝ) - 1) * (p : ℝ) ^ (-(((s - r : ℕ) : ℝ) / (s : ℝ))) *
        ((p : ℝ) ^ (s * k + r)) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (s * k + r))
          ((digPoint p (s * k + r) C v c : ℤ) - (digPoint p (s * k + r) C w c : ℤ)) : ℝ)
          / (p : ℝ) ^ (s * k + r)) ^ 2) :=
  Proofs.skelred_sep_real p r k M hp hs hr hkm C v w hM

/-- **`lem:skelred`(ii)** (carry propagation): if the centred difference `a` of two fine positions
`P, P' < p^(k+1)` has `|a| < p`, then for `1 ≤ j ≤ k`,
`⌊P'/p^j⌋ - ⌊P/p^j⌋ ≡ ξ_j (mod p^(k+1-j))` with `ξ_j ∈ {0, sgn a}`, and `ξ_j ≠ 0` implies
`ξ_(j-1) ≠ 0` for `j ≥ 2`. -/
theorem skelred_carry (p k P P' : ℕ) (hp : 2 ≤ p) (hP : P < p ^ (k + 1)) (hP' : P' < p ^ (k + 1))
    (ha : |cmod (p ^ (k + 1)) ((P' : ℤ) - P)| < p) :
    ∃ ξ : ℕ → ℤ, (∀ j, 1 ≤ j → j ≤ k →
        ((P' / p ^ j : ℕ) : ℤ) - (P / p ^ j : ℕ) ≡ ξ j [ZMOD (p : ℤ) ^ (k + 1 - j)] ∧
          (ξ j = 0 ∨ ξ j = Int.sign (cmod (p ^ (k + 1)) ((P' : ℤ) - P)))) ∧
      ∀ j, 2 ≤ j → j ≤ k → ξ j ≠ 0 → ξ (j - 1) ≠ 0 :=
  Proofs.skelred_carry p k P P' hp hP hP' ha

/-! ### `lem:skelnec` (pure-skeleton conditions) -/

/-- **`lem:skelnec`(N1)**: in a `(0,m,s)`-net over `𝔽_p` in skeleton graph form, every square
submatrix `A[I, J]` of the coefficients `A_{z,d}` of the skeleton digits (rows `z ∈ I` skeleton
coordinates) on the last levels `x_{d,k}` (columns `d ∈ J` full coordinates) is invertible. -/
theorem skelnec_N1 (s r p k : ℕ) [Fact p.Prime] (hr : r ≤ s)
    (C : Fin s → Matrix (Fin (s * k + r)) (Fin (s * k + r)) (ZMod p)) (hC : IsSkGF s r p k C)
    (hnet : IsNet0 s p (s * k + r) (digPoint p (s * k + r) C)) (n : ℕ) (I J : Fin n ↪ Fin s)
    (hI : ∀ a, r ≤ (I a : ℕ)) (hJ : ∀ b, (J b : ℕ) < r) :
    (Matrix.of fun a b => ent (C (I a)) k (skOff r k (J b : ℕ) + k)).det ≠ 0 :=
  Proofs.skelnec_N1 s r p k hr C hC hnet n I J hI hJ

/-- **`lem:skelnec`(N2)** (forced faults): for `k ≥ 1` and distinct skeleton coordinates
`z_i ≠ z_j`, the coefficient `g_ij` of `S_{z_i}` on `z_{j,k-1}` is nonzero. -/
theorem skelnec_N2 (s r p k : ℕ) [Fact p.Prime] (hr : r ≤ s) (hk : 1 ≤ k)
    (C : Fin s → Matrix (Fin (s * k + r)) (Fin (s * k + r)) (ZMod p)) (hC : IsSkGF s r p k C)
    (hnet : IsNet0 s p (s * k + r) (digPoint p (s * k + r) C)) (i j : Fin s) (hi : r ≤ (i : ℕ))
    (hj : r ≤ (j : ℕ)) (hij : i ≠ j) :
    ent (C i) k (skOff r k (j : ℕ) + (k - 1)) ≠ 0 :=
  Proofs.skelnec_N2 s r p k hr hk C hC hnet i j hi hj hij

/-- **`lem:skelnec`(N3)**, full coordinate: for a set `I` of `n ≤ k + 1` skeleton coordinates and a
full coordinate `x_d`, the coefficients of the `S_{z_i}` (`i ∈ I`) on the levels
`x_{d,k}, …, x_{d,k-n+1}` form an invertible matrix. -/
theorem skelnec_N3_full (s r p k : ℕ) [Fact p.Prime] (hr : r ≤ s)
    (C : Fin s → Matrix (Fin (s * k + r)) (Fin (s * k + r)) (ZMod p)) (hC : IsSkGF s r p k C)
    (hnet : IsNet0 s p (s * k + r) (digPoint p (s * k + r) C)) (n : ℕ) (hn : n ≤ k + 1)
    (I : Fin n ↪ Fin s) (hI : ∀ a, r ≤ (I a : ℕ)) (d : Fin s) (hd : (d : ℕ) < r) :
    (Matrix.of fun a b : Fin n => ent (C (I a)) k (skOff r k (d : ℕ) + (k - (b : ℕ)))).det ≠ 0 :=
  Proofs.skelnec_N3_full s r p k hr C hC hnet n hn I hI d hd

/-- **`lem:skelnec`(N3)**, skeleton coordinate: for a set `I` of `n ≤ k` skeleton coordinates and a
skeleton coordinate `z_e ∉ I`, the coefficients of the `S_{z_i}` (`i ∈ I`) on the levels
`z_{e,k-1}, …, z_{e,k-n}` form an invertible matrix. -/
theorem skelnec_N3_skel (s r p k : ℕ) [Fact p.Prime] (hr : r ≤ s)
    (C : Fin s → Matrix (Fin (s * k + r)) (Fin (s * k + r)) (ZMod p)) (hC : IsSkGF s r p k C)
    (hnet : IsNet0 s p (s * k + r) (digPoint p (s * k + r) C)) (n : ℕ) (hn : n ≤ k)
    (I : Fin n ↪ Fin s) (hI : ∀ a, r ≤ (I a : ℕ)) (e : Fin s) (he : r ≤ (e : ℕ))
    (heI : ∀ a, I a ≠ e) :
    (Matrix.of fun a b : Fin n => ent (C (I a)) k (skOff r k (e : ℕ) + (k - 1 - (b : ℕ)))).det ≠ 0 :=
  Proofs.skelnec_N3_skel s r p k hr C hC hnet n hn I hI e he heI

/-! ### `prop:skelcomp` (completion) -/

/-- The frame's `K`-box is invertible and `Φ^F` (`frameGraphK`) is its graph form, for arbitrary
depths `K` with `∑ K = m` (`sec:skel`: `lem:Ts` and the graph form with depths `K`). -/
theorem frameGraphK_spec {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) :
    IsUnit (boxMatrix (frameRead m inf x) K).det ∧
      ∀ c, graphGenK (m := m) K (frameGraphK R m K inf x) c * boxMatrix (frameRead m inf x) K =
        frameRead m inf x c :=
  Proofs.frameGraphK_spec K hK inf x hx

/-- **`prop:skelcomp`(i)** (normal form, for arbitrary depths `K`, in particular the skeleton depths
for every `k`): with `L_c = diag((Q^K_c)⁻¹, 1, …, 1)` and `U_d = Toep(uNK_d)`, row `0` of
`L_c Φ^F_cd U_d` carries `w_cd y_cd^n` at the `x`-index `n` (level `K_d - 1 - n`). -/
theorem skelcomp_normal {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) (c d : Fin s) (hcd : c ≠ d)
    (j : Fin (K d)) :
    ent (Lgauge (m - K c) (Ring.inverse (QfK K inf x c)) * frameGraphK R m K inf x c d *
        toep (K d) (uNK K inf x d)) 0 j = wN inf x c d * yN inf x c d ^ (K d - 1 - (j : ℕ)) :=
  Proofs.skelcomp_normal K hK inf x hx c d hcd j

/-- **`prop:skelcomp`(i), consequence: `prop:Gs` on the rows `S`.** If the residual problem on the
rows `S` is solvable, then for arbitrary depths `K` (every `k`) one column gauge `U_d` per column
(lower triangular, unit diagonal) makes row `0` of `L_c Φ^F_cd U_d`, `L_c = diag(λ'_c (Q^K_c)⁻¹, 1, …)`,
equal to the design `F_n[c][d]` at the `x`-indices `n < ℓ_d = #(S \ {d})` and `0` above, for all
rows `c ∈ S`, `c ≠ d`. -/
theorem skel_Gs {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) (S : Finset (Fin s))
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R)
    (hres : ResidualSk inf x S F lam Ur) :
    ∃ U : (d : Fin s) → Matrix (Fin (K d)) (Fin (K d)) R, (∀ d, IsLTU (U d)) ∧
      ∀ c ∈ S, ∀ d, c ≠ d → ∀ j : Fin (K d),
        ent (Lgauge (m - K c) (lam c * Ring.inverse (QfK K inf x c)) * frameGraphK R m K inf x c d *
          U d) 0 j = if K d - 1 - (j : ℕ) < (S.erase d).card then F (K d - 1 - (j : ℕ)) c d else 0 :=
  Proofs.skel_Gs K hK inf x hx S F lam Ur hres

/-- **`prop:skelcomp`(i), consequence: `prop:F` on the rows `S`.** If every column has at least
`ℓ_d` levels, a design on the rows `S` is reachable with the row scalars `λ'` iff the residual
problem on `S` is solvable with these `λ'`. -/
theorem skel_reach_iff {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) (S : Finset (Fin s))
    (hKS : ∀ d, (S.erase d).card ≤ K d) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (hlam : ∀ c ∈ S, IsUnit (lam c)) :
    (∃ U : (d : Fin s) → Matrix (Fin (K d)) (Fin (K d)) R, (∀ d, IsLTU (U d)) ∧
      ∀ c ∈ S, ∀ d, c ≠ d → ∀ j : Fin (K d),
        ent (Lgauge (m - K c) (lam c * Ring.inverse (QfK K inf x c)) * frameGraphK R m K inf x c d *
          U d) 0 j = if K d - 1 - (j : ℕ) < (S.erase d).card then F (K d - 1 - (j : ℕ)) c d else 0) ↔
      ∃ Ur : Fin s → ℕ → ℕ → R, ResidualSk inf x S F lam Ur :=
  Proofs.skel_reach_iff K hK inf x hx S hKS F lam hlam

/-- **`prop:skelcomp`(ii)** (`ℓ = 1`): for every `k ≥ 0`, all distinct places and all units
`κ_0, …, κ_{s-2}`, the moves of `lem:box` (`Φ' = L Φ^F U` off the diagonal, diagonal blocks set)
turn the frame's graph form with depths `(k+1, …, k+1, k)` into a graph form whose skeleton digit is
`S_z = ∑_d κ_d x_{d,k}` (all other entries of row `0` of `z`, own block included, `0`); it is a
digital `(0, sk+s-1, s)`-net over `𝔽_p`. -/
theorem skelcomp_ii (p : ℕ) [Fact p.Prime] (s k : ℕ) (hs : 2 ≤ s) (inf : Fin s)
    (x : Fin s → ZMod p) (hx : PlacesOK inf x) (κ : ℕ → ZMod p) (hκ : ∀ d, d + 1 < s → κ d ≠ 0) :
    ∃ (L : (c : Fin s) → Matrix (Fin (s * k + (s - 1) - skDepth (s - 1) k c))
        (Fin (s * k + (s - 1) - skDepth (s - 1) k c)) (ZMod p))
      (U : (d : Fin s) → Matrix (Fin (skDepth (s - 1) k d)) (Fin (skDepth (s - 1) k d)) (ZMod p))
      (Φ : (c d : Fin s) → Matrix (Fin (s * k + (s - 1) - skDepth (s - 1) k c))
        (Fin (skDepth (s - 1) k d)) (ZMod p)),
      (∀ c, IsLTU (L c)) ∧ (∀ d, IsLTU (U d)) ∧
      (∀ c d, c ≠ d → Φ c d =
        L c * frameGraphK (ZMod p) (s * k + (s - 1)) (skDepth (s - 1) k) inf x c d * U d) ∧
      (∀ z d : Fin s, (z : ℕ) + 1 = s → ∀ l : Fin (skDepth (s - 1) k d),
        ent (Φ z d) 0 l = if (d : ℕ) + 1 < s ∧ (l : ℕ) = k then κ d else 0) ∧
      IsNet0 s p (s * k + (s - 1))
        (digPoint p (s * k + (s - 1)) (graphGenK (m := s * k + (s - 1)) (skDepth (s - 1) k) Φ)) :=
  Proofs.skelcomp_ii p s k hs inf x hx κ hκ

/-- **`prop:skelcomp`(iii)** (`ℓ = 2`, `s = r + 2`): skeleton digits
`S_{z_i} = ∑_d A_id x_{d,k} + ∑_d β_id x_{d,k-1} + g_i z_{j,k-1} + o_i z_{i,k-1}` satisfying
(N1) (all entries and `2 × 2` minors of `A` nonzero), (N2) (`g_i ≠ 0`) and (N3)
(`det[A_{·d}, β_{·d}] ≠ 0`), with arbitrary own coefficients `o_i`, are reachable from the frame
for a suitable choice of the places (independent of `k`), for every `k ≥ 1`, and complete to a
digital `(0, sk+s-2, s)`-net over `𝔽_p`. -/
theorem skelcomp_iii (p : ℕ) [Fact p.Prime] (r : ℕ) (hr : 1 ≤ r) (A β : Fin 2 → ℕ → ZMod p)
    (g o : Fin 2 → ZMod p) (hA : ∀ i d, d < r → A i d ≠ 0)
    (hA2 : ∀ d d', d < r → d' < r → d ≠ d' → A 0 d * A 1 d' - A 0 d' * A 1 d ≠ 0)
    (hg : ∀ i, g i ≠ 0) (hβ : ∀ d, d < r → A 0 d * β 1 d - β 0 d * A 1 d ≠ 0) :
    ∃ (inf : Fin (r + 2)) (x : Fin (r + 2) → ZMod p), PlacesOK inf x ∧ ∀ k, 1 ≤ k →
      ∃ (L : (c : Fin (r + 2)) → Matrix (Fin ((r + 2) * k + r - skDepth r k c))
          (Fin ((r + 2) * k + r - skDepth r k c)) (ZMod p))
        (U : (d : Fin (r + 2)) → Matrix (Fin (skDepth r k d)) (Fin (skDepth r k d)) (ZMod p))
        (Φ : (c d : Fin (r + 2)) → Matrix (Fin ((r + 2) * k + r - skDepth r k c))
          (Fin (skDepth r k d)) (ZMod p)),
        (∀ c, IsLTU (L c)) ∧ (∀ d, IsLTU (U d)) ∧
        (∀ c d, c ≠ d → Φ c d =
          L c * frameGraphK (ZMod p) ((r + 2) * k + r) (skDepth r k) inf x c d * U d) ∧
        (∀ i : Fin 2, ∀ d : Fin (r + 2), ∀ l : Fin (skDepth r k d),
          ent (Φ (Fin.natAdd r i) d) 0 l = sk2Coef r k A β g o i (d : ℕ) (l : ℕ)) ∧
        IsNet0 (r + 2) p ((r + 2) * k + r)
          (digPoint p ((r + 2) * k + r) (graphGenK (m := (r + 2) * k + r) (skDepth r k) Φ)) :=
  Proofs.skelcomp_iii p r hr A β g o hA hA2 hg hβ

/-- **Graph forms in the skeleton depths** (bridge between the two descriptions): a graph form
`graphGenK (skDepth r k) Φ` is in skeleton graph form (`IsSkGF`), and row `k` of a skeleton
coordinate `z` on level `l` of block `d` is entry `(0, l)` of `Φ z d`. -/
theorem skel_graphGen (s r p k : ℕ) (hr : r ≤ s)
    (Φ : (c d : Fin s) → Matrix (Fin (s * k + r - skDepth r k c)) (Fin (skDepth r k d)) (ZMod p)) :
    IsSkGF s r p k (graphGenK (m := s * k + r) (skDepth r k) Φ) ∧
      ∀ z d : Fin s, r ≤ (z : ℕ) → ∀ l : Fin (skDepth r k d),
        ent (graphGenK (m := s * k + r) (skDepth r k) Φ z) k (skOff r k (d : ℕ) + l) =
          ent (Φ z d) 0 l :=
  Proofs.skel_graphGen s r p k hr Φ

/-! ### `lem:skellat` (L1), (T) -/

/-- **`lem:skellat`(L1)** (`r = 1`): if `ρ ≥ 2` and `ρ^ℓ (ρ + 1) ≤ p`, every nonzero
`(x, z_1, …, z_ℓ) ∈ ℤ^(1+ℓ)` with `z_i ≡ ρ^i x (mod p)` has maximum norm at least `ρ^ℓ`. -/
theorem skellat_L1 (ℓ p ρ : ℕ) (hρ : 2 ≤ ρ) (hp : ρ ^ ℓ * (ρ + 1) ≤ p) (x : ℤ) (z : Fin ℓ → ℤ)
    (hz : ∀ i : Fin ℓ, (p : ℤ) ∣ z i - (ρ : ℤ) ^ ((i : ℕ) + 1) * x) (hne : ¬(x = 0 ∧ z = 0)) :
    (ρ : ℤ) ^ ℓ ≤ |x| ∨ ∃ i, (ρ : ℤ) ^ ℓ ≤ |z i| :=
  Proofs.skellat_L1 ℓ p ρ hρ hp x z hz hne

/-- **`lem:skellat`(L1)**, equality: `(1, ρ, …, ρ^ℓ)` is a nonzero lattice vector of maximum norm
`ρ^ℓ`, so `λ_∞(Λ_A) = ρ^ℓ`. -/
theorem skellat_L1_attained (ℓ p ρ : ℕ) (hρ : 1 ≤ ρ) :
    ∃ x : ℤ, ∃ z : Fin ℓ → ℤ, (∀ i : Fin ℓ, (p : ℤ) ∣ z i - (ρ : ℤ) ^ ((i : ℕ) + 1) * x) ∧
      ¬(x = 0 ∧ z = 0) ∧ |x| ≤ (ρ : ℤ) ^ ℓ ∧ ∀ i, |z i| ≤ (ρ : ℤ) ^ ℓ :=
  Proofs.skellat_L1_attained ℓ p ρ hρ

/-- **`lem:skellat`(T)** (`ℓ = r = 2`): if `ρ ≥ 2` and `ρ² - 4 < p`, every nonzero
`(x, z) ∈ ℤ⁴` with `z_1 ≡ ρ x_1 + x_2`, `z_2 ≡ x_1 + ρ x_2 (mod p)` has maximum norm at least
`ρ - 1`. -/
theorem skellat_T (p ρ : ℕ) (hρ : 2 ≤ ρ) (hp : ρ ^ 2 < p + 4) (x z : Fin 2 → ℤ)
    (h1 : (p : ℤ) ∣ z 0 - ((ρ : ℤ) * x 0 + x 1)) (h2 : (p : ℤ) ∣ z 1 - (x 0 + (ρ : ℤ) * x 1))
    (hne : ¬(x = 0 ∧ z = 0)) :
    (ρ : ℤ) - 1 ≤ |x 0| ∨ (ρ : ℤ) - 1 ≤ |x 1| ∨ (ρ : ℤ) - 1 ≤ |z 0| ∨ (ρ : ℤ) - 1 ≤ |z 1| :=
  Proofs.skellat_T p ρ hρ hp x z h1 h2 hne

/-! ### `prop:S1E` (Euclidean form of `thm:S1`(1)) -/

/-- **`prop:S1E`, net.** For `s ≥ 3`, every prime `p ≥ s - 1`, every `k ≥ 0` and all units
`κ_0, …, κ_{s-2}` there is a digital `(0, sk+s-1, s)`-net over `𝔽_p` in graph form with depths
`(k+1, …, k+1, k)` and skeleton digit `S_z = ∑_d κ_d x_{d,k}` (the recipe of
`prop:skelcomp`(ii) on the frame of `def:S1`). -/
theorem S1E_net (p : ℕ) [Fact p.Prime] (s k : ℕ) (hs : 3 ≤ s) (hp : s - 1 ≤ p) (κ : ℕ → ZMod p)
    (hκ : ∀ d, d + 1 < s → κ d ≠ 0) :
    ∃ C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p),
      IsS1Kskel s p k κ C ∧ IsNet0 s p (s * k + (s - 1)) (digPoint p (s * k + (s - 1)) C) :=
  Proofs.S1E_net p s k hs hp κ hκ

/-- **`prop:S1E`, separation (integer form).** Every graph form with depths `(k+1, …, k+1, k)` and
skeleton digit `∑_d κ_d x_{d,k}`: any two distinct points have squared toroidal distance (times
`N²`) at least `λ_jit(κ)² f²`, `f = p^(m-k-1)`. -/
theorem S1E_sep (p : ℕ) [Fact p.Prime] (s k : ℕ) (hs : 2 ≤ s) (κ : ℕ → ZMod p)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (hC : IsS1Kskel s p k κ C) (v w : Fin (s * k + (s - 1)) → ZMod p) (hvw : v ≠ w) :
    lamJit2 s p κ * p ^ (2 * ((s - 1) * (k + 1) - 1)) ≤
      torusDist2 (p ^ (s * k + (s - 1))) (digPoint p (s * k + (s - 1)) C v)
        (digPoint p (s * k + (s - 1)) C w) :=
  Proofs.S1E_sep p s k hs κ C hC v w hvw

/-- **`prop:S1E`, separation (real form)**: `δ N^(1/s) ≥ p^(-1/s) λ_jit(κ)` (toroidal). -/
theorem S1E_sep_real (p : ℕ) [Fact p.Prime] (s k : ℕ) (hs : 2 ≤ s) (κ : ℕ → ZMod p)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (hC : IsS1Kskel s p k κ C) (v w : Fin (s * k + (s - 1)) → ZMod p) (hvw : v ≠ w) :
    Real.sqrt (lamJit2 s p κ) * (p : ℝ) ^ (-(1 / (s : ℝ))) *
        ((p : ℝ) ^ (s * k + (s - 1))) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (s * k + (s - 1)))
          ((digPoint p (s * k + (s - 1)) C v c : ℤ) - (digPoint p (s * k + (s - 1)) C w c : ℤ)) : ℝ)
          / (p : ℝ) ^ (s * k + (s - 1))) ^ 2) :=
  Proofs.S1E_sep_real p s k hs κ C hC v w hvw

/-- **`prop:S1E`**, the second inequality: `λ_jit(κ) ≥ λ₂(Λ_κ) - √s`. -/
theorem S1E_lam2 (p : ℕ) [Fact p.Prime] (s : ℕ) (κ : ℕ → ZMod p) :
    Real.sqrt (lam2Sq s p κ) - Real.sqrt s ≤ Real.sqrt (lamJit2 s p κ) :=
  Proofs.S1E_lam2 p s κ

/-! ### `rem:codes` (Construction A) -/

/-- **`rem:codes`**, maximum norm: for `r ≥ 1`, `λ_∞(Λ_A)` (`Λ_A = {(x, z) : z ≡ A x (mod p)}`) is
the least largest centred entry of a nonzero codeword `(x, A x)` of `C_A`: every nonzero lattice
vector has maximum norm at least that weight, and some nonzero lattice vector attains it. -/
theorem codes_linf {ℓ r : ℕ} (p : ℕ) [Fact p.Prime] (hr : 1 ≤ r)
    (A : Matrix (Fin ℓ) (Fin r) (ZMod p)) :
    (∀ (x : Fin r → ℤ) (z : Fin ℓ → ℤ), (∀ i, (z i : ZMod p) = ∑ d, A i d * (x d : ZMod p)) →
        ¬(x = 0 ∧ z = 0) → ∃ y : Fin r → ZMod p, y ≠ 0 ∧
          cwInf p A y ≤ max (univ.sup fun d => (x d).natAbs) (univ.sup fun i => (z i).natAbs)) ∧
      ∀ y : Fin r → ZMod p, y ≠ 0 → (∀ y' : Fin r → ZMod p, y' ≠ 0 → cwInf p A y ≤ cwInf p A y') →
        ∃ (x : Fin r → ℤ) (z : Fin ℓ → ℤ), (∀ i, (z i : ZMod p) = ∑ d, A i d * (x d : ZMod p)) ∧
          ¬(x = 0 ∧ z = 0) ∧
          max (univ.sup fun d => (x d).natAbs) (univ.sup fun i => (z i).natAbs) = cwInf p A y :=
  Proofs.codes_linf p hr A

/-- **`rem:codes`**, Euclidean norm: `λ₂(Λ_A)² = min(p², w_E(C_A))`: every nonzero lattice vector
has squared norm at least `min(p², w_E(y))` for some nonzero codeword `y` or at least `p²`, and the
centred lift of a codeword attains `w_E(y)`. -/
theorem codes_l2 {ℓ r : ℕ} (p : ℕ) [Fact p.Prime] (A : Matrix (Fin ℓ) (Fin r) (ZMod p)) :
    (∀ (x : Fin r → ℤ) (z : Fin ℓ → ℤ), (∀ i, (z i : ZMod p) = ∑ d, A i d * (x d : ZMod p)) →
        ¬(x = 0 ∧ z = 0) →
        p ^ 2 ≤ ∑ d, (x d).natAbs ^ 2 + ∑ i, (z i).natAbs ^ 2 ∨
          ∃ y : Fin r → ZMod p, y ≠ 0 ∧ cwEuc p A y ≤ ∑ d, (x d).natAbs ^ 2 + ∑ i, (z i).natAbs ^ 2) ∧
      (1 ≤ ℓ + r → ∃ (x : Fin r → ℤ) (z : Fin ℓ → ℤ),
        (∀ i, (z i : ZMod p) = ∑ d, A i d * (x d : ZMod p)) ∧ ¬(x = 0 ∧ z = 0) ∧
          ∑ d, (x d).natAbs ^ 2 + ∑ i, (z i).natAbs ^ 2 = p ^ 2) ∧
      ∀ y : Fin r → ZMod p, ∃ (x : Fin r → ℤ) (z : Fin ℓ → ℤ),
        (∀ i, (z i : ZMod p) = ∑ d, A i d * (x d : ZMod p)) ∧ (y ≠ 0 → ¬(x = 0 ∧ z = 0)) ∧
          ∑ d, (x d).natAbs ^ 2 + ∑ i, (z i).natAbs ^ 2 = cwEuc p A y :=
  Proofs.codes_l2 p A

/-- **`rem:codes`(a)**: condition (N1) of `lem:skelnec` (every square submatrix of `A` invertible)
holds iff the systematic code `C_A = {(x, A x)}` is MDS (every nonzero codeword has Hamming
weight at least `ℓ + 1`). -/
theorem codes_mds {ℓ r : ℕ} (p : ℕ) [Fact p.Prime] (A : Matrix (Fin ℓ) (Fin r) (ZMod p)) :
    (∀ (n : ℕ) (I : Fin n ↪ Fin ℓ) (J : Fin n ↪ Fin r),
        (Matrix.of fun a b => A (I a) (J b)).det ≠ 0) ↔
      ∀ y : Fin r → ZMod p, y ≠ 0 → ℓ + 1 ≤ cwHam p A y :=
  Proofs.codes_mds p A

