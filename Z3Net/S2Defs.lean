module
public import Z3Net.SkelDefs

@[expose] public section

namespace Z3NetF

open Matrix Finset

/-! ## New definitions (entry S2) -/

/-- `Ω_l = ∏_{j < l} (c_j + i) ∈ ℤ[i]` (`lem:skellat`(G); `c_j` is `c_(j+1)` of the paper). -/
def gaussOmega (c : ℕ → ℤ) (l : ℕ) : GaussianInt := ∏ j ∈ range l, (⟨c j, 1⟩ : GaussianInt)

/-- The Gaussian matrix of `lem:skellat`(G): `A_1 x + i A_2 x = ∑_{l ≤ r-2} x_l Ω_l +
(x_{r-1} + i x_r) Ω_{r-1}`; column `d` (`0`-based, `d < r`) is `Ω_{d+1}` for `d + 1 < r` and
`i Ω_{r-1}` for `d = r - 1`; row `0` is the real, row `1` the imaginary part. -/
def gaussA (r : ℕ) (c : ℕ → ℤ) (i : Fin 2) (d : ℕ) : ℤ :=
  if (i : ℕ) = 0 then
    (if d + 1 < r then gaussOmega c (d + 1) else (⟨0, 1⟩ : GaussianInt) * gaussOmega c (r - 1)).re
  else (if d + 1 < r then gaussOmega c (d + 1) else (⟨0, 1⟩ : GaussianInt) * gaussOmega c (r - 1)).im

/-- The parameters of `def:G2rule`: `c_1 = ⌊√2 B⌋ + 1`, `c_l = ⌊√B⌋ + 1` for `l ≥ 2` (`0`-based). -/
def cG (B j : ℕ) : ℤ := if j = 0 then ((Nat.sqrt (2 * B ^ 2) + 1 : ℕ) : ℤ) else ((Nat.sqrt B + 1 : ℕ) : ℤ)

/-- `A(B)` of `def:G2rule` (`r = s - 2` columns). -/
def AG (s B : ℕ) (i : Fin 2) (d : ℕ) : ℤ := gaussA (s - 2) (cG B) i d

/-- `max_j ‖A_j(B)‖₁`. -/
def normA (s B : ℕ) : ℤ :=
  max (∑ d ∈ range (s - 2), |AG s B 0 d|) (∑ d ∈ range (s - 2), |AG s B 1 d|)

/-- `B(p)` of `def:G2rule`: the largest `B ≥ 1` with `B (1 + max_j ‖A_j(B)‖₁) < p` (`0` if none). -/
def Bp (s p : ℕ) : ℕ := Nat.findGreatest (fun B => 1 ≤ B ∧ (B : ℤ) * (1 + normA s B) < p) p

/-- `F = 1 + ⌈(s - 2)/2⌉` (`thm:S2`). -/
def Fs (s : ℕ) : ℕ := 1 + (s - 1) / 2

/-- `ρ` of `def:S2` for `s = 4`: the largest `ρ` with `ρ² - 4 < p`. -/
def rhoT (p : ℕ) : ℕ := Nat.findGreatest (fun ρ => ρ ^ 2 < p + 4) p

/-- The matrix `[[ρ, 1], [1, ρ]]` of `lem:skellat`(T). -/
def AT (ρ : ℕ) (i : Fin 2) (d : ℕ) : ℤ := if (i : ℕ) = d then (ρ : ℤ) else 1

/-- The matrix `A` of `def:S2`: `AT ρ` with `ρ` maximal for `s = 4`, `A(B(p))` for `s ≥ 5`. -/
def S2A (s p : ℕ) : Fin 2 → ℕ → ℤ := if s = 4 then AT (rhoT p) else AG s (Bp s p)

/-- `β_id = 1` iff `d ∈ D_i` (`D_1 = D1`, `D_2` its complement in the full coordinates). -/
def betaD (D1 : Finset ℕ) (i : Fin 2) (d : ℕ) : ℤ :=
  if (i : ℕ) = 0 then (if d ∈ D1 then 1 else 0) else (if d ∈ D1 then 0 else 1)

/-- **`def:S2`**: `C` is in graph form with depths `(k+1, …, k+1, k, k)` (`r = s - 2` full
coordinates) and its skeleton digits are `S_{z_1} = A_1 x_{·,k} + ∑_{d ∈ D_1} x_{d,k-1} + z_{2,k-1}`,
`S_{z_2} = A_2 x_{·,k} + ∑_{d ∈ D_2} x_{d,k-1} - z_{1,k-1}` (own coefficients `0`, all other
coefficients `0`), `A = S2A s p`. -/
def IsS2skel (s p k : ℕ) (D1 : Finset ℕ)
    (C : Fin s → Matrix (Fin (s * k + (s - 2))) (Fin (s * k + (s - 2))) (ZMod p)) : Prop :=
  IsSkGF s (s - 2) p k C ∧ ∀ (i : Fin 2) (z d : Fin s), (z : ℕ) = s - 2 + (i : ℕ) →
    ∀ l < skDepth (s - 2) k d, ent (C z) k (skOff (s - 2) k (d : ℕ) + l) =
      sk2Coef (s - 2) k (fun i d => ((S2A s p i d : ℤ) : ZMod p))
        (fun i d => ((betaD D1 i d : ℤ) : ZMod p)) ![1, -1] 0 i (d : ℕ) l

/-- The prime thresholds of `thm:S2`(2): `137, 443, 2179, 6101` for `s = 5, 6, 7, 8`. -/
def S2pthr (s : ℕ) : ℕ := if s = 5 then 137 else if s = 6 then 443 else if s = 7 then 2179 else 6101

/-- The exact thresholds of the proof of `thm:S2`: `B(p) ≥ F + 1` iff `p > 132, 440, 2170, 6095`. -/
def S2thr (s : ℕ) : ℕ := if s = 5 then 132 else if s = 6 then 440 else if s = 7 then 2170 else 6095

end Z3NetF
