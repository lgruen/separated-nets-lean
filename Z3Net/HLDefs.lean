/-! ## Prop H_k for arbitrary graph forms (stage 1 additions) -/

/-- The integer point (in `[0, q^(sk))^s`) of the digital net over `ℤ/qℤ` with graph form `Φ`
(depths `(k, …, k)`) at index `x`. The split-frame net is the case `Φ = HLPhi …`
(`HLpoint s q k u v lam gco dg = GFpoint s q k (HLPhi s q k u v lam gco dg)` by definition). -/
def GFpoint (s q k : ℕ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (x : Fin (s * k) → ZMod q) : Fin s → ℕ :=
  digPoint q (s * k) (graphGen s k Φ) x

/-- **Row `0` of every block is the design** (Prop H_k, hypothesis on the graph form): for the
doubled design `F2 x c d = 2 F_x[c][d]` (integers), row `0` of every block `Φ_cd`, diagonal
included, carries `F_{k-1-j}[c][d]` at level `j` when `k-1-j < s-1` (i.e. on the levels
`k-1, …, k-L`, `L = min(k, s-1)`) and `0` below; doubled: `2 Φ_cd[0, j] = F2 (k-1-j) c d`
(`½ ≡ (q+1)/2` for odd `q`). -/
def RowDesign (s q k : ℕ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (F2 : ℕ → Fin s → Fin s → ℤ) : Prop :=
  ∀ (c d : Fin s) (r : Fin (s * k - k)), (r : ℕ) = 0 → ∀ j : Fin k,
    2 * Φ c d r j = if k - 1 - (j : ℕ) < s - 1 then (F2 (k - 1 - (j : ℕ)) c d : ZMod q) else 0

/-- `2 b_c` of Prop H_k(1): with `2σ_c = sig2`, the options are `2t ∈ {2σ_c + q, 2σ_c - q}` if
`σ_E = ∑ E` is odd and `2t ∈ {2σ_c, 2σ_c - 2q sgn σ_c}` if it is even (a single option `0` if
`σ_c = 0`); `2 b_c = min_t max(0, |2q E_c + 2t| - 2)`. -/
def bOpt2 {s : ℕ} (q : ℕ) (F2 : ℕ → Fin s → Fin s → ℤ) (E : Fin s → ℤ) (J : Fin s → ℕ)
    (c : Fin s) : ℤ :=
  if (∑ d, E d) % 2 = 1 then
    min (max 0 (|2 * (q : ℤ) * E c + sig2 F2 E J c + q| - 2))
      (max 0 (|2 * (q : ℤ) * E c + sig2 F2 E J c - q| - 2))
  else
    min (max 0 (|2 * (q : ℤ) * E c + sig2 F2 E J c| - 2))
      (max 0 (|2 * (q : ℤ) * E c + sig2 F2 E J c - 2 * q * Int.sign (sig2 F2 E J c)| - 2))

/-- `2A_c` over the first `L` levels: `∑_{d ≠ c} max_{j < L} |2M^(j)[c][d]|`. -/
def A2L (s L : ℕ) (F2 : ℕ → Fin s → Fin s → ℤ) (c : Fin s) : ℕ :=
  ∑ d ∈ univ.erase c, (range L).sup fun j => (M2 F2 j c d).natAbs

/-- `B = max_c (2a_c + 2A_c)` with `A_c` over the first `L` levels. -/
def BdomL (s L : ℕ) (F2 : ℕ → Fin s → Fin s → ℤ) : ℕ :=
  univ.sup fun c : Fin s => (-F2 0 c c).toNat + A2L s L F2 c

/-- `2C = max_{c,d} |2F_0[c][d]|` (the constant `C` of Prop H_k(3), doubled). -/
def C2max (s : ℕ) (F2 : ℕ → Fin s → Fin s → ℤ) : ℕ :=
  univ.sup fun c : Fin s => univ.sup fun d : Fin s => (F2 0 c d).natAbs

/-- `2C_s = max_c 2a_c` for the design `H_s` (Theorem HL: `C_s = max_c a_c`). -/
def CH2 (s : ℕ) : ℕ := univ.sup fun c : Fin s => aH2 s c

/-! ## New definitions (entry Half) -/

/-- The graph form of `prop:half` with integer deeper rows (depths `(1, …, 1)`, `m = s`): row `0`
of the block `(c, d)` is `B_cd = M_cd = M2_cd · ½` with `½ ≡ (p+1)/2`, row `r ≥ 1` is `D c r d`
(coordinate `c` has the digits `n_c`, `r_c = (B n)_c` and `∑_d D c r d · n_d`, `r = 1, …, s-2`). -/
def halfPhi (s p : ℕ) (M2 : Fin s → Fin s → ℤ) (D : Fin s → ℕ → Fin s → ℤ) (c d : Fin s) :
    Matrix (Fin (s * 1 - 1)) (Fin 1) (ZMod p) :=
  fun r _ => if (r : ℕ) = 0 then (M2 c d : ZMod p) * (((p + 1) / 2 : ℕ) : ZMod p)
    else (D c r d : ZMod p)

/-- The steps `0 ≠ E ∈ {-2, …, 2}^s`. -/
def halfSteps (s : ℕ) : Finset (Fin s → ℤ) :=
  (Fintype.piFinset fun _ : Fin s => Finset.Icc (-2 : ℤ) 2).filter fun E => E ≠ 0

/-- `β_c = (M E)_c = (∑_d M2_cd E_d) / 2`. -/
noncomputable def halfBeta {s : ℕ} (M2 : Fin s → Fin s → ℤ) (E : Fin s → ℤ) (c : Fin s) : ℝ :=
  ((∑ d, M2 c d * E d : ℤ) : ℝ) / 2

/-- `ℓ_c(E)` of `prop:half`, clipped at `0`: for `σ_E = ∑ E` odd,
`min(|E_c + ½|, |E_c - ½|) - (|β_c| + 1)/p`; for `σ_E` even,
`min_{κ ∈ {0, sgn β_c}} |E_c - κ + β_c/p| - 1/p` (`sgn β_c = sgn(2β_c)`). -/
noncomputable def halfEll {s : ℕ} (p : ℕ) (M2 : Fin s → Fin s → ℤ) (E : Fin s → ℤ) (c : Fin s) :
    ℝ :=
  max 0 (if (∑ d, E d) % 2 = 1 then
      min |(E c : ℝ) + 1 / 2| |(E c : ℝ) - 1 / 2| - (|halfBeta M2 E c| + 1) / p
    else min |(E c : ℝ) + halfBeta M2 E c / p|
        |(E c : ℝ) - ((Int.sign (∑ d, M2 c d * E d) : ℤ) : ℝ) + halfBeta M2 E c / p| - 1 / p)

/-- The `p`-free part `ℓ^∞_c(E)`: `min(|E_c + ½|, |E_c - ½|)` for `σ_E` odd,
`min_{κ ∈ {0, sgn β_c}} |E_c - κ|` for `σ_E` even. -/
noncomputable def halfEllInf {s : ℕ} (M2 : Fin s → Fin s → ℤ) (E : Fin s → ℤ) (c : Fin s) : ℝ :=
  if (∑ d, E d) % 2 = 1 then min |(E c : ℝ) + 1 / 2| |(E c : ℝ) - 1 / 2|
  else min |(E c : ℝ)| |(E c : ℝ) - ((Int.sign (∑ d, M2 c d * E d) : ℤ) : ℝ)|

/-- `LB₂(p) = min(2, min_{0 ≠ E ∈ {-2,…,2}^s} |ℓ(E)|)` (Euclidean norm). -/
noncomputable def halfLB2 {s : ℕ} (p : ℕ) (M2 : Fin s → Fin s → ℤ) : ℝ :=
  min 2 (⨅ E : halfSteps s, Real.sqrt (∑ c, halfEll p M2 (E : Fin s → ℤ) c ^ 2))

/-- `λ(M) = min_{0 ≠ E ∈ {-2,…,2}^s} |ℓ^∞(E)|`. -/
noncomputable def halfLam {s : ℕ} (M2 : Fin s → Fin s → ℤ) : ℝ :=
  ⨅ E : halfSteps s, Real.sqrt (∑ c, halfEllInf M2 (E : Fin s → ℤ) c ^ 2)

/-- `2A = max_c ∑_d |M2_cd|` (`A = max_c ∑_d |M_cd|`). -/
def halfA2 {s : ℕ} (M2 : Fin s → Fin s → ℤ) : ℕ :=
  univ.sup fun c : Fin s => ∑ d, (M2 c d).natAbs

/-- Every square submatrix of `M2` (equivalently of `M = M2/2`) with disjoint row and column
index sets has nonzero determinant. -/
def DisjMinors {s : ℕ} (M2 : Fin s → Fin s → ℤ) : Prop :=
  ∀ (n : ℕ) (r c : Fin n → Fin s), Function.Injective r → Function.Injective c →
    (∀ i j, r i ≠ c j) → (Matrix.of fun i j => M2 (r i) (c j)).det ≠ 0

/-- The `s = 5` design of `tab:half`, doubled (`M = M5h / 2`; `eis_link_fix.py`, `designs()[5]`). -/
def M5h : Fin 5 → Fin 5 → ℤ :=
  ![![-5, 3, 1, -3, 1],
    ![-3, -3, 3, -1, -1],
    ![1, -1, -5, -3, 3],
    ![-1, -1, 3, -7, 1],
    ![3, -1, 1, -1, -3]]

/-- The integer deeper rows of the `s = 5` design: `D5tab j c` is deeper row `j + 1` of
coordinate `c` (`eis_link_check.rational_design`, seed `0`). -/
def D5tab : Fin 3 → Fin 5 → Fin 5 → ℤ :=
  ![![![-1, 1, -1, -4, -2], ![-1, 4, 0, -1, -3], ![-4, 1, 1, 1, 2], ![-3, -1, 0, -3, 2],
      ![-1, 3, -1, -2, 4]],
    ![![4, 3, 0, 1, -3], ![-3, 3, 2, 0, 2], ![-3, -4, 0, -1, -2], ![-2, -2, 1, -1, 1],
      ![-4, -3, -1, 0, 3]],
    ![![4, -4, -4, 3, -1], ![4, -1, 3, -1, -4], ![3, -3, -1, -2, 3], ![-1, 1, -4, -1, -3],
      ![-2, -3, 3, 4, 1]]]

/-- The deeper rows `D5h c r` (`r = 1, 2, 3`) of the `s = 5` design. -/
def D5h (c : Fin 5) (r : ℕ) (d : Fin 5) : ℤ :=
  if r = 1 then D5tab 0 c d else if r = 2 then D5tab 1 c d else if r = 3 then D5tab 2 c d else 0

