/-
Development copy (Solution side) of ChallengeHL. Note: Theorem HL of the research notes (2026-10-07; independently
audited in the research notes): split-frame digital `(0,sk,s)`-nets
over `ℤ/qℤ` whose first offset digit carries a half-integer geometric layer (the packing `D_s⁺`),
for every `k`; separation tending to `min(√s/2, √2)`; the `s = 5` design with
`δ N^(1/5) > 1.0265` for every prime `q ≥ 1511` and every `k ≥ 1`.
Author: Leonhard Gruenschloss.
Use of AI: see the section "Use of AI" of `README.md`.
The centred residue `cres` is adapted from Lennart Rudolph's Palomar formalization of the
even-order Grünschloß–Keller nets (github.com/lennrt/palomar-formalizations, MIT licence).
-/
module
public import Mathlib

@[expose] public section

/-!
# Definitions of entry HL (verbatim copy of the definitions in `ChallengeHL.lean`)

Generated by `scripts/sync_hldefs.py`; keep in sync with `ChallengeHL.lean` (Comparator checks
that the Solution declarations have the same types and values).
-/

namespace Z3NetHL

open Matrix Finset

/-! ## Digital nets, elementary boxes, distances (`s` coordinates) -/

/-- Integer coordinate of the digital point with generator matrix `C` and index `v`:
the digits are `d = C v ∈ (ℤ/qℤ)^m` (digit `0` most significant) and
`coord q m C v = ∑_j val(d_j) · q^(m-1-j) ∈ [0, q^m)`. -/
def coord (q m : ℕ) (C : Matrix (Fin m) (Fin m) (ZMod q)) (v : Fin m → ZMod q) : ℕ :=
  ∑ j : Fin m, ((C *ᵥ v) j).val * q ^ (m - 1 - (j : ℕ))

/-- The integer point (`s` coordinates) of the digital net with generator matrices `C c` at
index `v`. -/
def digPoint {s : ℕ} (q m : ℕ) (C : Fin s → Matrix (Fin m) (Fin m) (ZMod q))
    (v : Fin m → ZMod q) : Fin s → ℕ :=
  fun c => coord q m (C c) v

/-- `(0,m,s)`-net property in base `q` of the family of integer points `X v ∈ [0,q^m)^s` indexed
by `v ∈ (ℤ/qℤ)^m`: for every `d` with `∑_c d c = m` and every elementary box
`∏_c [a_c q^(-d_c), (a_c+1) q^(-d_c))` (`a_c < q^(d_c)`), exactly one index `v` has its point
`X v / q^m` in the box. -/
def IsNet0 (s q m : ℕ) (X : (Fin m → ZMod q) → Fin s → ℕ) : Prop :=
  ∀ d : Fin s → ℕ, ∑ c, d c = m → ∀ a : Fin s → ℕ, (∀ c, a c < q ^ d c) →
    ∃! v : Fin m → ZMod q, ∀ c, X v c / q ^ (m - d c) = a c

/-- Distance from the integer `u` to the lattice `N ℤ`: `min (u mod N) (N - u mod N)`.
(Adapted from `GKEvenNet.cres`.) -/
def cres (N : ℕ) (u : ℤ) : ℕ :=
  min (u % (N : ℤ)).toNat (N - (u % (N : ℤ)).toNat)

/-- Squared toroidal distance, at integer scale `N`, between the integer points `x, y`
(i.e. `N²` times the squared distance of `x / N`, `y / N` on the torus `(ℝ/ℤ)^s`). -/
def torusDist2 {s : ℕ} (N : ℕ) (x y : Fin s → ℕ) : ℕ :=
  ∑ c, cres N ((x c : ℤ) - (y c : ℤ)) ^ 2

/-- Owner of row `r` of a box matrix: for the list `ds` of row counts, `boxLoc ds c₀ r` is the
pair (coordinate, row inside that coordinate), coordinates numbered from `c₀`; the first `ds[0]`
rows belong to coordinate `c₀`, the next `ds[1]` rows to coordinate `c₀ + 1`, and so on. -/
def boxLoc : List ℕ → ℕ → ℕ → ℕ × ℕ
  | [], c, r => (c, r)
  | x :: xs, c, r => if r < x then (c, r) else boxLoc xs (c + 1) (r - x)

/-- Box matrix of `C` for `d`: the first `d 0` rows of `C 0`, then the first `d 1` rows of `C 1`,
…, then the first `d (s-1)` rows of `C (s-1)` (rows past `∑ d` are `0`). -/
def boxMatrix {R : Type*} [Zero R] {s m : ℕ} (C : Fin s → Matrix (Fin m) (Fin m) R)
    (d : Fin s → ℕ) : Matrix (Fin m) (Fin m) R :=
  fun r l =>
    if h : (boxLoc (List.ofFn d) 0 r).1 < s ∧ (boxLoc (List.ofFn d) 0 r).2 < m then
      C ⟨(boxLoc (List.ofFn d) 0 r).1, h.1⟩ ⟨(boxLoc (List.ofFn d) 0 r).2, h.2⟩ l
    else 0

/-- Generator matrix of coordinate `c` of the digital net with graph form `Φ`: rows `0..k-1` are
the identity on the column block `c` (index digit `c k + i` is level `i` of the cell `n_c`), rows
`k + r` are `(Φ_{c0} | Φ_{c1} | … | Φ_{c(s-1)})` row `r`. Column `j` belongs to block `j / k`,
level `j % k`. -/
def graphGen {R : Type*} [Zero R] [One R] (s k : ℕ)
    (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) R) (c : Fin s) :
    Matrix (Fin (s * k)) (Fin (s * k)) R :=
  fun i j =>
    if hi : (i : ℕ) < k then (if (j : ℕ) = (c : ℕ) * k + (i : ℕ) then 1 else 0)
    else Φ c ⟨(j : ℕ) / k, Nat.div_lt_of_lt_mul (Nat.lt_of_lt_of_eq j.isLt (Nat.mul_comm s k))⟩
      ⟨(i : ℕ) - k, Nat.sub_lt_sub_right (Nat.le_of_not_lt hi) i.isLt⟩
      ⟨(j : ℕ) % k, Nat.mod_lt _ (Nat.pos_of_mul_pos_left (Fin.pos j))⟩

/-! ## The split frame -/

/-- Split-frame generator matrix of coordinate `c` on `ℤ[t]_{<m}` (index = coefficient vector
`x` of `V = ∑_l x_l t^l`): digit `i < k` is the coefficient of `(t - v_c)^i` in `V`, i.e.
`∑_l C(l, i) v_c^(l-i) x_l`; digit `i ≥ k` is the coefficient of `(t - u_c)^(i-k)`. -/
def splitGen {s : ℕ} (m k : ℕ) (u v : Fin s → ℤ) (c : Fin s) : Matrix (Fin m) (Fin m) ℤ :=
  fun i l =>
    if (i : ℕ) < k then (((l : ℕ).choose (i : ℕ) : ℕ) : ℤ) * v c ^ ((l : ℕ) - (i : ℕ))
    else (((l : ℕ).choose ((i : ℕ) - k) : ℕ) : ℤ) * u c ^ ((l : ℕ) - ((i : ℕ) - k))

/-- The point `(c, e)` of the split frame: `v_c` for `e = 0` (cell point), `u_c` for `e = 1`
(offset point). -/
def splitPt {s : ℕ} (u v : Fin s → ℤ) (c : Fin s) (e : Fin 2) : ℤ := if (e : ℕ) = 0 then v c else u c

/-- Multiplicity of the point `(c, e)` in the box with depths `d`: `min(d_c, k)` at `v_c`,
`d_c - k` (truncated) at `u_c`. -/
def splitMult {s : ℕ} (k : ℕ) (d : Fin s → ℕ) (c : Fin s) (e : Fin 2) : ℕ :=
  if (e : ℕ) = 0 then min (d c) k else d c - k

/-! ## Rational data modulo `q` -/

/-- Reduction of a rational number modulo `q`: `num(x) · den(x)⁻¹ ∈ ℤ/qℤ`. -/
def qr (q : ℕ) (x : ℚ) : ZMod q := (x.num : ZMod q) * ((x.den : ℕ) : ZMod q)⁻¹

/-! ## The net with a design -/

/-- The basis polynomial `E_{d,j} = ∏_{d' ≠ d} (t - v_{d'})^k · (t - v_d)^j`. -/
noncomputable def Epoly {s : ℕ} (k : ℕ) (v : Fin s → ℤ) (d : Fin s) (j : ℕ) : Polynomial ℤ :=
  (∏ d' ∈ univ.erase d, (Polynomial.X - Polynomial.C (v d')) ^ k) *
    (Polynomial.X - Polynomial.C (v d)) ^ j

/-- `Ψ_cd[r, j]` = digit `k + r` of reading `c` (of the split frame) of `E_{d,j}`. -/
noncomputable def Psi {s : ℕ} (k : ℕ) (u v : Fin s → ℤ) (c d : Fin s) :
    Matrix (Fin (s * k - k)) (Fin k) ℤ :=
  fun r j => (splitGen (s * k) k u v c *ᵥ fun i => (Epoly k v d j).coeff i)
    ⟨k + (r : ℕ), Nat.add_lt_of_lt_sub' r.isLt⟩

/-- `P_c^(-1) = (∏_{d'} (u_c - v_{d'}))⁻¹` in `ℤ/qℤ`. -/
def PinvZ {s : ℕ} (q : ℕ) (u v : Fin s → ℤ) (c : Fin s) : ZMod q :=
  (∏ d' : Fin s, ((u c - v d' : ℤ) : ZMod q))⁻¹

/-- The node `y_cd = 1/(u_c - v_d)` in `ℤ/qℤ`. -/
def yZ {s : ℕ} (q : ℕ) (u v : Fin s → ℤ) (c d : Fin s) : ZMod q := ((u c - v d : ℤ) : ZMod q)⁻¹

/-- Coefficients (constant term first) of `∏_{y ∈ ys} (X - y)`. -/
def rootsPoly {R : Type*} [CommRing R] : List R → ℕ → R
  | [], i => if i = 0 then 1 else 0
  | y :: ys, i => (if i = 0 then 0 else rootsPoly ys (i - 1)) - y * rootsPoly ys i

/-- Coefficients `[X^i] (X^n mod P)` for the monic `P = X^r + ∑_{i<r} p_i X^i` (`r ≥ 1`, `i < r`):
`X^0 mod P = 1`, `X^(n+1) mod P = X · (X^n mod P) - [X^(r-1)](X^n mod P) · P`. -/
def xpowRem {R : Type*} [CommRing R] (p : ℕ → R) (r : ℕ) : ℕ → ℕ → R
  | 0, i => if i = 0 then 1 else 0
  | n + 1, i => (if i = 0 then 0 else xpowRem p r n (i - 1)) - xpowRem p r n (r - 1) * p i

/-- `γ_{n,i} = [X^i] (X^n mod ∏_{c ≠ d} (X - y_cd))` in `ℤ/qℤ` (`i < s - 1`). -/
def gamZ {s : ℕ} (q : ℕ) (u v : Fin s → ℤ) (d : Fin s) (n i : ℕ) : ZMod q :=
  xpowRem (rootsPoly (((List.finRange s).filter (fun c => c ≠ d)).map (fun c => yZ q u v c d)))
    (s - 1) n i

/-- The all-`k` gauge `U'^(k)_d` in `x`-index (row `n'`, column `n`): for `n < s - 1` the
coefficient vector of `f_{d,n}` (entries `gco d n n'`, `n' ≤ n`); for `n ≥ s - 1` the column
`e_n - γ_n`. -/
def UxZ {s : ℕ} (q : ℕ) (u v : Fin s → ℤ) (gco : Fin s → ℕ → ℕ → ℚ) (d : Fin s) (n' n : ℕ) :
    ZMod q :=
  if n < s - 1 then (if n' ≤ n then qr q (gco d n n') else 0)
  else if n' = n then 1 else if n' < s - 1 then -gamZ q u v d n n' else 0

/-- `U'^(k)_d` in level index (`k × k`, lower triangular): entry `(i, j)` is
`UxZ (k-1-i) (k-1-j)`. -/
def UkZ {s : ℕ} (q : ℕ) (u v : Fin s → ℤ) (gco : Fin s → ℕ → ℕ → ℚ) (k : ℕ) (d : Fin s) :
    Matrix (Fin k) (Fin k) (ZMod q) :=
  fun i j => UxZ q u v gco d (k - 1 - (i : ℕ)) (k - 1 - (j : ℕ))

/-- The graph-form blocks `Φ'_cd` of the net over `ℤ/qℤ`. -/
noncomputable def HLPhi (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ)
    (gco : Fin s → ℕ → ℕ → ℚ) (dg : Fin s → ℕ → ℚ) (c d : Fin s) :
    Matrix (Fin (s * k - k)) (Fin k) (ZMod q) :=
  fun r j =>
    if c = d then
      (if (r : ℕ) = 0 ∧ k - 1 - (j : ℕ) < s - 1 then qr q (dg c (k - 1 - (j : ℕ))) else 0)
    else (if (r : ℕ) = 0 then qr q (lam c) * PinvZ q u v c ^ k else 1) *
      ∑ j' : Fin k, (Psi k u v c d r j' : ZMod q) * UkZ q u v gco k d j' j

/-- Generator matrices of the net over `ℤ/qℤ`. -/
noncomputable def HLGen (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ)
    (gco : Fin s → ℕ → ℕ → ℚ) (dg : Fin s → ℕ → ℚ) :
    Fin s → Matrix (Fin (s * k)) (Fin (s * k)) (ZMod q) :=
  graphGen s k (HLPhi s q k u v lam gco dg)

/-- The integer point (in `[0, q^(sk))^s`) of the net with index `x ∈ (ℤ/qℤ)^(sk)`. -/
noncomputable def HLpoint (s q k : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ)
    (gco : Fin s → ℕ → ℕ → ℚ) (dg : Fin s → ℕ → ℚ) (x : Fin (s * k) → ZMod q) : Fin s → ℕ :=
  digPoint q (s * k) (HLGen s q k u v lam gco dg) x

/-- The node `y_cd = 1/(u_c - v_d)` over `ℚ`. -/
def yQ {s : ℕ} (u v : Fin s → ℤ) (c d : Fin s) : ℚ := ((u c - v d : ℤ) : ℚ)⁻¹

/-- The design `F_n[c][d]` (`x`-index `n`, i.e. level `k-1-n`) over `ℚ`. -/
def HLdes {s : ℕ} (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ)
    (dg : Fin s → ℕ → ℚ) (n : ℕ) (c d : Fin s) : ℚ :=
  if s - 1 ≤ n then 0
  else if c = d then dg c n
  else lam c * ∑ n' ∈ range (n + 1), gco d n n' * yQ u v c d ^ (n' + 1)

/-- **Admissibility** (exact condition for `t = 0` at every `k`): `q ≥ 2`; the `2s` points are
pairwise distinct modulo every prime factor of `q`; `λ'_c` and the leading coefficients
`gco d n n` (`n < s - 1`) have numerator and denominator coprime to `q`. -/
def HLAdm (s q : ℕ) (u v : Fin s → ℤ) (lam : Fin s → ℚ) (gco : Fin s → ℕ → ℕ → ℚ) : Prop :=
  2 ≤ q ∧
  (∀ c e c' e', (c, e) ≠ (c', e') → Int.gcd (splitPt u v c e - splitPt u v c' e') q = 1) ∧
  (∀ c, Int.gcd (lam c).num q = 1 ∧ Nat.Coprime (lam c).den q) ∧
  (∀ d, ∀ n < s - 1, Int.gcd (gco d n n).num q = 1 ∧ Nat.Coprime (gco d n n).den q)

/-- Denominators of the remaining design data are coprime to `q` (used to identify row `0` of
the net with the design modulo `q`). -/
def HLDen (s q : ℕ) (gco : Fin s → ℕ → ℕ → ℚ) (dg : Fin s → ℕ → ℚ) : Prop :=
  (∀ d, ∀ n < s - 1, ∀ n' ≤ n, Nat.Coprime (gco d n n').den q) ∧
  (∀ c, ∀ n < s - 1, Nat.Coprime (dg c n).den q)

/-! ## The carry relaxation and the dominance constants -/

/-- `2σ_c` of Prop H_k: for cell steps `E` and carry lengths `J` (and the doubled design
`F2 x c d = 2 F_x[c][d]`), `2σ_c = ∑_d (E_d · 2F_0[c][d] + sgn(E_d) ∑_{x=1}^{J_d} 2F_x[c][d])`. -/
def sig2 {s : ℕ} (F2 : ℕ → Fin s → Fin s → ℤ) (E : Fin s → ℤ) (J : Fin s → ℕ) (c : Fin s) : ℤ :=
  ∑ d, (E d * F2 0 c d + Int.sign (E d) * ∑ x ∈ Icc 1 (J d), F2 x c d)

/-- Doubled partial sums `2M^(j)[c][d] = ∑_{x ≤ j} 2F_x[c][d]`. -/
def M2 {s : ℕ} (F2 : ℕ → Fin s → Fin s → ℤ) (j : ℕ) (c d : Fin s) : ℤ :=
  ∑ x ∈ range (j + 1), F2 x c d

/-- `2A_c = ∑_{d ≠ c} max_{j ≤ s-2} |2M^(j)[c][d]|`. -/
def A2 (s : ℕ) (F2 : ℕ → Fin s → Fin s → ℤ) (c : Fin s) : ℕ :=
  ∑ d ∈ univ.erase c, (range (s - 1)).sup fun j => (M2 F2 j c d).natAbs

/-- `B = max_c (2a_c + 2A_c)` with `2a_c = -2F_0[c][c]`. -/
def Bdom (s : ℕ) (F2 : ℕ → Fin s → Fin s → ℤ) : ℕ :=
  univ.sup fun c : Fin s => (-F2 0 c c).toNat + A2 s F2 c

/-! ## The explicit design `H_s` (Lemma 2) -/

/-- Offset points `u_c = 2c`. -/
def uH {s : ℕ} (c : Fin s) : ℤ := 2 * (c : ℤ)

/-- Cell points `v_d = 2d + 1`. -/
def vH {s : ℕ} (d : Fin s) : ℤ := 2 * (d : ℤ) + 1

/-- `λ'_c = ½ ∏_{d' ≠ c} (u_c - v_{d'})^(s-1)`. -/
def lamH (s : ℕ) (c : Fin s) : ℚ := (∏ d' ∈ univ.erase c, ((uH c - vH d' : ℤ) : ℚ) ^ (s - 1)) / 2

/-- `f_{d,0} = 1`, `f_{d,1} = 2y`, `f_{d,n} = 2y^n - 2y^(n-1)` (`n ≥ 2`), i.e. `g_{d,j} = 1 + 2y^j`. -/
def gcoH {s : ℕ} (_d : Fin s) (n n' : ℕ) : ℚ :=
  if n = 0 then (if n' = 0 then 1 else 0)
  else if n' = n then 2 else if n' + 1 = n ∧ 2 ≤ n then -2 else 0

/-- Doubled off-diagonal design of `H_s` (zero diagonal). -/
def F2H0 (s : ℕ) (x : ℕ) (c d : Fin s) : ℤ :=
  ⌊2 * HLdes (uH (s := s)) vH (lamH s) gcoH (fun _ _ => 0) x c d⌋

/-- `2a_c`: `2A_c` rounded up to an odd integer (so that `F_0[c][c] = -a_c ∈ ½ + ℤ`). -/
def aH2 (s : ℕ) (c : Fin s) : ℕ := A2 s (F2H0 s) c + (if Even (A2 s (F2H0 s) c) then 1 else 0)

/-- Diagonal of `H_s`: `F_0[c][c] = -a_c`, deeper diagonal `0`. -/
def dgH (s : ℕ) (c : Fin s) (n : ℕ) : ℚ := if n = 0 then -(aH2 s c : ℚ) / 2 else 0

/-- The constant `B_s = max_c (2a_c + 2A_c)` of `H_s`. -/
def BH (s : ℕ) : ℕ := univ.sup fun c : Fin s => aH2 s c + A2 s (F2H0 s) c

