module
public import Z3Net.SkelDefs

@[expose] public section

namespace Z3NetF

open Matrix Finset

/-! ## New definitions (entry Obs) -/

/-- Homogeneous place difference `D_cd = α_c β_d - α_d β_c` of the places `a_c = [α_c : β_c]`
(`sec:frames`, subsection "Cauchy identities"). -/
def Dh {R : Type*} [CommRing R] {ι : Type*} (α β : ι → R) (c d : ι) : R :=
  α c * β d - α d * β c

/-- The Cauchy layer `W_cd = λ_c μ_d / D_cd` (`lem:CH`; `Ring.inverse` inverts units). -/
noncomputable def cauchyW {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R)
    (c d : ι) : R :=
  lam c * mu d * Ring.inverse (Dh α β c d)

/-- `π_cd = W_cd W_dc` (`lem:CH`). -/
noncomputable def cauchyPi {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R)
    (c d : ι) : R :=
  cauchyW α β lam mu c d * cauchyW α β lam mu d c

/-- The hypotheses of `lem:CH`: every `λ_c`, every `μ_d` and every `D_cd` (`c ≠ d`) is a unit. -/
def CauchyOK {R : Type*} [CommRing R] {ι : Type*} (α β lam mu : ι → R) : Prop :=
  (∀ c, IsUnit (lam c)) ∧ (∀ d, IsUnit (mu d)) ∧ ∀ c d, c ≠ d → IsUnit (Dh α β c d)

/-- `χ = D_ac D_bd / (D_ab D_cd)` of `lem:CH`(P). -/
noncomputable def chiCH {R : Type*} [CommRing R] {ι : Type*} (α β : ι → R) (a b c d : ι) : R :=
  Dh α β a c * Dh α β b d * Ring.inverse (Dh α β a b * Dh α β c d)

/-- `ψ = D_ad D_bc / (D_ab D_cd)` of `lem:CH`(P). -/
noncomputable def psiCH {R : Type*} [CommRing R] {ι : Type*} (α β : ι → R) (a b c d : ι) : R :=
  Dh α β a d * Dh α β b c * Ring.inverse (Dh α β a b * Dh α β c d)

/-- The points of the graph form with blocks `Φ` and depths `(k, …, k)` over `ℤ/qℤ`. -/
def gfPoint {s : ℕ} (q k : ℕ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q)) :
    (Fin (s * k) → ZMod q) → Fin s → ℕ :=
  digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ)

/-- The geometric layer `M̃_cd` (`sec:prelim`): the centred representative, in `(-q/2, q/2]`, of
the level-`(k-1)` entry of the first offset row of block `(c, d)`, diagonal included. -/
def Mt {s q k : ℕ} (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (c d : Fin s) : ℤ :=
  (ent (Φ c d) 0 (k - 1)).valMinAbs

/-- Squared Euclidean distance of two integer points, in cell units (`q^(m-k)` integer units). -/
noncomputable def cellDist2 {s : ℕ} (q m k : ℕ) (x y : Fin s → ℕ) : ℝ :=
  ∑ c, (((x c : ℝ) - (y c : ℝ)) / (q : ℝ) ^ (m - k)) ^ 2

/-- Two distinct indices whose points have squared Euclidean and squared toroidal distance `< B`
in cell units; so `(δ N^(1/s))² < B` for the toroidal and for the Euclidean minimum distance. -/
def PairBelow {s : ℕ} (q m k : ℕ) (X : (Fin m → ZMod q) → Fin s → ℕ) (B : ℝ) : Prop :=
  ∃ v w : Fin m → ZMod q, v ≠ w ∧ cellDist2 q m k (X v) (X w) < B ∧
    (torusDist2 (q ^ m) (X v) (X w) : ℝ) / (q : ℝ) ^ (2 * (m - k)) < B

/-- `σ_c = M_ca + ε M_cb`: the change of the first offset digit of coordinate `c` under the step
`e_a + ε e_b` without carries (`sec:dims`, "Deficit bounds"). -/
def sig {s : ℕ} (M : Fin s → Fin s → ℤ) (a b : Fin s) (ε : ℤ) (c : Fin s) : ℤ :=
  M c a + ε * M c b

/-- `K_pair(M) = ∞` (`def:Ktrue`): some diagonal entry is positive, or some two-axis
configuration `e_a + ε e_b` has both moving coordinates forward (`σ_a > 0`, `ε σ_b > 0`). -/
def PairInf {s : ℕ} (M : Fin s → Fin s → ℤ) : Prop :=
  (∃ a, 0 < M a a) ∨ ∃ a b, a ≠ b ∧ ∃ ε ∈ ({1, -1} : Finset ℤ),
    0 < sig M a b ε a ∧ 0 < ε * sig M a b ε b

/-- The finite value of `K_pair(M)` (`def:Ktrue`): the maximum of `max_a |M_aa|` and of `|σ_b|`
over the two-axis configurations `e_a + ε e_b` with `a` forward (`σ_a > 0`) and the other moving
coordinate `b` backward with `ε σ_b < 0`. -/
def pairVal {s : ℕ} (M : Fin s → Fin s → ℤ) : ℕ :=
  max (univ.sup fun a => (M a a).natAbs)
    (univ.sup fun a => univ.sup fun b => ({1, -1} : Finset ℤ).sup fun ε =>
      if a ≠ b ∧ 0 < sig M a b ε a ∧ ε * sig M a b ε b < 0 then (sig M a b ε b).natAbs else 0)

/-- **`def:Ktrue`**: `K_pair(M) ∈ ℕ ∪ {∞}`. -/
noncomputable def Kpair {s : ℕ} (M : Fin s → Fin s → ℤ) : ℕ∞ :=
  @ite ℕ∞ (PairInf M) (Classical.dec _) ⊤ (pairVal M : ℕ∞)

end Z3NetF
