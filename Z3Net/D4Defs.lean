/-
Development copy (Solution side) of Challenge4D. Note: Theorem 4D of the research notes (2026-10-07; independently audited in
the research notes): explicit well-separated digital `(0,4k,4)`-nets over `ℤ/qℤ` for every
odd `q`, built from design A (`witnesses/dim4_designs.json : hill_q11`).
Author: Leonhard Gruenschloss.
Use of AI: see the section "Use of AI" of `README.md`.
The centred residue `cres` is adapted from Lennart Rudolph's Palomar formalization of the
even-order Grünschloß–Keller nets (github.com/lennrt/palomar-formalizations, MIT licence).
-/
module
public import Mathlib

@[expose] public section

/-!
# Definitions of the 4D entry (verbatim copy of the definitions in `Challenge4D.lean`)

Generated by `scripts/sync_d4defs.py`; keep in sync with `Challenge4D.lean` (Comparator checks
that the Solution declarations have the same types and values).
-/

namespace Z3NetD4

open Matrix Finset

/-! ## Digital nets, elementary boxes, distances (four coordinates) -/

/-- Integer coordinate of the digital point with generator matrix `C` and index `v`:
the digits are `d = C v ∈ (ℤ/qℤ)^m` (digit `0` most significant) and
`coord q m C v = ∑_j val(d_j) · q^(m-1-j) ∈ [0, q^m)`. -/
def coord (q m : ℕ) (C : Matrix (Fin m) (Fin m) (ZMod q)) (v : Fin m → ZMod q) : ℕ :=
  ∑ j : Fin m, ((C *ᵥ v) j).val * q ^ (m - 1 - (j : ℕ))

/-- The integer point (four coordinates) of the digital net with generator matrices `C c` at
index `v`. -/
def digPoint (q m : ℕ) (C : Fin 4 → Matrix (Fin m) (Fin m) (ZMod q)) (v : Fin m → ZMod q) :
    Fin 4 → ℕ :=
  fun c => coord q m (C c) v

/-- `(0,m,4)`-net property in base `q` of the family of integer points `X v ∈ [0,q^m)^4` indexed
by `v ∈ (ℤ/qℤ)^m`: for every `d` with `d 0 + d 1 + d 2 + d 3 = m` and every elementary box
`∏_c [a_c q^(-d_c), (a_c+1) q^(-d_c))` (`a_c < q^(d_c)`), exactly one index `v` has its point
`X v / q^m` in the box. -/
def IsNet0 (q m : ℕ) (X : (Fin m → ZMod q) → Fin 4 → ℕ) : Prop :=
  ∀ d : Fin 4 → ℕ, d 0 + d 1 + d 2 + d 3 = m → ∀ a : Fin 4 → ℕ, (∀ c, a c < q ^ d c) →
    ∃! v : Fin m → ZMod q, ∀ c, X v c / q ^ (m - d c) = a c

/-- Distance from the integer `u` to the lattice `N ℤ`: `min (u mod N) (N - u mod N)`.
(Adapted from `GKEvenNet.cres`.) -/
def cres (N : ℕ) (u : ℤ) : ℕ :=
  min (u % (N : ℤ)).toNat (N - (u % (N : ℤ)).toNat)

/-- Squared toroidal distance, at integer scale `N`, between the integer points `x, y`
(i.e. `N²` times the squared distance of `x / N`, `y / N` on the torus `(ℝ/ℤ)⁴`). -/
def torusDist2 (N : ℕ) (x y : Fin 4 → ℕ) : ℕ :=
  ∑ c, cres N ((x c : ℤ) - (y c : ℤ)) ^ 2

/-- Box matrix of `C` for `d = (d 0, d 1, d 2, d 3)`: the first `d 0` rows of `C 0`, then the first
`d 1` rows of `C 1`, the first `d 2` rows of `C 2`, and the remaining rows of `C 3` (for
`∑ d = m` these are the first `d 3` rows of `C 3`). -/
def boxMatrix {R : Type*} {m : ℕ} (C : Fin 4 → Matrix (Fin m) (Fin m) R) (d : Fin 4 → ℕ) :
    Matrix (Fin m) (Fin m) R :=
  fun r =>
    if (r : ℕ) < d 0 then C 0 r
    else if (r : ℕ) < d 0 + d 1 then C 1 ⟨(r : ℕ) - d 0, Nat.lt_of_le_of_lt (Nat.sub_le _ _) r.isLt⟩
    else if (r : ℕ) < d 0 + d 1 + d 2 then C 2 ⟨(r : ℕ) - d 0 - d 1,
      Nat.lt_of_le_of_lt (Nat.le_trans (Nat.sub_le _ _) (Nat.sub_le _ _)) r.isLt⟩
    else C 3 ⟨(r : ℕ) - d 0 - d 1 - d 2, Nat.lt_of_le_of_lt
      (Nat.le_trans (Nat.sub_le _ _) (Nat.le_trans (Nat.sub_le _ _) (Nat.sub_le _ _))) r.isLt⟩

/-! ## The frame: readings at `0, -1, ∞, 1` -/

/-- The finite places: coordinate `0 ↦ 0`, `1 ↦ -1`, `3 ↦ 1` (coordinate `2` is the place `∞`;
its entry here is unused). -/
def place : Fin 4 → ℤ := ![0, -1, 0, 1]

/-- Frame generator matrix of coordinate `c` on `ℤ[t]_{<m}` (index = coefficient vector `v` of
`V = ∑_l v_l t^l`): for finite places digit `i` is the coefficient of `(t - a_c)^i`, i.e.
`∑_l C(l, i) a_c^(l-i) v_l`; for `c = 2` (`∞`) digit `i` is `v_{m-1-i}`. -/
def frameGen (m : ℕ) (c : Fin 4) : Matrix (Fin m) (Fin m) ℤ :=
  fun i l =>
    if c = 2 then (if (l : ℕ) + (i : ℕ) + 1 = m then 1 else 0)
    else (((l : ℕ).choose (i : ℕ) : ℕ) : ℤ) * place c ^ ((l : ℕ) - (i : ℕ))

/-! ## The basis polynomials `E_{d,j}` -/

/-- Coefficient sequence of `(t - a)^e`: coefficient `i` is `C(e, i) (-a)^(e-i)`. -/
def linPow (a : ℤ) (e : ℕ) (i : ℕ) : ℤ := ((e.choose i : ℕ) : ℤ) * (-a) ^ (e - i)

/-- Product (Cauchy convolution) of coefficient sequences. -/
def conv (f g : ℕ → ℤ) (n : ℕ) : ℤ := ∑ i ∈ range (n + 1), f i * g (n - i)

/-- Exponents of `t`, `t + 1`, `t - 1` in `E_{d,j}`: `E_{d,j} = P_d(t) (t - a_d)^j` for finite
`d`, `E_{∞,j} = t^k (t+1)^k (t-1)^k · t^(k-1-j)`. -/
def exT (k : ℕ) (d : Fin 4) (j : ℕ) : ℕ := if d = 0 then j else if d = 2 then 2 * k - 1 - j else k
def exP (k : ℕ) (d : Fin 4) (j : ℕ) : ℕ := if d = 1 then j else k
def exM (k : ℕ) (d : Fin 4) (j : ℕ) : ℕ := if d = 3 then j else k

/-- Coefficient vector of `E_{d,j} = t^(exT) (t+1)^(exP) (t-1)^(exM)` in `ℤ[t]_{<4k}`. -/
def Evec (k : ℕ) (d : Fin 4) (j : ℕ) : Fin (4 * k) → ℤ :=
  fun i => conv (conv (linPow 0 (exT k d j)) (linPow (-1) (exP k d j))) (linPow 1 (exM k d j)) i

/-- `Ψ_cd[r, j]` = digit `k + r` of reading `c` of `E_{d,j}` (`= (Φ^F_cd · Q_d^k Toep(g_d))[r, j]`). -/
def Psi (k : ℕ) (c d : Fin 4) : Matrix (Fin (3 * k)) (Fin k) ℤ :=
  fun r j => (frameGen (4 * k) c *ᵥ Evec k d j) ⟨k + (r : ℕ), Nat.lt_of_lt_of_eq
    (Nat.add_lt_add_left r.isLt k) ((Nat.add_comm k (3 * k)).trans (Nat.succ_mul 3 k).symm)⟩

/-! ## Design A (`hill_q11`) and its gauge -/

/-- Design A: `F_l[c][d]` is the target of level `k-1-l` of row `0` of `Φ'_cd` (`l ≤ 2`). -/
def Fdes (l : ℕ) : Matrix (Fin 4) (Fin 4) ℤ :=
  if l = 0 then !![-1, -1, -1, -1; -2, -1, 2, 1; 1, 1, -1, -1; -2, -1, -2, -1]
  else if l = 1 then !![0, 2, 0, 0; -2, 0, -2, -1; 0, 0, 0, 2; 2, 1, -2, 0]
  else if l = 2 then !![0, -1, 0, 0; 0, 0, 0, -1; 0, -2, 0, 0; -1, 0, -2, 0]
  else 0

/-- Residual row scalings `λ'_c`. -/
def lamRes : Fin 4 → ℤ := ![1, -2, -1, 2]

/-- Residual gauge `U'_d` of design A (rows `n'`, columns `n`, `x`-index `n` = level `k-1-n`),
entries in `ℤ[1/2]` written with `h = 1/2`. -/
def Ures {R : Type*} [CommRing R] (h : R) (d : Fin 4) : Matrix (Fin 3) (Fin 3) R :=
  if d = 0 then !![-1, 0, 0; 0, 1, -h ^ 2; 0, 0, -h ^ 2]
  else if d = 1 then !![-1, 0, 2; 0, 2, -5; 0, 0, 2]
  else if d = 2 then !![-1, 0, 0; 0, -1, -h; 0, 0, -h]
  else !![1, -2, 0; 0, -2, 4; 0, 0, 4]

/-- `α_n` (`n ≥ 3`): `v_n = α_n v_1 + β_n v_2` for the first-row vectors `v_n = (w_c y_c^n)_{c ≠ d}`
of Proposition N (`y = ±1` for `d ∈ {0, ∞}`; `y ∈ {1, 1/2}` for `d = -1`; `y ∈ {-1, -1/2}` for
`d = 1`). -/
def alpha {R : Type*} [CommRing R] (h : R) (d : Fin 4) (n : ℕ) : R :=
  if d = 1 then h ^ (n - 2) - 1
  else if d = 3 then (-1) ^ n * (1 - h ^ (n - 2))
  else if n % 2 = 1 then 1 else 0

/-- `β_n` (`n ≥ 3`), see `alpha`. -/
def beta {R : Type*} [CommRing R] (h : R) (d : Fin 4) (n : ℕ) : R :=
  if d = 1 then 2 - h ^ (n - 2)
  else if d = 3 then (-1) ^ n * (2 - h ^ (n - 2))
  else if n % 2 = 0 then 1 else 0

/-- The all-`k` residual gauge `U'^(k)_d` in `x`-index (row `n'`, column `n`): `U'_d` on
`n', n ≤ 2`; for `n ≥ 3` the column `e_n - α_n e_1 - β_n e_2`. -/
def Ux {R : Type*} [CommRing R] (h : R) (d : Fin 4) (n' n : ℕ) : R :=
  if hn : n' < 3 ∧ n < 3 then Ures h d ⟨n', hn.1⟩ ⟨n, hn.2⟩
  else if 3 ≤ n then
    (if n' = n then 1 else if n' = 1 then -alpha h d n else if n' = 2 then -beta h d n else 0)
  else 0

/-- `U'^(k)_d` in level index (`k × k`, lower triangular): entry `(i, j)` is
`Ux (k-1-i) (k-1-j)`. -/
def Uk {R : Type*} [CommRing R] (h : R) (k : ℕ) (d : Fin 4) : Matrix (Fin k) (Fin k) R :=
  fun i j => Ux h d (k - 1 - (i : ℕ)) (k - 1 - (j : ℕ))

/-- `Q_c^(-k)` (`Q_0 = -1`, `Q_{-1} = Q_1 = 2`, `Q_∞ = 1`), with `h = 1/2`. -/
def Qinv {R : Type*} [CommRing R] (h : R) (k : ℕ) : Fin 4 → R := ![(-1) ^ k, h ^ k, 1, h ^ k]

/-- The graph-form blocks `Φ'_cd` (`3k × k`; rows = offset digits `k + r` of coordinate `c`,
columns = levels of the cell `n_d`) of `𝒫⁴_{k,·}` over a ring `R` with `h = 1/2`. -/
def D4Phi (R : Type*) [CommRing R] (h : R) (k : ℕ) (c d : Fin 4) :
    Matrix (Fin (3 * k)) (Fin k) R :=
  fun r j =>
    if c = d then (if (r : ℕ) = 0 then ((Fdes (k - 1 - (j : ℕ)) c c : ℤ) : R) else 0)
    else (if (r : ℕ) = 0 then (lamRes c : R) * Qinv h k c else 1) *
      ∑ j' : Fin k, (Psi k c d r j' : R) * Uk h k d j' j

/-- Generator matrix of coordinate `c` of the digital net with graph form `Φ`: rows `0..k-1` are
the identity on the column block `c` (index digit `c k + i` is level `i` of the cell `n_c`), rows
`k + r` are `(Φ_{c0} | Φ_{c1} | Φ_{c2} | Φ_{c3})` row `r`. Column `j` belongs to block `j / k`,
level `j % k`. -/
def graphGen {R : Type*} [Zero R] [One R] (k : ℕ)
    (Φ : Fin 4 → Fin 4 → Matrix (Fin (3 * k)) (Fin k) R) (c : Fin 4) :
    Matrix (Fin (4 * k)) (Fin (4 * k)) R :=
  fun i j =>
    if hi : (i : ℕ) < k then (if (j : ℕ) = (c : ℕ) * k + (i : ℕ) then 1 else 0)
    else Φ c ⟨(j : ℕ) / k, Nat.div_lt_of_lt_mul (Nat.lt_of_lt_of_eq j.isLt (Nat.mul_comm 4 k))⟩
      ⟨(i : ℕ) - k, Nat.sub_lt_left_of_lt_add (Nat.le_of_not_lt hi)
        (Nat.lt_of_lt_of_eq i.isLt ((Nat.succ_mul 3 k).trans (Nat.add_comm (3 * k) k)))⟩
      ⟨(j : ℕ) % k, Nat.mod_lt _ (Nat.pos_of_mul_pos_left j.pos)⟩

/-- Generator matrices of `𝒫⁴_{k,q}` over `ℤ/qℤ` (`h = 2⁻¹ ∈ ℤ/qℤ`). -/
def D4Gen (q k : ℕ) : Fin 4 → Matrix (Fin (4 * k)) (Fin (4 * k)) (ZMod q) :=
  graphGen k (D4Phi (ZMod q) (2 : ZMod q)⁻¹ k)

/-- The integer point (in `[0, q^(4k))^4`) of `𝒫⁴_{k,q}` with index `v ∈ (ℤ/qℤ)^(4k)`. -/
def D4point (q k : ℕ) (v : Fin (4 * k) → ZMod q) : Fin 4 → ℕ :=
  digPoint q (4 * k) (D4Gen q k) v

/-! ## Definition N, literally (faithfulness of the `E`-basis description) -/

/-- The frame over `ℚ`. -/
def frameQ (k : ℕ) (c : Fin 4) : Matrix (Fin (4 * k)) (Fin (4 * k)) ℚ :=
  (frameGen (4 * k) c).map (Int.cast : ℤ → ℚ)

/-- The raw graph form of the frame, `Φ^F_cd = O_c G⁻¹` restricted to the columns of block `d`
(rows `r` = offset digit `k + r` of reading `c`, columns `l` = level `l` of the cell `n_d`), where
`G` is the `(k,k,k,k)` box matrix of the frame, inverted over `ℚ` with Mathlib's `⁻¹`. -/
noncomputable def frameGraph (k : ℕ) (c d : Fin 4) : Matrix (Fin (3 * k)) (Fin k) ℚ :=
  fun r l => (frameQ k c * (boxMatrix (frameQ k) (fun _ => k))⁻¹)
    ⟨k + (r : ℕ), Nat.lt_of_lt_of_eq (Nat.add_lt_add_left r.isLt k)
      ((Nat.add_comm k (3 * k)).trans (Nat.succ_mul 3 k).symm)⟩
    ⟨(d : ℕ) * k + (l : ℕ), Nat.lt_of_lt_of_le (Nat.add_lt_add_left l.isLt ((d : ℕ) * k))
      ((Nat.succ_mul (d : ℕ) k).symm.trans_le (Nat.mul_le_mul_right k d.isLt))⟩

/-- The unit series `g_d` of Lemma R (here polynomials): `g_d(x) = ∏_{b ≠ d finite} (1 + x/(a_d - b))^k`
for finite `d`, `g_∞(x) = (1 - x²)^k`. -/
noncomputable def gpoly (k : ℕ) (d : Fin 4) : Polynomial ℚ :=
  if d = 0 then (1 + Polynomial.X) ^ k * (1 - Polynomial.X) ^ k
  else if d = 1 then (1 - Polynomial.X) ^ k * (1 - Polynomial.C (1 / 2) * Polynomial.X) ^ k
  else if d = 2 then (1 - Polynomial.X ^ 2) ^ k
  else (1 + Polynomial.X) ^ k * (1 + Polynomial.C (1 / 2) * Polynomial.X) ^ k

/-- `Q_c = ∏_{b ≠ c finite} (a_c - b)` (`Q_∞ = 1`). -/
def Qval : Fin 4 → ℚ := ![-1, 2, 1, 2]

/-- Level-indexed Toeplitz matrix of `g`: entry `(i, j)` is `g_(i-j)` for `i ≥ j`, else `0`
(so that `ρ · Toep(g)` has generating function `ρ(x) g(x)`). -/
noncomputable def toep (k : ℕ) (g : Polynomial ℚ) : Matrix (Fin k) (Fin k) ℚ :=
  fun i j => if j ≤ i then g.coeff ((i : ℕ) - (j : ℕ)) else 0

/-- The note's column gauge `U_d = Q_d^k Toep(g_d) U'^(k)_d`. -/
noncomputable def Ulit (k : ℕ) (d : Fin 4) : Matrix (Fin k) (Fin k) ℚ :=
  ((Qval d ^ k) • toep k (gpoly k d)) * Uk (1 / 2 : ℚ) k d

/-- The Cauchy kernel of Proposition N: `w_cd`, `y_cd` (`1/(a_c - a_d)` for finite `c, d`;
`(1, 0)` for `c = ∞`; `(1, a_c)` for `d = ∞`). -/
def wN (c d : Fin 4) : ℚ := if c = 2 ∨ d = 2 then 1 else 1 / ((place c : ℚ) - place d)
def yN (c d : Fin 4) : ℚ :=
  if c = 2 then 0 else if d = 2 then (place c : ℚ) else 1 / ((place c : ℚ) - place d)

/-! ## The constant `c₄(q)` -/

/-- `q² c₄(q)²`: `1` for `q = 5`, `5` for `q = 7`, `(q - 5)² + 4` otherwise. -/
def K4 (q : ℕ) : ℤ := if q = 5 then 1 else if q = 7 then 5 else ((q : ℤ) - 5) ^ 2 + 4

/-- The constant `c₄(q) = √(K4 q) / q` of Theorem 4D. -/
noncomputable def c4 (q : ℕ) : ℝ := Real.sqrt (K4 q : ℝ) / q

end Z3NetD4
