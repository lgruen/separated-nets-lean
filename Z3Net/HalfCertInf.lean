module
public import Z3Net.HalfCertDefs

@[expose] public section

/-! # Entry Half: kernel checks λ(M5h) ≥ √5/2 (generated by `scripts/gen_halfcert.py`) -/

namespace Z3NetHL.Proofs

set_option maxRecDepth 100000
set_option maxHeartbeats 0

theorem chkInf5_m2 : chkInf5 (-2) = true := by decide +kernel
theorem chkInf5_m1 : chkInf5 (-1) = true := by decide +kernel
theorem chkInf5_0 : chkInf5 (0) = true := by decide +kernel
theorem chkInf5_1 : chkInf5 (1) = true := by decide +kernel
theorem chkInf5_2 : chkInf5 (2) = true := by decide +kernel

theorem lam5_ge : ∀ E ∈ halfSteps 5, Real.sqrt 5 / 2 ≤ Real.sqrt (∑ c, halfEllInf M5h E c ^ 2) :=
  lam5_of_chk (forall_vals5 chkInf5_m2 chkInf5_m1 chkInf5_0 chkInf5_1 chkInf5_2)

end Z3NetHL.Proofs
