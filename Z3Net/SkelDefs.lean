/-
Development copy (Solution side) of the new definitions of ChallengeSkel (entry Skel).
Generated by `scripts/sync_skeldefs.py`; keep in sync with `ChallengeSkel.lean`.
-/
module
public import Z3Net.FDefs

@[expose] public section

namespace Z3NetF

open Matrix Finset

/-! ## New definitions (entry Skel) -/

/-- Total entry accessor: `ent A i j = A i j` if `(i, j)` is in range, `0` otherwise
(verbatim from `ChallengeKN.lean`). -/
def ent {R : Type*} [Zero R] {a b : ℕ} (A : Matrix (Fin a) (Fin b) R) (i j : ℕ) : R :=
  if h : i < a ∧ j < b then A ⟨i, h.1⟩ ⟨j, h.2⟩ else 0

/-- Depth of coordinate `c` for `m = s k + r`: `k + 1` for the full coordinates `c < r`, `k` for the
skeleton coordinates `c ≥ r`. -/
def skDepth {s : ℕ} (r k : ℕ) (c : Fin s) : ℕ := if (c : ℕ) < r then k + 1 else k

/-- First index digit of block `c` (blocks in coordinate order): `c k + min(c, r)`. -/
def skOff (r k c : ℕ) : ℕ := c * k + min c r

/-- `C` is in graph form with the skeleton depths: digit `j < K_c` of coordinate `c` is the
index digit `skOff r k c + j`. -/
def IsSkGF (s r p k : ℕ) (C : Fin s → Matrix (Fin (s * k + r)) (Fin (s * k + r)) (ZMod p)) :
    Prop :=
  ∀ c : Fin s, ∀ j < skDepth r k c, ∀ col < s * k + r,
    ent (C c) j col = if col = skOff r k (c : ℕ) + j then 1 else 0

/-- Fine position `P_c = ⌊X_c / p^(m-k-1)⌋` of coordinate `c` of the point with index `v`
(`sec:fine`; for a skeleton coordinate `P_c = p n_c + S_c`). -/
def finePos {s : ℕ} (p m k : ℕ) (C : Fin s → Matrix (Fin m) (Fin m) (ZMod p))
    (v : Fin m → ZMod p) (c : Fin s) : ℕ :=
  digPoint p m C v c / p ^ (m - (k + 1))

/-- Centred residue of `u` modulo `M`: the representative in `(-M/2, M/2]`. -/
def cmod (M : ℕ) (u : ℤ) : ℤ :=
  if u % (M : ℤ) + u % (M : ℤ) ≤ (M : ℤ) then u % (M : ℤ) else u % (M : ℤ) - M

/-- Lower triangular with unit diagonal (the shape of the gauge moves of `lem:box`(c)). -/
def IsLTU {R : Type*} [CommRing R] {n : ℕ} (M : Matrix (Fin n) (Fin n) R) : Prop :=
  (∀ i j, i < j → M i j = 0) ∧ ∀ i, IsUnit (M i i)

/-- Start of block `d` in the box matrix with depths `K`: `∑_{e < d} K_e`. -/
def offL {s : ℕ} (K : Fin s → ℕ) (d : Fin s) : ℕ := ∑ e ∈ univ.filter (fun e => e < d), K e

/-- The graph form `Φ^F` of the frame with arbitrary depths `K` (`∑ K = m`): `Φ^F_cd[r, l]` is
entry `(K_c + r, offL K d + l)` of `C^F_c G_K⁻¹`, `G_K` the `K`-box matrix of the frame. -/
noncomputable def frameGraphK (R : Type*) [CommRing R] {s : ℕ} (m : ℕ) (K : Fin s → ℕ)
    (inf : Fin s) (x : Fin s → R) (c d : Fin s) : Matrix (Fin (m - K c)) (Fin (K d)) R :=
  fun r l => ent (frameRead m inf x c * (boxMatrix (frameRead m inf x) K)⁻¹)
    (K c + (r : ℕ)) (offL K d + (l : ℕ))

/-- `Q^K_c = ∏_{b finite, b ≠ c} (a_c - a_b)^(K_b)`, `Q^K_∞ = 1` (`prop:skelcomp`(i)). -/
def QfK {R : Type*} [CommRing R] {s : ℕ} (K : Fin s → ℕ) (inf : Fin s) (x : Fin s → R)
    (c : Fin s) : R :=
  if c = inf then 1 else ∏ b ∈ univ.filter (fun b => b ≠ inf ∧ b ≠ c), (x c - x b) ^ K b

/-- The normalizing column gauge series for depths `K`: `∏_{b finite, b ≠ d} (a_d - a_b + x)^(K_b)`
for finite `d`, `∏_{b finite} (1 - a_b x)^(K_b)` for `d = ∞`. -/
noncomputable def uNK {R : Type*} [CommRing R] {s : ℕ} (K : Fin s → ℕ) (inf : Fin s)
    (x : Fin s → R) (d : Fin s) : Polynomial R :=
  if d = inf then ∏ b ∈ univ.filter (fun b => b ≠ inf), (1 - Polynomial.C (x b) * Polynomial.X) ^ K b
  else ∏ b ∈ univ.filter (fun b => b ≠ inf ∧ b ≠ d), (Polynomial.C (x d - x b) + Polynomial.X) ^ K b

/-- The residual problem on a set `S` of rows (`prop:skelcomp`(i), "consequently"): units `λ'_c`
(`c ∈ S`) and, for each column `d`, an upper-triangular `ℓ_d × ℓ_d` matrix `U'_d` with unit
diagonal (`ℓ_d = #(S \ {d})`, `x`-indices `n', n < ℓ_d`) such that
`F_n[c][d] = λ'_c ∑_{n' ≤ n} w_cd y_cd^(n') U'_d[n', n]` for `c ∈ S`, `c ≠ d`, `n < ℓ_d`. -/
def ResidualSk {R : Type*} [CommRing R] {s : ℕ} (inf : Fin s) (x : Fin s → R)
    (S : Finset (Fin s)) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) : Prop :=
  (∀ c ∈ S, IsUnit (lam c)) ∧
    (∀ d n' n, n < n' → n' < (S.erase d).card → Ur d n' n = 0) ∧
    (∀ d n, n < (S.erase d).card → IsUnit (Ur d n n)) ∧
    ∀ c ∈ S, ∀ d, c ≠ d → ∀ n, n < (S.erase d).card →
      F n c d = lam c * ∑ n' ∈ range (n + 1), wN inf x c d * yN inf x c d ^ n' * Ur d n' n

/-- Coefficient of the prescribed skeleton digit `S_{z_i}` (`ℓ = 2`, `prop:skelcomp`(iii)) on level
`l` of block `d`: `S_{z_i} = ∑_d A_id x_{d,k} + ∑_d β_id x_{d,k-1} + g_i z_{j,k-1} + o_i z_{i,k-1}`
(`{i, j} = {1, 2}`; full coordinates `d < r`, skeleton coordinates `z_i = r + i`). -/
def sk2Coef {R : Type*} [Zero R] (r k : ℕ) (A β : Fin 2 → ℕ → R) (g o : Fin 2 → R) (i : Fin 2)
    (d l : ℕ) : R :=
  if d < r then (if l = k then A i d else if l + 1 = k then β i d else 0)
  else if d = r + (i : ℕ) then (if l + 1 = k then o i else 0)
  else (if l + 1 = k then g i else 0)

/-- The lattice of `prop:S1E`: `a_z ≡ ∑_d κ_d a_{x_d} (mod p)`, the skeleton coordinate last
(`a ∈ ℤ^s`, `κ_d` the coefficient of the full coordinate `d < s - 1`). -/
def InLatK {s : ℕ} (p : ℕ) (κ : ℕ → ZMod p) (a : Fin s → ℤ) : Prop :=
  ∑ c : Fin s, (if (c : ℕ) + 1 < s then κ c * (a c : ZMod p) else -(a c : ZMod p)) = 0

/-- `‖(|a| - 𝟏)₊‖₂²` (the jitter norm of `prop:S1E`). -/
def jitNorm2 {s : ℕ} (a : Fin s → ℤ) : ℕ := ∑ c, ((a c).natAbs - 1) ^ 2

/-- `λ_jit(κ)² = min_{0 ≠ a ∈ Λ_κ} ‖(|a| - 𝟏)₊‖₂²`. -/
noncomputable def lamJit2 (s p : ℕ) (κ : ℕ → ZMod p) : ℕ :=
  sInf {n | ∃ a : Fin s → ℤ, InLatK p κ a ∧ a ≠ 0 ∧ jitNorm2 a = n}

/-- `λ₂(Λ_κ)² = min_{0 ≠ a ∈ Λ_κ} ‖a‖₂²`. -/
noncomputable def lam2Sq (s p : ℕ) (κ : ℕ → ZMod p) : ℕ :=
  sInf {n | ∃ a : Fin s → ℤ, InLatK p κ a ∧ a ≠ 0 ∧ ∑ c, (a c).natAbs ^ 2 = n}

/-- `C` is in graph form with depths `(k+1, …, k+1, k)` and skeleton digit
`S_z = ∑_{d < s-1} κ_d x_{d,k}` (every other coefficient of row `k` of `z = s - 1`, own block
included, is `0`). -/
def IsS1Kskel (s p k : ℕ) (κ : ℕ → ZMod p)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p)) : Prop :=
  IsSkGF s (s - 1) p k C ∧ ∀ z d : Fin s, (z : ℕ) + 1 = s → ∀ l < skDepth (s - 1) k d,
    ent (C z) k (skOff (s - 1) k (d : ℕ) + l) = if (d : ℕ) + 1 < s ∧ l = k then κ d else 0

/-- Centred weight of a codeword `(x, A x)` of `C_A` in the maximum norm (`rem:codes`). -/
def cwInf {ℓ r : ℕ} (p : ℕ) (A : Matrix (Fin ℓ) (Fin r) (ZMod p)) (x : Fin r → ZMod p) : ℕ :=
  max (univ.sup fun d => (x d).valMinAbs.natAbs) (univ.sup fun i => ((A *ᵥ x) i).valMinAbs.natAbs)

/-- Euclidean (squared Lee) weight of the codeword `(x, A x)` (`rem:codes`). -/
def cwEuc {ℓ r : ℕ} (p : ℕ) (A : Matrix (Fin ℓ) (Fin r) (ZMod p)) (x : Fin r → ZMod p) : ℕ :=
  ∑ d, (x d).valMinAbs.natAbs ^ 2 + ∑ i, ((A *ᵥ x) i).valMinAbs.natAbs ^ 2

/-- Hamming weight of the codeword `(x, A x)`. -/
def cwHam {ℓ r : ℕ} (p : ℕ) (A : Matrix (Fin ℓ) (Fin r) (ZMod p)) (x : Fin r → ZMod p) : ℕ :=
  (univ.filter fun d => x d ≠ 0).card + (univ.filter fun i => (A *ᵥ x) i ≠ 0).card

end Z3NetF
