/-!
# Definitions of entry S1 (verbatim copy of the definitions in `ChallengeS1.lean`)

Generated by `scripts/sync_s1defs.py`; keep in sync with `ChallengeS1.lean` (Comparator checks
that the Solution declarations have the same types and values).

# Challenge (entry S1): one-skeleton-coordinate lattice nets in every dimension

Throughout `s ≥ 3` is the dimension, `m = s k + (s - 1)` (residue `r = s - 1`), digits are indexed
`0, …, m-1` (digit `0` most significant) and the coordinates are `Fin s`. The basic definitions
(`coord`, `digPoint`, `IsNet0`, `cres`, `torusDist2`) are verbatim copies of those of entry U
(`ChallengeU.lean`), and `ent` of the second entry (`ChallengeKN.lean`), in the namespace
`Z3NetS1`.

**Graph form with unequal depths.** Coordinates `c < s - 1` are *full* (coarse depth `k + 1`);
coordinate `s - 1` is the *skeleton* coordinate `z` (coarse depth `k`); `depth s k c`, and
`∑_c depth = m`. The index is the vector of coarse digits: block `c` occupies index digits
`off k c + j = c (k+1) + j`, `j < depth s k c` (level `0` most significant), and digit `j` of
coordinate `c` is index digit `off k c + j`. Digit `k` of `z` (its first offset digit) is the
*skeleton digit*.

**Theorem S1** (`IsS1skel`): the skeleton digit is
`S_z = ∑_{i=1}^{s-1} ρ^i x_{i,k}`, where `x_{i,k}` is the last coarse digit (level `k`) of the full
coordinate `i - 1` (index digit `(i-1)(k+1) + k`); all other coefficients of that row are `0`
(own block included). `skRow s k ρ col` is the coefficient of index digit `col`. For `s = 3` this is
the skeleton `skB2 ρ` of the second entry (`B2`).

With fine positions `P_c` (the first `k + 1` digits of coordinate `c`) every difference of two
points lies in the index-`p` lattice `Λ = {a ∈ ℤ^s : a_z ≡ ∑_{i=1}^{s-1} ρ^i a_{i} (mod p)}`
(no faults), and `λ∞(Λ) = ρ` when `ρ^s < p` (Lemma L2_s).

Main declarations:

* `L2s_min`, `L2s_attained` — Lemma L2_s: every nonzero vector of `Λ` has sup-norm `≥ ρ`
  (`ρ^s < p`), and `(1, 0, …, 0, ρ) ∈ Λ`, so `λ∞(Λ) = ρ` exactly.
* `S1_net` — net completion for every `k ≥ 0`: for `s ≥ 3`, prime `p`, `ρ ≥ 2`, `ρ^s < p` there is
  a digital `(0, sk+s-1, s)`-net over `𝔽_p` in graph form with the S1 skeleton row.
* `S1_sep`, `S1_sep_real` — every net with the S1 skeleton row has toroidal separation
  `δ ≥ (ρ - 1) p^(-1/s) N^(-1/s)`, `N = p^m` (integer form: `(ρ-1)² p^(2((s-1)(k+1)-1)) ≤ N² δ²`).
* `S1_const` — with `ρ = ρ_s(p)` the largest `ρ` with `ρ^s < p` (`rhoS`) and `p > 2^s` prime:
  `ρ ≥ 2`, `ρ^s < p < (ρ+1)^s` and `(ρ-1) p^(-1/s) > (ρ-1)/(ρ+1) ≥ 1/3` (`≥ 1/2` if `p > 3^s`).
* `S1_main` — the headline: for every `s ≥ 3`, prime `p > 2^s` and `k ≥ 0` there is a digital
  `(0, sk+s-1, s)`-net over `𝔽_p` (S1 skeleton with `ρ = ρ_s(p)`) whose toroidal minimum distance
  exceeds `N^(-1/s) / 3`.

Added for `thm:S1` in full (core.tex rev 10.4; results cited by `\label`):

* `S1gen_net` — the explicit net `𝒮¹_{k,p,ρ}` of Definition `def:S1` (`S1gen`: frame on the
  places `∞, 0, …, s-2`, graph form, the gauge of Proposition `prop:skelcomp`(ii), own blocks `0`)
  has the S1 skeleton row and is a digital `(0, sk+s-1, s)`-net over `𝔽_p`; with `S1_sep`,
  `S1_sep_real` this is the net sentence and part (1) for the net of the definition.
* `S1_const_tendsto` — part (1): `(ρ_s(p) - 1) p^(-1/s) → 1`.
* `S1_cells`, `S1lat_index`, `S1lat_min`, `S1_opt` — part (2): the fine positions of the points
  are exactly the cells of the lattice `Λ` (`S1lat`, a subgroup of `ℤ^s` of index `p`), each once;
  `λ∞(Λ) = ρ`; every subgroup of `ℤ^s` of index `p` has a nonzero vector of sup-norm
  `≤ ρ_s(p)` (so `λ∞ = ρ_s(p)` is the largest possible).
* `S1_mu`, `S1_cover`, `S1_mesh`, `S1_mesh_tendsto` — part (3): `μ = ⌈p/ρ^(s-1)⌉`
  (`muS`) satisfies `ρ - 1 ≤ μ < ρ(1 + 1/ρ)^s + 1` and uniform bounds; covering radius in
  `[0,1)^s`: `h N^(1/s) ≤ √s (μ + 1) p^(-1/s)`; mesh ratio `h/δ ≤ √s (μ + 1)/(ρ - 1)` (against the
  toroidal `δ`); and `√s (μ + 1)/(ρ - 1) → √s`.

Not formalized: the numerical tables.
-/

namespace Z3NetS1

open Matrix Finset

/-! ## Digital nets, elementary boxes, distances (verbatim from `ChallengeU.lean`) -/

/-- Integer coordinate of the digital point with generator matrix `C` and index `v`:
the digits are `d = C v ∈ (ℤ/qℤ)^m` (digit `0` most significant) and
`coord q m C v = ∑_j val(d_j) · q^(m-1-j) ∈ [0, q^m)`. -/
def coord (q m : ℕ) (C : Matrix (Fin m) (Fin m) (ZMod q)) (v : Fin m → ZMod q) : ℕ :=
  ∑ j : Fin m, ((C *ᵥ v) j).val * q ^ (m - 1 - (j : ℕ))

/-- The integer point (`s` coordinates) of the digital net with generator matrices `C c` at
index `v`. -/
def digPoint {s : ℕ} (q m : ℕ) (C : Fin s → Matrix (Fin m) (Fin m) (ZMod q))
    (v : Fin m → ZMod q) : Fin s → ℕ :=
  fun c => coord q m (C c) v

/-- `(0,m,s)`-net property in base `q` of the family of integer points `X v ∈ [0,q^m)^s` indexed
by `v ∈ (ℤ/qℤ)^m`: for every `d` with `∑_c d c = m` and every elementary box
`∏_c [a_c q^(-d_c), (a_c+1) q^(-d_c))` (`a_c < q^(d_c)`), exactly one index `v` has its point
`X v / q^m` in the box. -/
def IsNet0 (s q m : ℕ) (X : (Fin m → ZMod q) → Fin s → ℕ) : Prop :=
  ∀ d : Fin s → ℕ, ∑ c, d c = m → ∀ a : Fin s → ℕ, (∀ c, a c < q ^ d c) →
    ∃! v : Fin m → ZMod q, ∀ c, X v c / q ^ (m - d c) = a c

/-- Distance from the integer `u` to the lattice `N ℤ`: `min (u mod N) (N - u mod N)`.
(Adapted from `GKEvenNet.cres`.) -/
def cres (N : ℕ) (u : ℤ) : ℕ :=
  min (u % (N : ℤ)).toNat (N - (u % (N : ℤ)).toNat)

/-- Squared toroidal distance, at integer scale `N`, between the integer points `x, y`
(i.e. `N²` times the squared distance of `x / N`, `y / N` on the torus `(ℝ/ℤ)^s`). -/
def torusDist2 {s : ℕ} (N : ℕ) (x y : Fin s → ℕ) : ℕ :=
  ∑ c, cres N ((x c : ℤ) - (y c : ℤ)) ^ 2

/-- Total entry accessor: `ent A i j = A i j` if `(i, j)` is in range, `0` otherwise
(verbatim from `ChallengeKN.lean`). -/
def ent {R : Type*} [Zero R] {a b : ℕ} (A : Matrix (Fin a) (Fin b) R) (i j : ℕ) : R :=
  if h : i < a ∧ j < b then A ⟨i, h.1⟩ ⟨j, h.2⟩ else 0

/-! ## Graph form with one skeleton coordinate -/

/-- Coarse depth of coordinate `c` for `m = s k + (s - 1)`: `k + 1` for the full coordinates
`c < s - 1`, `k` for the skeleton coordinate `c = s - 1`. -/
def depth (s k : ℕ) (c : Fin s) : ℕ := if (c : ℕ) + 1 < s then k + 1 else k

/-- First index digit of block `c`: `c (k + 1)` (all earlier blocks are full). -/
def off (k : ℕ) {s : ℕ} (c : Fin s) : ℕ := (c : ℕ) * (k + 1)

/-- Coefficient of index digit `col` in the S1 skeleton digit: `ρ^(d+1)` if `col` is the last
coarse level `k` of the full block `d` (`col = d (k+1) + k`, `d < s - 1`), else `0`. -/
def skRow (s k ρ col : ℕ) : ℕ :=
  if col % (k + 1) = k ∧ col / (k + 1) + 1 < s then ρ ^ (col / (k + 1) + 1) else 0

/-- `C` is in graph form with depths `depth s k` (digit `j < K_c` of coordinate `c` is index
digit `off k c + j`), and the skeleton digit (row `k` of the skeleton coordinate `s - 1`) is
`S_z = ∑_{d < s-1} ρ^(d+1) x_{d,k}`, every other coefficient of that row being `0`. -/
def IsS1skel (s p k ρ : ℕ)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p)) : Prop :=
  (∀ c : Fin s, ∀ j < depth s k c, ∀ col < s * k + (s - 1),
      ent (C c) j col = if col = off k c + j then 1 else 0) ∧
  (∀ z : Fin s, (z : ℕ) + 1 = s → ∀ col < s * k + (s - 1),
      ent (C z) k col = ((skRow s k ρ col : ℕ) : ZMod p))

/-- `ρ_s(p)`: the largest `ρ ≤ p` with `ρ^s < p` (`= ⌊p^(1/s)⌋` for prime `p` and `s ≥ 2`). -/
def rhoS (s p : ℕ) : ℕ := Nat.findGreatest (fun ρ => ρ ^ s < p) p

/-! ## The explicit net `𝒮¹_{k,p,ρ}` of Definition `def:S1`

The frame of the places `∞, 0, 1, …, s-2` (coordinate `0` at `∞`, coordinate `c ≥ 1` at the place
`c - 1`; `place`, `frameGen` are verbatim copies of `ChallengeU.lean`), read in graph form with the
depths `(k+1, …, k+1, k)` (`frameBox` is the box matrix of this composition: row `r` is digit
`lev r` of reading `blk r`), followed by the recipe of Proposition `prop:skelcomp`(ii) with
`κ_d = ρ^d`: on every full block `d` subtract multiples of the last level `k` from the levels
`l < k` so that the frame's skeleton row `ψ` (`framePsi`) vanishes there, scale level `k` to `κ_d`
(the column gauge `gaugeS1`), and set all diagonal blocks to `0` (`S1gen`). -/

/-- Place of coordinate `c ≥ 1`: `a_c = c - 1` (coordinate `0` is the place `∞`). -/
def place {s : ℕ} (c : Fin s) : ℤ := (c : ℤ) - 1

/-- Frame generator matrix of coordinate `c` on `ℤ[t]_{<m}` (index = coefficient vector `v` of
`V = ∑_l v_l t^l`): for `c ≥ 1` digit `i` is the coefficient of `(t - a_c)^i`, i.e.
`∑_l C(l, i) a_c^(l-i) v_l`; for `c = 0` (`∞`) digit `i` is `v_{m-1-i}`. -/
def frameGen {s : ℕ} (m : ℕ) (c : Fin s) : Matrix (Fin m) (Fin m) ℤ :=
  fun i l =>
    if (c : ℕ) = 0 then (if (l : ℕ) + (i : ℕ) + 1 = m then 1 else 0)
    else (((l : ℕ).choose (i : ℕ) : ℕ) : ℤ) * place c ^ ((l : ℕ) - (i : ℕ))

/-- Coordinate (block) of index digit `r` for the depths `(k+1, …, k+1, k)`: `min(r / (k+1), s-1)`. -/
def blk (s k r : ℕ) : ℕ := min (r / (k + 1)) (s - 1)

/-- Level of index digit `r` inside its block: `r - blk r · (k+1)`. -/
def lev (s k r : ℕ) : ℕ := r - blk s k r * (k + 1)

/-- Box matrix of the frame over `𝔽_p` for the depths `(k+1, …, k+1, k)`: row `r` is digit
`lev r` of the reading `blk r`. -/
def frameBox (s k p : ℕ) : Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p) :=
  fun r col =>
    if h : blk s k r < s then
      ((ent (frameGen (s * k + (s - 1)) (⟨blk s k r, h⟩ : Fin s)) (lev s k r) col : ℤ) : ZMod p)
    else 0

/-- The frame's skeleton row in graph form: `ψ = (digit k of the reading s-1) · B⁻¹`. -/
noncomputable def framePsi (s k p : ℕ) : Fin (s * k + (s - 1)) → ZMod p :=
  (fun col : Fin (s * k + (s - 1)) => if h : 0 < s then
      ((ent (frameGen (s * k + (s - 1)) (⟨s - 1, Nat.sub_lt h Nat.one_pos⟩ : Fin s)) k col : ℤ) : ZMod p) else 0) ᵥ*
    (frameBox s k p)⁻¹

/-- The column gauge of Proposition `prop:skelcomp`(ii) (move (c)): on every full block `d`
(index digits `d(k+1) + l`, `l ≤ k`, `d < s - 1`) the last level `r = d(k+1) + k` becomes
`κ_d ψ_r⁻¹` times itself (`κ_d = ρ^(d+1)` in `0`-based numbering) and `-ψ_l ψ_r⁻¹` times it is
added to every level `l < k` of the block; identity elsewhere. (The graph form is multiplied by
this matrix on the right.) -/
noncomputable def gaugeS1 (s k p ρ : ℕ) :
    Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p) :=
  fun r col =>
    if (r : ℕ) % (k + 1) = k ∧ (r : ℕ) / (k + 1) + 1 < s then
      (if col = r then ((ρ ^ ((r : ℕ) / (k + 1) + 1) : ℕ) : ZMod p) * (framePsi s k p r)⁻¹
       else if (col : ℕ) / (k + 1) = (r : ℕ) / (k + 1) ∧ (col : ℕ) < r then
         -(framePsi s k p col) * (framePsi s k p r)⁻¹ else 0)
    else if col = r then 1 else 0

/-- **The net `𝒮¹_{k,p,ρ}` of Definition `def:S1`**, generator matrices in graph form: digit
`i < K_c` of coordinate `c` is index digit `off k c + i`; every other row is the corresponding row
of `F_c B⁻¹ G` (frame reading `F_c` over `𝔽_p`, box matrix `B = frameBox`, gauge `G = gaugeS1`)
with the own-block columns (`blk col = c`) set to `0`. -/
noncomputable def S1gen (s p k ρ : ℕ) (c : Fin s) :
    Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p) :=
  fun i col =>
    if (i : ℕ) < depth s k c then (if (col : ℕ) = off k c + i then 1 else 0)
    else if blk s k col = (c : ℕ) then 0
    else (((frameGen (s * k + (s - 1)) c).map (Int.cast : ℤ → ZMod p)) * (frameBox s k p)⁻¹ *
      gaugeS1 s k p ρ) i col

/-! ## Fine positions, the lattice `Λ`, `μ` -/

/-- Fine position `P_c` of the point with index `v`: the first `k + 1` digits of coordinate `c`,
`⌊X_c / p^(m-k-1)⌋ ∈ [0, p^(k+1))` (for the skeleton coordinate this is `p n_z + S_z`). -/
def finePos (s p k : ℕ) (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (v : Fin (s * k + (s - 1)) → ZMod p) (c : Fin s) : ℕ :=
  digPoint p (s * k + (s - 1)) C v c / p ^ (s * k + (s - 1) - (k + 1))

/-- Check vector `h = (ρ, ρ², …, ρ^(s-1), -1)` (`h_c = ρ^(c+1)` for `c < s - 1`, `h_(s-1) = -1`). -/
def chk (s ρ : ℕ) (c : Fin s) : ℤ := if (c : ℕ) + 1 < s then (ρ : ℤ) ^ ((c : ℕ) + 1) else -1

/-- The check map `a ↦ h · a = ∑_c h_c a_c` reduced modulo `p`, as an additive homomorphism
`ℤ^s → ℤ/pℤ`. -/
def chkHom (s p ρ : ℕ) : (Fin s → ℤ) →+ ZMod p :=
  (Int.castAddHom (ZMod p)).comp
    (∑ c : Fin s, (AddMonoidHom.mulLeft (chk s ρ c)).comp (Pi.evalAddMonoidHom (fun _ : Fin s => ℤ) c))

/-- The lattice `Λ = {a ∈ ℤ^s : a_z ≡ ∑_{d=1}^{s-1} ρ^d a_{x_d} (mod p)} = {a : p ∣ h · a}` of
Lemma `lem:skellat`(L), as a subgroup of `ℤ^s`: the kernel of `chkHom` (it has index `p`,
`S1lat_index`). -/
def S1lat (s p ρ : ℕ) : AddSubgroup (Fin s → ℤ) := (chkHom s p ρ).ker

/-- `μ = ⌈p / ρ^(s-1)⌉` (for `ρ ≥ 1`). -/
def muS (s p ρ : ℕ) : ℕ := (p + ρ ^ (s - 1) - 1) / ρ ^ (s - 1)

end Z3NetS1
