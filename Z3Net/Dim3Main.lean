/-! ### `cor:allm` -/

/-- **`cor:allm`.** For every prime `p ≥ 37` and every `m ≥ 3` there is a digital `(0,m,3)`-net over
`𝔽_p` (the nets of `thm:col` (the column net `𝒞_p`) for `m = 3`, `thm:main` for `m ≡ 0`, `m ≥ 6`, `thm:allm` (`𝓑¹`) for
`m ≡ 1`, `thm:S1` at `s = 3` (`𝓑²`) for `m ≡ 2`, with `ρ` maximal) whose toroidal minimum distance
satisfies `δ N^(1/3) ≥ bndDim3 p` (`N = p^m`), and whose covering radius satisfies
`h N^(1/3) ≤ √3`, `p^(1/3) √(2 + p^(-2))`, `min{p^(2/3) √(1 + 2p^(-2)), 4.264}` for
`m ≡ 0, 1, 2 (mod 3)`. -/
theorem cor_allm (p m : ℕ) (hp : p.Prime) (hp37 : 37 ≤ p) (hm : 3 ≤ m) :
    ∃ C : Fin 3 → Matrix (Fin m) (Fin m) (ZMod p),
      IsNet0 p m (digPoint p m C) ∧
      (∀ v w : Fin m → ZMod p, v ≠ w →
        bndDim3 p * ((p : ℝ) ^ m) ^ (-(1 / (3 : ℝ))) ≤
          Real.sqrt (∑ c, ((cres (p ^ m) ((digPoint p m C v c : ℤ) - (digPoint p m C w c : ℤ)) : ℝ)
            / (p : ℝ) ^ m) ^ 2)) ∧
      (∀ y : Fin 3 → ℝ, (∀ c, 0 ≤ y c ∧ y c < 1) → ∃ v : Fin m → ZMod p,
        Real.sqrt (∑ c, (y c - (digPoint p m C v c : ℝ) / (p : ℝ) ^ m) ^ 2) ≤
          (if m % 3 = 0 then Real.sqrt 3
           else if m % 3 = 1 then (p : ℝ) ^ (1 / (3 : ℝ)) * Real.sqrt (2 + 1 / (p : ℝ) ^ 2)
           else min ((p : ℝ) ^ (2 / (3 : ℝ)) * Real.sqrt (1 + 2 / (p : ℝ) ^ 2)) 4.264) *
            ((p : ℝ) ^ m) ^ (-(1 / (3 : ℝ)))) :=
  Proofs.cor_allm p m hp hp37 hm

/-- **`cor:allm`, the uniform constants**: for every prime `p ≥ 37`, `bndDim3 p > 0.2715`, and
`> 0.4250` if `p ≥ 83`. -/
theorem bndDim3_gt (p : ℕ) (hp : p.Prime) (hp37 : 37 ≤ p) :
    0.2715 < bndDim3 p ∧ (83 ≤ p → 0.4250 < bndDim3 p) :=
  Proofs.bndDim3_gt p hp hp37

/-- **`cor:allm`: the lower bound tends to `1`.** -/
theorem bndDim3_tendsto : Filter.Tendsto bndDim3 Filter.atTop (nhds 1) :=
  Proofs.bndDim3_tendsto

/-- **`cor:allm`: quasi-uniformity.** For every prime `p ≥ 37` the mesh ratio is bounded uniformly
in `m`: there is `M` such that for every `m ≥ 3` some digital `(0,m,3)`-net over `𝔽_p` has every
`y ∈ [0,1)³` within `M δ_T(w, w')` of a net point, for all distinct indices `w ≠ w'`. -/
theorem cor_allm_mesh (p : ℕ) (hp : p.Prime) (hp37 : 37 ≤ p) :
    ∃ M : ℝ, ∀ m : ℕ, 3 ≤ m → ∃ C : Fin 3 → Matrix (Fin m) (Fin m) (ZMod p),
      IsNet0 p m (digPoint p m C) ∧
      ∀ y : Fin 3 → ℝ, (∀ c, 0 ≤ y c ∧ y c < 1) → ∃ v : Fin m → ZMod p,
        ∀ w w' : Fin m → ZMod p, w ≠ w' →
          Real.sqrt (∑ c, (y c - (digPoint p m C v c : ℝ) / (p : ℝ) ^ m) ^ 2) ≤
            M * Real.sqrt (∑ c, ((cres (p ^ m)
              ((digPoint p m C w c : ℤ) - (digPoint p m C w' c : ℤ)) : ℝ) / (p : ℝ) ^ m) ^ 2) :=
  Proofs.cor_allm_mesh p hp hp37

/-- **`cor:allm`, `m ≡ 2`**: for every prime `p ≥ 11` and every `k ≥ 1` (`m = 3k + 2 ≥ 5`) the net
`𝓑²_{k,p,ρ}` with `ρ = ρ_3(p)` is a `(0,m,3)`-net over `𝔽_p` with covering radius
`h N^(1/3) < 4.264` and mesh ratio `h/δ ≤ 7√3` (against the toroidal `δ`). -/
theorem cor_allm_mesh2 (p k : ℕ) (hp : p.Prime) (hp11 : 11 ≤ p) (hk : 1 ≤ k) :
    IsNet0 p (3 * k + 2) (digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p))) ∧
    ∀ y : Fin 3 → ℝ, (∀ c, 0 ≤ y c ∧ y c < 1) → ∃ v : Fin (3 * k + 2) → ZMod p,
      Real.sqrt (∑ c, (y c - (digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p)) v c : ℝ)
          / (p : ℝ) ^ (3 * k + 2)) ^ 2) < 4.264 * ((p : ℝ) ^ (3 * k + 2)) ^ (-(1 / (3 : ℝ))) ∧
      ∀ w w' : Fin (3 * k + 2) → ZMod p, w ≠ w' →
        Real.sqrt (∑ c, (y c - (digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p)) v c : ℝ)
          / (p : ℝ) ^ (3 * k + 2)) ^ 2) ≤
        7 * Real.sqrt 3 * Real.sqrt (∑ c, ((cres (p ^ (3 * k + 2))
          ((digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p)) w c : ℤ) -
            (digPoint p (3 * k + 2) (B2gen p k (rhoS 3 p)) w' c : ℤ)) : ℝ)
          / (p : ℝ) ^ (3 * k + 2)) ^ 2) :=
  Proofs.cor_allm_mesh2 p k hp hp11 hk

/-- **`cor:allm`, the `m ≡ 2` constants** (`ρ = ρ_3(p)`, `μ = ⌈p/ρ²⌉`): for every prime `p ≥ 11`,
`√3 (μ + 1) p^(-1/3) < 4.264` and `(μ + 1)/(ρ - 1) ≤ 7`; both maxima are attained at `p = 23`
(`4.2633…` and `7`). -/
theorem cor_allm_consts :
    (∀ p : ℕ, p.Prime → 11 ≤ p →
      Real.sqrt 3 * ((muS 3 p (rhoS 3 p) : ℝ) + 1) * (p : ℝ) ^ (-(1 / (3 : ℝ))) < 4.264 ∧
      ((muS 3 p (rhoS 3 p) : ℝ) + 1) / ((rhoS 3 p : ℝ) - 1) ≤ 7) ∧
    4.2633 < Real.sqrt 3 * ((muS 3 23 (rhoS 3 23) : ℝ) + 1) * (23 : ℝ) ^ (-(1 / (3 : ℝ))) ∧
    ((muS 3 23 (rhoS 3 23) : ℝ) + 1) / ((rhoS 3 23 : ℝ) - 1) = 7 :=
  Proofs.cor_allm_consts

