/-- The places of the frame: `x = ∞` (coordinate `0`; its entry is unused), `z = (0, 1, a3)`. -/
def t3Places (D : T3Design) : Fin 4 → ZMod D.p := ![0, 0, 1, (D.a3 : ZMod D.p)]

/-- Coefficient of the skeleton digit `S_{z_i}` on level `l` of the full coordinate `x` (depth
`k + 1`; levels `k, k-1, k-2` carry `κ_i, β_i, η_i`). -/
def t3xCoef (D : T3Design) (k : ℕ) (i : Fin 3) (l : ℕ) : ℤ :=
  if l = k then D.κ i else if l + 1 = k then D.β i else if l + 2 = k then D.η i else 0

/-- Coefficient of `S_{z_i}` on level `l` of the skeleton coordinate `z_j` (depth `k`): `o_i` on
`z_{i,k-1}`; for `j ≠ i`, `g_ij` on `z_{j,k-1}` and `H_ij` on `z_{j,k-2}`. -/
def t3zCoef (D : T3Design) (k : ℕ) (i j : Fin 3) (l : ℕ) : ℤ :=
  if i = j then (if l + 1 = k then D.o i else 0)
  else if l + 1 = k then D.g i j else if l + 2 = k then D.H i j else 0

/-- `C` is in graph form with the depths `(k+1, k, k, k)` (`IsSkGF` with `r = 1`) and its skeleton
digits (row `k` of `C z_i`) are those of `D`: every coefficient is `t3xCoef` resp. `t3zCoef`. -/
def IsT3skel (D : T3Design) (k : ℕ)
    (C : Fin 4 → Matrix (Fin (4 * k + 1)) (Fin (4 * k + 1)) (ZMod D.p)) : Prop :=
  IsSkGF 4 1 D.p k C ∧
    (∀ (i : Fin 3) (l : ℕ), l < k + 1 →
      ent (C i.succ) k (skOff 1 k 0 + l) = ((t3xCoef D k i l : ℤ) : ZMod D.p)) ∧
    ∀ (i j : Fin 3) (l : ℕ), l < k →
      ent (C i.succ) k (skOff 1 k ((j.succ : Fin 4) : ℕ) + l) = ((t3zCoef D k i j l : ℤ) : ZMod D.p)

/-- `|a|_∞` of `a ∈ ℤ⁴`. -/
def t3MaxAbs (a : Fin 4 → ℤ) : ℤ := max (max |a 0| |a 1|) (max |a 2| |a 3|)

/-- The relaxation of the proof of `prop:t3s4` ("Separation"): a centred fine difference `a ∈ ℤ⁴`
with `|a|_∞ < p/2` (coordinate `0` is `x`, `i.succ` is `z_i`), floor changes `ξ1 = ξ_{·,1}`,
`ξ2 = ξ_{·,2}` with sign-consistent prefix patterns `(ξ1_c, ξ2_c) ∈ {(0,0), (σ_c,0), (σ_c,σ_c)}`,
`σ_c = sgn a_c`, and
`a_{z_i} ≡ κ_i a_x + β_i ξ1_x + η_i ξ2_x + ∑_{j ≠ i} (g_ij ξ1_{z_j} + H_ij ξ2_{z_j}) + o_i ξ1_{z_i} (mod p)`. -/
def T3Rel (D : T3Design) (a ξ1 ξ2 : Fin 4 → ℤ) : Prop :=
  (∀ c, 2 * |a c| < D.p) ∧
    (∀ c, (ξ1 c = 0 ∨ ξ1 c = Int.sign (a c)) ∧ (ξ2 c = 0 ∨ ξ2 c = Int.sign (a c)) ∧
      (ξ2 c ≠ 0 → ξ1 c ≠ 0)) ∧
    ∀ i : Fin 3, (D.p : ℤ) ∣ a i.succ - (D.κ i * a 0 + D.β i * ξ1 0 + D.η i * ξ2 0 +
      ∑ j : Fin 3, (if j = i then D.o i * ξ1 j.succ else D.g i j * ξ1 j.succ + D.H i j * ξ2 j.succ))

