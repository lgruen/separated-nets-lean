module
public import Z3Net.HalfCertSound

@[expose] public section

/-!
# Entry Half: explicit checkers for `tab:half` (generated by `scripts/gen_halfcert.py`)

`okS{s} p T e₀ … e_{s-1}` checks `T ≤ 10⁸ ∑_c hLc²` for the step `E = (e₀, …)` of the design
`M{s}h` (linear forms written out); `chk{s}` runs it over `vals5` (`s = 5`) resp. `vals3`
(`s = 6, 8`) in the remaining coordinates. `lb{s}_of_chk` turns a successful run into
`n/10⁴ ≤ |ℓ(E)|` for the steps it covers. `okInf5`/`chkInf5`: the `p`-free check `5 ≤ ∑ (2ℓ^∞)²`.
-/

namespace Z3NetHL.Proofs

set_option maxRecDepth 100000

/-! ## `s = 5` -/

lemma lin5_0 (E : Fin 5 → ℤ) :
    ∑ d, M5h 0 d * E d = (-5) * E 0 + (3) * E 1 + (1) * E 2 + (-3) * E 3 + (1) * E 4 := by
  simp only [Fin.sum_univ_five, M5h]; simp

lemma lin5_1 (E : Fin 5 → ℤ) :
    ∑ d, M5h 1 d * E d = (-3) * E 0 + (-3) * E 1 + (3) * E 2 + (-1) * E 3 + (-1) * E 4 := by
  simp only [Fin.sum_univ_five, M5h]; simp

lemma lin5_2 (E : Fin 5 → ℤ) :
    ∑ d, M5h 2 d * E d = (1) * E 0 + (-1) * E 1 + (-5) * E 2 + (-3) * E 3 + (3) * E 4 := by
  simp only [Fin.sum_univ_five, M5h]; simp

lemma lin5_3 (E : Fin 5 → ℤ) :
    ∑ d, M5h 3 d * E d = (-1) * E 0 + (-1) * E 1 + (3) * E 2 + (-7) * E 3 + (1) * E 4 := by
  simp only [Fin.sum_univ_five, M5h]; simp

lemma lin5_4 (E : Fin 5 → ℤ) :
    ∑ d, M5h 4 d * E d = (3) * E 0 + (-1) * E 1 + (1) * E 2 + (-1) * E 3 + (-3) * E 4 := by
  simp only [Fin.sum_univ_five, M5h]; simp

def okS5 (p : ℕ) (T e0 e1 e2 e3 e4 : ℤ) : Bool :=
  decide (e0 = 0 ∧ e1 = 0 ∧ e2 = 0 ∧ e3 = 0 ∧ e4 = 0) ||
  decide (T ≤ 100000000 * (
      hLc (p : ℤ) (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e0 ((-5) * e0 + (3) * e1 + (1) * e2 + (-3) * e3 + (1) * e4) ^ 2 +
      hLc (p : ℤ) (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e1 ((-3) * e0 + (-3) * e1 + (3) * e2 + (-1) * e3 + (-1) * e4) ^ 2 +
      hLc (p : ℤ) (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e2 ((1) * e0 + (-1) * e1 + (-5) * e2 + (-3) * e3 + (3) * e4) ^ 2 +
      hLc (p : ℤ) (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e3 ((-1) * e0 + (-1) * e1 + (3) * e2 + (-7) * e3 + (1) * e4) ^ 2 +
      hLc (p : ℤ) (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e4 ((3) * e0 + (-1) * e1 + (1) * e2 + (-1) * e3 + (-3) * e4) ^ 2))

def chk5 (p : ℕ) (T e0 : ℤ) : Bool :=
  vals5.all fun e1 => vals5.all fun e2 => vals5.all fun e3 => vals5.all fun e4 => okS5 p T e0 e1 e2 e3 e4

lemma okS5_sound (p : ℕ) (T : ℤ) (E : Fin 5 → ℤ) (hE : E ≠ 0)
    (h : okS5 p T (E 0) (E 1) (E 2) (E 3) (E 4) = true) :
    T ≤ 100000000 * ∑ c, hLc p (oddB E) (E c) (∑ d, M5h c d * E d) ^ 2 := by
  have hz : ¬ (E 0 = 0 ∧ E 1 = 0 ∧ E 2 = 0 ∧ E 3 = 0 ∧ E 4 = 0) := by
    rintro ⟨h0, h1, h2, h3, h4⟩; apply hE; funext i; fin_cases i <;> simp [*]
  simp only [okS5, Bool.or_eq_true, decide_eq_true_eq] at h
  rcases h with h | h
  · exact absurd h hz
  · rw [Fin.sum_univ_five (fun c => hLc p (oddB E) (E c) (∑ d, M5h c d * E d) ^ 2)]
    simp only [lin5_0, lin5_1, lin5_2, lin5_3, lin5_4]
    simp only [oddB, Fin.sum_univ_five]
    exact h

theorem lb5_of_chk (p : ℕ) (hp : 0 < p) (n : ℕ) (T : ℤ) (hT : T = (2 * (p : ℤ) * n) ^ 2)
    (hchk : ∀ e0 ∈ vals5, chk5 p T e0 = true) :
    ∀ E ∈ halfSteps 5,
      (n : ℝ) / 10 ^ 4 ≤ Real.sqrt (∑ c, halfEll p M5h E c ^ 2) := by
  intro E hE
  obtain ⟨hE0, hb⟩ := halfSteps_mem hE
  have m : ∀ c, E c ∈ vals5 := fun c => (mem_vals5 _ (hb c).1 (hb c).2)
  have h := hchk (E 0) (m 0)
  simp only [chk5, List.all_eq_true] at h
  exact le_sqrt_of_cert p hp M5h E n T hT (okS5_sound p T E hE0 (h _ (m 1) _ (m 2) _ (m 3) _ (m 4)))

