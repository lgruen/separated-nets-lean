/-! ## `λ(M5h)` -/

def okInf5 (e0 e1 e2 e3 e4 : ℤ) : Bool :=
  decide (e0 = 0 ∧ e1 = 0 ∧ e2 = 0 ∧ e3 = 0 ∧ e4 = 0) ||
  decide (5 ≤ (
      hLinf (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e0 ((-5) * e0 + (3) * e1 + (1) * e2 + (-3) * e3 + (1) * e4) ^ 2 +
      hLinf (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e1 ((-3) * e0 + (-3) * e1 + (3) * e2 + (-1) * e3 + (-1) * e4) ^ 2 +
      hLinf (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e2 ((1) * e0 + (-1) * e1 + (-5) * e2 + (-3) * e3 + (3) * e4) ^ 2 +
      hLinf (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e3 ((-1) * e0 + (-1) * e1 + (3) * e2 + (-7) * e3 + (1) * e4) ^ 2 +
      hLinf (decide ((e0 + e1 + e2 + e3 + e4) % 2 = 1)) e4 ((3) * e0 + (-1) * e1 + (1) * e2 + (-1) * e3 + (-3) * e4) ^ 2))

def chkInf5 (e0 : ℤ) : Bool :=
  vals5.all fun e1 => vals5.all fun e2 => vals5.all fun e3 => vals5.all fun e4 => okInf5 e0 e1 e2 e3 e4

lemma okInf5_sound (E : Fin 5 → ℤ) (hE : E ≠ 0)
    (h : okInf5 (E 0) (E 1) (E 2) (E 3) (E 4) = true) :
    ((5 : ℕ) : ℤ) ≤ ∑ c, hLinf (oddB E) (E c) (∑ d, M5h c d * E d) ^ 2 := by
  have hz : ¬ (E 0 = 0 ∧ E 1 = 0 ∧ E 2 = 0 ∧ E 3 = 0 ∧ E 4 = 0) := by
    rintro ⟨h0, h1, h2, h3, h4⟩; apply hE; funext i; fin_cases i <;> simp [*]
  simp only [okInf5, Bool.or_eq_true, decide_eq_true_eq] at h
  rcases h with h | h
  · exact absurd h hz
  · rw [Fin.sum_univ_five (fun c => hLinf (oddB E) (E c) (∑ d, M5h c d * E d) ^ 2)]
    simp only [lin5_0, lin5_1, lin5_2, lin5_3, lin5_4]
    simp only [oddB, Fin.sum_univ_five]
    exact_mod_cast h

theorem lam5_of_chk (hchk : ∀ e0 ∈ vals5, chkInf5 e0 = true) :
    ∀ E ∈ halfSteps 5, Real.sqrt 5 / 2 ≤ Real.sqrt (∑ c, halfEllInf M5h E c ^ 2) := by
  intro E hE
  obtain ⟨hE0, hb⟩ := halfSteps_mem hE
  have m : ∀ c, E c ∈ vals5 := fun c => mem_vals5 _ (hb c).1 (hb c).2
  have h := hchk (E 0) (m 0)
  simp only [chkInf5, List.all_eq_true] at h
  have := le_sqrt_inf_of_cert M5h E 5 (okInf5_sound E hE0 (h _ (m 1) _ (m 2) _ (m 3) _ (m 4)))
  exact_mod_cast this

end Z3NetHL.Proofs
