/-! ## Digital point sets, boxes, distances -/

/-! ## `lem:nie` -/

/-- **`lem:nie`**, one shape. Over a commutative ring `R` with `q` elements (digits read through
`e`), every elementary box with `d_c` digits in coordinate `c` contains exactly one point iff the
box minor for `d` is a unit of `R`. -/
theorem nie_box {R : Type*} [CommRing R] {q s m : ℕ} (e : R ≃ Fin q)
    (C : Fin s → Matrix (Fin m) (Fin m) R) (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    BoxExact e C d ↔ IsUnit (boxMatrix C d).det :=
  Proofs.nie_box e C d hd

/-- **`lem:nie`**: `(0,m,s)`-net iff every box minor is a unit of `R`. -/
theorem nie_net {R : Type*} [CommRing R] {q s m : ℕ} (e : R ≃ Fin q)
    (C : Fin s → Matrix (Fin m) (Fin m) R) :
    IsNet0E e C ↔ ∀ d : Fin s → ℕ, ∑ c, d c = m → IsUnit (boxMatrix C d).det :=
  Proofs.nie_net e C

/-- **`lem:nie`** over a finite field: `(0,m,s)`-net iff every box minor is nonzero. -/
theorem nie_net_field {K : Type*} [Field K] {q s m : ℕ} (e : K ≃ Fin q)
    (C : Fin s → Matrix (Fin m) (Fin m) K) :
    IsNet0E e C ↔ ∀ d : Fin s → ℕ, ∑ c, d c = m → (boxMatrix C d).det ≠ 0 :=
  Proofs.nie_net_field e C

/-- **`lem:nie`** over `ℤ/qℤ` with the standard digits `ZMod.val`. -/
theorem nie_zmod {s q m : ℕ} [NeZero q] (C : Fin s → Matrix (Fin m) (Fin m) (ZMod q)) :
    IsNet0 s q m (digPoint q m C) ↔ ∀ d : Fin s → ℕ, ∑ c, d c = m → IsUnit (boxMatrix C d).det :=
  Proofs.nie_zmod q C

/-! ## Graph forms with depths `K` and `lem:box` -/

/-- Paper, `sec:prelim`: if the box matrix `G` of a digital point set for the depths `K` is
invertible, the point set is a graph form in the cells `G v`: `C_c = graphGenK K Φ c · G`. -/
theorem graphForm_of_box {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (C : Fin s → Matrix (Fin m) (Fin m) R) (hG : IsUnit (boxMatrix C K).det) :
    ∃ Φ : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R,
      ∀ c, graphGenK K Φ c * boxMatrix C K = C c :=
  Proofs.graphForm_of_box K hK C hG

/-- **`lem:box`**: the box minor of a graph form for `d` equals, up to a sign that depends only
on `K` and `d`, the determinant of the reduced box matrix (top `d_c - K_c` offset rows of the
over coordinates on the last `K_e - d_e` levels of the under coordinates); such a squaring
bijection `σ` exists. In particular the diagonal blocks never enter. -/
theorem box_minor {R : Type*} [CommRing R] {s m : ℕ} (K d : Fin s → ℕ) (hK : ∑ c, K c = m)
    (hd : ∑ c, d c = m) :
    Nonempty (UnderCols K d ≃ OverRows K d) ∧
      ∀ σ : UnderCols K d ≃ OverRows K d, ∃ ε : R, (ε = 1 ∨ ε = -1) ∧
        ∀ Φ : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R,
          (boxMatrix (graphGenK K Φ) d).det = ε * (redBox K d Φ σ).det :=
  Proofs.box_minor K d hK hd

/-- **`lem:box`**: the box minor for `d = K` is `1`. -/
theorem box_minor_self {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (Φ : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R) :
    (boxMatrix (graphGenK K Φ) K).det = 1 :=
  Proofs.box_minor_self K hK Φ

/-- **`lem:box`**, gauge move (a): replacing the diagonal blocks does not change any box minor. -/
theorem gauge_diag {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (Φ Φ' : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R)
    (h : ∀ c d, c ≠ d → Φ' c d = Φ c d) (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    (boxMatrix (graphGenK K Φ') d).det = (boxMatrix (graphGenK K Φ) d).det :=
  Proofs.gauge_diag K hK Φ Φ' h d hd

/-- **`lem:box`**, gauge move (c) (with (a)): `Φ'_cd = L_c Φ_cd U_d` (`c ≠ d`, diagonal blocks
arbitrary) with `L_c`, `U_d` lower triangular with unit diagonal multiplies every box minor by a
unit of `R` that does not depend on `Φ`. -/
theorem gauge_LU {R : Type*} [CommRing R] {s m : ℕ} (K : Fin s → ℕ) (hK : ∑ c, K c = m)
    (L : (c : Fin s) → Matrix (Fin (m - K c)) (Fin (m - K c)) R)
    (U : (d : Fin s) → Matrix (Fin (K d)) (Fin (K d)) R)
    (hL : ∀ c i j, i < j → L c i j = 0) (hLu : ∀ c i, IsUnit (L c i i))
    (hU : ∀ d i j, i < j → U d i j = 0) (hUu : ∀ d i, IsUnit (U d i i))
    (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    ∃ u : R, IsUnit u ∧ ∀ Φ Φ' : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R,
      (∀ c d, c ≠ d → Φ' c d = L c * Φ c d * U d) →
        (boxMatrix (graphGenK K Φ') d).det = u * (boxMatrix (graphGenK K Φ) d).det :=
  Proofs.gauge_LU K hK L U hL hLu hU hUu d hd

/-- **`lem:box`**, gauge move (b), `s = 3`: block scalings `Φ'_cd = μ_cd Φ_cd` (`c ≠ d`, units
`μ_cd`) multiply every box minor by a unit of `R` that does not depend on `Φ`. -/
theorem gauge_scale3 {R : Type*} [CommRing R] {m : ℕ} (K : Fin 3 → ℕ) (hK : ∑ c, K c = m)
    (μ : Fin 3 → Fin 3 → R) (hμ : ∀ c d, c ≠ d → IsUnit (μ c d))
    (d : Fin 3 → ℕ) (hd : ∑ c, d c = m) :
    ∃ u : R, IsUnit u ∧ ∀ Φ Φ' : (c d : Fin 3) → Matrix (Fin (m - K c)) (Fin (K d)) R,
      (∀ c d, c ≠ d → Φ' c d = μ c d • Φ c d) →
        (boxMatrix (graphGenK K Φ') d).det = u * (boxMatrix (graphGenK K Φ) d).det :=
  Proofs.gauge_scale3 K hK μ hμ d hd

/-- **`lem:box`**, consequence: the moves (a) and (c) map `(0,m,s)`-nets over a finite
commutative ring (`ℤ/qℤ`, `𝔽_q`, …) to `(0,m,s)`-nets. -/
theorem gauge_net {R : Type*} [CommRing R] {q s m : ℕ} (e : R ≃ Fin q) (K : Fin s → ℕ)
    (hK : ∑ c, K c = m)
    (L : (c : Fin s) → Matrix (Fin (m - K c)) (Fin (m - K c)) R)
    (U : (d : Fin s) → Matrix (Fin (K d)) (Fin (K d)) R)
    (hL : ∀ c i j, i < j → L c i j = 0) (hLu : ∀ c i, IsUnit (L c i i))
    (hU : ∀ d i j, i < j → U d i j = 0) (hUu : ∀ d i, IsUnit (U d i i))
    (Φ Φ' : (c d : Fin s) → Matrix (Fin (m - K c)) (Fin (K d)) R)
    (h : ∀ c d, c ≠ d → Φ' c d = L c * Φ c d * U d) :
    IsNet0E e (graphGenK K Φ) → IsNet0E e (graphGenK K Φ') :=
  Proofs.gauge_net e K hK L U hL hLu hU hUu Φ Φ' h

/-- **`lem:box`**, consequence for `s = 3`: block scalings map `(0,m,3)`-nets to `(0,m,3)`-nets. -/
theorem gauge_net3 {R : Type*} [CommRing R] {q m : ℕ} (e : R ≃ Fin q) (K : Fin 3 → ℕ)
    (hK : ∑ c, K c = m) (μ : Fin 3 → Fin 3 → R) (hμ : ∀ c d, c ≠ d → IsUnit (μ c d))
    (Φ Φ' : (c d : Fin 3) → Matrix (Fin (m - K c)) (Fin (K d)) R)
    (h : ∀ c d, c ≠ d → Φ' c d = μ c d • Φ c d) :
    IsNet0E e (graphGenK K Φ) → IsNet0E e (graphGenK K Φ') :=
  Proofs.gauge_net3 e K hK μ hμ Φ Φ' h

/-! ## `lem:hermite` and `lem:Ts` -/

/-- **`lem:hermite`**: `det H = ± ∏_{P < Q} (x_Q - x_P)^(α_P α_Q)`, over any commutative ring. -/
theorem hermite_det {R : Type*} [CommRing R] {n m : ℕ} (x : Fin n → R) (α : Fin n → ℕ)
    (αinf : ℕ) (hm : ∑ P, α P + αinf = m) :
    (hermiteMat m x α αinf).det =
        ∏ Q : Fin n, ∏ P : Fin n, (if P < Q then (x Q - x P) ^ (α P * α Q) else 1) ∨
      (hermiteMat m x α αinf).det =
        -∏ Q : Fin n, ∏ P : Fin n, (if P < Q then (x Q - x P) ^ (α P * α Q) else 1) :=
  Proofs.hermite_det_core x α αinf hm

/-- **`lem:hermite`**, consequence: over a field, `H` is invertible if the points with
`α_P ≥ 1` are pairwise distinct. -/
theorem hermite_ne_zero {K : Type*} [Field K] {n m : ℕ} (x : Fin n → K) (α : Fin n → ℕ)
    (αinf : ℕ) (hm : ∑ P, α P + αinf = m)
    (hx : ∀ P Q, P ≠ Q → 1 ≤ α P → 1 ≤ α Q → x P ≠ x Q) :
    (hermiteMat m x α αinf).det ≠ 0 :=
  Proofs.hermite_ne_zero_core x α αinf hm hx

/-- **`lem:hermite`**, consequence: if two points with `α_P, α_Q ≥ 1` coincide, `H` has two equal
rows (over any commutative ring). -/
theorem hermite_rows {R : Type*} [CommRing R] {n m : ℕ} (x : Fin n → R) (α : Fin n → ℕ)
    (αinf : ℕ) (hm : ∑ P, α P + αinf = m) (P Q : Fin n) (hPQ : P ≠ Q) (hP : 1 ≤ α P)
    (hQ : 1 ≤ α Q) (hx : x P = x Q) :
    ∃ r r' : Fin m, r ≠ r' ∧ hermiteMat m x α αinf r = hermiteMat m x α αinf r' :=
  Proofs.hermite_rows_core x α αinf hm P Q hPQ hP hQ hx

/-- **`lem:Ts`**, value: every box minor of the frame is `± ∏_{c' < c} (a_c - a_c')^(d_c' d_c)`
over the pairs of finite places, over any commutative ring. -/
theorem frame_minor {R : Type*} [CommRing R] {s m : ℕ} (inf : Fin s) (x : Fin s → R)
    (d : Fin s → ℕ) (hd : ∑ c, d c = m) :
    (boxMatrix (frameRead m inf x) d).det = ∏ c : Fin s, ∏ c' : Fin s,
        (if c' < c ∧ c ≠ inf ∧ c' ≠ inf then (x c - x c') ^ (d c' * d c) else 1) ∨
      (boxMatrix (frameRead m inf x) d).det = -∏ c : Fin s, ∏ c' : Fin s,
        (if c' < c ∧ c ≠ inf ∧ c' ≠ inf then (x c - x c') ^ (d c' * d c) else 1) :=
  Proofs.frame_minor_core inf x (d := d) hd

/-- **`lem:Ts`**, net criterion: for `m ≥ 2` and `q` prime to the denominators of the finite
places, the frame (reduced modulo `q`) is a `(0,m,s)`-net over `ℤ/qℤ` iff the finite places are
pairwise distinct modulo every prime factor of `q`. -/
theorem frame_net_iff {s q m : ℕ} (hq : 2 ≤ q) (hm : 2 ≤ m) (inf : Fin s) (a : Fin s → ℚ)
    (hden : ∀ c, c ≠ inf → Nat.Coprime (a c).den q) :
    IsNet0 s q m (digPoint q m (frameRead m inf (fun c => ratRed q (a c)))) ↔
      ∀ p : ℕ, p.Prime → p ∣ q → ∀ c c', c ≠ inf → c' ≠ inf → c ≠ c' →
        ratRed p (a c) ≠ ratRed p (a c') :=
  Proofs.frame_net_iff_core hq hm inf a hden

/-! ## `lem:Tsplit` (box minors of the split frame) -/

/-- **`lem:Tsplit`**, value: the box matrix of the split frame is the Hermite matrix of the `2s`
points with the multiplicities `splitMult`, so its determinant is, up to sign, the confluent
Vandermonde product (any commutative ring, `m = s k`). -/
theorem Tsplit_minor {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R) (d : Fin s → ℕ)
    (hd : ∑ c, d c = s * k) :
    Z3NetF.boxMatrix (splitRead (s * k) k u v) d = hermiteMat (s * k) (splitPts u v) (splitMult k d) 0 ∧
      ((boxMatrix (splitRead (s * k) k u v) d).det = ∏ Q : Fin (2 * s), ∏ P : Fin (2 * s),
          (if P < Q then (splitPts u v Q - splitPts u v P) ^ (splitMult k d P * splitMult k d Q) else 1) ∨
        (boxMatrix (splitRead (s * k) k u v) d).det = -∏ Q : Fin (2 * s), ∏ P : Fin (2 * s),
          (if P < Q then (splitPts u v Q - splitPts u v P) ^ (splitMult k d P * splitMult k d Q) else 1)) :=
  Proofs.Tsplit_minor_core k u v d hd

/-- **`lem:Tsplit`**, net criterion: for `s ≥ 4`, `k ≥ 1` and rational points with denominators
prime to `q`, the split frame (reduced modulo `q`) is a `(0,sk,s)`-net over `ℤ/qℤ` iff the `2s`
points are pairwise distinct modulo every prime factor of `q`. -/
theorem Tsplit_net_iff {s q k : ℕ} (hs : 4 ≤ s) (hk : 1 ≤ k) (hq : 2 ≤ q) (u v : Fin s → ℚ)
    (hden : ∀ c, Nat.Coprime (u c).den q ∧ Nat.Coprime (v c).den q) :
    IsNet0 s q (s * k) (digPoint q (s * k)
        (splitRead (s * k) k (fun c => ratRed q (u c)) (fun c => ratRed q (v c)))) ↔
      ∀ p : ℕ, p.Prime → p ∣ q → Function.Injective (fun P => ratRed p (splitPts u v P)) :=
  Proofs.Tsplit_net_iff_core hs hk hq u v hden

/-- **`lem:Tsplit`**, the parenthetical consequence: distinctness of the `2s` points modulo `p`
needs `p ≥ 2s`. -/
theorem Tsplit_prime_bound {s p : ℕ} (u v : Fin s → ℚ)
    (h : Function.Injective (fun P => ratRed p (splitPts u v P))) (hp : p.Prime) : 2 * s ≤ p :=
  Proofs.Tsplit_prime_bound_core u v h hp

/-! ## The frame of `s` places, `m = s k`: graph form, `lem:Rs`, `prop:Ns` -/

/-- The frame's `(k, …, k)` box is invertible, and `Φ^F` is its graph form: `C^F_c = graphGenK
(k, …, k) Φ^F c · G` (`sec:frames`, before `lem:Rs`). -/
theorem frameGraph_spec {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) :
    IsUnit (boxMatrix (frameRead (s * k) inf x) (fun _ => k)).det ∧
      ∀ c, graphGenK (m := s * k) (fun _ => k) (frameGraph R k inf x) c *
        boxMatrix (frameRead (s * k) inf x) (fun _ => k) = frameRead (s * k) inf x c :=
  Proofs.frameGraph_spec_core k inf x hx

/-- **`lem:Rs`**: for `c ≠ d`, row `0` of `Φ^F_cd` has the generating function `rsGen`:
level `j` carries `[x^(k-1-j)] rsGen`. -/
theorem Rs_row0 {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k)) (hr : (r : ℕ) = 0)
    (j : Fin k) :
    frameGraph R k inf x c d r j = PowerSeries.coeff (k - 1 - (j : ℕ)) (rsGen k inf x c d) :=
  Proofs.Rs_row0_core k inf x hx c d hcd r hr j

/-- **`prop:Ns`**: with `L_c = diag(Q_c^(-k), 1, …, 1)` and `U_d = Toep(uN_d)`, row `0` of
`L_c Φ^F_cd U_d` carries `w_cd y_cd^n` at the `x`-index `n` (level `k-1-n`), for every `k`. -/
theorem Ns_row0 {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k)) (hr : (r : ℕ) = 0)
    (j : Fin k) :
    (Lgauge (s * k - k) (Ring.inverse (Qf inf x c ^ k)) * frameGraph R k inf x c d *
        toep k (uN k inf x d)) r j = wN inf x c d * yN inf x c d ^ (k - 1 - (j : ℕ)) :=
  Proofs.Ns_row0_core k inf x hx c d hcd r hr j

/-! ## Designs, the residual problem, `prop:Gs`, `def:Ns`, `cor:tsk`, `prop:F` -/

/-- **`prop:Gs`**, the coefficients `β_n` exist and are unique (`n ≥ s-1`, every column `d`). -/
theorem Gs_beta {R : Type*} [CommRing R] {s : ℕ} (hs : 2 ≤ s) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur) (d : Fin s) (n : ℕ) :
    ∃! b : Fin (s - 1) → R, ∀ c, c ≠ d →
      lam c * (wN inf x c d * yN inf x c d ^ n) = ∑ i : Fin (s - 1), b i * F i c d :=
  Proofs.Gs_beta_core inf x hs hx F lam Ur hres d n

/-- **`prop:Gs`**, the gauge: `L_c` and `U_d` are lower triangular with unit diagonal (for any
`β`), so they are gauge moves of `lem:box`(c). -/
theorem Gs_gauge {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur) :
    (∀ c i j, i < j → Lmat k inf x lam c i j = 0) ∧ (∀ c i, IsUnit (Lmat k inf x lam c i i)) ∧
      (∀ d i j, i < j → Ugauge k inf x Ur β d i j = 0) ∧
      (∀ d i, IsUnit (Ugauge k inf x Ur β d i i)) :=
  Proofs.Gs_gauge_core k inf x F lam Ur β hx hres

/-- **`prop:Gs`**: row `0` of `L_c Φ^F_cd U_d` equals the design on the `x`-indices `< s-1`
(truncated if `k < s-1`) and vanishes below, every `k ≥ 1`, `c ≠ d`. -/
theorem Gs_row0 {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur)
    (hβ : BetaRel inf x F lam β) (c d : Fin s) (hcd : c ≠ d) (r : Fin (s * k - k))
    (hr : (r : ℕ) = 0) (j : Fin k) :
    (Lmat k inf x lam c * frameGraph R k inf x c d * Ugauge k inf x Ur β d) r j =
      if k - 1 - (j : ℕ) < s - 1 then F (k - 1 - (j : ℕ)) c d else 0 :=
  Proofs.Gs_row0_core k inf x F lam Ur β hx hres hβ c d hcd r hr j

/-- **`cor:tsk`**: every box minor of `𝒫^F_k` over `R` is a unit of `R` (any `β`). -/
theorem tsk_unit {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (inf : Fin s) (x : Fin s → R)
    (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (hres : Residual inf x F lam Ur)
    (d : Fin s → ℕ) (hd : ∑ c, d c = s * k) :
    IsUnit (boxMatrix (PGen k inf x F lam Ur β) d).det :=
  Proofs.tsk_unit_core k inf x hx F lam Ur β hres d hd

/-- **`cor:tsk`**: for every ring homomorphism `ψ : R → ℤ/qℤ` (for `R = ℤ[1/D D']` it exists iff
`gcd(q, D D') = 1`, `away_hom`), the reduction of `𝒫^F_k` is a digital `(0,sk,s)`-net over `ℤ/qℤ`,
every `k ≥ 1` (one point in every cell). -/
theorem tsk_net {R : Type*} [CommRing R] {s q : ℕ} [NeZero q] (ψ : R →+* ZMod q) (k : ℕ)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R)
    (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R)
    (hres : Residual inf x F lam Ur) :
    IsNet0 s q (s * k) (digPoint q (s * k) fun c => (PGen k inf x F lam Ur β c).map ψ) :=
  Proofs.tsk_net_core k inf x ψ hx F lam Ur β hres

/-- `ℤ[1/D] → ℤ/qℤ` exists when `gcd(q, D) = 1` (`def:Ns`). -/
theorem away_hom (q D : ℕ) (h : Nat.Coprime q D) :
    Nonempty (Localization.Away (D : ℤ) →+* ZMod q) :=
  Proofs.away_hom_core q D h

/-- **`prop:F`**, reachability: for `k ≥ s-1`, the off-diagonal part of the design is reachable
from the frame by column gauges `U_d` (lower triangular, unit diagonal) with row scalars
`λ'_c Q_c^(-k)` iff the residual problem is solvable with these `λ'`. -/
theorem F_reach_iff {R : Type*} [CommRing R] {s : ℕ} (hs : 2 ≤ s) (k : ℕ) (hk : s - 1 ≤ k)
    (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x) (F : ℕ → Fin s → Fin s → R)
    (lam : Fin s → R) (hlam : ∀ c, IsUnit (lam c)) :
    (∃ U : Fin s → Matrix (Fin k) (Fin k) R, (∀ d i j, i < j → U d i j = 0) ∧
      (∀ d i, IsUnit (U d i i)) ∧ ∀ c d, c ≠ d → ∀ (r : Fin (s * k - k)), (r : ℕ) = 0 →
        ∀ j : Fin k, (Lmat k inf x lam c * frameGraph R k inf x c d * U d) r j =
          if k - 1 - (j : ℕ) < s - 1 then F (k - 1 - (j : ℕ)) c d else 0) ↔
    ∃ Ur : Fin s → ℕ → ℕ → R, Residual inf x F lam Ur :=
  Proofs.F_reach_iff_core inf x hs k hk hx F lam hlam

/-- **`prop:F`**: the residual problem is solvable with the row scalars `λ'` iff for every column
`d` and every `j ≤ s-2`, `M^(j)[c][d] = λ'_c w_cd g_{d,j}(y_cd)` (`c ≠ d`) for a polynomial
`g_{d,j}` of degree `j` with unit leading coefficient. -/
theorem F_poly_iff {R : Type*} [CommRing R] [Nontrivial R] {s : ℕ} (inf : Fin s) (x : Fin s → R)
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (hlam : ∀ c, IsUnit (lam c)) :
    (∃ Ur : Fin s → ℕ → ℕ → R, Residual inf x F lam Ur) ↔
      ∀ d : Fin s, ∀ j, j < s - 1 → ∃ g : Polynomial R, g.natDegree = j ∧
        IsUnit g.leadingCoeff ∧ ∀ c, c ≠ d →
          Msum F j c d = lam c * wN inf x c d * g.eval (yN inf x c d) :=
  Proofs.F_poly_iff_core inf x F lam hlam

/-- **`prop:F`**, finite `c, d`: `λ'_c w_cd g(y_cd) = λ'_c h(z_cd)` with `z_cd = 1/(a_c - a_d)` and
`h = z g`, of degree `j + 1` without constant term. -/
theorem F_finite {R : Type*} [CommRing R] [Nontrivial R] {s : ℕ} (inf : Fin s) (x : Fin s → R)
    (lam : Fin s → R) (c d : Fin s) (hc : c ≠ inf) (hd : d ≠ inf) (g : Polynomial R) (j : ℕ)
    (hg : g.natDegree = j) (hgu : IsUnit g.leadingCoeff) :
    lam c * wN inf x c d * g.eval (yN inf x c d) =
        lam c * (Polynomial.X * g).eval (Ring.inverse (x c - x d)) ∧
      (Polynomial.X * g).natDegree = j + 1 ∧ (Polynomial.X * g).coeff 0 = 0 :=
  Proofs.F_finite_core inf x lam c d hc hd g j hg hgu

/-! ## `lem:Ss` and `prop:D` -/

/-- **`lem:Ss`**, the coordinate bounds, every `k ≥ 1`. Let a digital net over `ℤ/qℤ` be in graph form
with depths `(k, …, k)` satisfying (H1), (H2), and let the cells of `w` be the toroidal neighbours
`n + e` of those of `v`, with carry lengths `j`. Then `q |Δ_i| ≥ b_i` for every `i`, where
`q^(m-k) Δ_i = e_i q^(m-k) + (X_i(w) mod q^(m-k)) - (X_i(v) mod q^(m-k))` (cell units). -/
theorem Ss_coord {s q k L : ℕ} [NeZero q] (hs : 2 ≤ s) (hq : 3 ≤ q) (hk : 1 ≤ k) (hL : 1 ≤ L) (hLk : L ≤ k)
    (F : ℕ → Fin s → Fin s → ℤ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (h1 : H1 F L Φ) (h2 : H2 Φ) (v w : Fin (s * k) → ZMod q) (e : Fin s → ℤ)
    (he : ∀ d, -1 ≤ e d ∧ e d ≤ 1)
    (hcell : ∀ d, ((digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) w d /
        q ^ (s * k - k) : ℕ) : ℤ) = ((digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) v d /
        q ^ (s * k - k) : ℕ) + e d) % (q ^ k : ℕ))
    (i : Fin s) :
    bval q F L e (fun d => carryLen q k (digPoint q (s * k) (graphGenK (m := s * k)
        (fun _ => k) Φ) v d / q ^ (s * k - k)) (e d)) i * (q ^ (s * k - k) : ℕ) ≤
      (q : ℤ) * |e i * (q ^ (s * k - k) : ℕ) +
        ((digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) w i % q ^ (s * k - k) : ℕ) : ℤ) -
        ((digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) v i % q ^ (s * k - k) : ℕ) : ℤ)| :=
  Proofs.Ss_coord_core s q k Φ F L hs hq hk hL hLk h1 h2 v w e he hcell i

/-- **`lem:Ss`**, the separation, every `k ≥ 1` (at `k = 1` the torus has period `q ≥ 3` cells; the
toroidal case split of the proof): `δ q^k ≥ LB = min(1, min_{e,j} (∑_i b_i²)^(1/2)/q)`, in the
integer form: for every `B ≤ q²` with `B ≤ ∑_i b_i²` for all steps `(e, j)`,
`q^(2(m-k)) B ≤ q² D²` for any two distinct points (`D²` the squared toroidal distance times
`N²`, `N = q^m`, `m = s k`). -/
theorem Ss_sep {s q k L : ℕ} [NeZero q] (hs : 2 ≤ s) (hq : 3 ≤ q) (hk : 1 ≤ k) (hL : 1 ≤ L) (hLk : L ≤ k)
    (F : ℕ → Fin s → Fin s → ℤ) (Φ : Fin s → Fin s → Matrix (Fin (s * k - k)) (Fin k) (ZMod q))
    (h1 : H1 F L Φ) (h2 : H2 Φ) (B : ℤ) (hBq : B ≤ (q : ℤ) ^ 2)
    (hB : ∀ e j, IsConfig k e j → B ≤ ∑ i, bval q F L e j i ^ 2)
    (v w : Fin (s * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (2 * (s * k - k)) * B ≤ (q : ℤ) ^ 2 *
      (torusDist2 (q ^ (s * k)) (digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) v)
        (digPoint q (s * k) (graphGenK (m := s * k) (fun _ => k) Φ) w) : ℤ) :=
  Proofs.Ss_sep_core s q k Φ F L hs hq hk hL hLk h1 h2 B hBq hB v w hvw

/-- **`prop:D`**: for a design whose diagonal vanishes below level `k-1`, with `F_0[c][c] = -α_c`
and `α_c ≥ ∑_{d ≠ c} max_{j ≤ s-2} |M^(j)[c][d]|`, `α_c ≤ a`: `LB ≥ 1 - a/q` for `q ≥ 5a+4`, i.e.
`B = (q - a)²` bounds `q²` and every `∑_i b_i²` (any `1 ≤ L ≤ s-1` levels, `k ≥ L`). -/
theorem D_LB {s q k L a : ℕ} (hL : 1 ≤ L) (hLs : L ≤ s - 1) (F : ℕ → Fin s → Fin s → ℤ)
    (α : Fin s → ℕ) (h0 : ∀ c, F 0 c c = -(α c : ℤ)) (hdiag : ∀ n c, 1 ≤ n → F n c c = 0)
    (hdom : ∀ c, ∑ d ∈ univ.filter (fun d => d ≠ c),
      (range (s - 1)).sup (fun j => (Msum F j c d).natAbs) ≤ α c)
    (ha : ∀ c, α c ≤ a) (hq : 5 * a + 4 ≤ q) :
    ((q : ℤ) - a) ^ 2 ≤ (q : ℤ) ^ 2 ∧
      ∀ e j, IsConfig k e j → ((q : ℤ) - a) ^ 2 ≤ ∑ i, bval q F L e j i ^ 2 :=
  Proofs.D_LB_core F L α a hL hLs h0 hdiag hdom ha q k hq

/-- **`prop:D`** applied to `𝒫^F_{k,q}` (the step of `thm:U`, for an arbitrary dominant reachable
design with integer entries): for `q ≥ 5a+4`, every `k ≥ 1` and distinct indices,
`q^(2(sk-k)) (q - a)² ≤ q² D²`, i.e. `δ ≥ (1 - a/q) N^(-1/s)`. -/
theorem D_sep {R : Type*} [CommRing R] {s q a : ℕ} [NeZero q] (hs : 2 ≤ s) (ψ : R →+* ZMod q)
    (k : ℕ) (hk : 1 ≤ k) (inf : Fin s) (x : Fin s → R) (hx : PlacesOK inf x)
    (F : ℕ → Fin s → Fin s → ℤ) (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R)
    (β : Fin s → ℕ → ℕ → R) (hres : Residual inf x (fun n c d => (F n c d : R)) lam Ur)
    (hβ : BetaRel inf x (fun n c d => (F n c d : R)) lam β)
    (α : Fin s → ℕ) (h0 : ∀ c, F 0 c c = -(α c : ℤ)) (hdiag : ∀ n c, 1 ≤ n → F n c c = 0)
    (hdom : ∀ c, ∑ d ∈ univ.filter (fun d => d ≠ c),
      (range (s - 1)).sup (fun j => (Msum F j c d).natAbs) ≤ α c)
    (ha : ∀ c, α c ≤ a) (hq : 5 * a + 4 ≤ q) (v w : Fin (s * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (2 * (s * k - k)) * ((q : ℤ) - a) ^ 2 ≤ (q : ℤ) ^ 2 *
      (torusDist2 (q ^ (s * k))
        (digPoint q (s * k) (fun c => (PGen k inf x (fun n c d => (F n c d : R)) lam Ur β c).map ψ) v)
        (digPoint q (s * k) (fun c => (PGen k inf x (fun n c d => (F n c d : R)) lam Ur β c).map ψ) w) : ℤ) :=
  Proofs.D_sep_core hs ψ k hk inf x hx F lam Ur β hres hβ α h0 hdiag hdom ha hq v w hvw

/-! ## `rem:K`: the first-order expansion of the relaxation (stage 6) -/

/-- **`rem:K`**, the degenerate case: if some own partial sum `M^(j)[a][a]` (`j < L`) is positive,
or some multi-axis step has no backward coordinate, then `LB = O(1/q)`. -/
theorem remK_bad {s L k : ℕ} (hL : 1 ≤ L) (hLk : L ≤ k) (F : ℕ → Fin s → Fin s → ℤ)
    (hbad : (∃ a, ∃ j < L, 0 < Msum F j a a) ∨
      ∃ e j, IsConfig k e j ∧ 2 ≤ (moving e).card ∧ ∀ i, e i ≠ 0 → 0 < e i * sigma F L e j i) :
    ∃ C : ℝ, ∀ q : ℕ, 1 ≤ q → LBval q F L k ≤ C / q :=
  Proofs.RemK.remK_bad_core hL hLk F hbad

/-- **`rem:K`**, the first-order expansion: otherwise (every own partial sum is `≤ 0` and every
multi-axis step has a backward coordinate) `LB = 1 - K/q + O(q⁻²)`, with `K = Kexp F L k`. -/
theorem remK_good {s L k : ℕ} (hs : 1 ≤ s) (hL : 1 ≤ L) (hLk : L ≤ k) (F : ℕ → Fin s → Fin s → ℤ)
    (hown : ∀ a, ∀ j < L, Msum F j a a ≤ 0)
    (hmulti : ∀ e j, IsConfig k e j → 2 ≤ (moving e).card → ∃ i, e i ≠ 0 ∧ e i * sigma F L e j i ≤ 0) :
    ∃ C : ℝ, ∃ q₀ : ℕ, ∀ q : ℕ, q₀ ≤ q →
      1 - (Kexp F L k : ℝ) / q ≤ LBval q F L k ∧
        LBval q F L k ≤ 1 - (Kexp F L k : ℝ) / q + C / (q : ℝ) ^ 2 :=
  Proofs.RemK.remK_good_core hs hL hLk F hown hmulti

/-! ## `prop:4DK2`: dimension four, deficit two (stage 6)

The design `A♯` of `app:designs` for the places `(0, -1, ∞, 1)` (in this coordinate order; the
place `∞` has index `2`, its entry of `xAs` is not used), with the residual solution `(λ', U')`
printed there, over `ℤ[1/10] = Localization.Away 10`. -/

/-- **`prop:4DK2`**, the data: the places are admissible over `ℤ[1/10]` and `(λ', U')` solves the
residual problem of `A♯` (the `36` identities of `app:designs`). -/
theorem As_residual :
    PlacesOK (2 : Fin 4) (fun c => (xAs c : Localization.Away (10 : ℤ))) ∧
      Residual (2 : Fin 4) (fun c => (xAs c : Localization.Away (10 : ℤ)))
        (fun n c d => (FAs n c d : Localization.Away (10 : ℤ)))
        (fun c => (lamAs c : Localization.Away (10 : ℤ)))
        (fun d n' n => (UrAs d n' n : Localization.Away (10 : ℤ))) :=
  Proofs.As.As_residual_core

/-- **`prop:4DK2` (1)**: every box minor of `𝒫^{A♯}_k` is a unit of `ℤ[1/10]` (i.e. `±2^i 5^j`),
every `k`, any `β`. -/
theorem As_unit (k : ℕ) (β : Fin 4 → ℕ → ℕ → Localization.Away (10 : ℤ)) (d : Fin 4 → ℕ)
    (hd : ∑ c, d c = 4 * k) : IsUnit (boxMatrix (PAs k β) d).det :=
  Proofs.As.As_unit_core k β d hd

/-- **`prop:4DK2` (1)**: for every ring homomorphism `ψ : ℤ[1/10] → ℤ/qℤ` (it exists iff
`gcd(q, 10) = 1`, `away_hom`), `𝒫^{A♯}_{k,q}` is a digital `(0,4k,4)`-net over `ℤ/qℤ` (one point in
every cell), every `k`. -/
theorem As_net {q : ℕ} [NeZero q] (ψ : Localization.Away (10 : ℤ) →+* ZMod q) (k : ℕ)
    (β : Fin 4 → ℕ → ℕ → Localization.Away (10 : ℤ)) :
    IsNet0 4 q (4 * k) (digPoint q (4 * k) fun c => (PAs k β c).map ψ) :=
  Proofs.As.As_net_core ψ k β

/-- **`prop:4DK2` (2)**, integer form: for `k ≥ 2` and `q ≥ 7` (`gcd(q, 10) = 1`, forced by `ψ`),
with the coefficients `β` of `prop:Gs`, distinct points satisfy
`q^(2(4k-k)) q² c♯(q)² ≤ q² D²` (`D²` the squared toroidal distance at integer scale `N = q^(4k)`),
i.e. `δ ≥ c♯(q) N^(-1/4)` with `c♯(q) = min(q-2, √2 (q-8))/q` (`q ≥ 9`), `c♯(7) = 2/7`. -/
theorem As_sep {q : ℕ} [NeZero q] (ψ : Localization.Away (10 : ℤ) →+* ZMod q) (hq : 7 ≤ q) (k : ℕ)
    (hk : 2 ≤ k) (β : Fin 4 → ℕ → ℕ → Localization.Away (10 : ℤ))
    (hβ : BetaRel (2 : Fin 4) (fun c => (xAs c : Localization.Away (10 : ℤ)))
      (fun n c d => (FAs n c d : Localization.Away (10 : ℤ)))
      (fun c => (lamAs c : Localization.Away (10 : ℤ))) β)
    (v w : Fin (4 * k) → ZMod q) (hvw : v ≠ w) :
    (q : ℤ) ^ (2 * (4 * k - k)) * BAs q ≤ (q : ℤ) ^ 2 *
      (torusDist2 (q ^ (4 * k)) (digPoint q (4 * k) (fun c => (PAs k β c).map ψ) v)
        (digPoint q (4 * k) (fun c => (PAs k β c).map ψ) w) : ℤ) :=
  Proofs.As.As_sep_core ψ hq k hk β hβ v w hvw

