/-! ## Lemma L2_s -/

/-- **Lemma L2_s, lower bound.** If `ρ^s < p` (`s ≥ 1`), every nonzero
`a = (x_1, …, x_(s-1), z) ∈ ℤ^s` with `z ≡ ∑_i ρ^i x_i (mod p)` has `‖a‖∞ ≥ ρ`
(here `x i` is `x_(i+1)`). -/
theorem L2s_min (s p ρ : ℕ) (hs : 1 ≤ s) (hρp : ρ ^ s < p) (x : Fin (s - 1) → ℤ) (z : ℤ)
    (hdiv : (p : ℤ) ∣ z - ∑ i : Fin (s - 1), (ρ : ℤ) ^ ((i : ℕ) + 1) * x i) (hne : ¬(x = 0 ∧ z = 0)) :
    (ρ : ℤ) ≤ |z| ∨ ∃ i : Fin (s - 1), (ρ : ℤ) ≤ |x i| :=
  Proofs.L2s_min s p ρ hs hρp x z hdiv hne

/-- **Lemma L2_s, attained.** `(1, 0, …, 0, ρ)` is a nonzero lattice vector of sup-norm `ρ`
(`s ≥ 2`, `ρ ≥ 1`), so `λ∞(Λ) = ρ` exactly when `ρ^s < p`. -/
theorem L2s_attained (s p ρ : ℕ) (hs : 2 ≤ s) (hρ : 1 ≤ ρ) :
    ∃ x : Fin (s - 1) → ℤ, ∃ z : ℤ,
      (p : ℤ) ∣ z - ∑ i : Fin (s - 1), (ρ : ℤ) ^ ((i : ℕ) + 1) * x i ∧
      ¬(x = 0 ∧ z = 0) ∧ |z| ≤ ρ ∧ ∀ i : Fin (s - 1), |x i| ≤ ρ :=
  Proofs.L2s_attained s p ρ hs hρ

/-! ## Theorem S1 -/

/-- **Theorem S1, net part.** For every `s ≥ 3`, prime `p`, `ρ ≥ 2` with `ρ^s < p` and every
`k ≥ 0` there is a digital `(0, sk+s-1, s)`-net over `𝔽_p` in graph form with the S1 skeleton
row. -/
theorem S1_net (s p k ρ : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hρ : 2 ≤ ρ) (hρp : ρ ^ s < p) :
    ∃ C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p),
      IsS1skel s p k ρ C ∧ IsNet0 s p (s * k + (s - 1)) (digPoint p (s * k + (s - 1)) C) :=
  Proofs.S1_net s p k ρ hs hp hρ hρp

/-- **Theorem S1, separation (integer form).** Same hypotheses; every net `C` with the S1
skeleton row and distinct indices `v ≠ w`, with `N = p^m`, `m = sk + s - 1`:
`(ρ - 1)² p^(2((s-1)(k+1) - 1)) ≤ N² δ²`, i.e. `δ ≥ (ρ - 1) p^(-(k+1))`. -/
theorem S1_sep (s p k ρ : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hρ : 2 ≤ ρ) (hρp : ρ ^ s < p)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (hC : IsS1skel s p k ρ C) (v w : Fin (s * k + (s - 1)) → ZMod p) (hvw : v ≠ w) :
    (ρ - 1) ^ 2 * p ^ (2 * ((s - 1) * (k + 1) - 1)) ≤
      torusDist2 (p ^ (s * k + (s - 1))) (digPoint p (s * k + (s - 1)) C v)
        (digPoint p (s * k + (s - 1)) C w) :=
  Proofs.S1_sep s p k ρ hs hp hρ hρp C hC v w hvw

/-- **Theorem S1, separation (real form).** The toroidal distance between any two distinct points
(points `X / N` in `[0,1)^s`, `N = p^m`) is at least `(ρ - 1) p^(-1/s) · N^(-1/s)`. -/
theorem S1_sep_real (s p k ρ : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hρ : 2 ≤ ρ) (hρp : ρ ^ s < p)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (hC : IsS1skel s p k ρ C) (v w : Fin (s * k + (s - 1)) → ZMod p) (hvw : v ≠ w) :
    ((ρ : ℝ) - 1) * (p : ℝ) ^ (-(1 / (s : ℝ))) * ((p : ℝ) ^ (s * k + (s - 1))) ^ (-(1 / (s : ℝ)))
      ≤ Real.sqrt (∑ c, ((cres (p ^ (s * k + (s - 1)))
          ((digPoint p (s * k + (s - 1)) C v c : ℤ) - (digPoint p (s * k + (s - 1)) C w c : ℤ)) : ℝ)
          / (p : ℝ) ^ (s * k + (s - 1))) ^ 2) :=
  Proofs.S1_sep_real s p k ρ hs hp hρ hρp C hC v w hvw

/-- **Constants.** For `s ≥ 2` and every prime `p > 2^s`, `ρ = ρ_s(p)` satisfies `ρ ≥ 2`,
`ρ^s < p < (ρ+1)^s`, and the S1 constant `(ρ - 1) p^(-1/s)` exceeds `(ρ - 1)/(ρ + 1) ≥ 1/3`;
for `p > 3^s` moreover `(ρ - 1)/(ρ + 1) ≥ 1/2`. -/
theorem S1_const (s p : ℕ) (hs : 2 ≤ s) (hp : p.Prime) (hps : 2 ^ s < p) :
    2 ≤ rhoS s p ∧ rhoS s p ^ s < p ∧ p < (rhoS s p + 1) ^ s ∧
      ((rhoS s p : ℝ) - 1) / ((rhoS s p : ℝ) + 1) < ((rhoS s p : ℝ) - 1) * (p : ℝ) ^ (-(1 / (s : ℝ))) ∧
      (1 : ℝ) / 3 ≤ ((rhoS s p : ℝ) - 1) / ((rhoS s p : ℝ) + 1) ∧
      (3 ^ s < p → (1 : ℝ) / 2 ≤ ((rhoS s p : ℝ) - 1) / ((rhoS s p : ℝ) + 1)) :=
  Proofs.S1_const s p hs hp hps

/-- **Theorem S1 (headline).** For every `s ≥ 3`, every prime `p > 2^s` and every `k ≥ 0` there is
a digital `(0, sk+s-1, s)`-net over `𝔽_p` with the S1 skeleton row (`ρ = ρ_s(p)`) in which any two
distinct points have toroidal distance greater than `N^(-1/s) / 3` (`N = p^(sk+s-1)`). -/
theorem S1_main (s p k : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hps : 2 ^ s < p) :
    ∃ C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p),
      IsS1skel s p k (rhoS s p) C ∧ IsNet0 s p (s * k + (s - 1)) (digPoint p (s * k + (s - 1)) C) ∧
      ∀ v w : Fin (s * k + (s - 1)) → ZMod p, v ≠ w →
        (1 : ℝ) / 3 * ((p : ℝ) ^ (s * k + (s - 1))) ^ (-(1 / (s : ℝ)))
          < Real.sqrt (∑ c, ((cres (p ^ (s * k + (s - 1)))
              ((digPoint p (s * k + (s - 1)) C v c : ℤ) - (digPoint p (s * k + (s - 1)) C w c : ℤ)) : ℝ)
              / (p : ℝ) ^ (s * k + (s - 1))) ^ 2) :=
  Proofs.S1_main s p k hs hp hps

/-! ## Theorem `thm:S1`: the explicit net, parts (1)–(3) -/

/-- **Theorem `thm:S1`, net sentence, for the explicit net of Definition `def:S1`.** For every
`s ≥ 3`, prime `p`, `ρ ≥ 2` with `ρ^s < p` and every `k ≥ 0`, the net `𝒮¹_{k,p,ρ}` (`S1gen`) has the
S1 skeleton digit `S_z = ∑_{d=1}^{s-1} ρ^d x_{d,k}` (all other entries of that row `0`) and is a
digital `(0, sk+s-1, s)`-net over `𝔽_p`. -/
theorem S1gen_net (s p k ρ : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hρ : 2 ≤ ρ) (hρp : ρ ^ s < p) :
    IsS1skel s p k ρ (S1gen s p k ρ) ∧
      IsNet0 s p (s * k + (s - 1)) (digPoint p (s * k + (s - 1)) (S1gen s p k ρ)) :=
  Proofs.S1gen_net s p k ρ hs hp hρ hρp

/-- **Theorem `thm:S1`(1), the limit.** The constant `(ρ - 1) p^(-1/s)` with `ρ = ρ_s(p)`
(`= ⌊p^(1/s)⌋` for prime `p`) tends to `1` as `p → ∞` (`s ≥ 2`). -/
theorem S1_const_tendsto (s : ℕ) (hs : 2 ≤ s) :
    Filter.Tendsto (fun p : ℕ => ((rhoS s p : ℝ) - 1) * (p : ℝ) ^ (-(1 / (s : ℝ))))
      Filter.atTop (nhds 1) :=
  Proofs.S1_const_tendsto s hs

/-- **Theorem `thm:S1`(2), lattice reading.** For every net in graph form with the S1 skeleton
row (`s ≥ 2`, `p` prime, any `ρ`, every `k`), the fine positions `P(v)` of all points lie in the
lattice `Λ` (`S1lat`), and conversely every `a ∈ Λ ∩ [0, p^(k+1))^s` is the fine position of exactly
one point: the occupied fine cells are exactly the cells of `Λ`. -/
theorem S1_cells (s p k ρ : ℕ) (hs : 2 ≤ s) (hp : p.Prime)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (hC : IsS1skel s p k ρ C) :
    (∀ v, (fun c => (finePos s p k C v c : ℤ)) ∈ S1lat s p ρ) ∧
      ∀ a : Fin s → ℕ, (∀ c, a c < p ^ (k + 1)) → (fun c => (a c : ℤ)) ∈ S1lat s p ρ →
        ∃! v, ∀ c, finePos s p k C v c = a c :=
  Proofs.S1_cells s p k ρ hs hp C hC

/-- **`Λ` has index `p`** in `ℤ^s` (`s ≥ 1`). -/
theorem S1lat_index (s p ρ : ℕ) (hs : 1 ≤ s) : (S1lat s p ρ).index = p :=
  Proofs.S1lat_index s p ρ hs

/-- **Theorem `thm:S1`(2), the minimum of `Λ`** (Lemma `lem:skellat`(L) in subgroup form): if
`ρ ≥ 1`, `ρ^s < p` and `s ≥ 2`, every nonzero `a ∈ Λ` has `‖a‖∞ ≥ ρ`, and some nonzero `a ∈ Λ` has
`‖a‖∞ ≤ ρ`; so `λ∞(Λ) = ρ`. -/
theorem S1lat_min (s p ρ : ℕ) (hs : 2 ≤ s) (hρ : 1 ≤ ρ) (hρp : ρ ^ s < p) :
    (∀ a ∈ S1lat s p ρ, a ≠ 0 → ∃ c, (ρ : ℤ) ≤ |a c|) ∧
      ∃ a ∈ S1lat s p ρ, a ≠ 0 ∧ ∀ c, |a c| ≤ ρ :=
  Proofs.S1lat_min s p ρ hs hρ hρp

/-- **Theorem `thm:S1`(2), optimality** (Lemma `lem:skellat`(L), pigeonhole). Every lattice
`L ⊆ ℤ^s` of index `p` (a subgroup of `ℤ^s` with `[ℤ^s : L] = p`; `p` prime, `s ≥ 2`) has a nonzero
vector of sup-norm at most `ρ_s(p) = ⌊p^(1/s)⌋`; so `λ∞(Λ) = ρ_s(p)` is the largest minimum of any
lattice of index `p`. -/
theorem S1_opt (s p : ℕ) (hs : 2 ≤ s) (hp : p.Prime) (L : AddSubgroup (Fin s → ℤ))
    (hL : L.index = p) : ∃ a ∈ L, a ≠ 0 ∧ ∀ c, |a c| ≤ rhoS s p :=
  Proofs.S1_opt s p hs hp L hL

/-- **Theorem `thm:S1`(3), `μ`.** For `s ≥ 3` and every prime `p > 2^s`, with `ρ = ρ_s(p)` and
`μ = ⌈p/ρ^(s-1)⌉`: `ρ - 1 ≤ μ`, `μ < ρ (1 + 1/ρ)^s + 1`, and the bounds of (3) are uniform in `p`:
`(μ + 1) p^(-1/s) ≤ (3/2)^s + 1` and `(μ + 1)/(ρ - 1) ≤ 2 (3/2)^s + 2`. -/
theorem S1_mu (s p : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hps : 2 ^ s < p) :
    rhoS s p - 1 ≤ muS s p (rhoS s p) ∧
      (muS s p (rhoS s p) : ℝ) < (rhoS s p : ℝ) * (1 + 1 / (rhoS s p : ℝ)) ^ s + 1 ∧
      ((muS s p (rhoS s p) : ℝ) + 1) * (p : ℝ) ^ (-(1 / (s : ℝ))) ≤ (3 / 2 : ℝ) ^ s + 1 ∧
      ((muS s p (rhoS s p) : ℝ) + 1) / ((rhoS s p : ℝ) - 1) ≤ 2 * (3 / 2 : ℝ) ^ s + 2 :=
  Proofs.S1_mu s p hs hp hps

/-- **Theorem `thm:S1`(3), covering.** For `s ≥ 3`, every prime `p > 2^s`, `ρ = ρ_s(p)`,
`μ = ⌈p/ρ^(s-1)⌉`, every `k ≥ 0` and every net with the S1 skeleton row: every `y ∈ [0,1)^s` is at
Euclidean distance less than `√s (μ + 1) p^(-1/s) N^(-1/s)` from a point `X_v / N` of the net
(`N = p^(sk+s-1)`); i.e. `h N^(1/s) ≤ √s (μ + 1) p^(-1/s)`. -/
theorem S1_cover (s p k : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hps : 2 ^ s < p)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (hC : IsS1skel s p k (rhoS s p) C) (y : Fin s → ℝ) (hy : ∀ c, 0 ≤ y c ∧ y c < 1) :
    ∃ v, Real.sqrt (∑ c, (y c - (digPoint p (s * k + (s - 1)) C v c : ℝ) / (p : ℝ) ^ (s * k + (s - 1))) ^ 2)
      < Real.sqrt s * ((muS s p (rhoS s p) : ℝ) + 1) * (p : ℝ) ^ (-(1 / (s : ℝ))) *
          ((p : ℝ) ^ (s * k + (s - 1))) ^ (-(1 / (s : ℝ))) :=
  Proofs.S1_cover s p k hs hp hps C hC y hy

/-- **Theorem `thm:S1`(3), mesh ratio.** Same hypotheses: every `y ∈ [0,1)^s` has a net point
`X_v / N` with `(ρ - 1) |y - X_v/N| ≤ √s (μ + 1) δ_T(w, w')` for all distinct indices `w ≠ w'`
(`δ_T` the toroidal distance, which is at most the Euclidean one); i.e.
`h / δ ≤ √s (μ + 1)/(ρ - 1)`. -/
theorem S1_mesh (s p k : ℕ) (hs : 3 ≤ s) (hp : p.Prime) (hps : 2 ^ s < p)
    (C : Fin s → Matrix (Fin (s * k + (s - 1))) (Fin (s * k + (s - 1))) (ZMod p))
    (hC : IsS1skel s p k (rhoS s p) C) (y : Fin s → ℝ) (hy : ∀ c, 0 ≤ y c ∧ y c < 1) :
    ∃ v, ∀ w w' : Fin (s * k + (s - 1)) → ZMod p, w ≠ w' →
      ((rhoS s p : ℝ) - 1) *
          Real.sqrt (∑ c, (y c - (digPoint p (s * k + (s - 1)) C v c : ℝ) / (p : ℝ) ^ (s * k + (s - 1))) ^ 2)
        ≤ Real.sqrt s * ((muS s p (rhoS s p) : ℝ) + 1) *
          Real.sqrt (∑ c, ((cres (p ^ (s * k + (s - 1)))
            ((digPoint p (s * k + (s - 1)) C w c : ℤ) - (digPoint p (s * k + (s - 1)) C w' c : ℤ)) : ℝ)
            / (p : ℝ) ^ (s * k + (s - 1))) ^ 2) :=
  Proofs.S1_mesh s p k hs hp hps C hC y hy

/-- **Theorem `thm:S1`(3), the limit of the mesh-ratio bound**: `√s (μ + 1)/(ρ - 1) → √s` as
`p → ∞` (`ρ = ρ_s(p)`, `μ = ⌈p/ρ^(s-1)⌉`, `s ≥ 2`), i.e. `h/δ ≤ √s (1 + o(1))`. -/
theorem S1_mesh_tendsto (s : ℕ) (hs : 2 ≤ s) :
    Filter.Tendsto (fun p : ℕ => Real.sqrt s * ((muS s p (rhoS s p) : ℝ) + 1) / ((rhoS s p : ℝ) - 1))
      Filter.atTop (nhds (Real.sqrt s)) :=
  Proofs.S1_mesh_tendsto s hs

