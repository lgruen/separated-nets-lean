/-- The full coordinate `x_{d+1}` (`d : Fin 2`) is coordinate `d`. -/
def s5x (d : Fin 2) : Fin 5 := d.castSucc.castSucc.castSucc

/-- The skeleton coordinate `z_{i+1}` (`i : Fin 3`) is coordinate `i + 2`. -/
def s5z (i : Fin 3) : Fin 5 := i.succ.succ

/-- A per-prime design of `prop:s5r2` (`s = 5`, `m = 5k + 2`, `r = 2`, `ℓ = 3`): the full coordinates
`x_1, x_2` are the coordinates `0, 1` (depth `k + 1`), the skeleton coordinates `z_1, z_2, z_3` the
coordinates `2, 3, 4` (depth `k`); `pl` are the (finite) places of the paper in this order. The
skeleton digit of `z_{i+1}` (`i : Fin 3`) is
`S_{z_i} = ∑_d (κ_id x_{d,k} + β_id x_{d,k-1} + η_id x_{d,k-2}) + ∑_{j ≠ i} (g_ij z_{j,k-1} + H_ij z_{j,k-2}) + o_i z_{i,k-1}`
(the diagonal entries of `g` and `H` are not used). `M`, `J2` are the certified minima `M_p`, `J_p²` of
`tab:s5r2`, `lat` the lattice minimum `λ_∞(Λ_κ)`, `pig` the pigeonhole bound `⌊p^(3/5)⌋`, and `tabM`,
`tabJ` the printed (truncated) values of `(M_p - 1) p^(-3/5)` and `J_p p^(-3/5)` in thousandths. -/
structure S5Design where
  p : ℕ
  pl : Fin 5 → ℕ
  κ : Fin 3 → Fin 2 → ℤ
  β : Fin 3 → Fin 2 → ℤ
  η : Fin 3 → Fin 2 → ℤ
  g : Fin 3 → Fin 3 → ℤ
  H : Fin 3 → Fin 3 → ℤ
  o : Fin 3 → ℤ
  M : ℕ
  J2 : ℕ
  lat : ℕ
  pig : ℕ
  tabM : ℕ
  tabJ : ℕ

