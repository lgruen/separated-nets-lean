/-- The places of the frame used for the reachability: the image of the paper's places under the
Möbius map `t ↦ 1/(t - b_1)`, `b_1` the place of `x_1`, which sends `b_1` to `∞` (coordinate `0`, its
entry `0⁻¹ = 0` is unused) and every other place `a` to `1/(a - b_1)`. -/
def s5Places (D : S5Design) : Fin 5 → ZMod D.p :=
  fun c => ((D.pl c : ZMod D.p) - (D.pl 0 : ZMod D.p))⁻¹

/-- Coefficient of the skeleton digit `S_{z_i}` on level `l` of the full coordinate `x_d` (depth
`k + 1`; levels `k, k-1, k-2` carry `κ_id, β_id, η_id`). -/
def s5xCoef (D : S5Design) (k : ℕ) (i : Fin 3) (d : Fin 2) (l : ℕ) : ℤ :=
  if l = k then D.κ i d else if l + 1 = k then D.β i d else if l + 2 = k then D.η i d else 0

/-- Coefficient of `S_{z_i}` on level `l` of the skeleton coordinate `z_j` (depth `k`): `o_i` on
`z_{i,k-1}`; for `j ≠ i`, `g_ij` on `z_{j,k-1}` and `H_ij` on `z_{j,k-2}`. -/
def s5zCoef (D : S5Design) (k : ℕ) (i j : Fin 3) (l : ℕ) : ℤ :=
  if i = j then (if l + 1 = k then D.o i else 0)
  else if l + 1 = k then D.g i j else if l + 2 = k then D.H i j else 0

/-- `C` is in graph form with the depths `(k+1, k+1, k, k, k)` (`IsSkGF` with `r = 2`) and its
skeleton digits (row `k` of `C z_i`) are those of `D`: every coefficient is `s5xCoef` resp. `s5zCoef`. -/
def IsS5skel (D : S5Design) (k : ℕ)
    (C : Fin 5 → Matrix (Fin (5 * k + 2)) (Fin (5 * k + 2)) (ZMod D.p)) : Prop :=
  IsSkGF 5 2 D.p k C ∧
    (∀ (i : Fin 3) (d : Fin 2) (l : ℕ), l < k + 1 →
      ent (C (s5z i)) k (skOff 2 k (d : ℕ) + l) = ((s5xCoef D k i d l : ℤ) : ZMod D.p)) ∧
    ∀ (i j : Fin 3) (l : ℕ), l < k →
      ent (C (s5z i)) k (skOff 2 k ((s5z j : Fin 5) : ℕ) + l) = ((s5zCoef D k i j l : ℤ) : ZMod D.p)

/-- `|a|_∞` of `a ∈ ℤ⁵`. -/
def s5MaxAbs (a : Fin 5 → ℤ) : ℤ := max (max (max |a 0| |a 1|) (max |a 2| |a 3|)) |a 4|

/-- The relaxation of the proof of `prop:s5r2` ("Separation"): a centred fine difference `a ∈ ℤ⁵`
with `|a|_∞ < p/2`, floor changes `ξ1 = ξ_{·,1}`, `ξ2 = ξ_{·,2}` with sign-consistent prefix
patterns `(ξ1_c, ξ2_c) ∈ {(0,0), (σ_c,0), (σ_c,σ_c)}`, `σ_c = sgn a_c`, and
`a_{z_i} ≡ ∑_d (κ_id a_{x_d} + β_id ξ1_{x_d} + η_id ξ2_{x_d}) + ∑_{j ≠ i} (g_ij ξ1_{z_j} + H_ij ξ2_{z_j}) + o_i ξ1_{z_i} (mod p)`. -/
def S5Rel (D : S5Design) (a ξ1 ξ2 : Fin 5 → ℤ) : Prop :=
  (∀ c, 2 * |a c| < D.p) ∧
    (∀ c, (ξ1 c = 0 ∨ ξ1 c = Int.sign (a c)) ∧ (ξ2 c = 0 ∨ ξ2 c = Int.sign (a c)) ∧
      (ξ2 c ≠ 0 → ξ1 c ≠ 0)) ∧
    ∀ i : Fin 3, (D.p : ℤ) ∣ a (s5z i) - (∑ d : Fin 2, (D.κ i d * a (s5x d) + D.β i d * ξ1 (s5x d) +
      D.η i d * ξ2 (s5x d)) + ∑ j : Fin 3, (if j = i then D.o i * ξ1 (s5z j)
        else D.g i j * ξ1 (s5z j) + D.H i j * ξ2 (s5z j)))

