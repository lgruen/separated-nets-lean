/-
Development copy (Solution side) of the new definitions of ChallengeSplit (entry Split).
Generated by `scripts/sync_splitdefs.py`; keep in sync with `ChallengeSplit.lean`. The definitions
that ChallengeSplit repeats from ChallengeF are those of `Z3Net/FDefs.lean`.
-/
module
public import Z3Net.FDefs

@[expose] public section

namespace Z3NetF

open Matrix Finset

/-! ## New definitions (entry Split) -/

/-- The `2s` points of the split frame have unit pairwise differences (`def:split`: distinct
rationals in `ℤ[1/D]`). -/
def SplitOK {R : Type*} [CommRing R] {s : ℕ} (u v : Fin s → R) : Prop :=
  ∀ P Q : Fin (2 * s), P ≠ Q → IsUnit (splitPts u v P - splitPts u v Q)

/-- The graph form `Φ^S` of the split frame (depths `(k, …, k)`): `Φ^S_cd[r, l]` is entry
`(k + r, d k + l)` of `C^S_c G⁻¹`, `G` the `(k, …, k)` box matrix of the split frame. -/
noncomputable def splitGraph (R : Type*) [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (c d : Fin s) : Matrix (Fin (s * k - k)) (Fin k) R :=
  fun r l => (splitRead (s * k) k u v c * (boxMatrix (splitRead (s * k) k u v) (fun _ => k))⁻¹)
    ⟨k + (r : ℕ), Nat.add_lt_of_lt_sub' r.isLt⟩
    ⟨(d : ℕ) * k + (l : ℕ), Nat.lt_of_lt_of_le (Nat.add_lt_add_left l.isLt ((d : ℕ) * k))
      ((Nat.succ_mul (d : ℕ) k).symm.trans_le (Nat.mul_le_mul_right k d.isLt))⟩

/-- `P_c = ∏_d (u_c - v_d) = ∏_d ϑ_cd` (`def:split`). -/
def Psplit {R : Type*} [CommRing R] {s : ℕ} (u v : Fin s → R) (c : Fin s) : R :=
  ∏ d, (u c - v d)

/-- The column gauge series `Π_d(v_d + x) = ∏_{b ≠ d} (v_d - v_b + x)^k`. -/
noncomputable def piSplit {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (v : Fin s → R) (d : Fin s) :
    Polynomial R :=
  ∏ b ∈ univ.filter (fun b => b ≠ d), (Polynomial.C (v d - v b) + Polynomial.X) ^ k

/-- The generating function of `lem:Rsplit`: `P_c^k / (Π_d(v_d + x) (ϑ_cd - x))`. -/
noncomputable def rsSplit {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (c d : Fin s) : PowerSeries R :=
  PowerSeries.C (Psplit u v c ^ k) * Ring.inverse ((piSplit k v d : PowerSeries R) *
    (PowerSeries.C (u c - v d) - PowerSeries.X))

/-- `w_cd = y_cd = 1/(u_c - v_d)` of `prop:Gsplit`. -/
noncomputable def ySplit {R : Type*} [CommRing R] {s : ℕ} (u v : Fin s → R) (c d : Fin s) : R :=
  Ring.inverse (u c - v d)

/-- The residual problem on the split frame: units `λ'_c`, and for each `d` an upper-triangular
`(s-1) × (s-1)` matrix `U'_d` with unit diagonal such that
`F_n[c][d] = λ'_c ∑_{n' ≤ n} w_cd y_cd^(n') U'_d[n', n]` for `c ≠ d`, `n ≤ s-2`. -/
def ResidualS {R : Type*} [CommRing R] {s : ℕ} (u v : Fin s → R)
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R) : Prop :=
  (∀ c, IsUnit (lam c)) ∧ (∀ d n' n, n < n' → n' < s - 1 → Ur d n' n = 0) ∧
    (∀ d n, n < s - 1 → IsUnit (Ur d n n)) ∧
    ∀ c d, c ≠ d → ∀ n, n < s - 1 →
      F n c d = lam c * ∑ n' ∈ range (n + 1), ySplit u v c d * ySplit u v c d ^ n' * Ur d n' n

/-- The defining relation of `β_n` (`n ≥ s-1`) on the split frame:
`λ' ⊙ (w_cd y_cd^n)_c = ∑_{i ≤ s-2} β_{n,i} F_i[·][d]` on the rows `c ≠ d`. -/
def BetaRelS {R : Type*} [CommRing R] {s : ℕ} (u v : Fin s → R)
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (β : Fin s → ℕ → ℕ → R) : Prop :=
  ∀ d n, s - 1 ≤ n → ∀ c, c ≠ d →
    lam c * (ySplit u v c d * ySplit u v c d ^ n) = ∑ i ∈ range (s - 1), β d n i * F i c d

/-- The column gauge `U_d = Toep(Π_d(v_d + x)) · U'^(k)_d` (level index). -/
noncomputable def UgaugeS {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (v : Fin s → R)
    (Ur : Fin s → ℕ → ℕ → R) (β : Fin s → ℕ → ℕ → R) (d : Fin s) : Matrix (Fin k) (Fin k) R :=
  toep k (piSplit k v d) *
    Matrix.of (fun i j : Fin k => Ux Ur β d (k - 1 - (i : ℕ)) (k - 1 - (j : ℕ)))

/-- The row gauge `L_c = diag(λ'_c P_c^(-k), 1, …, 1)`. -/
noncomputable def LmatS {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (lam : Fin s → R) (c : Fin s) : Matrix (Fin (s * k - k)) (Fin (s * k - k)) R :=
  Lgauge (s * k - k) (lam c * Ring.inverse (Psplit u v c ^ k))

/-- The blocks of `𝒫^{u,v,F}_k` (`def:Ns` on the split frame): `L_c Φ^S_cd U_d` for `c ≠ d`; the
diagonal block has row `0` equal to `(F_{s-2}[c][c], …, F_0[c][c])` on the levels
`(k-s+1, …, k-1)` and all other entries `0`. -/
noncomputable def PPhiS {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R)
    (β : Fin s → ℕ → ℕ → R) (c d : Fin s) : Matrix (Fin (s * k - k)) (Fin k) R :=
  if c = d then fun r l => if (r : ℕ) = 0 ∧ k - 1 - (l : ℕ) < s - 1 then F (k - 1 - (l : ℕ)) c c
    else 0
  else LmatS k u v lam c * splitGraph R k u v c d * UgaugeS k v Ur β d

/-- Generator matrices of `𝒫^{u,v,F}_k` over `R` (graph form with depths `(k, …, k)`). -/
noncomputable def PGenS {R : Type*} [CommRing R] {s : ℕ} (k : ℕ) (u v : Fin s → R)
    (F : ℕ → Fin s → Fin s → R) (lam : Fin s → R) (Ur : Fin s → ℕ → ℕ → R)
    (β : Fin s → ℕ → ℕ → R) : Fin s → Matrix (Fin (s * k)) (Fin (s * k)) R :=
  graphGenK (m := s * k) (fun _ => k) (PPhiS k u v F lam Ur β)

end Z3NetF
